import React from "react";

const Insurance = ({
  step,
  insurance,
  setInsurance,
  familyMembers,
  setFamilyMembers
}) => {

  const handleInsuranceChange = (field, value) => {
    setInsurance({
      ...insurance,
      [field]: value
    });
  };

  const handleInsuranceFile = (e) => {
    const file = e.target.files[0];
    setInsurance({
      ...insurance,
      policy_document: file
    });
  };

  return (
    <>
      {step === 5 && (
        <div className="step-content">

          {/* INSURANCE DETAILS */}
          <div className="card mb-4 shadow-sm">
            <div className="card-header bg-light fw-semibold">
              Insurance Details
            </div>

            <div className="card-body">
              <div className="row g-3">

                <div className="col-md-6">
                  <label className="form-label">Insurance Company</label>
                  <input
                    type="text"
                    className="form-control"
                    maxLength={150}
                    value={insurance.insurance_company || ""}
                    onChange={(e) =>
                      handleInsuranceChange("insurance_company", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-6">
                  <label className="form-label">Policy Number</label>
                  <input
                    type="text"
                    className="form-control"
                    maxLength={100}
                    value={insurance.policy_number || ""}
                    onChange={(e) =>
                      handleInsuranceChange("policy_number", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-6">
                  <label className="form-label">From Date</label>
                  <input
                    type="date"
                    className="form-control"
                    value={insurance.from_date || ""}
                    onChange={(e) =>
                      handleInsuranceChange("from_date", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-6">
                  <label className="form-label">To Date</label>
                  <input
                    type="date"
                    className="form-control"
                    value={insurance.to_date || ""}
                    onChange={(e) =>
                      handleInsuranceChange("to_date", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-6">
                  <label className="form-label">Sum Insured</label>
                  <input
                    type="number"
                    className="form-control"
                    step="0.01"
                    value={insurance.sum_insured || ""}
                    onChange={(e) =>
                      handleInsuranceChange("sum_insured", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-6">
                  <label className="form-label">Policy Premium</label>
                  <input
                    type="number"
                    className="form-control"
                    step="0.01"
                    value={insurance.policy_premium || ""}
                    onChange={(e) =>
                      handleInsuranceChange("policy_premium", e.target.value)
                    }
                  />
                </div>

                <div className="col-md-12">
                  <label className="form-label">
                    Family Members Covered
                  </label>
                  <textarea
                    className="form-control"
                    rows="2"
                    value={insurance.family_members_covered || ""}
                    onChange={(e) =>
                      handleInsuranceChange(
                        "family_members_covered",
                        e.target.value
                      )
                    }
                  />
                </div>

                <div className="col-md-12">
                  <label className="form-label">Policy Document</label>
                  <input
                    type="file"
                    className="form-control"
                    accept=".pdf,.jpg,.jpeg,.png"
                    onChange={handleInsuranceFile}
                  />
                </div>

              </div>
            </div>
          </div>

        </div>
      )}
    </>
  );
};

export default Insurance;