const catchAsync = require("../../../utils/catchAsync");
const Service = require("./employeeSalaryRegisterMonthly.service");

const generateMonthlySalary = catchAsync(async (req, res) => {
    if (req.isSuperAdmin) {
        if (!req.body.organization_id) {
            throw new AppError("organization_id is required", 400);
        }
    } else {
        req.body.organization_id = req.user.organization_id;
    }
  const result = await Service.generateMonthlySalary(req.body);

  res.status(200).json({
    status: "success",
    data: result,
  });
});

module.exports = {
  generateMonthlySalary,
};
