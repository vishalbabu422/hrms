import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormTextarea,
  CRow,
} from '@coreui/react'
import { useEffect, useMemo, useState } from 'react'
import api from '../../api/axios'
// import GstSelect from '../components/gst-select'
// import WoDesignationSelect from '../components/wo-designation-select'
import { useNavigate, useParams } from 'react-router-dom'
import { toast } from 'react-toastify'
// import { calculateAmounts, calculateDuration } from '../../utils/workOrderCalculations'
import { validateWorkOrderDesgn } from '../../validations/workOrderDesgnValidation'

const emptyReplica = {
  title: '',
  description: '',
  deployment_from: '',
  deployment_to: '',
  duration_days: '',
  totalAmount: 0,
  totalDays: 0,
  months: 0,
  partialMonthFactor: 0,
}

const defaultInitialData = {
  workOrderId: '',
  deployments: [],
}

const normalizeReplica = (replica = {}) => ({
  ...emptyReplica,
  ...replica,
})

const WorkOrderDesgnFormComponent = ({ initialData, mode = 'create', onSubmit = () => {} }) => {
  const { id } = useParams()
  const workOrderId = id
  const navigate = useNavigate()
  const [errors, setErrors] = useState([])
  const [replicas, setReplicas] = useState([])

  useEffect(() => {
    if (!workOrderId) return

    const fetchDesignations = async () => {
      try {
        const response = await api.get(`/admin/workorder-desgn/workorder/${workOrderId}`)

        const list = response.data?.data?.workOrderDesgnList || []

        if (list.length > 0) {
          const computed = list.map((item) => {
            const replica = normalizeReplica(item)

            // 1️⃣ Calculate duration
            const duration = calculateDuration(replica.deployment_from, replica.deployment_to)

            const withDuration = {
              ...replica,
              ...duration,
            }

            // 2️⃣ Calculate amounts
            const amounts = calculateAmounts(withDuration, {
              totalAmount: true,
              cgst: true,
              sgst: true,
              igst: true,
            })

            return {
              ...withDuration,
              ...amounts,
            }
          })

          setReplicas(computed)
        } else {
          setReplicas([{ ...emptyReplica }])
        }
      } catch (err) {
        console.error(err)
        setReplicas([{ ...emptyReplica }])
      }
    }

    fetchDesignations()
  }, [workOrderId])

  useEffect(() => {
    if (!replicas.length) return

    // const fetchResourceRates = async () => {
    //   const updates = await Promise.all(
    //     replicas.map(async (replica, index) => {
    //       if (!replica?.desgn_id_fk) return null

    //       try {
    //         const response = await api.get(`/admin/resourcerate/designation/${replica.desgn_id_fk}`)
    //         const data = response.data?.data || {}

    //         return {
    //           index,
    //           monthly_unit_rate: Number(data.unit_rate_incl_agency_margin || 0),
    //         }
    //       } catch (error) {
    //         console.error('Failed to fetch resource rate:', error)
    //         return null
    //       }
    //     }),
    //   )

    //   setReplicas((prev) => {
    //     let changed = false
    //     const next = [...prev]

    //     updates.forEach((update) => {
    //       if (!update) return

    //       const current = next[update.index]
    //       if (!current) return

    //       if (Number(current.monthly_unit_rate || 0) === update.monthly_unit_rate) return

    //       const withRate = {
    //         ...current,
    //         monthly_unit_rate: update.monthly_unit_rate,
    //       }

    //       const amounts = calculateAmounts(withRate, {
    //         totalAmount: true,
    //         cgst: true,
    //         sgst: true,
    //         igst: true,
    //       })

    //       next[update.index] = { ...withRate, ...amounts }
    //       changed = true
    //     })

    //     return changed ? next : prev
    //   })
    // }

    fetchResourceRates()
  }, [replicas.map((item) => item?.desgn_id_fk || '').join('|')])

  // Fetch GST percentages when SAC/GST code changes in any deployment row
  useEffect(() => {
    if (!replicas.length) return

    // const fetchGstPercentages = async () => {
    //   const updates = await Promise.all(
    //     replicas.map(async (replica, index) => {
    //       if (!replica?.sac_code) return null

    //       try {
    //         const response = await api.get(`/admin/gst-code/${replica.sac_code}`)
    //         const gst = response.data?.data || {}

    //         return {
    //           index,
    //           cgst_percent: Number(gst.cgst_rate || 0),
    //           sgst_percent: Number(gst.sgst_rate || 0),
    //           igst_percent: Number(gst.igst_rate || 0),
    //         }
    //       } catch (error) {
    //         console.error('Failed to fetch gst percentages:', error)
    //         return null
    //       }
    //     }),
    //   )

    //   setReplicas((prev) => {
    //     let changed = false
    //     const next = [...prev]

    //     updates.forEach((update) => {
    //       if (!update) return

    //       const current = next[update.index]
    //       if (!current) return

    //       const hasPercentChange =
    //         Number(current.cgst_percent || 0) !== update.cgst_percent ||
    //         Number(current.sgst_percent || 0) !== update.sgst_percent ||
    //         Number(current.igst_percent || 0) !== update.igst_percent

    //       if (!hasPercentChange) return

    //       const withPercent = { ...current, ...update }
    //       const amounts = calculateAmounts(withPercent, {
    //         totalAmount: true,
    //         cgst: true,
    //         sgst: true,
    //         igst: true,
    //       })
    //       next[update.index] = { ...withPercent, ...amounts }
    //       changed = true
    //     })

    //     return changed ? next : prev
    //   })
    // }

    fetchGstPercentages()
  }, [replicas.map((item) => item?.sac_code || '').join('|')])

  const updateReplica = (index, field, value) => {
    const updated = [...replicas]
    updated[index] = { ...updated[index], [field]: value }

    // if (field === 'desgn_id_fk' && Number(value) !== 0) {
    //   updated[index].description = ''
    // }

    const durationDrivers = ['deployment_from', 'deployment_to']
    const amountDrivers = ['monthly_unit_rate', 'req_person_count', 'months', 'days']

    if (durationDrivers.includes(field)) {
      const duration = calculateDuration(
        updated[index].deployment_from,
        updated[index].deployment_to,
      )

      updated[index] = {
        ...updated[index],
        ...duration,
      }
    }

    if (amountDrivers.includes(field)) {
      const amounts = calculateAmounts(updated[index], {
        totalAmount: true,
        cgst: true,
        sgst: true,
        igst: true,
      })
      updated[index].totalAmount = amounts.totalAmount
      updated[index].igst_amount = amounts.igst_amount
      updated[index].cgst_amount = amounts.cgst_amount
      updated[index].sgst_amount = amounts.sgst_amount
    }

    setReplicas(updated)
  }

  const addReplica = () => {
    setReplicas((prev) => [...prev, { ...emptyReplica }])
  }

  const removeReplica = (index) => {
    setReplicas((prev) => prev.filter((_, idx) => idx !== index))
  }

  const totalOfTotalAmount = useMemo(
    () => replicas.reduce((s, r) => s + Math.round(r.totalAmount || 0), 0),
    [replicas],
  )

  const totalIgst = useMemo(
    () => replicas.reduce((s, r) => s + Number(r.igst_amount || 0), 0),
    [replicas],
  )
  const totalCgst = useMemo(
    () => replicas.reduce((s, r) => s + Number(r.cgst_amount || 0), 0),
    [replicas],
  )
  const totalSgst = useMemo(
    () => replicas.reduce((s, r) => s + Number(r.sgst_amount || 0), 0),
    [replicas],
  )

  const grandTotal = Math.round(totalOfTotalAmount + totalIgst + totalCgst + totalSgst)

  // const handleSubmit = async (e) => {
  //   e.preventDefault()

  //   const payload = {
  //     work_order_id: workOrderId,
  //     deployments: replicas,
  //      modified_by: 1, // ✅ add this (replace with real user id later)
  //   }

  //   try {
  //     await api.post('admin/workorder-desgn/create', payload)
  //     toast.success(`Designations for Work Order saved successfully`)
  //     navigate('/work-order')
  //   } catch (error) {
  //     console.error(error)
  //     toast.error(error.response?.data?.message || 'Failed to save Designations')
  //   }
  // }

  const handleSubmit = async (e) => {
    e.preventDefault()

    const payload = {
      work_order_id: workOrderId,
      deployments: replicas.map((item) => ({
        ...item,
        modified_by: 1,
      })),
    }

    try {
      await api.post('admin/workorder-desgn/create', payload)

      await api.patch(`/admin/workorder/edit/${workOrderId}`, {
        grand_total: grandTotal,
      })

      toast.success(`Designations for Work Order saved successfully`)
      navigate('/work-order')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to save Designations')
    }
  }

  return (
    <CForm onSubmit={handleSubmit}>
      {Array.isArray(replicas) &&
        replicas.map((r, i) => (
          <CCard className="mt-4" key={i}>
            <CCardBody>
              <div className="d-flex justify-content-between mb-3">
                <strong>Milestone #{i + 1}</strong>
                <div>
                  <CButton size="sm" color="primary" type="button" onClick={addReplica}>
                    +
                  </CButton>{' '}
                  {replicas.length > 1 && (
                    <CButton
                      size="sm"
                      color="secondary"
                      type="button"
                      onClick={() => removeReplica(i)}
                    >
                      -
                    </CButton>
                  )}
                </div>
              </div>

              <CRow className="g-3">
                <CCol md={6}>
                  <GstSelect
                    name="sac_code"
                    value={r.sac_code ?? ''}
                    onChange={(e) => updateReplica(i, 'sac_code', e.target.value)}
                    required
                  />

                  {errors[i]?.sac_code && (
                    <div className="text-danger mt-1">{errors[i].sac_code}</div>
                  )}
                </CCol>

                <CCol md={6}>
                  <CFormLabel>
                    Title <span className="text-danger">*</span>
                  </CFormLabel>

                  <CFormInput
                    value={r.title ?? ''}
                    onChange={(e) => updateReplica(i, 'title', e.target.value)}
                    placeholder="Enter Title"
                  />
                </CCol>

                {/* {(Number(r.desgn_id_fk) === 0 || r.description) && ( */}
                <CCol md={12}>
                  <CFormLabel>Description</CFormLabel>
                  <CFormTextarea
                    type="description"
                    value={r.description ?? ''}
                    onChange={(e) => updateReplica(i, 'description', e.target.value)}
                  />
                </CCol>

                <CCol md={6}>
                  <CFormLabel>
                    From <span className="text-danger">*</span>
                  </CFormLabel>

                  <CFormInput
                    type="date"
                    value={r.deployment_from ?? ''}
                    onChange={(e) => updateReplica(i, 'deployment_from', e.target.value)}
                    invalid={!!errors[i]?.deployment_from}
                    feedback={errors[i]?.deployment_from}
                  />
                </CCol>

                <CCol md={6}>
                  <CFormLabel>
                    To <span className="text-danger">*</span>
                  </CFormLabel>

                  <CFormInput
                    type="date"
                    value={r.deployment_to ?? ''}
                    onChange={(e) => updateReplica(i, 'deployment_to', e.target.value)}
                    invalid={!!errors[i]?.deployment_to}
                    feedback={errors[i]?.deployment_to}
                  />
                </CCol>

                <CCol md={4}>
                  <CFormLabel>
                    Duration <span className="text-danger">*</span>
                  </CFormLabel>

                  <CFormInput
                    value={r.duration_days ?? ''}
                    readOnly
                    invalid={!!errors[i]?.duration_days}
                  />

                  {errors[i]?.duration_days && (
                    <div className="text-danger mt-1">{errors[i].duration_days}</div>
                  )}
                </CCol>

                <CCol md={3}>
                  <CFormLabel>Total Amount</CFormLabel>
                  <CFormInput type="number" value={r.totalAmount ?? 0} readOnly />
                </CCol>
              </CRow>
            </CCardBody>
          </CCard>
        ))}

      {replicas.length > 0 && (
        <CCard className="mt-4">
          <CCardBody>
            <CRow className="mt-3 mb-3">
              <CCol md={3}>
                <CFormLabel>Total</CFormLabel>
                <CFormInput value={totalOfTotalAmount.toFixed(2) ?? 0} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormLabel>IGST</CFormLabel>
                <CFormInput value={totalIgst.toFixed(2) ?? 0} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormLabel>CGST</CFormLabel>
                <CFormInput value={totalCgst.toFixed(2) ?? 0} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormLabel>SGST</CFormLabel>
                <CFormInput value={totalSgst.toFixed(2) ?? 0} readOnly />
              </CCol>
            </CRow>
            <CRow>
              <CCol md={12}>
                <CFormLabel>
                  <strong>Grand Total</strong>
                </CFormLabel>
                <CFormInput value={grandTotal.toFixed(2) ?? 0} readOnly />
              </CCol>
            </CRow>

            <CButton className="mt-4" type="submit" color="primary">
              {mode === 'edit' ? 'Update' : 'Submit'}
            </CButton>
          </CCardBody>
        </CCard>
      )}
    </CForm>
  )
}

export default WorkOrderDesgnFormComponent
