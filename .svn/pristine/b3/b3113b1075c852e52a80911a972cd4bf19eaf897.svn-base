import React, { forwardRef, useImperativeHandle, useState, useEffect } from 'react'
import api from '../../../api/axios'
import { toast } from 'react-toastify'
import useDocumentUpload from '../../../hooks/useDocumentUpload'
import useEmployeeDocuments from '../../../hooks/fetchDocuments'
import { validateInsurance } from '../../../validations/insuranceValidation'

const Insurance = forwardRef(({ employeeId, isEdit }, ref) => {
  const [loading, setLoading] = useState(false)
  const [isExisting, setIsExisting] = useState(false)
  const [errors, setErrors] = useState({})

  const [insurance, setInsurance] = useState({
    insurance_company: '',
    policy_number: '',
    from_date: '',
    to_date: '',
    sum_insured: '',
    policy_premium: '',
    family_members_covered: '',
    policy_document: null,
  })

  const [policyFile, setPolicyFile] = useState(null)

  const { uploadDocument, updateDocument } = useDocumentUpload(employeeId)

  // 🔥 fetch existing document
  const { documents } = useEmployeeDocuments(employeeId, 'POLICY_DOCUMENT')

  const policyDoc = documents?.find((d) => d.doc_type === 'POLICY_DOCUMENT')

  // ================= FETCH INSURANCE =================
  useEffect(() => {
    if (!employeeId) return

    const fetchInsurance = async () => {
      try {
        const res = await api.get(`/employee/${employeeId}/insurance`)
        const data = res.data?.data?.[0]

        if (data) {
          setInsurance(data)
          setIsExisting(true)
        }
      } catch (err) {
        console.error('Fetch insurance error', err)
      }
    }

    fetchInsurance()
  }, [employeeId])

  // ================= HANDLERS =================
  // const handleChange = (field, value) => {
  //   setInsurance((prev) => ({
  //     ...prev,
  //     [field]: value,
  //   }))
  // }

  const handleChange = (field, value) => {
    setInsurance((prev) => ({
      ...prev,
      [field]: value,
    }))

    setErrors((prev) => ({
      ...prev,
      [field]: '',
    }))
  }

  const handleFile = (e) => {
    const file = e.target.files[0]
    setPolicyFile(file)
  }

  // ================= SUBMIT =================
  useImperativeHandle(ref, () => ({
    // submit: async () => {
    //   try {
    //     setLoading(true)

    //     const url = `/employee/${employeeId}/insurance`

    //     // 🔥 SAVE INSURANCE DATA
    //     if (isExisting) {
    //       await api.patch(url, insurance)
    //     } else {
    //       await api.post(url, insurance)
    //     }

    //     // 🔥 HANDLE DOCUMENT
    //     if (policyFile) {
    //       if (policyDoc?.id) {
    //         await updateDocument({
    //           docId: policyDoc.id,
    //           file: policyFile,
    //           docType: 'POLICY_DOCUMENT',
    //           remarks: 'Insurance policy document',
    //         })
    //       } else {
    //         await uploadDocument({
    //           file: policyFile,
    //           docType: 'POLICY_DOCUMENT',
    //           remarks: 'Insurance policy document',
    //         })
    //       }
    //     }

    //     toast.success('Insurance saved')
    //     return true
    //   } catch (error) {
    //     console.error(error)
    //     toast.error(error.response?.data?.message || 'Failed to save insurance')
    //     return false
    //   } finally {
    //     setLoading(false)
    //   }
    // },

    submit: async () => {
      try {
        setLoading(true)

        const validationErrors = validateInsurance(insurance, 'Insurance')

        if (Object.keys(validationErrors).length > 0) {
          setErrors(validationErrors)
          return false
        }

        const url = `/employee/${employeeId}/insurance`

        if (isExisting) {
          await api.patch(url, insurance)
        } else {
          await api.post(url, insurance)
        }

        // file upload (no validation)
        if (policyFile) {
          if (policyDoc?.id) {
            await updateDocument({
              docId: policyDoc.id,
              file: policyFile,
              docType: 'POLICY_DOCUMENT',
              remarks: 'Insurance policy document',
            })
          } else {
            await uploadDocument({
              file: policyFile,
              docType: 'POLICY_DOCUMENT',
              remarks: 'Insurance policy document',
            })
          }
        }

        return true
      } catch (error) {
        console.error(error)
        return false
      } finally {
        setLoading(false)
      }
    },
  }))

  return (
    <div className="step-content">
      <div className="card mb-4 shadow-sm">
        <div className="card-header bg-light fw-semibold">Insurance Details</div>

        <div className="card-body">
          <div className="row g-3">
            <div className="col-md-6">
              <label className="form-label">
                Insurance Company <span className="text-danger">*</span>
              </label>

              <input
                className={`form-control ${errors.insurance_company ? 'is-invalid' : ''}`}
                value={insurance.insurance_company || ''}
                onChange={(e) => handleChange('insurance_company', e.target.value)}
              />

              <div className="invalid-feedback">{errors.insurance_company}</div>
            </div>

            <div className="col-md-6">
              <label className="form-label">
                Policy Number <span className="text-danger">*</span>
              </label>

              <input
                className={`form-control ${errors.policy_number ? 'is-invalid' : ''}`}
                value={insurance.policy_number || ''}
                onChange={(e) => handleChange('policy_number', e.target.value)}
              />

              <div className="invalid-feedback">{errors.policy_number}</div>
            </div>

            <div className="col-md-6">
              <label className="form-label">
                From Date <span className="text-danger">*</span>
              </label>

              <input
                type="date"
                className={`form-control ${errors.from_date ? 'is-invalid' : ''}`}
                value={insurance.from_date || ''}
                onChange={(e) => handleChange('from_date', e.target.value)}
              />

              <div className="invalid-feedback">{errors.from_date}</div>
            </div>

            <div className="col-md-6">
              <label className="form-label">To Date</label>
              <input
                type="date"
                className="form-control"
                value={insurance.to_date || ''}
                onChange={(e) => handleChange('to_date', e.target.value)}
              />
            </div>

            <div className="col-md-6">
              <label className="form-label">
                Sum Insured <span className="text-danger">*</span>
              </label>

              <input
                type="number"
                className={`form-control ${errors.sum_insured ? 'is-invalid' : ''}`}
                value={insurance.sum_insured || ''}
                onChange={(e) => handleChange('sum_insured', e.target.value)}
              />

              <div className="invalid-feedback">{errors.sum_insured}</div>
            </div>

            <div className="col-md-6">
              <label className="form-label">
                Policy Premium <span className="text-danger">*</span>
              </label>

              <input
                type="number"
                className={`form-control ${errors.policy_premium ? 'is-invalid' : ''}`}
                value={insurance.policy_premium || ''}
                onChange={(e) => handleChange('policy_premium', e.target.value)}
              />

              <div className="invalid-feedback">{errors.policy_premium}</div>
            </div>

            <div className="col-md-12">
              <label className="form-label">Family Members Covered</label>
              <textarea
                className="form-control"
                value={insurance.family_members_covered || ''}
                onChange={(e) => handleChange('family_members_covered', e.target.value)}
              />
            </div>

            {/* FILE */}
            <div className="col-md-12">
              <label className="form-label">Policy Document</label>

              <input type="file" className="form-control" onChange={handleFile} />

              {/* Existing doc */}
              {!policyFile && policyDoc && (
                <div className="mt-2">
                  <a href={policyDoc.file_url} target="_blank" rel="noreferrer">
                    {policyDoc.file_name}
                  </a>
                </div>
              )}

              {/* New file */}
              {policyFile && <small className="text-success">{policyFile.name}</small>}
            </div>
          </div>
        </div>
      </div>
    </div>
  )
})

export default Insurance
