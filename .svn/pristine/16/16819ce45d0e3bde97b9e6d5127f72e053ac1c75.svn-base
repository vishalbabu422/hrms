import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

const Add = () => {
  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3">
              <CCol md={12}>
                <CFormLabel htmlFor="inputCategory">Category</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputCategory"
                  name="category"
                  placeholder="Enter category"
                  maxLength={20}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputEmpNo">Empanelment No</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputEmpNo"
                  name="empNo"
                  placeholder="Enter empanelment no"
                  inputMode="numeric"
                  pattern="[0-9]*"
                  maxLength={50}
                  onInput={(e) => {
                    e.target.value = e.target.value.replace(/\D/g, '')
                  }}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputEmpanelmentDate"> Date</CFormLabel>
                <CFormInput type="date" id="inputEmpanelmentDate" name="empanelmentDate" required />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputCategory">Short Code</CFormLabel>
                <CFormInput
                  type="text"
                  id="shortcode"
                  name="shortcode"
                  placeholder="Enter shortcode"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputRfe">RFE</CFormLabel>
                <CFormInput
                  type="text"
                  id="rfe"
                  name="rfe"
                  placeholder="Enter rfe"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputEffectiveFrom">Effective From</CFormLabel>
                <CFormInput type="date" id="inputEffectiveFrom" name="effectiveFrom" required />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputEffectiveTo">Effective To</CFormLabel>
                <CFormInput type="date" id="inputEffectiveTo" name="effectiveTo" />
              </CCol>

              <CCol md={12}>
                <CFormLabel htmlFor="status">Status</CFormLabel>
                <CFormSelect id="status" name="status">
                  <option value="">Select</option>
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton color="primary" type="submit">
                  Submit
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Add
