const router = require("express").Router();

const EmployeeWOLeaveController = require("./employeeWOLeave.controller");

const {
  protect,
  restrictTo,
} = require("../../../middlewares/authMiddleware");

const ROLES = ["ORG_ADMIN", "SUPER_ADMIN"];

router.use(protect);

router
  .route("/")
  .get(
    restrictTo(...ROLES),
    EmployeeWOLeaveController.getEmployeeWOLeave
  )
  .post(
    restrictTo(...ROLES),
    EmployeeWOLeaveController.assignEmployeeWOLeave
  );

module.exports = router;