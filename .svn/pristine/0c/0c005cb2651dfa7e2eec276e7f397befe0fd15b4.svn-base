const router = require("express").Router({ mergeParams: true });

const controller = require("./employeeWOMpr.controller");
const { protect, restrictTo } = require("../../../middlewares/authMiddleware");
const upload = require("../../../middlewares/mprdocumentUpload.middleware");

const ROLES = ["ORG_ADMIN", "SUPER_ADMIN"];

router.use(protect);

router
  .route("/")
  .get(
    restrictTo(...ROLES),
    controller.getEmployeeWOMpr
  )
  .post(restrictTo(...ROLES), controller.createEmployeeWOMpr);

router
  .route("/upload")
  .post(upload.single("file"), controller.uploadEmployeeWOMpr);

router
  .route("/:mprId")
  .delete(restrictTo(...ROLES), controller.deleteEmployeeWOMpr);

module.exports = router;