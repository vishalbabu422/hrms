import React, { useState, useEffect } from 'react'
import api from '../../../api/axios'

const Address = ({ employeeId, employeeAddress, setEmployeeAddress }) => {

  const emptyAddress = (type) => ({
    address_type: type,
    address_line1: '',   // ✅ FIXED (was address)
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
    is_primary: false,
  })

  const [sameAddress, setSameAddress] = useState(false)

  // ================= FETCH ADDRESS =================
  useEffect(() => {
    if (!employeeId) return   // ✅ FIXED

    const fetchAddress = async () => {
      try {
        const response = await api.get(`/employee/${employeeId}/address`)

        const data = response.data?.data || response.data   // ✅ FIXED

        setEmployeeAddress({
          correspondence: data?.correspondence_address || emptyAddress('CORRESPONDENCE'),
          permanent: data?.permanent_address || emptyAddress('PERMANENT'),
        })
      } catch (error) {
        console.error('Error fetching address', error)
      }
    }

    fetchAddress()
  }, [employeeId])

  // ================= HANDLE CORRESPONDENCE =================
  const handleCorrespondenceChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      correspondence: {
        ...prev?.correspondence,
        [name]: value,
      },
    }))

    if (sameAddress) {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: {
          ...prev?.permanent,
          [name]: value,
        },
      }))
    }
  }

  // ================= HANDLE PERMANENT =================
  const handlePermanentChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      permanent: {
        ...prev?.permanent,
        [name]: value,
      },
    }))
  }

  // ================= SAME ADDRESS =================
  const handleSameAddressToggle = () => {
    const checked = !sameAddress
    setSameAddress(checked)

    if (checked) {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: {
          ...prev?.correspondence,
          address_type: 'PERMANENT',
          is_primary: false,
        },
      }))
    } else {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: emptyAddress('PERMANENT'),   // ✅ FIXED
      }))
    }
  }

  const addressFields = ['landmark', 'city', 'district', 'state', 'country', 'pin_code']

  return (
    <>
      {/* ================= Correspondence ================= */}
      <div className="card mb-4 shadow-sm">
        <div className="card-header bg-light fw-semibold">
          Correspondence Address
        </div>

        <div className="card-body">
          <div className="row g-3">

            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.correspondence?.address_line1 || ''}   // ✅ FIXED
                onChange={handleCorrespondenceChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.correspondence?.[field] || ''}   // ✅ FIXED
                  onChange={handleCorrespondenceChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}

          </div>
        </div>
      </div>

      {/* ================= Permanent ================= */}
      <div className="card shadow-sm">   {/* ✅ FIXED (removed \) */}

        <div className="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
          Permanent Address

          <div className="form-check mb-0">
            <input
              className="form-check-input"
              type="checkbox"
              checked={sameAddress}
              onChange={handleSameAddressToggle}
            />

            <label className="form-check-label small">
              Same as Correspondence
            </label>
          </div>
        </div>

        <div className="card-body">
          <div className="row g-3">

            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.permanent?.address_line1 || ''}   // ✅ FIXED
                onChange={handlePermanentChange}
                disabled={sameAddress}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.permanent?.[field] || ''}   // ✅ FIXED
                  onChange={handlePermanentChange}
                  placeholder={`Enter ${field}`}
                  disabled={sameAddress}
                />
              </div>
            ))}

          </div>
        </div>
      </div>
    </>
  )
}

export default Address