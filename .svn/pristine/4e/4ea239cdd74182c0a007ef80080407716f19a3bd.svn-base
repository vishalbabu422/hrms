import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormTextarea,
  CRow,
  CFormSelect,
} from '@coreui/react'
import { useState } from 'react'

const emptyReplica = {
  fromDate: '',
  toDate: '',
  durationText: '',
  totalDays: 0,
  personCount: '',
  unitRate: '',
  totalAmount: 0,
  cgst: '',
  sgst: '',
  igst: '',
}

const Add = () => {
  const [workOrderId, setWorkOrderId] = useState('')
  const [replicas, setReplicas] = useState([])

  /* ---------- Duration logic ---------- */
  const calculateDuration = (from, to) => {
    if (!from || !to) return { text: '', days: 0 }

    const start = new Date(from)
    const end = new Date(to)
    if (start > end) return { text: '', days: 0 }

    let months = 0
    let days = 0
    let cursor = new Date(start)

    while (cursor <= end) {
      const y = cursor.getFullYear()
      const m = cursor.getMonth()

      const monthStart = new Date(y, m, 1)
      const monthEnd = new Date(y, m + 1, 0)

      const effectiveStart = cursor > monthStart ? cursor : monthStart
      const effectiveEnd = end < monthEnd ? end : monthEnd

      const fullMonth =
        effectiveStart.getDate() === 1 && effectiveEnd.getDate() === monthEnd.getDate()

      if (fullMonth) {
        months++
      } else {
        days += effectiveEnd.getDate() - effectiveStart.getDate() + 1
      }

      cursor = new Date(y, m + 1, 1)
    }

    const text = [months ? `${months} Month(s)` : '', days ? `${days} Day(s)` : '']
      .filter(Boolean)
      .join(' ')

    return { text, days }
  }

  /* ---------- Replica update ---------- */
  const updateReplica = (index, field, value) => {
    const updated = [...replicas]
    updated[index][field] = value

    if (field === 'fromDate' || field === 'toDate') {
      const d = calculateDuration(updated[index].fromDate, updated[index].toDate)
      updated[index].durationText = d.text
      updated[index].totalDays = d.days
    }

    if (['personCount', 'unitRate', 'totalDays'].includes(field)) {
      const p = Number(updated[index].personCount || 0)
      const r = Number(updated[index].unitRate || 0)
      const d = Number(updated[index].totalDays || 0)
      updated[index].totalAmount = p * r * d
    }

    setReplicas(updated)
  }

  /* ---------- Totals ---------- */
  const grandTotal = replicas.reduce((s, r) => s + r.totalAmount, 0)
  const totalCgst = replicas.reduce((s, r) => s + (r.totalAmount * (r.cgst || 0)) / 100, 0)
  const totalSgst = replicas.reduce((s, r) => s + (r.totalAmount * (r.sgst || 0)) / 100, 0)
  const totalIgst = replicas.reduce((s, r) => s + (r.totalAmount * (r.igst || 0)) / 100, 0)

  /* ---------- Submit ---------- */
  const handleSubmit = (e) => {
    e.preventDefault()
    const payload = {
      workOrderId,
      deployments: replicas,
      grandTotal,
      totalCgst,
      totalSgst,
      totalIgst,
    }
    console.log(payload)
  }

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        <CCol md={6}>
          <CFormLabel>Work Order</CFormLabel>
          <CFormSelect
            value={workOrderId}
            onChange={(e) => {
              setWorkOrderId(e.target.value)
              if (!replicas.length) setReplicas([{ ...emptyReplica }])
            }}
          >
            <option value="">Select Work Order</option>
            <option value="1">Work Order 1</option>
            <option value="2">Work Order 2</option>
          </CFormSelect>
        </CCol>
      </CRow>

      {replicas.map((r, i) => (
        <CCard className="mt-4" key={i}>
          <CCardBody>
            <div className="d-flex justify-content-between mb-3">
              <strong>Deployment #{i + 1}</strong>
              <div>
                <CButton
                  size="sm"
                  color="success"
                  onClick={() => setReplicas([...replicas, { ...emptyReplica }])}
                >
                  +
                </CButton>{' '}
                {replicas.length > 1 && (
                  <CButton
                    size="sm"
                    color="danger"
                    onClick={() => setReplicas(replicas.filter((_, idx) => idx !== i))}
                  >
                    −
                  </CButton>
                )}
              </div>
            </div>

            <CRow className="g-3">
              <CCol md={4}>
                <CFormLabel>From</CFormLabel>
                <CFormInput
                  type="date"
                  value={r.fromDate}
                  onChange={(e) => updateReplica(i, 'fromDate', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>To</CFormLabel>
                <CFormInput
                  type="date"
                  value={r.toDate}
                  onChange={(e) => updateReplica(i, 'toDate', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>Duration</CFormLabel>
                <CFormInput value={r.durationText} readOnly />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Persons</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.personCount}
                  onChange={(e) => updateReplica(i, 'personCount', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>Unit Rate</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.unitRate}
                  onChange={(e) => updateReplica(i, 'unitRate', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>Total</CFormLabel>
                <CFormInput value={r.totalAmount} readOnly />
              </CCol>

              <CCol md={4}>
                <CFormLabel>CGST %</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.cgst}
                  onChange={(e) => updateReplica(i, 'cgst', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>SGST %</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.sgst}
                  onChange={(e) => updateReplica(i, 'sgst', e.target.value)}
                />
              </CCol>
              <CCol md={4}>
                <CFormLabel>IGST %</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.igst}
                  onChange={(e) => updateReplica(i, 'igst', e.target.value)}
                />
              </CCol>
            </CRow>
          </CCardBody>
        </CCard>
      ))}

      {replicas.length > 0 && (
        <CCard className="mt-4">
          <CCardBody>
            <strong>Grand Totals</strong>
            <CRow className="mt-3">
              <CCol md={3}>
                <CFormInput value={grandTotal} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormInput value={totalCgst} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormInput value={totalSgst} readOnly />
              </CCol>
              <CCol md={3}>
                <CFormInput value={totalIgst} readOnly />
              </CCol>
            </CRow>
          </CCardBody>
        </CCard>
      )}

      <CButton className="mt-4" type="submit" color="primary">
        Save
      </CButton>
    </CForm>
  )
}

export default Add
