import {
  CBadge,
  CButton,
  CModal,
  CModalBody,
  CModalFooter,
  CModalHeader,
  CModalTitle,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
} from '@coreui/react'

const CtcHistoryModal = ({ visible, onClose, employee }) => {
  // DUMMY HISTORY DATA
  const historyData = [
    {
      id: 1,
      effective_from: '2026-04-01',
      old_ctc: '40000',
      new_ctc: '45000',
      increment_amount: '5000',
      increment_percentage: '12.5',
      remarks: 'Annual Appraisal',
      updated_by: 'Admin',
      type: 'Appraisal',
    },
    {
      id: 2,
      effective_from: '2026-10-01',
      old_ctc: '45000',
      new_ctc: '48000',
      increment_amount: '3000',
      increment_percentage: '6.67',
      remarks: 'Promotion Increment',
      updated_by: 'HR Manager',
      type: 'Promotion',
    },
  ]

  return (
    <CModal
      visible={visible}
      onClose={onClose}
      size="xl"
      alignment="center"
      backdrop="static"
    >
      <CModalHeader>
        <CModalTitle>
          CTC History {employee?.name ? `- ${employee.name}` : ''}
        </CModalTitle>
      </CModalHeader>

      <CModalBody>
        {/* SUMMARY CARD */}
        <div
          style={{
            background: '#f8fafc',
            border: '1px solid #e5e7eb',
            borderRadius: '12px',
            padding: '16px',
            marginBottom: '20px',
          }}
        >
          <div className="d-flex justify-content-between flex-wrap gap-3">
            <div>
              <div className="text-muted small">Employee</div>
              <div className="fw-semibold">
                {employee?.name || '-'}
              </div>
            </div>

            <div>
              <div className="text-muted small">Current CTC</div>
              <div className="fw-semibold text-primary">
                ₹ {employee?.ctc || 0}
              </div>
            </div>

            <div>
              <div className="text-muted small">Total Revisions</div>
              <div className="fw-semibold text-success">
                {historyData.length}
              </div>
            </div>
          </div>
        </div>

        {/* HISTORY TABLE */}
        <CTable bordered hover responsive align="middle">
          <CTableHead color="light">
            <CTableRow>
              <CTableHeaderCell>
                Effective Date
              </CTableHeaderCell>

              <CTableHeaderCell>
                Previous CTC
              </CTableHeaderCell>

              <CTableHeaderCell>
                Revised CTC
              </CTableHeaderCell>

              <CTableHeaderCell>
                Increment
              </CTableHeaderCell>

              <CTableHeaderCell>
                Increment %
              </CTableHeaderCell>

              <CTableHeaderCell>
                Type
              </CTableHeaderCell>

              <CTableHeaderCell>
                Remarks
              </CTableHeaderCell>

              <CTableHeaderCell>
                Updated By
              </CTableHeaderCell>
            </CTableRow>
          </CTableHead>

          <CTableBody>
            {historyData.map((item) => (
              <CTableRow key={item.id}>
                <CTableDataCell>
                  {item.effective_from}
                </CTableDataCell>

                <CTableDataCell>
                  ₹ {item.old_ctc}
                </CTableDataCell>

                <CTableDataCell className="fw-semibold text-primary">
                  ₹ {item.new_ctc}
                </CTableDataCell>

                <CTableDataCell className="text-success fw-semibold">
                  +₹ {item.increment_amount}
                </CTableDataCell>

                <CTableDataCell>
                  +{item.increment_percentage}%
                </CTableDataCell>

                <CTableDataCell>
                  <CBadge
                    color={
                      item.type === 'Promotion'
                        ? 'info'
                        : 'success'
                    }
                  >
                    {item.type}
                  </CBadge>
                </CTableDataCell>

                <CTableDataCell>
                  {item.remarks}
                </CTableDataCell>

                <CTableDataCell>
                  {item.updated_by}
                </CTableDataCell>
              </CTableRow>
            ))}
          </CTableBody>
        </CTable>
      </CModalBody>

      <CModalFooter>
        <CButton
          color="secondary"
          onClick={onClose}
        >
          Close
        </CButton>
      </CModalFooter>
    </CModal>
  )
}

export default CtcHistoryModal
