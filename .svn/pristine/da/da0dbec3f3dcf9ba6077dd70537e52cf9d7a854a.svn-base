import React, { useState, useEffect, useRef } from 'react'
import { CCard, CCardBody, CRow, CCol, CButton, CContainer } from '@coreui/react'

import PageHeader from '../components/form-header'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'

import './mpr.css'

// reuse your existing components
import WorkOrderSelect from '../components/leave-mpr/WorkOrderSelect'
import EmployeeMultiSelect from '../components/leave-mpr/EmployeeMultiSelect'
import MonthYearSelect from '../components/leave-mpr/MonthYearSelect'

// reuse hook
import useLeaveMprForm from '../../hooks/useWoMpr'

const MPR = () => {
  const {
    workOrder,
    setWorkOrder,
    month,
    setMonth,
    monthOptions,

    selectedEmployees,
    setSelectedEmployees,
    filteredEmployees,
    isReady,
  } = useLeaveMprForm(true)

  const [checkedEmployees, setCheckedEmployees] = useState([])
  const [generatedFiles, setGeneratedFiles] = useState({})
  const [uploadedFiles, setUploadedFiles] = useState({})

  const isAllChecked =
    filteredEmployees.length > 0 &&
    filteredEmployees.every((emp) =>
      checkedEmployees.some((c) => c.id === (emp.id || emp.employee_id)),
    )

  //  Reset when workOrder changes
  useEffect(() => {
    setCheckedEmployees([])
    setGeneratedFiles({})
    setUploadedFiles({})
  }, [workOrder])

  // Row checkbox toggle
  const handleRowCheck = (emp) => {
    const empId = emp.id || emp.employee_id

    if (checkedEmployees.some((e) => e.id === empId)) {
      setCheckedEmployees((prev) => prev.filter((e) => e.id !== empId))
    } else {
      setCheckedEmployees((prev) => [...prev, { id: empId, name: emp.name }])
    }
  }

  // Header select all
  const handleHeaderCheck = () => {
    if (isAllChecked) {
      setCheckedEmployees([])
    } else {
      const all = displayEmployees.map((emp) => ({
        id: emp.id || emp.employee_id,
        name: emp.name || `${emp.first_name || ''} ${emp.last_name || ''}`,
      }))
      setCheckedEmployees(all)
    }
  }

  // Generate per employee
  const handleGenerate = () => {
    if (checkedEmployees.length === 0) {
      alert('Select employees first')
      return
    }

    const newFiles = {}

    checkedEmployees.forEach((emp) => {
      const blob = new Blob([`Generated for: ${emp.name}`], {
        type: 'application/pdf',
      })
      newFiles[emp.id] = URL.createObjectURL(blob)
    })

    setGeneratedFiles((prev) => ({
      ...prev,
      ...newFiles,
    }))
  }

  // Upload per employee
  const handleFileUpload = (e) => {
    const file = e.target.files[0]
    if (!file) return

    if (checkedEmployees.length === 0) {
      alert('Select employees first')
      return
    }

    const fileURL = URL.createObjectURL(file)
    const newFiles = {}

    checkedEmployees.forEach((emp) => {
      newFiles[emp.id] = fileURL
    })

    setUploadedFiles((prev) => ({
      ...prev,
      ...newFiles,
    }))
  }

  return (
    <CContainer fluid>
      <PageHeader title="MPR" />

      <CCard className="mpr-card">
        <CCardBody className="mpr-card-body">
          {/* Filters */}
          <CRow className="g-3 mb-2">
            <CCol md={4}>
              <WorkOrderSelect workOrder={workOrder} setWorkOrder={setWorkOrder} />
            </CCol>
            <CCol md={4}>
              <MonthYearSelect month={month} setMonth={setMonth} options={monthOptions} />
            </CCol>
            <CCol md={4}>
              <EmployeeMultiSelect
                workOrder={workOrder}
                month={month}
                selectedEmployees={selectedEmployees}
                setSelectedEmployees={setSelectedEmployees}
              />
            </CCol>
          </CRow>

          {/* Table */}
          {isReady && (
            <div className="mpr-table">
              <table className="table">
                <thead>
                  <tr>
                    <th>
                      <input type="checkbox" checked={isAllChecked} onChange={handleHeaderCheck} />{' '}
                      Emp Name
                    </th>
                    <th>Designation</th>
                    <th>Leave Granted</th>
                    <th>Leave Taken</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  {filteredEmployees.map((emp, i) => {
                    const empId = emp.id
                    console.log(emp)
                    const empName = `${emp.first_name || ''} ${emp.middle_name || ''} ${emp.last_name || ''}`
                    const leaveGranted = emp?.employeeWorkOrderLeaves?.[0]?.leave_granted
                    const leaveTaken = emp?.employeeWorkOrderLeaves?.[0]?.leave_taken
                    const designation =
                      emp?.EmployeeWorkOrderDeployment?.[0]?.WoDesgnMapping?.Designation?.designat
                    return (
                      <tr key={empId}>
                        <td>
                          <input
                            type="checkbox"
                            checked={checkedEmployees.some((e) => e.id === empId)}
                            onChange={() => handleRowCheck(emp)}
                          />{' '}
                          {empName}
                        </td>

                        {/*  Replace with real API later */}
                        <td>{designation ?? '-'}</td>
                        <td>{leaveGranted ?? '-'}</td>
                        <td>{leaveTaken ?? '-'}</td>

                        <td>
                          {uploadedFiles[empId] ? (
                            <a href={uploadedFiles[empId]} download>
                              <CIcon icon={cilCloudDownload} size="lg" />
                            </a>
                          ) : generatedFiles[empId] ? (
                            <a href={generatedFiles[empId]} download="mpr.pdf">
                              <CIcon icon={cilCloudDownload} size="lg" />
                            </a>
                          ) : null}
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>

              {/* Actions */}
              <div className="mt-3 d-flex gap-2">
                <CButton color="primary" onClick={handleGenerate}>
                  Generate
                </CButton>

                <label className="btn btn-light mb-0">
                  Upload
                  <input type="file" hidden accept=".pdf" onChange={handleFileUpload} />
                </label>
              </div>
            </div>
          )}
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default MPR
