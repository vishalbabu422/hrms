import { validateFields } from "../utils/validator";

export const validateTraining = (training) => {

    const rules = {

        training_name: {
            required: true,
            message: "Training name is required"
        },

        training_type: {
            required: true,
            message: "Training type is required"
        }

    };

    const errors = validateFields(training, rules);

    if (
        training.training_start_date &&
        training.training_end_date &&
        training.training_end_date < training.training_start_date
    ) {
        errors.training_end_date = "End date cannot be before start date";
    }

    if (training.certificate_file instanceof File) {

        const allowedTypes = [
            "application/pdf",
            "image/jpeg",
            "image/png"
        ];

        if (!allowedTypes.includes(training.certificate_file.type)) {
            errors.certificate_file = "Only PDF, JPG or PNG allowed";
        }

        if (training.certificate_file.size > 5 * 1024 * 1024) {
            errors.certificate_file = "File must be under 5MB";
        }

    }

    return errors;

};