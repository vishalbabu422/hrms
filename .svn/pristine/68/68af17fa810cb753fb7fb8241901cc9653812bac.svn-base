  "paths": {
    "/admin/empanelment/index": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Empanelment"],
        "summary": "Get Empanelment List",
        "description": "Get all empanelment records",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "is_active",
            "in": "query",
            "required": false,
            "type": "boolean",
            "description": "Filter by active status"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Sort fields (Ex: id desc)"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Select specific fields"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "Empanelment list fetched successfully"
          },
          "400": {
            "description": "Invalid request",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/empanelment/{id}": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Empanelment"],
        "summary": "Get Empanelment Code Edit List",
        "description": "Get all the Empanelment Codes!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "description": "ID of the Empanelment Code",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "is_active",
            "description": "Activeness of the Empanelment Code",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GstCodeResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },

    "/admin/empanelment/create": {
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Empanelment"],
        "summary": "Create Empanelment",
        "description": "Create a new Empanelment record in the master table",
        "consumes": ["application/json"],
        "produces": ["application/json"],

        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "category",
                "empanelment_no",
                "date",
                "shortcode",
                "rfe",
                "effective_from"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "maxLength": 20,
                  "example": "VENDOR"
                },
                "empanelment_no": {
                  "type": "string",
                  "maxLength": 50,
                  "example": "EMP-2024-001"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-15"
                },
                "shortcode": {
                  "type": "string",
                  "example": "EMP24"
                },
                "rfe": {
                  "type": "string",
                  "example": "RFE-IT-SERVICES"
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-31"
                }
              }
            }
          }
        ],

        "responses": {
          "201": {
            "description": "Empanelment created successfully",
            "schema": {
              "$ref": "#/definitions/EmpanelmentResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "Empanelment already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },

    "/admin/empanelment/edit/{id}": {
      "patch": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Empanelment"],
        "summary": "Update Empanelment (Partial)",
        "description": "Partially update an Empanelment using its ID",
        "consumes": ["application/json"],
        "produces": ["application/json"],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Empanelment ID",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "category": {
                  "type": "string",
                  "maxLength": 20,
                  "example": "Consultant"
                },
                "empanelment_no": {
                  "type": "string",
                  "maxLength": 50,
                  "example": "EMP-2024-002"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-05-01"
                },
                "shortcode": {
                  "type": "string",
                  "example": "NEWCODE"
                },
                "rfe": {
                  "type": "string",
                  "example": "RFE-99999"
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-05-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2026-03-31"
                },
                "is_active": {
                  "type": "boolean",
                  "example": false
                }
              }
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Empanelment updated successfully",
            "schema": {
              "$ref": "#/definitions/EmpanelmentResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "Empanelment not found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },

    "/admin/empanelment/delete/{id}": {
      "delete": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Empanelment"],
        "summary": "Delete Empanelment",
        "description": "Soft delete an Empanelment by ID",
        "produces": ["application/json"],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the Empanelment",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],

        "responses": {
          "200": {
            "description": "Empanelment deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Empanelment deleted successfully"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "Empanelment not found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "Empanelment already inactive",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },

