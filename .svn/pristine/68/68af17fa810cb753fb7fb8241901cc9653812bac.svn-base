  "definitions": {
    "EmpanelmentResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },

        "category": {
          "type": "string",
          "maxLength": 20
        },

        "empanelment_no": {
          "type": "string",
          "maxLength": 50
        },

        "date": {
          "type": "string",
          "format": "date"
        },

        "shortcode": {
          "type": "string",
          "maxLength": 255
        },

        "rfe": {
          "type": "string",
          "maxLength": 255
        },

        "effective_from": {
          "type": "string",
          "format": "date"
        },

        "effective_to": {
          "type": "string",
          "format": "date"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "category",
        "empanelment_no",
        "date",
        "shortcode",
        "rfe",
        "effective_from"
      ]
    },

    "GstCodeResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },

        "code_type": {
          "type": "string",
          "maxLength": 10
        },

        "code": {
          "type": "string",
          "maxLength": 10
        },

        "description": {
          "type": "string"
        },

        "gst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "sgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "igst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cess_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "other_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "effective_from": {
          "type": "string",
          "format": "date"
        },

        "effective_to": {
          "type": "string",
          "format": "date"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code_type", "code", "description", "effective_from"]
    },

    "EmpanelmentDesignationResponse": {
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },

    "empanelment_id_fk": {
      "type": "integer",
      "format": "int64"
    },

    "type": {
      "type": "string",
      "maxLength": 100
    },

    "designation": {
      "type": "string",
      "maxLength": 150
    },

    "qualification": {
      "type": "string"
    },

    "exp_in_years": {
      "type": "number",
      "format": "float",
      "description": "Experience in years (example: 5.5)"
    },

    "is_active": {
      "type": "boolean",
      "default": true
    },

    "created": {
      "type": "string",
      "format": "date-time"
    },

    "modified": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "empanelment_id_fk",
    "type",
    "designation",
    "qualification",
    "exp_in_years"
  ]
},
   "ResourceRateResponse": {
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },

    "desgn_id_fk": {
      "type": "integer",
      "format": "int64"
    },

    "unit_rate_incl_agency_margin": {
      "type": "number",
      "format": "float",
      "description": "Unit rate including agency margin"
    },

    "agency_margin_percent": {
      "type": "number",
      "format": "float",
      "description": "Agency margin percentage"
    },

    "agency_amount": {
      "type": "number",
      "format": "float",
      "description": "Calculated agency margin amount"
    },

    "unit_rate_excl_agency_margin": {
      "type": "number",
      "format": "float",
      "description": "Unit rate excluding agency margin"
    },

    "nicsi_margin_percent": {
      "type": "number",
      "format": "float",
      "description": "NICSI margin percentage"
    },

    "nicsi_margin_amount": {
      "type": "number",
      "format": "float",
      "description": "NICSI margin amount"
    },

    "total_amount": {
      "type": "number",
      "format": "float",
      "description": "Total amount before GST"
    },

    "hsn_sac_code": {
      "type": "string",
      "maxLength": 10
    },

    "cgst_amount": {
      "type": "number",
      "format": "float"
    },

    "sgst_amount": {
      "type": "number",
      "format": "float"
    },

    "igst_amount": {
      "type": "number",
      "format": "float"
    },

    "total_gst_amount": {
      "type": "number",
      "format": "float"
    },

    "final_amount": {
      "type": "number",
      "format": "float",
      "description": "Final amount including GST"
    },

    "is_active": {
      "type": "boolean",
      "default": true
    },

    "created": {
      "type": "string",
      "format": "date-time"
    },

    "modified": {
      "type": "string",
      "format": "date-time"
    }
  },

  "required": [
    "desgn_id_fk",
    "unit_rate_incl_agency_margin",
    "unit_rate_excl_agency_margin",
    "total_amount",
    "final_amount"
  ]
},



    "InvalidResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
