 "/admin/resourcerate/create": {
  "post": {
    "security": [
      { "Authorization": [] }
    ],
    "tags": ["Resource Rate"],
    "summary": "Create Resource Rate",
    "description": "Create a new Resource Rate record",
    "consumes": ["application/json"],
    "produces": ["application/json"],
    "parameters": [
      {
        "in": "body",
        "name": "body",
        "required": true,
        "schema": {
          "type": "object",
          "required": [
            "desgn_id_fk",
            "unit_rate_incl_agency_margin",
            "unit_rate_excl_agency_margin",
            "total_amount",
            "final_amount"
          ],
          "properties": {
            "desgn_id_fk": {
              "type": "integer",
              "format": "int64",
              "example": 1
            },
            "unit_rate_incl_agency_margin": {
              "type": "number",
              "format": "float",
              "example": 50000
            },
            "agency_margin_percent": {
              "type": "number",
              "format": "float",
              "example": 10
            },
            "agency_amount": {
              "type": "number",
              "format": "float",
              "example": 5000
            },
            "unit_rate_excl_agency_margin": {
              "type": "number",
              "format": "float",
              "example": 45000
            },
            "nicsi_margin_percent": {
              "type": "number",
              "format": "float",
              "example": 5
            },
            "nicsi_margin_amount": {
              "type": "number",
              "format": "float",
              "example": 2250
            },
            "total_amount": {
              "type": "number",
              "format": "float",
              "example": 47250
            },
            "hsn_sac_code": {
              "type": "string",
              "example": "9983"
            },
            "cgst_amount": {
              "type": "number",
              "format": "float",
              "example": 4252.5
            },
            "sgst_amount": {
              "type": "number",
              "format": "float",
              "example": 4252.5
            },
            "igst_amount": {
              "type": "number",
              "format": "float",
              "example": 0
            },
            "total_gst_amount": {
              "type": "number",
              "format": "float",
              "example": 8505
            },
            "final_amount": {
              "type": "number",
              "format": "float",
              "example": 55755
            }
          }
        }
      }
    ],
    "responses": {
      "201": {
        "description": "Resource Rate created successfully",
        "schema": {
          "$ref": "#/definitions/ResourceRateResponse"
        }
      },
      "409": {
        "description": "Resource Rate already exists",
