        ],
        "tags": ["GST Codes"],
        "summary": "Create GST Code",
        "description": "Create a new GST Code in the master table",
        "consumes": ["application/json"],
        "produces": ["application/json"],

        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "code_type",
                "code",
                "description",
                "effective_from"
              ],
              "properties": {
                "code_type": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "HSN"
                },
                "code": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "998313"
                },
                "description": {
                  "type": "string",
                  "example": "IT Consulting Services"
                },
                "gst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "sgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "igst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cess_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "other_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-31"
                }
              }
            }
          }
        ],

        "responses": {
          "201": {
            "description": "GST Code created successfully",
            "schema": {
              "$ref": "#/definitions/GstCodeResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "GST Code already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
