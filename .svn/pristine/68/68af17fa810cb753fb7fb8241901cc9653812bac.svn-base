      {
        "in": "body",
        "name": "body",
        "required": true,
        "schema": {
          "type": "object",
          "required": [
            "empanelment_id_fk",
            "type",
            "designation",
            "qualification",
            "exp_in_years"
          ],
          "properties": {
            "empanelment_id_fk": {
              "type": "integer",
