const router = require('express').Router();
const DivisionController = require('./division.controller');

const {
    protect,
    restrictTo,
    checkPermission,
} = require("../../../middlewares/authMiddleware");
const ROLES = ["ORG_ADMIN", "SUPER_ADMIN"];

router.use(protect);
router
    .route("/")
    .get(
        restrictTo(...ROLES),
        //checkPermission("DIVISION_VIEW"),
        DivisionController.findAll
    )
    .post(
        restrictTo(...ROLES),
        //checkPermission("DIVISION_CREATE"),
        DivisionController.create
    );

router
    .route("/:id")
    .get(
        restrictTo(...ROLES),
        //checkPermission("DIVISION_VIEW"),
        DivisionController.findById
    )
    .patch(
        restrictTo(...ROLES),
        //checkPermission("DIVISION_UPDATE"),
        DivisionController.update
    )
    .delete(
        restrictTo(...ROLES),
        //checkPermission("DIVISION_DELETE"),
        DivisionController.delete
    );

module.exports = router;
