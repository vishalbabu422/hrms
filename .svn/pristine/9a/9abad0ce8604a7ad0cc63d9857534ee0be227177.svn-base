import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'
import { useState } from 'react'
import { validateEmpSalaryStructure } from '../../validations/empSalaryStructureValidation'

const EmpSalaryStructureForm = ({ onSubmit }) => {
  const [selectedGroup, setSelectedGroup] = useState('')
  const [selectedStructure, setSelectedStructure] = useState('')
  const [selectedEmployees, setSelectedEmployees] = useState({})
  const [selectAll, setSelectAll] = useState(false)
  const [globalDate, setGlobalDate] = useState('')
  const [errors, setErrors] = useState({})

  /* ✅ DIFFERENT EMPLOYEE LISTS */

  const organisationEmployees = [
    { id: 1, name: 'Shrikant' },
    { id: 2, name: 'Vishal' },
    { id: 3, name: 'Akansha' },
  ]

  const workOrderEmployees = [
    { id: 101, name: 'Ravi' },
    { id: 102, name: 'Pooja' },
    { id: 103, name: 'Amit' },
  ]

  /* ✅ DYNAMIC LIST */
  const employees =
    selectedGroup === 'org'
      ? organisationEmployees
      : selectedGroup === 'work'
        ? workOrderEmployees
        : []

  const show = selectedGroup && selectedStructure

  /* ================= HANDLERS ================= */

  const handleCheckbox = (id) => {
    const updated = {
      ...selectedEmployees,
      [id]: {
        ...selectedEmployees[id],
        checked: !selectedEmployees[id]?.checked,
      },
    }

    setSelectedEmployees(updated)

    const allSelected = employees.every((emp) => updated[emp.id]?.checked)
    setSelectAll(allSelected)
  }

  const handleSelectAll = () => {
    const newValue = !selectAll
    setSelectAll(newValue)

    const updated = {}
    employees.forEach((emp) => {
      updated[emp.id] = {
        ...selectedEmployees[emp.id],
        checked: newValue,
      }
    })

    setSelectedEmployees(updated)
  }

  const handleChange = (id, field, value) => {
    setSelectedEmployees((prev) => ({
      ...prev,
      [id]: {
        ...prev[id],
        [field]: value,
      },
    }))
  }

  const handleApplyDateToSelected = () => {
    if (!globalDate) {
      alert('Please select a date first')
      return
    }

    const updated = { ...selectedEmployees }

    employees.forEach((emp) => {
      if (updated[emp.id]?.checked) {
        updated[emp.id].effective_from = globalDate
      }
    })

    setSelectedEmployees(updated)
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    const validationErrors = validateEmpSalaryStructure(selectedEmployees)
    setErrors(validationErrors)

    if (Object.keys(validationErrors).length > 0) return

    const finalData = Object.entries(selectedEmployees) // ✅ ARRAY
      .filter(([_, v]) => v.checked)
      .map(([id, v]) => ({
        // employee_id: Number(id),
        employee_id: Number(id),
        employee_name: employees.find((e) => e.id === Number(id))?.name, // 🔥 add this only
        salary_structure_id: Number(selectedStructure), // ✅ IMPORTANT
        ctc: v.value,
        effective_from: v.effective_from,
      }))

    onSubmit(finalData)
  }
  const selectedCount = Object.values(selectedEmployees).filter((e) => e?.checked).length

  /* ================= UI ================= */

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        {/* FILTER */}
        <CCol md={12}>
          <CCard className="mb-3">
            <CCardBody>
              <CRow>
                <CCol md={6}>
                  <CFormLabel>Emp Group</CFormLabel>
                  <CFormSelect
                    onChange={(e) => {
                      setSelectedGroup(e.target.value)

                      /* 🔥 RESET ON CHANGE */
                      setSelectedEmployees({})
                      setSelectAll(false)
                    }}
                  >
                    <option value="">Select</option>
                    <option value="org">Organisation</option>
                    <option value="work">Work Order</option>
                  </CFormSelect>
                </CCol>

                <CCol md={6}>
                  <CFormLabel>Salary Structure</CFormLabel>
                  <CFormSelect onChange={(e) => setSelectedStructure(e.target.value)}>
                    <option value="">Select</option>
                    <option value="1">Structure A</option>
                    <option value="2">Structure B</option>
                  </CFormSelect>
                </CCol>
              </CRow>
            </CCardBody>
          </CCard>
        </CCol>

        {/* TABLE */}
        {show && (
          <CCol md={12}>
            <CCard>
              <CCardBody>
                {/* HEADER */}
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6>Employees ({selectedGroup === 'org' ? 'Organisation' : 'Work Order'})</h6>

                  <div className="d-flex align-items-center gap-2">
                    <span>Effective Date:</span>

                    <CFormInput
                      type="date"
                      value={globalDate}
                      onChange={(e) => setGlobalDate(e.target.value)}
                      style={{ width: '180px' }}
                    />

                    <CButton
                      size="sm"
                      color="primary"
                      onClick={handleApplyDateToSelected}
                      disabled={selectedCount === 0}
                    >
                      Apply to Selected
                    </CButton>

                    <span className="text-muted">Selected: {selectedCount}</span>
                  </div>
                </div>

                {/* TABLE */}
                <table className="table table-bordered align-middle">
                  <thead>
                    <tr>
                      <th style={{ width: '50px' }} className="text-center">
                        <input type="checkbox" checked={selectAll} onChange={handleSelectAll} />
                      </th>
                      <th>Employee Name</th>
                      <th style={{ width: '260px' }}>CTC</th>
                      <th style={{ width: '220px' }}>Effective From</th>
                    </tr>
                  </thead>

                  <tbody>
                    {employees.map((emp) => {
                      const selected = selectedEmployees[emp.id] || {}

                      return (
                        <tr
                          key={emp.id}
                          style={{
                            background: selected.checked ? '#e7f1ff' : 'transparent',
                          }}
                        >
                          <td className="text-center">
                            <input
                              type="checkbox"
                              checked={!!selected.checked}
                              onChange={() => handleCheckbox(emp.id)}
                            />
                          </td>

                          <td>{emp.name}</td>

                          <td>
                            <div style={{ maxWidth: '220px' }}>
                              {/* Input group */}
                              <div className="input-group">
                                <span className="input-group-text">₹</span>

                                <CFormInput
                                  type="number"
                                  placeholder="Enter CTC"
                                  value={selected.value || ''}
                                  readOnly={!selected.checked}
                                  className={errors[emp.id]?.ctc ? 'is-invalid' : ''}
                                  onChange={(e) => handleChange(emp.id, 'value', e.target.value)}
                                />
                              </div>

                              {/* 🔥 ERROR BELOW (correct position) */}
                              {errors[emp.id]?.ctc && (
                                <div className="text-danger small mt-1">{errors[emp.id].ctc}</div>
                              )}
                            </div>
                          </td>
                          <td>
                            <CFormInput
                              type="date"
                              value={selected.effective_from || ''}
                              readOnly={!selected.checked}
                              className={errors[emp.id]?.effective_from ? 'is-invalid' : ''}
                              style={{
                                borderColor: errors[emp.id]?.effective_from ? '#dc3545' : '',
                                boxShadow: errors[emp.id]?.effective_from
                                  ? '0 0 0 0.2rem rgba(220,53,69,.25)'
                                  : '',
                              }}
                              onChange={(e) =>
                                handleChange(emp.id, 'effective_from', e.target.value)
                              }
                            />
                            {errors[emp.id]?.effective_from && (
                              <div className="text-danger small mt-1">
                                {errors[emp.id].effective_from}
                              </div>
                            )}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>

                {/* SAVE */}
                <div className="text-end mt-3">
                  <CButton type="submit" color="primary" disabled={selectedCount === 0}>
                    Save
                  </CButton>
                </div>
              </CCardBody>
            </CCard>
          </CCol>
        )}
      </CRow>
    </CForm>
  )
}

export default EmpSalaryStructureForm
