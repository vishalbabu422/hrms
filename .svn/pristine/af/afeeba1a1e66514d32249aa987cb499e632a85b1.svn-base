const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const EmployeeQualification = sequelize.define('EmployeeQualification', {

    id: {
        type: DataTypes.BIGINT,
        primaryKey: true,
        autoIncrement: true
    },

    employee_id: {
        type: DataTypes.BIGINT,
        allowNull: true   // DB me NOT NULL nahi hai
    },

    qualification_type: {
        type: DataTypes.STRING(50)
    },

    qualification_name: {
        type: DataTypes.STRING(200),
        allowNull: false
    },

    specialization: {
        type: DataTypes.STRING(150)
    },

    institute_name: {
        type: DataTypes.STRING(200)
    },

    board_university: {
        type: DataTypes.STRING(200)
    },

    year_of_passing: {
        type: DataTypes.INTEGER
    },

    grade: {
        type: DataTypes.STRING(50)
    },

    percentage: {
        type: DataTypes.DECIMAL(5, 2)
    },

    duration_months: {
        type: DataTypes.INTEGER
    },

    is_highest: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },

    remarks: {
        type: DataTypes.TEXT
    }

}, {
    tableName: 'employee_qualifications',
    schema: 'pmu',
    timestamps: true,
    createdAt: 'created_at',
    updatedAt: 'updated_at',
});

EmployeeQualification.associate = (models) => {

    EmployeeQualification.belongsTo(models.Employee, {
        foreignKey: 'employee_id',
        onDelete: 'CASCADE'
    });

};

module.exports = EmployeeQualification;
