import React, { useState, useEffect } from 'react'
import api from '../../../api/axios'

// component that handles both office and client addresses
const OfficeAddress = ({ employeeId, employeeAddress, setEmployeeAddress }) => {
  // no longer tracking same-address; client office handled independently

  const emptyAddress = (type) => ({
    address_type: type,
    address_line1: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
    is_primary: false,
  })

  // fetch existing values when employeeId changes
  useEffect(() => {
    const fetchAddress = async () => {
      try {
        const response = await api.get(`/employee/${employeeId}/address`)
        const data = response.data
        setEmployeeAddress({
          office: data?.office_address || emptyAddress('OFFICE'),
          client_office: data?.client_address || emptyAddress('CLIENT_OFFICE'),
        })
      } catch (error) {
        console.error('Error fetching address', error)
      }
    }

    if (employeeId) fetchAddress()
  }, [employeeId])

  const handleOfficeChange = (e) => {
    const { name, value } = e.target
    setEmployeeAddress((prev) => ({
      ...prev,
      office: {
        ...prev.office,
        [name]: value,
      },
    }))

  }

  const handleClientChange = (e) => {
    const { name, value } = e.target
    setEmployeeAddress((prev) => ({
      ...prev,
      client_office: {
        ...prev.client_office,
        [name]: value,
      },
    }))
  }


  const addressFields = ['landmark', 'city', 'district', 'state', 'country', 'pin_code']

  return (
    <>
      {/* Office Address card */}
      <div className="card mb-4 shadow-sm">
        <div className="card-header bg-light fw-semibold">Office Address</div>
        <div className="card-body">
          <div className="row g-3">
            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress.office.address_line1}
                onChange={handleOfficeChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress.office[field] || ''}
                  onChange={handleOfficeChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Client Address card */}
      <div className="card shadow-sm">
        <div className="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
          Client Address
        </div>

        <div className="card-body">
          <div className="row g-3">
            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress.client_office.address_line1}
                onChange={handleClientChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress.client_office[field] || ''}
                  onChange={handleClientChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </>
  )
}

export default OfficeAddress
