import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CRow,
  CFormSelect,
} from '@coreui/react'
import { useState } from 'react'

const emptyReplica = {
  hsnCode: '',
  description: '',
  fromDate: '',
  toDate: '',
  durationText: '',
  totalDays: 0,
  months: 0,
  days: 0,
  dayMonthDays: 0,
  personCount: '',
  unitRate: '',
  totalAmount: 0,
  cgst: 0,
  sgst: 0,
  igst: 0,
}

const Add = () => {
  const [workOrderId, setWorkOrderId] = useState('')
  const [replicas, setReplicas] = useState([])

  /* ---------- Duration logic ---------- */
  const calculateDuration = (from, to) => {
    if (!from || !to) return { text: '', months: 0, days: 0, dayMonthDays: 0 }

    const start = new Date(from)
    const end = new Date(to)
    if (start > end) return { text: '', months: 0, days: 0, dayMonthDays: 0 }

    let months = 0
    let days = 0
    let dayMonthDays = 0
    let cursor = new Date(start)

    while (cursor <= end) {
      const y = cursor.getFullYear()
      const m = cursor.getMonth()

      const monthStart = new Date(y, m, 1)
      const monthEnd = new Date(y, m + 1, 0)

      const effectiveStart = cursor > monthStart ? cursor : monthStart
      const effectiveEnd = end < monthEnd ? end : monthEnd

      const fullMonth =
        effectiveStart.getDate() === 1 && effectiveEnd.getDate() === monthEnd.getDate()

      if (fullMonth) {
        months++
      } else {
        const partialDays = effectiveEnd.getDate() - effectiveStart.getDate() + 1
        days += partialDays
        dayMonthDays = monthEnd.getDate()
      }

      cursor = new Date(y, m + 1, 1)
    }

    const text = [months ? `${months} Month(s)` : '', days ? `${days} Day(s)` : '']
      .filter(Boolean)
      .join(' ')

    return { text, months, days, dayMonthDays }
  }

  /* ---------- Amount + IGST calculation ---------- */
  const calculateAmounts = (replica) => {
    const A = Number(replica.unitRate || 0)
    const B = Number(replica.personCount || 0)
    const X = Number(replica.months || 0)
    const Y = Number(replica.days || 0)
    const M = Number(replica.dayMonthDays || 0)

    if (!A || !B) {
      return { totalAmount: 0, igst: 0 }
    }

    const monthlyAmount = X * A
    const dailyAmount = M ? (A / M) * Y : 0
    const durationAmount = monthlyAmount + dailyAmount

    const totalAmount = Number((durationAmount * B).toFixed(2))
    const cgst = Number((totalAmount * 0.0).toFixed(2))
    const sgst = Number((totalAmount * 0.0).toFixed(2))
    const igst = Number((totalAmount * 0.18).toFixed(2))

    return { totalAmount, igst, cgst, sgst }
  }

  /* ---------- Replica update ---------- */
  const updateReplica = (index, field, value) => {
    const updated = [...replicas]
    updated[index][field] = value

    const durationDrivers = ['fromDate', 'toDate']
    const amountDrivers = ['unitRate', 'personCount', 'months', 'days']

    if (durationDrivers.includes(field)) {
      const d = calculateDuration(updated[index].fromDate, updated[index].toDate)
      updated[index].durationText = d.text
      updated[index].months = d.months
      updated[index].days = d.days
      updated[index].dayMonthDays = d.dayMonthDays
    }

    if (amountDrivers.includes(field)) {
      const amounts = calculateAmounts(updated[index])
      updated[index].totalAmount = amounts.totalAmount
      updated[index].igst = amounts.igst
      updated[index].cgst = amounts.cgst
      updated[index].sgst = amounts.sgst
    }

    setReplicas(updated)
  }

  /* ---------- Totals ---------- */
  const totalOfTotalAmount = replicas.reduce((s, r) => s + Number(r.totalAmount || 0), 0) // total of all the total amount
  const totalIgst = replicas.reduce((s, r) => s + Number(r.igst || 0), 0)
  const totalCgst = replicas.reduce((s, r) => s + Number(r.cgst || 0), 0)
  const totalSgst = replicas.reduce((s, r) => s + Number(r.sgst || 0), 0)

  const grandTotal = totalOfTotalAmount + totalIgst + totalCgst + totalSgst

  /* ---------- Submit ---------- */
  const handleSubmit = (e) => {
    e.preventDefault()
    console.log({
      workOrderId,
      deployments: replicas,
      totalOfTotalAmount,
      totalIgst,
      totalCgst,
      totalSgst,
      grandTotal,
    })
  }

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        <CCol md={6}>
          <CFormLabel>Work Order</CFormLabel>
          <CFormSelect
            value={workOrderId}
            onChange={(e) => {
              setWorkOrderId(e.target.value)
              setReplicas([{ ...emptyReplica }])
            }}
          >
            <option value="">Select Work Order</option>
            <option value="1">Work Order 1</option>
            <option value="2">Work Order 2</option>
          </CFormSelect>
        </CCol>
      </CRow>

      {replicas.map((r, i) => (
        <CCard className="mt-4" key={i}>
          <CCardBody>
            <div className="d-flex justify-content-between mb-3">
              <strong>Deployment #{i + 1}</strong>
              <div>
                <CButton
                  size="sm"
                  color="success"
                  onClick={() => setReplicas([...replicas, { ...emptyReplica }])}
                >
                  +
                </CButton>{' '}
                {replicas.length > 1 && (
                  <CButton
                    size="sm"
                    color="danger"
                    onClick={() => setReplicas(replicas.filter((_, idx) => idx !== i))}
                  >
                    −
                  </CButton>
                )}
              </div>
            </div>

            <CRow className="g-3">
              <CCol md={6}>
                <CFormLabel value={r.hsnCode}>HSN Code</CFormLabel>
                <CFormSelect>
                  <option value="">Select Code</option>
                  <option value="1">Code 1</option>
                  <option value="2">Code 2</option>
                </CFormSelect>
              </CCol>
              <CCol md={6}>
                <CFormLabel value={r.description}>Description</CFormLabel>
                <CFormSelect>
                  <option value="">Select Description</option>
                  <option value="1">Description 1</option>
                  <option value="2">Description 2</option>
                </CFormSelect>
              </CCol>
              <CCol md={6}>
                <CFormLabel>From</CFormLabel>
                <CFormInput
                  type="date"
                  value={r.fromDate}
                  onChange={(e) => updateReplica(i, 'fromDate', e.target.value)}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>To</CFormLabel>
                <CFormInput
                  type="date"
                  value={r.toDate}
                  onChange={(e) => updateReplica(i, 'toDate', e.target.value)}
                />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Duration</CFormLabel>
                <CFormInput value={r.durationText} readOnly />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Persons</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.personCount}
                  onChange={(e) => updateReplica(i, 'personCount', e.target.value)}
                />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Unit Rate</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.unitRate}
                  onChange={(e) => updateReplica(i, 'unitRate', e.target.value)}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Total Amount</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.totalAmount}
                  onChange={(e) => updateReplica(i, 'totalAmount', e.target.value)}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>IGST (18%)</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.igst}
                  onChange={(e) => updateReplica(i, 'igst', e.target.value)}
                />
              </CCol>
              <CCol md={3}>
                <CFormLabel>CGST (0%)</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.cgst}
                  onChange={(e) => updateReplica(i, 'cgst', e.target.value)}
                />
              </CCol>
              <CCol md={3}>
                <CFormLabel>SGST (0%)</CFormLabel>
                <CFormInput
                  type="number"
                  value={r.sgst}
                  onChange={(e) => updateReplica(i, 'sgst', e.target.value)}
                />
              </CCol>
            </CRow>
          </CCardBody>
        </CCard>
      ))}

      {replicas.length > 0 && (
        <CCard className="mt-4">
          <CCardBody>
            <CRow className="mt-3 mb-3">
              <CCol md={3}>
                <CFormLabel>Total</CFormLabel>
                <CFormInput value={totalOfTotalAmount.toFixed(2)} />
              </CCol>
              <CCol md={3}>
                <CFormLabel>IGST</CFormLabel>
                <CFormInput value={totalIgst.toFixed(2)} />
              </CCol>
              <CCol md={3}>
                <CFormLabel>CGST</CFormLabel>
                <CFormInput value={totalCgst.toFixed(2)} />
              </CCol>
              <CCol md={3}>
                <CFormLabel>SGST</CFormLabel>
                <CFormInput value={totalSgst.toFixed(2)} />
              </CCol>
            </CRow>
            <CRow>
              <CCol md={12}>
                <CFormLabel>
                  <strong>Grand Total</strong>
                </CFormLabel>
                <CFormInput value={grandTotal.toFixed(2)} />
              </CCol>
            </CRow>

            <CButton className="mt-4" type="submit" color="primary">
              Submit
            </CButton>
          </CCardBody>
        </CCard>
      )}
    </CForm>
  )
}

export default Add
