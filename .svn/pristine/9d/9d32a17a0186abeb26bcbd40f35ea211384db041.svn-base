{
  "swagger": "2.0",
  "info": {
    "description": "KMS API Documentation",
    "version": "1.0",
    "title": "PMU API",
    "contact": {
      "email": "vishalbabu422@gmail.com"
    }
  },
  "schemes": ["http", "https"],
  "host": "localhost:3100",
  "basePath": "/api/v1",
  "securityDefinitions": {
    "Authorization": {
      "type": "apiKey",
      "name": "authorization",
      "in": "header",
      "description": "Authentication token"
    }
  },
  "paths": {
    "/admin/gst-code/index": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Get GST Code List",
        "description": "Get all the GST Codes!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "is_active",
            "description": "Filter any field (Ex. is_active : true)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "description": "Ex. (id desc)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "description": "Ex. (workflow_state_id,status,created_by,modified_by,created,modified,...)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "Pagination page no. (Ex. 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "Pagination limit. (Ex. 10)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GstCodeResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "GstCodeMaster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },

        "code_type": {
          "type": "string",
          "maxLength": 10
        },

        "code": {
          "type": "string",
          "maxLength": 10
        },

        "description": {
          "type": "string"
        },

        "gst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "sgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "igst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cess_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "other_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "effective_from": {
          "type": "string",
          "format": "date"
        },

        "effective_to": {
          "type": "string",
          "format": "date"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code_type", "code", "description", "effective_from"]
    },
    "InvalidResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
