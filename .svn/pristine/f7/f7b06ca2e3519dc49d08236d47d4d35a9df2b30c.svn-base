const { SalaryComponent } = require("../../../models");
const APIFeatures = require("../../../utils/apiFeature");
const AppError = require("../../../utils/appError");

// GET ALL
exports.getSalaryComponents = async (query) => {
  const features = new APIFeatures(query)
    .filter()
    .sort()
    .limitFields()
    .paginate();

  if (!features.query.where) features.query.where = {};

  // filters
  if (query.is_active !== undefined) {
    features.query.where.is_active = query.is_active === "true";
  }

  if (query.type) {
    features.query.where.type = query.type;
  }

  const { rows, count } =
    await SalaryComponent.findAndCountAll(features.query);

  const page = query.page * 1 || 1;
  const limit = query.limit * 1 || 10;

  return {
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: rows.length,
    data: rows,
  };
};

// GET BY ID
exports.getSalaryComponentById = async (id) => {
  const component = await SalaryComponent.findByPk(id);

  if (!component) {
    throw new AppError("Salary Component not found", 404);
  }

  return component;
};

// CREATE
exports.createSalaryComponent = async (data, transaction) => {
  const existing = await SalaryComponent.findOne({
    where: {
      code: data.code,
      is_active: true,
    },
    transaction,
  });

  if (existing) {
    throw new AppError(
      "Salary Component with this code already exists",
      409
    );
  }

  return await SalaryComponent.create(
    {
      ...data,
      is_active: data.is_active ?? true,
      created: new Date(),
      modified: new Date(),
    },
    { transaction }
  );
};

// UPDATE
exports.updateSalaryComponent = async (id, data, transaction) => {
  const component = await SalaryComponent.findByPk(id, { transaction });

  if (!component) {
    throw new AppError("Salary Component not found", 404);
  }

  // duplicate check
  if (data.code && data.code !== component.code) {
    const duplicate = await SalaryComponent.findOne({
      where: {
        code: data.code,
        is_active: true,
      },
      transaction,
    });

    if (duplicate && duplicate.id !== component.id) {
      throw new AppError(
        "Salary Component with this code already exists",
        409
      );
    }
  }

  return await component.update(
    {
      ...data,
      modified: new Date(),
    },
    { transaction }
  );
};

// DELETE (SOFT)
exports.deleteSalaryComponent = async (id, transaction) => {
  const component = await SalaryComponent.findByPk(id, { transaction });

  if (!component) {
    throw new AppError("Salary Component not found", 404);
  }

  if (component.is_active === false) {
    throw new AppError("Salary Component already deleted", 409);
  }

  return await component.update(
    {
      is_deleted : true,
      modified: new Date(),
    },
    { transaction }
  );
};