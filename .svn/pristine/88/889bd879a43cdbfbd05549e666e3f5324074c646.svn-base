import React, { useState } from 'react'
import CIcon from '@coreui/icons-react'
import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilPeople,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
  cilBuilding,
} from '@coreui/icons'

const Add = () => {
  const [step, setStep] = useState(0)
  const [profileImage, setProfileImage] = useState(null)
  const [cancelledCheque, setCancelledCheque] = useState(null)
  const [screeningMail, setScreeningMail] = useState(null)
  const [policyDocument, setPolicyDocument] = useState(null)
  const [selectedDocType, setSelectedDocType] = useState('')
  const [selectedFile, setSelectedFile] = useState(null)
  const [documents, setDocuments] = useState([])
  const [employeeDetails, setEmployeeDetails] = useState({
    employeeType: '',
    stateOfWorking: '',
  })

  const stepConfig = [
    { label: 'Basic Information', icon: cilUser },
    { label: 'Address', icon: cilLocationPin },
    { label: 'Office Address', icon: cilBuilding },
    { label: 'Qualification', icon: cilEducation },
    { label: 'Bank Details', icon: cilBank },
    { label: 'Insurance', icon: cilShieldAlt },
    { label: 'Screening Test', icon: cilClipboard },
    { label: 'Experience', icon: cilBriefcase },
    { label: 'Documents', icon: cilFile },
  ]

  const [qualifications, setQualifications] = useState([
    {
      qualificationType: '',
      qualificationName: '',
      specialization: '',
      instituteName: '',
      boardUniversity: '',
      yearOfPassing: '',
      grade: '',
      percentage: '',
      document: null, // 👈 added
    },
  ])

  const [experiences, setExperiences] = useState([
    {
      companyName: '',
      designation: '',
      startDate: '',
      endDate: '',
      totalExperience: '',
      document: null, // 👈 added
    },
  ])

  // ================= ADDRESS STATE =================
  const [sameAddress, setSameAddress] = useState(false)

  const emptyAddress = {
    address: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: '',
    pincode: '',
  }

  const [correspondence, setCorrespondence] = useState(emptyAddress)
  const [permanent, setPermanent] = useState(emptyAddress)

  const handleCorrespondenceChange = (e) => {
    const { name, value } = e.target
    const updated = { ...correspondence, [name]: value }
    setCorrespondence(updated)

    if (sameAddress) {
      setPermanent(updated)
    }
  }

  const handlePermanentChange = (e) => {
    const { name, value } = e.target
    setPermanent({ ...permanent, [name]: value })
  }

  const handleSameAddressToggle = (e) => {
    const checked = e.target.checked
    setSameAddress(checked)

    if (checked) {
      setPermanent(correspondence)
    } else {
      setPermanent(emptyAddress)
    }
  }

  const handleImageUpload = (e) => {
    const file = e.target.files[0]
    if (!file) return
    const reader = new FileReader()
    reader.onload = () => setProfileImage(reader.result)
    reader.readAsDataURL(file)
  }

  const handleChequeUpload = (e) => {
    const file = e.target.files[0]

    if (!file) return

    const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png']

    if (!allowedTypes.includes(file.type)) {
      alert('Only PDF, JPG, PNG files are allowed.')
      return
    }

    if (file.size > 2 * 1024 * 1024) {
      alert('File size must be less than 2MB.')
      return
    }

    setCancelledCheque(file)
  }

  const handleScreeningMailUpload = (e) => {
    const file = e.target.files[0]

    if (!file) return

    const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png']

    if (!allowedTypes.includes(file.type)) {
      alert('Only PDF, JPG, PNG files are allowed.')
      return
    }

    if (file.size > 2 * 1024 * 1024) {
      alert('File size must be less than 2MB.')
      return
    }

    setScreeningMail(file)
  }

  const handlePolicyUpload = (e) => {
    const file = e.target.files[0]

    if (!file) return

    const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png']

    if (!allowedTypes.includes(file.type)) {
      alert('Only PDF, JPG, PNG files are allowed.')
      return
    }

    if (file.size > 5 * 1024 * 1024) {
      alert('File size must be less than 5MB.')
      return
    }

    setPolicyDocument(file)
  }

  const [officeAddress, setOfficeAddress] = useState(emptyAddress)
  const [clientAddress, setClientAddress] = useState(emptyAddress)

  const handleOfficeChange = (e) => {
    const { name, value } = e.target
    setOfficeAddress({ ...officeAddress, [name]: value })
  }

  const handleClientChange = (e) => {
    const { name, value } = e.target
    setClientAddress({ ...clientAddress, [name]: value })
  }

  // FAMILY MEMBERS STATE
  const [familyMembers, setFamilyMembers] = useState([
    {
      relation: '',
      name: '',
      dob: '',
      gender: '',
      pan_number: '',
      is_dependent: false,
    },
  ])

  // INSURANCE STATE
  const [insurance, setInsurance] = useState({
    insurance_company: '',
    policy_number: '',
    from_date: '',
    to_date: '',
    sum_insured: '',
    policy_premium: '',
    family_members_covered: '',
    policy_document: null,
  })

  const handleFamilyChange = (index, field, value) => {
    const updated = [...familyMembers]
    updated[index][field] = value
    setFamilyMembers(updated)
  }

  const addFamilyMember = () => {
    setFamilyMembers([
      ...familyMembers,
      {
        relation: '',
        name: '',
        dob: '',
        gender: '',
        pan_number: '',
        is_dependent: false,
      },
    ])
  }

  const removeFamilyMember = (index) => {
    setFamilyMembers(familyMembers.filter((_, i) => i !== index))
  }

  const handleInsuranceChange = (field, value) => {
    setInsurance({ ...insurance, [field]: value })
  }

  const handleInsuranceFile = (e) => {
    const file = e.target.files[0]
    if (!file) return
    setInsurance({ ...insurance, policy_document: file })
  }

  const handleFileSelect = (file) => {
    if (!file) return
    setSelectedFile(file)
  }

  const handleDrop = (e) => {
    e.preventDefault()
    const file = e.dataTransfer.files[0]
    if (file) setSelectedFile(file)
  }

  const handleDragOver = (e) => {
    e.preventDefault()
  }

  const handleAddDocument = () => {
    if (!selectedDocType || !selectedFile) {
      alert('Please select document type and file.')
      return
    }

    setDocuments((prev) => [
      ...prev,
      {
        type: selectedDocType,
        file: selectedFile,
      },
    ])

    // Reset
    setSelectedFile(null)
    setSelectedDocType('')

    const input = document.getElementById('hiddenFileInput')
    if (input) input.value = ''
  }

  const handleRemoveDocument = (indexToRemove) => {
    setDocuments((prev) => prev.filter((_, index) => index !== indexToRemove))

    const input = document.getElementById('hiddenFileInput')
    if (input) input.value = ''
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
        {/* 🔹 UNDERLINE STEPPER */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => setStep(index)}
            >
              <CIcon icon={item.icon} className="stepper-icon" />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* 🔹 STEP 1 */}
        {step === 0 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="row">
                <div className="col-md-3 ">
                  <label className="avatar-upload">
                    <input type="file" hidden accept="image/*" onChange={handleImageUpload} />
                    <div className="avatar-1">
                      {profileImage ? <img src={profileImage} alt="Profile" /> : <span>📷</span>}
                    </div>
                  </label>
                  <small className="text-muted d-block mt-2 mx-3">Upload Photo</small>
                </div>

                <div className="col-md-12">
                  <div className="row g-3 mt-2 align-items-end">
                    <div className="col-md-3">
                      <label className="form-label">Salutation</label>
                      <select className="form-select" name="salutation">
                        <option value="">Select</option>
                        <option value="Mr">Mr</option>
                        <option value="Ms">Ms</option>
                        <option value="Mrs">Mrs</option>
                        <option value="Dr">Dr</option>
                      </select>
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">First Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter First Name"
                        maxLength={20}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Middle Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Middle Name"
                        maxLength={50}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Last Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Last Name"
                        maxLength={50}
                      />
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Employee Type</label>
                      <select
                        className="form-select"
                        value={employeeDetails.employeeType}
                        onChange={(e) =>
                          setEmployeeDetails({
                            ...employeeDetails,
                            employeeType: e.target.value,
                          })
                        }
                      >
                        <option value="">Select</option>
                        <option value="Payroll">Payroll</option>
                        <option value="Contractual">Contractual</option>
                      </select>
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">State of Working</label>
                      <select
                        className="form-select"
                        value={employeeDetails.stateOfWorking}
                        onChange={(e) =>
                          setEmployeeDetails({
                            ...employeeDetails,
                            stateOfWorking: e.target.value,
                          })
                        }
                      >
                        <option value="">Select</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Haryana">Haryana</option>
                        <option value="Uttar Pradesh">Uttar Pradesh</option>
                      </select>
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Email Address</label>
                      <input
                        type="email"
                        className="form-control"
                        placeholder="Enter Email Id"
                        maxLength={120}
                      />
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Contact No</label>
                      <input
                        type="tel"
                        className="form-control"
                        placeholder="Enter Contact Number"
                        maxLength={15}
                      />
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Date of Birth</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Marital Status</label>
                      <select className="form-select" name="marital_status" required>
                        <option value="">Select</option>
                        <option value="SINGLE">Single</option>
                        <option value="MARRIED">Married</option>
                        <option value="DIVORCED">Divorced</option>
                        <option value="WIDOWED">Widowed</option>
                        <option value="SEPARATED">Separated</option>
                      </select>
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Fathers Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Fathers Name"
                        maxLength={150}
                      />
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Mothers Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Mothers Name"
                        maxLength={150}
                      />
                    </div>
                    <div className="col-md-6">
                      <label className="form-label">Gender</label>
                      <select className="form-select">
                        <option value="">Select </option>
                        <option>Male</option>
                        <option>Female</option>
                      </select>
                    </div>

                    <div className="col-md-6">
                      <label className="form-label">Blood Group</label>
                      <select className="form-select" name="blood_group">
                        <option value="">Select</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                      </select>
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Date Of Joining</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Probation End Date</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Confirmation Date</label>
                      <input type="date" className="form-control" name="confirmation_date" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Notice Period (Days)</label>
                      <input
                        type="number"
                        className="form-control"
                        name="notice_period_days"
                        min={0}
                        max={180}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {step === 1 && (
          <div className="step-content">
            {/* ===== Correspondence ===== */}
            <div className="card mb-4 shadow-sm">
              <div className="card-header bg-light fw-semibold">Correspondence Address</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-12">
                    <textarea
                      className="form-control"
                      rows="3"
                      name="address"
                      value={correspondence.address}
                      onChange={handleCorrespondenceChange}
                      placeholder="Enter address"
                    />
                  </div>

                  {Object.keys(emptyAddress)
                    .slice(1)
                    .map((field) => (
                      <div className="col-md-3" key={field}>
                        <input
                          className="form-control"
                          name={field}
                          value={correspondence[field]}
                          onChange={handleCorrespondenceChange}
                          placeholder={`Enter ${field}`}
                        />
                      </div>
                    ))}
                </div>
              </div>
            </div>

            {/* ===== Permanent ===== */}
            <div className="card shadow-sm">
              <div className="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                Permanent Address
                <div className="form-check mb-0">
                  <input
                    className="form-check-input"
                    type="checkbox"
                    checked={sameAddress}
                    onChange={handleSameAddressToggle}
                  />
                  <label className="form-check-label small">Same as Correspondence</label>
                </div>
              </div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-12">
                    <textarea
                      className="form-control"
                      rows="3"
                      name="address"
                      value={permanent.address}
                      onChange={handlePermanentChange}
                      // disabled={sameAddress}
                      placeholder="Enter address"
                    />
                  </div>

                  {Object.keys(emptyAddress)
                    .slice(1)
                    .map((field) => (
                      <div className="col-md-3" key={field}>
                        <input
                          className="form-control"
                          name={field}
                          value={permanent[field]}
                          onChange={handlePermanentChange}
                          // disabled={sameAddress}
                          placeholder={`Enter ${field}`}
                        />
                      </div>
                    ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {step === 2 && (
          <div className="step-content">
            {/* ===== Office Address ===== */}
            <div className="card mb-4 shadow-sm">
              <div className="card-header bg-light fw-semibold">Office Address</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-12">
                    <textarea
                      className="form-control"
                      rows="3"
                      name="address"
                      value={officeAddress.address}
                      onChange={handleOfficeChange}
                      placeholder="Enter office address"
                    />
                  </div>

                  {Object.keys(emptyAddress)
                    .slice(1)
                    .map((field) => (
                      <div className="col-md-3" key={field}>
                        <input
                          className="form-control"
                          name={field}
                          value={officeAddress[field]}
                          onChange={handleOfficeChange}
                          placeholder={`Enter ${field}`}
                        />
                      </div>
                    ))}
                </div>
              </div>
            </div>

            {/* ===== Client Address ===== */}
            <div className="card shadow-sm">
              <div className="card-header bg-light fw-semibold">Client Office Address</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-12">
                    <textarea
                      className="form-control"
                      rows="3"
                      name="address"
                      value={clientAddress.address}
                      onChange={handleClientChange}
                      placeholder="Enter client address"
                    />
                  </div>

                  {Object.keys(emptyAddress)
                    .slice(1)
                    .map((field) => (
                      <div className="col-md-3" key={field}>
                        <input
                          className="form-control"
                          name={field}
                          value={clientAddress[field]}
                          onChange={handleClientChange}
                          placeholder={`Enter ${field}`}
                        />
                      </div>
                    ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="step-content">
            {qualifications.map((q, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  <div className="col-md-6">
                    <label className="form-label">Qualification Type</label>
                    <select
                      className="form-select"
                      value={q.qualificationType}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].qualificationType = e.target.value
                        setQualifications(arr)
                      }}
                    >
                      <option value="">Select</option>
                      <option>Degree</option>
                      <option>Certification</option>
                      <option>Diploma</option>
                      <option>Training</option>
                    </select>
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Qualification Name</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.qualificationName}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].qualificationName = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Specialization</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.specialization}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].specialization = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Institute Name</label>
                    <input
                      type="text"
                      className="form-control"
                      name="institute_name"
                      value={q.instituteName}
                      maxLength={200}
                      placeholder="Enter institute name"
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].instituteName = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Board / University</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.boardUniversity}
                      maxLength={200}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].boardUniversity = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Year of Passing</label>
                    <input
                      type="number"
                      className="form-control"
                      value={q.yearOfPassing}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].yearOfPassing = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Grade</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.grade}
                      maxLength={50}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].grade = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Percentage (%)</label>
                    <input
                      type="number"
                      className="form-control"
                      value={q.percentage}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].percentage = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>
                  <div className="col-md-12">
                    <label className="form-label">Upload Certificate</label>
                    <input
                      type="file"
                      className="form-control"
                      accept=".pdf,.jpg,.jpeg,.png"
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].document = e.target.files[0]
                        setQualifications(arr)
                      }}
                    />
                    {q.document && <small className="text-success">{q.document.name}</small>}
                  </div>
                </div>

                {/* REMOVE */}
                {qualifications.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() =>
                        setQualifications(qualifications.filter((_, i) => i !== index))
                      }
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD MORE */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setQualifications([
                  ...qualifications,
                  {
                    qualificationType: '',
                    qualificationName: '',
                    specialization: '',
                    instituteName: '',
                    boardUniversity: '',
                    yearOfPassing: '',
                    grade: '',
                    percentage: '',
                    document: null,
                  },
                ])
              }
            >
              + Add Qualification
            </button>
          </div>
        )}

        {step === 4 && (
          <div className="step-content">
            <div className="row border rounded g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Bank Name</label>
                <input
                  type="text"
                  className="form-control"
                  name="bank_name"
                  placeholder="Enter bank name"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Branch Name</label>
                <input
                  type="text"
                  className="form-control"
                  name="branch_name"
                  placeholder="Enter branch name"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Bank Address</label>
                <input
                  type="text"
                  className="form-control"
                  name="bank_address"
                  placeholder="Enter bank branch address"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Account Number</label>
                <input
                  type="text"
                  className="form-control"
                  name="account_number"
                  placeholder="Enter account number"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">IFSC Code</label>
                <input
                  type="text"
                  className="form-control"
                  name="ifsc_code"
                  placeholder="Enter IFSC code (e.g. SBIN0001234)"
                  maxLength={11}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">MICR Code</label>
                <input
                  type="text"
                  className="form-control"
                  name="micr_code"
                  placeholder="Enter MICR code"
                  maxLength={9}
                />
              </div>
              {/* Cancelled Cheque Upload */}
              <div className="col-md-12">
                <label className="form-label">Cancelled Cheque (Upload)</label>
                <input
                  type="file"
                  className="form-control"
                  name="cancelled_cheque"
                  accept=".pdf,.jpg,.jpeg,.png"
                  onChange={handleChequeUpload}
                />
                <small className="text-muted">Allowed: PDF, JPG, PNG | Max Size: 2MB</small>
              </div>
            </div>
          </div>
        )}

        {step === 5 && (
          <div className="step-content">
            {/* ================= INSURANCE ================= */}
            <div className="card mb-4 shadow-sm">
              <div className="card-header bg-light fw-semibold">Insurance Details</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-6">
                    <label className="form-label">Insurance Company</label>
                    <input
                      type="text"
                      className="form-control"
                      value={insurance.insurance_company}
                      onChange={(e) => handleInsuranceChange('insurance_company', e.target.value)}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Policy Number</label>
                    <input
                      type="text"
                      className="form-control"
                      value={insurance.policy_number}
                      onChange={(e) => handleInsuranceChange('policy_number', e.target.value)}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">From Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={insurance.from_date}
                      onChange={(e) => handleInsuranceChange('from_date', e.target.value)}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">To Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={insurance.to_date}
                      onChange={(e) => handleInsuranceChange('to_date', e.target.value)}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Sum Insured</label>
                    <input
                      type="number"
                      className="form-control"
                      step="0.01"
                      value={insurance.sum_insured}
                      onChange={(e) => handleInsuranceChange('sum_insured', e.target.value)}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Policy Premium</label>
                    <input
                      type="number"
                      className="form-control"
                      step="0.01"
                      value={insurance.policy_premium}
                      onChange={(e) => handleInsuranceChange('policy_premium', e.target.value)}
                    />
                  </div>

                  <div className="col-md-12">
                    <label className="form-label">Family Members Covered</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={insurance.family_members_covered}
                      onChange={(e) =>
                        handleInsuranceChange('family_members_covered', e.target.value)
                      }
                    />
                  </div>

                  <div className="col-md-12">
                    <label className="form-label">Policy Document</label>
                    <input
                      type="file"
                      className="form-control"
                      accept=".pdf,.jpg,.jpeg,.png"
                      onChange={handleInsuranceFile}
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* ================= FAMILY MEMBERS ================= */}
            <div className="card shadow-sm">
              <div className="card-header bg-light fw-semibold">Family Members</div>

              <div className="card-body">
                {familyMembers.map((member, index) => (
                  <div key={index} className="border rounded p-3 mb-3">
                    <div className="row g-3">
                      <div className="col-md-6">
                        <label className="form-label">Relation</label>
                        <select
                          className="form-select"
                          value={member.relation}
                          onChange={(e) => handleFamilyChange(index, 'relation', e.target.value)}
                        >
                          <option value="">Select</option>
                          <option value="SPOUSE">Spouse</option>
                          <option value="CHILD">Child</option>
                          <option value="FATHER">Father</option>
                          <option value="MOTHER">Mother</option>
                          <option value="SIBLING">Sibling</option>
                        </select>
                      </div>

                      <div className="col-md-6">
                        <label className="form-label">Name</label>
                        <input
                          type="text"
                          className="form-control"
                          value={member.name}
                          onChange={(e) => handleFamilyChange(index, 'name', e.target.value)}
                        />
                      </div>

                      <div className="col-md-6">
                        <label className="form-label">Date of Birth</label>
                        <input
                          type="date"
                          className="form-control"
                          value={member.dob}
                          onChange={(e) => handleFamilyChange(index, 'dob', e.target.value)}
                        />
                      </div>

                      <div className="col-md-6">
                        <label className="form-label">Gender</label>
                        <select
                          className="form-select"
                          value={member.gender}
                          onChange={(e) => handleFamilyChange(index, 'gender', e.target.value)}
                        >
                          <option value="">Select</option>
                          <option value="Male">Male</option>
                          <option value="Female">Female</option>
                        </select>
                      </div>

                      <div className="col-md-6">
                        <label className="form-label">PAN Number</label>
                        <input
                          type="text"
                          className="form-control"
                          value={member.pan_number}
                          onChange={(e) => handleFamilyChange(index, 'pan_number', e.target.value)}
                        />
                      </div>

                      <div className="col-md-6 d-flex align-items-center">
                        <div className="form-check mt-4">
                          <input
                            type="checkbox"
                            className="form-check-input"
                            checked={member.is_dependent}
                            onChange={(e) =>
                              handleFamilyChange(index, 'is_dependent', e.target.checked)
                            }
                          />
                          <label className="form-check-label">Is Dependent</label>
                        </div>
                      </div>
                    </div>

                    {familyMembers.length > 1 && (
                      <div className="text-end mt-2">
                        <button
                          type="button"
                          className="btn btn-outline-danger btn-sm"
                          onClick={() => removeFamilyMember(index)}
                        >
                          Remove
                        </button>
                      </div>
                    )}
                  </div>
                ))}

                <button type="button" className="btn btn-outline-primary" onClick={addFamilyMember}>
                  + Add Family Member
                </button>
              </div>
            </div>
          </div>
        )}

        {step === 6 && (
          <div className="step-content">
            <div className="row border rounded g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Test Scheduled Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Test Given Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Marks Secured</label>
                <input type="number" className="form-control" min={0} step="0.01" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Result</label>
                <select className="form-select">
                  <option value="">Select Result</option>
                  <option value="PASS">PASS</option>
                  <option value="FAIL">FAIL</option>
                </select>
              </div>

              {/* Screening Mail Copy Upload */}
              <div className="col-md-12">
                <label className="form-label">Screening Mail Copy</label>
                <input
                  type="file"
                  className="form-control"
                  accept=".pdf,.jpg,.jpeg,.png"
                  onChange={handleScreeningMailUpload}
                />
                <small className="text-muted">Allowed: PDF, JPG, PNG | Max Size: 2MB</small>
              </div>
            </div>
          </div>
        )}

        {step === 7 && (
          <div className="step-content">
            {experiences.map((exp, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3 mt-2">
                  <div className="col-md-6">
                    <label className="form-label">Company Name</label>
                    <input
                      type="text"
                      className="form-control"
                      placeholder="Enter Company Name"
                      maxLength={200}
                      value={exp.companyName}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].companyName = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Designation</label>
                    <input
                      type="text"
                      className="form-control"
                      placeholder="Enter Designation"
                      maxLength={150}
                      value={exp.designation}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].designation = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Start Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={exp.startDate}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].startDate = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">End Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={exp.endDate}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].endDate = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-12">
                    <label className="form-label">Total Experience (Years)</label>
                    <input
                      type="number"
                      className="form-control"
                      min={0}
                      step="0.1"
                      value={exp.totalExperience}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].totalExperience = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>
                  <div className="col-md-12">
                    <label className="form-label">Upload Experience Certificate</label>
                    <input
                      type="file"
                      className="form-control"
                      accept=".pdf,.jpg,.jpeg,.png"
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].document = e.target.files[0]
                        setExperiences(arr)
                      }}
                    />
                    {exp.document && <small className="text-success">{exp.document.name}</small>}
                  </div>
                </div>

                {/* REMOVE BUTTON */}
                {experiences.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => setExperiences(experiences.filter((_, i) => i !== index))}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD EXPERIENCE BUTTON */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setExperiences([
                  ...experiences,
                  {
                    companyName: '',
                    designation: '',
                    startDate: '',
                    endDate: '',
                    totalExperience: '',
                    document: null,
                  },
                ])
              }
            >
              + Add Experience
            </button>
          </div>
        )}
        {step === 8 && (
          <div className="step-content">
            <div className="card shadow-sm p-4">
              <div className="row g-3">
                {/* Document Type */}
                <div className="col-md-12">
                  <label className="form-label">Document Type</label>
                  <select
                    className="form-select"
                    value={selectedDocType}
                    onChange={(e) => setSelectedDocType(e.target.value)}
                  >
                    <option value="">Select Document Type</option>
                    <option value="RESUME">Resume</option>
                    <option value="PAN_FILE">PAN Card</option>
                    <option value="AADHAAR_FILE">Aadhaar Card</option>
                    <option value="VOTER_ID_FILE">Voter ID</option>
                    <option value="BIRTH_CERT">Birth Certificate</option>
                    <option value="DRIVING_LICENSE">Driving License</option>
                    <option value="WORK_PERMIT">Work Permit</option>
                    <option value="POLICY_DOCUMENT">Policy Document</option>
                    <option value="SALARY_SLIP">Salary Slip</option>
                    <option value="FORM16">Form 16</option>
                    <option value="POLICE_VERIFICATION">Police Verification</option>
                    <option value="DECLARATION">Declaration</option>
                  </select>
                </div>

                {/* Upload Box */}
                <div className="col-12">
                  <label className="form-label">Upload File</label>

                  <div
                    className="border rounded p-5 text-center"
                    style={{
                      cursor: 'pointer',
                      background: '#fafafa',
                      borderStyle: 'dashed',
                    }}
                    onDrop={handleDrop}
                    onDragOver={handleDragOver}
                    onClick={() => document.getElementById('hiddenFileInput').click()}
                  >
                    {selectedFile ? (
                      <div className="text-success fw-semibold">{selectedFile.name}</div>
                    ) : (
                      <div className="text-muted">Drag & Drop file here or Click to Browse</div>
                    )}
                  </div>

                  <input
                    id="hiddenFileInput"
                    type="file"
                    hidden
                    accept=".pdf,.jpg,.jpeg,.png"
                    onChange={(e) => handleFileSelect(e.target.files[0])}
                  />
                </div>

                {/* Add Button */}
                <div className="col-12 text-end">
                  <button type="button" className="btn btn-primary" onClick={handleAddDocument}>
                    Add Document
                  </button>
                </div>
              </div>
            </div>

            {/* ================= DOCUMENT PREVIEW TABLE ================= */}
            {documents.length > 0 && (
              <div className="card mt-4 shadow-sm p-3">
                <h6 className="fw-semibold mb-3">Uploaded Documents</h6>

                <div className="table-responsive">
                  <table className="table table-bordered align-middle">
                    <thead className="table-light">
                      <tr>
                        <th>Document Type</th>
                        <th>File Name</th>
                        <th width="100">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      {documents.map((doc, index) => (
                        <tr key={index}>
                          <td>{doc.type}</td>
                          <td>{doc.file.name}</td>
                          <td>
                            <button
                              className="btn btn-sm btn-outline-danger"
                              onClick={() => handleRemoveDocument(index)}
                            >
                              Remove
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}

        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>
          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => setStep(step + 1)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
