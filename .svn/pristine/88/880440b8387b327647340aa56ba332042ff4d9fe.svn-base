import EmployeeDesignationFormComponent from './form-component'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const Add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      // Simulate API delay
      await new Promise((resolve) => setTimeout(resolve, 800))

      // Dummy stored object
      const dummyResponse = {
        id: Date.now(),
        ...payload,
      }

      console.log('Saved Dummy Data:', dummyResponse)

      toast.success('Employee Designation created successfully')

      navigate('/employeedesignation')
    } catch (error) {
      console.error(error)
      toast.error('Failed to create Employee Designation')
    }
  }

  const initialData = {
    employee_id: '',
    designation_id: '',
    effective_from: '',
    effective_to: '',
  }

  return (
    <EmployeeDesignationFormComponent
      initialData={initialData}
      mode="create"
      onSubmit={handleSubmit}
    />
  )
}

export default Add