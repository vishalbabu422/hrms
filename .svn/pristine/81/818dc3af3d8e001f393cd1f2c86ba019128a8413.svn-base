const catchAsync = require("../../../utils/catchAsync");
const SalaryStructureService = require("./salaryStructure.service");
const sequelize = require("../../../utils/database");
const APIFeatures = require("../../../utils/apiFeature");
const AppError = require("../../../utils/appError");
const {SalaryStructure} = require("../../../models");
// GET ALL
const getSalaryStructures = catchAsync(async (req, res) => {
  
  const features = new APIFeatures(
    req.query,
    SalaryStructure,
    ["name"]
)
.filter()
.search()
.sort()
.limitFields()
.join()
.paginate();

features.query.where = {
    ...features.query.where,
    is_deleted: false
};

features.query.distinct = true;

const result = await SalaryStructureService.getSalaryStructures(features.query);

  res.status(200).json({
    status: "success",
    ...result,
  });
});

// GET BY ID
const getSalaryStructureById = catchAsync(async (req, res) => {
  const features = new APIFeatures(req.query).limitFields().join();

  if (!features.query.where) features.query.where = {};

  features.query.where = {
    ...features.query.where,
    id: req.params.id,
    is_deleted: false,
  };

  const result = await SalaryStructureService.getSalaryStructureById(
    features.query,
  );

  res.status(200).json({
    status: "success",
    data: result,
  });
});

// CREATE
const createSalaryStructure = catchAsync(async (req, res) => {
  if (req.isSuperAdmin) {
    if (!req.body.org_id) {
      throw new AppError("organization_id is required", 400);
    }
  } else {
    req.body.org_id = req.user.org_id;
  }
  const result = await sequelize.transaction(async (t) => {
    return await SalaryStructureService.createSalaryStructure(req.body, t);
  });

  res.status(201).json({
    status: "success",
    message: "Salary Structure created successfully",
    data: result,
  });
});

// UPDATE
const updateSalaryStructure = catchAsync(async (req, res) => {
  const result = await sequelize.transaction(async (t) => {
    return await SalaryStructureService.updateSalaryStructure(
      req.params.id,
      req.body,
      t,
    );
  });

  res.status(200).json({
    status: "success",
    message: "Salary Structure updated successfully",
    data: result,
  });
});

// DELETE
const deleteSalaryStructure = catchAsync(async (req, res) => {
  await sequelize.transaction(async (t) => {
    await SalaryStructureService.deleteSalaryStructure(req.params.id, t);
  });

  res.status(200).json({
    status: "success",
    message: "Salary Structure deleted successfully",
  });
});

const getEmployeeBySalaryStructure = catchAsync(async (req, res) => {
  const salaryStructureId = req.params.id;
  const { month, year } = req.query;

  const data = await SalaryStructureService.getEmployeeBySalaryStructure(
    salaryStructureId,
    month,
    year,
  );
  
  res.status(200).json({
    status: "success",
    results: data.length,
    data,
  });
});

module.exports = {
  getSalaryStructures,
  getSalaryStructureById,
  createSalaryStructure,
  updateSalaryStructure,
  deleteSalaryStructure,
  getEmployeeBySalaryStructure,
};
