import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle,cilDescription } from '@coreui/icons'
import { CSpinner } from '@coreui/react'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import api from '../../api/axios'

import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'

import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

const Index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')

  // gst codes and loader
  const [organization, setOrganization] = useState([])
  const [loading, setLoading] = useState(false)

  // fetch all the availale gst codes
  const fetchOrganization = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/organization/index', { params })
      setOrganization(response.data.data.organizationList)
      setTotalPages(response.data.totalPages)
    } catch (error) {
      console.error(error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchOrganization()
    }
  }, [search, sort, page])

  // sort
  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // delete
  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Organisation?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/organization/delete/${id}`)

      toast.success('Organisation deleted successfully')

      fetchOrganization()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete Organisation')
    }
  }

  const navigate = useNavigate()

  const ActionButton = ({ color, icon, onClick }) => (
  <CButton
    size="sm"
    color={color}
    variant="ghost"
    onClick={onClick}
    className="rounded-circle"
  >
    <CIcon icon={icon} />
  </CButton>
)

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Company</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch onSearch={setSearch} placeholder="Search By Organisation" />

              <CTooltip content="Add Organisation" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/organization/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped responsive>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Organisation"
                      sortKey="org_name"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Organisation Code"
                      sortKey="org_code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Email"
                      sortKey="contact_email"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Phone"
                      sortKey="contact_phone"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Address"
                      sortKey="address"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell>Status</CTableHeaderCell>
                    <CTableHeaderCell>Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>

                <CTableBody>
                  {loading ? (
                    <CTableRow>
                      <CTableDataCell colSpan={13} className="text-center py-4">
                        <CSpinner size="sm" />
                      </CTableDataCell>
                    </CTableRow>
                  ) : organization.length > 0 ? (
                    organization.map((item) => (
                      <CTableRow key={item.id}>
                        <CTableDataCell>{item.org_name}</CTableDataCell>
                        <CTableDataCell>{item.org_code}</CTableDataCell>
                        <CTableDataCell>{item.contact_email}</CTableDataCell>
                        <CTableDataCell>{item.contact_phone}</CTableDataCell>
                        <CTableDataCell>{item.address}</CTableDataCell>
                        <CTableDataCell>
                          {item.is_active ? (
                            <CIcon icon={cilCheckCircle} className="text-success" />
                          ) : (
                            <CIcon icon={cilXCircle} className="text-danger" />
                          )}
                        </CTableDataCell>

                        <CTableDataCell>
                          <div className="d-flex gap-2">
                            <CTooltip content="Preview" placement="top">
                              <div>
                                <ActionButton
                                  color="primary"
                                  icon={cilDescription}
                                  onClick={() => navigate(`/organization/preview/${item.id}`)}
                                />
                              </div>
                            </CTooltip>

                            <CTooltip content="Edit" placement="left">
                              <CButton
                                color="primary"
                                size="sm"
                                variant="ghost"
                                onClick={() => navigate(`/organization/edit/${item.id}`)}
                              >
                                <CIcon icon={cilPencil} />
                              </CButton>
                            </CTooltip>
                            {item.is_active && (
                              <CTooltip content="Delete" placement="right">
                                <CButton
                                  color="danger"
                                  size="sm"
                                  variant="ghost"
                                  onClick={() => confirmDelete(item.id)}
                                >
                                  <CIcon icon={cilTrash} />
                                </CButton>
                              </CTooltip>
                            )}
                          </div>
                        </CTableDataCell>
                      </CTableRow>
                    ))
                  ) : (
                    <TableEmptyState colSpan={13} />
                  )}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Index
