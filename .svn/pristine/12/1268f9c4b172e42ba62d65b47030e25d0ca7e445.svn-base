const PDFDocument = require("pdfkit");
const fs = require("fs");
const path = require("path");

class SalarySlipPdf {
  static async generate(data) {
    const {
      employee_id,
      employee_name,
      gross_earnings,
      total_deductions,
      net_salary,
      components,
      leave_taken,
      leave_deduction,
    } = data;

    // Folder path
    const folderPath = path.join(
      __dirname,
      "../uploads/salary-slips"
    );

    if (!fs.existsSync(folderPath)) {
      fs.mkdirSync(folderPath, { recursive: true });
    }

    // File name

    const filename = `salary-slip-${employee_id}-${Date.now()}.pdf`;
    const filePath = path.join(folderPath, filename);

    // PDF init
    const doc = new PDFDocument({
      margin: 40,
      size: "A4",
    });

    const stream = fs.createWriteStream(filePath);
    doc.pipe(stream);

    // --------------------------
    // Helpers
    // --------------------------

    const drawBox = (x, y, w, h) => {
      doc.rect(x, y, w, h).stroke();
    };

    const formatAmount = (value) => {
      return ` ${Number(value || 0).toFixed(2)}`;
    };

    // --------------------------
    // Header
    // --------------------------
    doc
     .font("Helvetica-Bold")
     .fontSize(20)
     .text("SALARY SLIP", 0, 40, {
    align: "center",
  });
    doc
      .fontSize(12)
      .font("Helvetica-Bold")
      .text(
        `Date: ${new Date().toLocaleDateString("en-IN")}`,
        400,
        40
      );

    doc.moveDown(2);

    doc
      .font("Helvetica-Bold")
      .text("Employee:", 40, 90, {
        continued: true,
      })
      .font("Helvetica")
      .text(` ${employee_name}`);

    doc
  .font("Helvetica-Bold")
  .text("Total Leaves:", 40, 115, {
    continued: true,
  })
  .font("Helvetica")
  .text(` ${leave_taken || 0}`);
    // --------------------------
    // Main Table
    // --------------------------
    let startX = 40;
    let startY = 170;
    let tableWidth = 515;
    let rowHeight = 37;
    let col1 = 370;
    let col2 = 145;

    // Outer Box
    drawBox(startX, startY, tableWidth, 370);

    // Header Row
    drawBox(startX, startY, tableWidth, rowHeight);

    doc
      .font("Helvetica-Bold")
      .fontSize(13)
      .text(
        "PAYSLIP DETAILS",
        startX + 10,
        startY + 12
      );

    // Components Header
    let y = startY + rowHeight;

    drawBox(startX, y, col1, rowHeight);
    drawBox(startX + col1, y, col2, rowHeight);

    doc
      .font("Helvetica-Bold")
      .fontSize(12)
      .text("Components", startX + 10, y + 12);

    doc
      .text("Monthly", startX + col1 + 10, y + 12);

    y += rowHeight;

    // Earnings Components Only
    const earningComponents = components.filter(
      (item) => item.type === "EARNING"
    );

    earningComponents.forEach((item) => {
      drawBox(startX, y, col1, rowHeight);
      drawBox(startX + col1, y, col2, rowHeight);

      doc
        .font("Helvetica")
        .fontSize(11)
        .text(item.name, startX + 10, y + 12);

      doc.text(
        formatAmount(item.amount),
        startX + col1 + 10,
        y + 12
      );

      y += rowHeight;
    });

    // Gross Earnings Row
    drawBox(startX, y, col1, rowHeight);
    drawBox(startX + col1, y, col2, rowHeight);

    doc
      .font("Helvetica-Bold")
      .text("Gross Earnings", startX + 10, y + 12);

    doc.text(
      formatAmount(gross_earnings),
      startX + col1 + 10,
      y + 12
    );

    y += rowHeight;

    // Deductions Title
    drawBox(startX, y, col1, rowHeight);
    drawBox(startX + col1, y, col2, rowHeight);

    doc
      .font("Helvetica-Bold")
      .text("Deductions", startX + 10, y + 12);

    y += rowHeight;

    // Leave Deduction Row
drawBox(startX, y, col1, rowHeight);
drawBox(startX + col1, y, col2, rowHeight);

doc
  .font("Helvetica")
  .text("Leave Deduction", startX + 10, y + 12);

doc.text(
  formatAmount(leave_deduction),
  startX + col1 + 10,
  y + 12
);

y += rowHeight;
    // Total Deductions Row
    drawBox(startX, y, col1, rowHeight);
    drawBox(startX + col1, y, col2, rowHeight);

    doc
      .font("Helvetica")
      .text("Total Deductions", startX + 10, y + 12);

    doc.text(
      formatAmount(total_deductions),
      startX + col1 + 10,
      y + 12
    );

    y += rowHeight;

    // Net Pay Row
    drawBox(startX, y, col1, rowHeight);
    drawBox(startX + col1, y, col2, rowHeight);

    doc
      .font("Helvetica-Bold")
      .fontSize(13)
      .text("Net Pay", startX + 10, y + 12);

    doc.text(
      formatAmount(net_salary),
      startX + col1 + 10,
      y + 12
    );

    // --------------------------
    // Footer
    // --------------------------
    doc
      .font("Helvetica")
      .fontSize(10)
      .text(
        "This is a system generated payslip.",
        40,
        y + 60
      );

    doc.end();

    await new Promise((resolve) => {
      stream.on("finish", resolve);
    });

    return {
      filename,
      filepath: `/uploads/salary-slips/${filename}`,
    };
  }
}

module.exports = SalarySlipPdf;