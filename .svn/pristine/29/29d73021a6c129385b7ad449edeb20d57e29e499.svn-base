export const formReducer = (state, action) => {
    switch (action.type) {

        case "SET_HEALTH":
            return {
                ...state,
                health: action.payload
            };

        case "SET_VACCINATIONS":
            return {
                ...state,
                vaccinations: action.payload
            };

        case "SET_SKILLS":
            return {
                ...state,
                skills: action.payload
            };

        case "SET_VEHICLES":
            return {
                ...state,
                vehicles: action.payload
            };

        case "SET_HOBBIES":
            return {
                ...state,
                hobbies: action.payload
            };

        case "SET_ASSETS":
            return {
                ...state,
                assets: action.payload
            };

        case "SET_ACHIEVEMENTS":
            return {
                ...state,
                achievements: action.payload
            };

        case "SET_DISCIPLINES":
            return {
                ...state,
                disciplines: action.payload
            };

        case "SET_LANGUAGES":
            return {
                ...state,
                languages: action.payload
            };

        case "SET_PASSPORT":
            return {
                ...state,
                passport: action.payload
            };

        case "UPDATE_PASSPORT":
            return {
                ...state,
                passport: {
                    ...state.passport,
                    [action.field]: action.value
                }
            };

        case "SET_STEP":
            return {
                ...state,
                step: action.payload,
            };

        case "UPDATE_FIELD":
            return {
                ...state,
                [action.section]: {
                    ...state[action.section],
                    [action.field]: action.value,
                },
            };

        case "ADD_ITEM":
            return {
                ...state,
                [action.section]: [
                    ...state[action.section],
                    action.payload,
                ],
            };

        case "REMOVE_ITEM":
            return {
                ...state,
                [action.section]: state[action.section].filter(
                    (_, index) => index !== action.index
                ),
            };

        case "UPDATE_ITEM":
            const updated = [...state[action.section]];
            updated[action.index][action.field] = action.value;

            return {
                ...state,
                [action.section]: updated,
            };

        default:
            return state;
    }
};