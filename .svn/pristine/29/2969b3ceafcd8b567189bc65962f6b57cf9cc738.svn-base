const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const RoleMaster = sequelize.define('RoleMaster', {

    id: {
        type: DataTypes.BIGINT,
        primaryKey: true,
        autoIncrement: true
    },

    role_code: {
        type: DataTypes.STRING(50),
        allowNull: false,
        unique: true
    },

    role_name: {
        type: DataTypes.STRING(100),
        allowNull: false
    },

    description: DataTypes.TEXT,

    is_system_role: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },

    role_level: {
        type: DataTypes.INTEGER,
        allowNull: false
    },

    is_active: {
        type: DataTypes.BOOLEAN,
        defaultValue: true
    }

}, {
    tableName: 'roles',
    schema: 'pmu',
    timestamps: true,
    createdAt: 'created_at',
    updatedAt: 'updated_at'
});

RoleMaster.associate = (models) => {

    RoleMaster.hasMany(models.EmployeeRole, {
        foreignKey: 'role_id'
    });

    RoleMaster.belongsToMany(models.Employee, {
        through: models.EmployeeRole,
        foreignKey: 'role_id',
        otherKey: 'employee_id'
    });

};

module.exports = RoleMaster;

