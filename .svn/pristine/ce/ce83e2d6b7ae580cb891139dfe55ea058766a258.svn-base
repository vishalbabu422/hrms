const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const SalaryAddonMaster = sequelize.define(
  "SalaryAddonMaster",
  {
    id: {
      type: DataTypes.BIGINT,
      allowNull: false,
      primaryKey: true,
      autoIncrement: true,
    },

    name: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    code: {
      type: DataTypes.STRING(100),
      allowNull: false,
      unique: true,
    },

    description: {
      type: DataTypes.TEXT,
      allowNull: true,
    },

    addon_type: {
      type: DataTypes.STRING(20),
      allowNull: false,
      validate: {
        isIn: [["EARNING", "DEDUCTION"]],
      },
    },

    taxable: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    affects_pf: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    affects_esi: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    recurring_allowed: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    is_active: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    is_deleted: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    created_at: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    updated_at: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    created_by: {
      type: DataTypes.BIGINT,
      allowNull: true,
    },

    updated_by: {
      type: DataTypes.BIGINT,
      allowNull: true,
    },
  },
  {
    schema: "pmu",
    tableName: "salary_addon_master",
    timestamps: false,
  }
);

SalaryAddonMaster.associate = (models) => {
  SalaryAddonMaster.belongsTo(models.Employee, {
    foreignKey: "created_by",
    as: "creator",
  });
};

module.exports = SalaryAddonMaster;