{
  "swagger": "2.0",
  "info": {
    "description": "KMS API Documentation",
    "version": "1.0",
    "title": "PMU API",
    "contact": {
      "email": "vishalbabu422@gmail.com"
    }
  },
  "schemes": ["http", "https"],
  "host": "localhost:3100",
  "basePath": "/api/v1",
  "securityDefinitions": {
    "Authorization": {
      "type": "apiKey",
      "name": "authorization",
      "in": "header",
      "description": "Authentication token"
    }
  },
  "paths": {
    "/admin/gst-code/index": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Get GST Code List",
        "description": "Get all the GST Codes!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "is_active",
            "description": "Filter any field (Ex. is_active : true)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "description": "Ex. (id desc)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "description": "Ex. (workflow_state_id,status,created_by,modified_by,created,modified,...)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "Pagination page no. (Ex. 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "Pagination limit. (Ex. 10)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GstCodeResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/gst-code/{id}": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Get GST Code Edit List",
        "description": "Get all the GST Codes!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "description": "ID of the GST Code",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "is_active",
            "description": "Activeness of the GST Code",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": true
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GstCodeResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/gst-code/create": {
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Create GST Code",
        "description": "Create a new GST Code in the master table",
        "consumes": ["application/json"],
        "produces": ["application/json"],

        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "code_type",
                "code",
                "description",
                "effective_from"
              ],
              "properties": {
                "code_type": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "HSN"
                },
                "code": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "998313"
                },
                "description": {
                  "type": "string",
                  "example": "IT Consulting Services"
                },
                "gst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "sgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "igst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cess_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "other_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-31"
                }
              }
            }
          }
        ],

        "responses": {
          "201": {
            "description": "GST Code created successfully",
            "schema": {
              "$ref": "#/definitions/GstCodeResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "GST Code already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/admin/gst-code/edit/{id}": {
      "patch": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Update GST Code (Partial)",
        "description": "Partially update a GST Code using its ID",
        "consumes": ["application/json"],
        "produces": ["application/json"],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the GST Code",
            "required": false,
            "type": "integer",
            "example": 1
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "code_type": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "HSN"
                },
                "code": {
                  "type": "string",
                  "maxLength": 10,
                  "example": "998313"
                },
                "description": {
                  "type": "string",
                  "example": "Updated IT Consulting Services"
                },
                "gst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "sgst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 9.0
                },
                "igst_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 18.0
                },
                "cess_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "other_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.0
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-31"
                },
                "is_active": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],

        "responses": {
          "200": {
            "description": "GST Code updated successfully",
            "schema": {
              "$ref": "#/definitions/GstCodeResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "GST Code not found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "GST Code already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/admin/gst-code/delete/{id}": {
      "delete": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["GST Codes"],
        "summary": "Delete GST Code",
        "description": "Soft delete a GST Code by ID",
        "produces": ["application/json"],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the GST Code",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],

        "responses": {
          "200": {
            "description": "GST Code deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "GST Code deleted successfully"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "GST Code not found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "GST Code already inactive",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "definitions": {
    "GstCodeMaster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },

        "code_type": {
          "type": "string",
          "maxLength": 10
        },

        "code": {
          "type": "string",
          "maxLength": 10
        },

        "description": {
          "type": "string"
        },

        "gst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "sgst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "igst_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "cess_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "other_rate": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },

        "effective_from": {
          "type": "string",
          "format": "date"
        },

        "effective_to": {
          "type": "string",
          "format": "date"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code_type", "code", "description", "effective_from"]
    },
    "InvalidResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
