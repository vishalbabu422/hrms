import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import api from '../../api/axios'

const RateFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [designationList, setDesignationList] = useState([])
  const [gstCodeList, setGstCodeList] = useState([])

  useEffect(() => {
    const fetchDesignation = async () => {
      const params = {
        fields: 'id,designation',
      }

      try {
        const response = await api.get('/admin/designation/index', { params })
        setDesignationList(response.data.data.DesignationList)
      } catch (error) {
        console.error('Failed to fetch designations:', error)
      }
    }

    const fetchGstCodes = async () => {
      const params = {
        fields: 'id,code',
      }

      try {
        const response = await api.get('/admin/gst-code/index', { params })
        setGstCodeList(response.data.data.GstCodeList)
      } catch (error) {
        console.error('Failed to fetch gst code:', error)
      }
    }

    fetchDesignation()
    fetchGstCodes()
  }, [])

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  useEffect(() => {
    if (!formData) return

    let updated = { ...formData }

    const unitIncl = Number(updated.unit_rate_incl_agency_margin) || 0
    const unitExcl = Number(updated.unit_rate_excl_agency_margin) || 0
    const agencyPercent = Number(updated.agency_margin_percent) || 0
    const agencyAmount = Number(updated.agency_amount) || 0
    const nicsiPercent = Number(updated.nicsi_margin_percent) || 0
    const nicsiAmount = Number(updated.nicsi_margin_amount) || 0

    // Mutual exclusivity
    if (unitIncl > 0) updated.unit_rate_excl_agency_margin = 0
    if (unitExcl > 0) updated.unit_rate_incl_agency_margin = 0

    const baseUnit = unitIncl > 0 ? unitIncl : unitExcl

    // Agency calculations
    if (unitIncl > 0 && agencyPercent > 0) {
      updated.agency_amount = (unitIncl * agencyPercent) / 100
    }

    if (unitExcl > 0 && agencyAmount > 0) {
      updated.agency_margin_percent = (agencyAmount / unitExcl) * 100
    }

    if (unitIncl > 0 && agencyAmount > 0) {
      updated.agency_margin_percent = (agencyAmount / unitIncl) * 100
    }

    // NICSI calculations
    if (baseUnit > 0 && nicsiPercent > 0) {
      updated.nicsi_margin_amount = (baseUnit * nicsiPercent) / 100
    }

    if (baseUnit > 0 && nicsiAmount > 0) {
      updated.nicsi_margin_percent = (nicsiAmount / baseUnit) * 100
    }

    const finalAgencyAmount = Number(updated.agency_amount) || 0
    const finalNicsiAmount = Number(updated.nicsi_margin_amount) || 0

    // Total Amount
    updated.total_amount = baseUnit + finalAgencyAmount + finalNicsiAmount

    // GST Calculations
    const totalAmount = Number(updated.total_amount) || 0
    const cgstPercent = Number(updated.cgst_percent) || 0
    const sgstPercent = Number(updated.sgst_percent) || 0
    const igstPercent = Number(updated.igst_percent) || 0

    updated.cgst_amount = (totalAmount * cgstPercent) / 100
    updated.sgst_amount = (totalAmount * sgstPercent) / 100
    updated.igst_amount = (totalAmount * igstPercent) / 100

    updated.total_gst_amount =
      (Number(updated.cgst_amount) || 0) +
      (Number(updated.sgst_amount) || 0) +
      (Number(updated.igst_amount) || 0)

    // Final Amount
    updated.final_amount =
      (Number(updated.total_amount) || 0) + (Number(updated.total_gst_amount) || 0)

    setFormData(updated)
  }, [
    formData?.unit_rate_incl_agency_margin,
    formData?.unit_rate_excl_agency_margin,
    formData?.agency_margin_percent,
    formData?.agency_amount,
    formData?.nicsi_margin_percent,
    formData?.nicsi_margin_amount,
    formData?.cgst_percent,
    formData?.sgst_percent,
    formData?.igst_percent,
  ])

  // Agency Amount Calculation Logic
  useEffect(() => {
    if (!formData) return

    const incl = Number(formData.unit_rate_incl_agency_margin) || 0
    const excl = Number(formData.unit_rate_excl_agency_margin) || 0
    const percent = Number(formData.agency_margin_percent) || 0

    let baseRate = 0

    if (incl > 0) baseRate = incl
    if (excl > 0) baseRate = excl

    if (baseRate > 0 && percent > 0) {
      const agencyAmount = (baseRate * percent) / 100

      if (agencyAmount !== formData.agency_amount) {
        setFormData((prev) => ({
          ...prev,
          agency_amount: Number(agencyAmount.toFixed(2)),
        }))
      }
    }
  }, [
    formData.unit_rate_incl_agency_margin,
    formData.unit_rate_excl_agency_margin,
    formData.agency_margin_percent,
  ])

  // Fetch GST percentages on code change
  useEffect(() => {
    if (!formData?.hsn_sac_code) return

    const fetchGstPercentages = async () => {
      try {
        const response = await api.get(`/admin/gst-code/${formData.hsn_sac_code}`)

        const gst = response.data.data

        setFormData((prev) => ({
          ...prev,
          cgst_percent: gst.cgst_percent || 0,
          sgst_percent: gst.sgst_percent || 0,
          igst_percent: gst.igst_percent || 0,
        }))
      } catch (error) {
        console.error('Failed to fetch gst percentages:', error)
      }
    }

    fetchGstPercentages()
  }, [formData?.hsn_sac_code])

  if (!formData) return null

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CForm className="row" onSubmit={handleSubmit}>
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={12}>
                <CFormLabel>Designation</CFormLabel>
                <CFormSelect
                  name="desgn_id_fk"
                  value={String(formData.desgn_id_fk)}
                  onChange={handleChange}
                >
                  <option value="">Select Designation</option>
                  {designationList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.designation}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Agency Margin (%)</CFormLabel>
                <CFormInput
                  name="agency_margin_percent"
                  value={formData.agency_margin_percent || ''}
                  onChange={handleChange}
                  placeholder="Enter Agency Margin (%)"
                  type="number"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Unit Rate (Including A.M)</CFormLabel>
                <CFormInput
                  name="unit_rate_incl_agency_margin"
                  value={formData.unit_rate_incl_agency_margin || ''}
                  onChange={handleChange}
                  placeholder="Enter Unit Rate (Including A.M)"
                  type="number"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Unit Rate (Excluding A.M)</CFormLabel>
                <CFormInput
                  name="unit_rate_excl_agency_margin"
                  value={formData.unit_rate_excl_agency_margin || ''}
                  onChange={handleChange}
                  placeholder="Enter Unit Rate (Excluding A.M)"
                  type="number"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Agency Amount</CFormLabel>
                <CFormInput
                  name="agency_amount"
                  value={formData.agency_amount || ''}
                  placeholder="Enter Agency Amount"
                  onChange={handleChange}
                  type="number"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>NICSI Margin (%)</CFormLabel>
                <CFormInput
                  type="number"
                  name="nicsi_margin_percent"
                  placeholder="Enter NICSI Margin (%)"
                  value={formData.nicsi_margin_percent || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>NICSI Margin Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="nicsi_margin_amount"
                  placeholder="Enter Margin Amount"
                  value={formData.nicsi_margin_amount || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Total Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="total_amount"
                  placeholder="Enter Total Amount"
                  value={formData.total_amount || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>

        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={3}>
                <CFormLabel>GST Code</CFormLabel>
                <CFormSelect
                  name="hsn_sac_code"
                  value={String(formData.hsn_sac_code)}
                  onChange={handleChange}
                >
                  <option value="">Select GST Code</option>
                  {gstCodeList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.code}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>CGST Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="cgst_amount"
                  placeholder="Enter CGST Amount"
                  value={formData.cgst_amount || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>SGST Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="sgst_amount"
                  placeholder="Enter SGST Amount"
                  value={formData.sgst_amount || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>IGST Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="igst_amount"
                  placeholder="Enter IGST Amount"
                  value={formData.igst_amount || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Total GST Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="total_gst_amount"
                  placeholder="Enter Total GST Amount"
                  value={formData.total_gst_amount || ''}
                  onChange={handleChange}
                />
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={12}>
                <CFormLabel>Final Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="final_amount"
                  placeholder="Enter Final Amount"
                  value={formData.final_amount || ''}
                  onChange={handleChange}
                />
              </CCol>
              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>
      </CForm>
    </CRow>
  )
}

export default RateFormComponent
