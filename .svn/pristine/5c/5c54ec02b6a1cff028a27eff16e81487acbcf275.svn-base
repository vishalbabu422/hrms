import ExamFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const Add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
        parent_division_id: payload.parent_division || null,
      }
      delete normalizedPayload.parent_division

      console.log('Creating examination with payload:', normalizedPayload)
      await api.post('/examinations', normalizedPayload)
      toast.success('Examination created successfully')
      navigate('/examination')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to create Examination')
    }
  }

  const initialData = {
    exam_name: '',
    exam_type: '',
    passing_marks:'',
    is_active: true,

  }

  return (
    <ExamFormComponent
      initialData={initialData}
      mode="create"
      onSubmit={handleSubmit}
    />
  )
}

export default Add