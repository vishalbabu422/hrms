import React, { useState, useEffect, forwardRef, useImperativeHandle } from 'react'
import api from '../../../api/axios'
import { toast } from 'react-toastify'
import useDocumentUpload from '../../../hooks/useDocumentUpload'
import useEmployeeDocuments from '../../../hooks/fetchDocuments'

const Bank = forwardRef(({ employeeId }, ref) => {
  const [loading, setLoading] = useState(false)
  const [isExisting, setIsExisting] = useState(false)

  const { uploadDocument, updateDocument } = useDocumentUpload(employeeId)

  const { documents } = useEmployeeDocuments(employeeId, 'CANCEL_CHEQUE')
  const chequeDoc = documents.find((d) => d.doc_type === 'CANCEL_CHEQUE')

  const emptyBank = {
    bank_name: '',
    branch_name: '',
    bank_address: '',
    account_number: '',
    ifsc: '',
    micr_code: '',
  }

  const [employeeBank, setEmployeeBank] = useState(emptyBank)
  const [chequeFile, setChequeFile] = useState(null)

  // ================= FETCH =================
  useEffect(() => {
    if (!employeeId) return

    const fetchBank = async () => {
      try {
        const res = await api.get(`/employee/${employeeId}/bankId`)
        const data = res.data?.data?.[0] || res.data

        if (data) {
          setEmployeeBank(data)
          setIsExisting(true)
        }
      } catch (err) {
        console.error('Fetch bank error', err)
      }
    }

    fetchBank()
  }, [employeeId])

  // ================= HANDLE CHANGE =================
  const handleChange = (field, value) => {
    setEmployeeBank((prev) => ({
      ...prev,
      [field]: value,
    }))
  }

  const handleChequeUpload = (e) => {
    const file = e.target.files[0]
    setChequeFile(file)
  }

  // ================= SUBMIT =================
  useImperativeHandle(ref, () => ({
    submit: async () => {
      try {
        setLoading(true)

        if (!employeeBank.bank_name || !employeeBank.account_number) {
          toast.error('Bank name and account number are required')
          return false
        }

        const url = `/employee/${employeeId}/bankId`

        //  Save bank data (JSON only)
        if (isExisting) {
          await api.patch(url, employeeBank)
        } else {
          await api.post(url, employeeBank)
        }

        //  Upload cheque separately (if exists)
        if (chequeFile) {console.log(chequeFile)
          if (chequeDoc?.id) {
            await updateDocument({
              docId: chequeDoc.id,
              file: chequeFile,
              docType: 'CANCEL_CHEQUE',
              remarks: 'Cancelled cheque',
            })
          } else {
            await uploadDocument({
              file: chequeFile,
              docType: 'CANCEL_CHEQUE',
              remarks: 'Cancelled cheque',
            })
          }
        }

        toast.success('Bank details saved')
        return true
      } catch (error) {
        console.error(error)
        toast.error(error.response?.data?.message || 'Failed to save bank details')
        return false
      } finally {
        setLoading(false)
      }
    },
  }))

  return (
    <div className="step-content">
      <div className="row border rounded g-3 mt-2 p-3">
        <div className="col-md-6">
          <label className="form-label">Bank Name</label>
          <input
            className="form-control"
            value={employeeBank.bank_name || ''}
            onChange={(e) => handleChange('bank_name', e.target.value)}
          />
        </div>

        <div className="col-md-6">
          <label className="form-label">Branch Name</label>
          <input
            className="form-control"
            value={employeeBank.branch_name || ''}
            onChange={(e) => handleChange('branch_name', e.target.value)}
          />
        </div>

        <div className="col-md-6">
          <label className="form-label">Bank Address</label>
          <input
            className="form-control"
            value={employeeBank.bank_address || ''}
            onChange={(e) => handleChange('bank_address', e.target.value)}
          />
        </div>

        <div className="col-md-6">
          <label className="form-label">Account Number</label>
          <input
            className="form-control"
            value={employeeBank.account_number || ''}
            onChange={(e) => handleChange('account_number', e.target.value)}
          />
        </div>

        <div className="col-md-6">
          <label className="form-label">IFSC Code</label>
          <input
            className="form-control"
            value={employeeBank.ifsc || ''}
            onChange={(e) => handleChange('ifsc', e.target.value)}
          />
        </div>

        <div className="col-md-6">
          <label className="form-label">MICR Code</label>
          <input
            className="form-control"
            value={employeeBank.micr_code || ''}
            onChange={(e) => handleChange('micr_code', e.target.value)}
          />
        </div>

        {/* Cheque Upload */}
        <div className="col-md-12">
          <label className="form-label">Cancelled Cheque</label>

          <input
            type="file"
            className="form-control"
            accept=".pdf,.jpg,.jpeg,.png"
            onChange={handleChequeUpload}
          />

          {/* Existing document */}
          {!chequeFile && chequeDoc && (
            <div className="mt-2">
              <small className="text-primary">
                Existing File:{' '}
                <a href={chequeDoc.file_url} target="_blank" rel="noreferrer">
                  {chequeDoc.file_name}
                </a>
              </small>
            </div>
          )}

          {/* Newly selected file */}
          {chequeFile && <small className="text-success mt-2 d-block">{chequeFile.name}</small>}
        </div>
      </div>
    </div>
  )
})

export default Bank
