import React, { useState, useRef } from 'react'
import { useParams } from 'react-router-dom'
import CIcon from '@coreui/icons-react'

import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
  cilBuilding,
  cilMap,
} from '@coreui/icons'

// Steps
import BasicInfo from './modules/basic-info'
import Address from './modules/address'
import OfficeAddress from './modules/office-address'
import Qualification from './modules/qualification'
import Bank from './modules/bank'
import Insurance from './modules/insurance'
import Screening from './modules/screening'
import Experience from './modules/experience'
import Ltc from './modules/ltc'
import Documents from './modules/document'
import { toast } from 'react-toastify'

const Add = () => {
  const { employeeId: paramId } = useParams()

  //  If edit mode → id comes from params
  const [employeeId, setEmployeeId] = useState(paramId || null)
  const [step, setStep] = useState(0)

  //  Holds all step refs
  const stepRefs = useRef([])

  //  Steps config
  const steps = [
    { label: 'Basic Information', icon: cilUser, component: BasicInfo },
    { label: 'Address', icon: cilLocationPin, component: Address },
    { label: 'Office Address', icon: cilBuilding, component: OfficeAddress },
    { label: 'Qualification', icon: cilEducation, component: Qualification },
    { label: 'Bank Details', icon: cilBank, component: Bank },
    { label: 'Insurance', icon: cilShieldAlt, component: Insurance },
    { label: 'Screening Test', icon: cilClipboard, component: Screening },
    { label: 'Experience', icon: cilBriefcase, component: Experience },
    { label: 'LTC', icon: cilMap, component: Ltc },
    { label: 'Documents', icon: cilFile, component: Documents },
  ]

  const StepComponent = steps[step].component

  const canNavigateToStep = (targetStep) => {
    // Step 0 (BasicInfo) is always allowed
    if (targetStep === 0) return true

    // All other steps require employeeId
    if (!employeeId) {
      toast.error('Please complete Basic Info first')
      return false
    }

    return true
  }

  // NEXT BUTTON HANDLER
  const handleNext = async () => {
    if (!canNavigateToStep(step)) {
      setStep(0)
      return
    }

    const currentStepRef = stepRefs.current[step]

    if (!currentStepRef?.submit) {
      console.warn('Submit method not found on step:', step)
      return
    }

    const result = await currentStepRef.submit()

    /**
     * result can be:
     * true → success
     * false → validation failed
     * { employeeId } → returned from BasicInfo
     */

    if (!result) return

    // Special case: Step 0 creates employee
    if (step === 0 && result?.employeeId) {
      setEmployeeId(result.employeeId)
    }

    setStep((prev) => prev + 1)
  }

  const handlePrevious = () => {
    setStep((prev) => prev - 1)
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
        {/* 🔹 Stepper */}
        <div className="stepper-underline mb-4">
          {steps.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => {
                if (!canNavigateToStep(index)) return
                setStep(index)
              }}
            >
              <CIcon icon={item.icon} className="stepper-icon" />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* 🔹 Current Step */}
        <StepComponent
          ref={(el) => (stepRefs.current[step] = el)}
          employeeId={employeeId}
          isEdit={!!employeeId}
        />

        {/* 🔹 Footer */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={handlePrevious}
          >
            Previous
          </button>

          <button
            className="btn btn-primary"
            disabled={step === steps.length - 1}
            onClick={handleNext}
          >
            {step === steps.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
