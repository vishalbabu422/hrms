import React from 'react'
import { CCard, CCardBody, CCol, CRow, CBadge, CButton } from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilUser, cilLocationPin, cilBank, cilInfo, cilPencil } from '@coreui/icons'
import { useNavigate } from 'react-router-dom'

const VendorPreview = () => {
  const navigate = useNavigate()

  const vendor = {
    organization_id: 1,
    empanelment_id_fk: 2,
    vendor_name: 'Tech Solutions Pvt Ltd',
    vendor_code: 'TSPL001',
    vendor_type: 'PRIVATE_LIMITED',
    contact_person: 'Rahul Sharma',
    contact_email: 'rahul.sharma@techsolutions.com',
    contact_phone: '+91-9876543210',
    website: 'https://www.techsolutions.com',
    address_line1: 'Plot No. 45, Sector 18',
    address_line2: 'Near Metro Station',
    city: 'Gurugram',
    state: 'Haryana',
    country: 'India',
    pincode: '122015',
    bank_name: 'HDFC Bank',
    account_number: '50200012345678',
    ifsc_code: 'HDFC0001234',
    branch_name: 'Gurugram Main Branch',
    onboarding_date: '2026-02-18',
    is_active: true,
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4 shadow-sm border-0">
          <CCardBody>
            {/* ================= HEADER ================= */}
            <div className="d-flex justify-content-between align-items-start mb-4">
              <div>
                <h4 className="fw-bold mb-1">{vendor.vendor_name || '-'}</h4>
                <div className="text-muted">{vendor.vendor_code || '-'}</div>
              </div>

              <div className="d-flex align-items-center gap-3">
                <CBadge color={vendor.is_active ? 'success' : 'danger'}>
                  {vendor.is_active ? 'Active' : 'Inactive'}
                </CBadge>

                <CButton
                  color="primary"
                  size="sm"
                  onClick={() => navigate(`/vendor/edit/${vendor.id}`)}
                >
                  <CIcon icon={cilPencil} className="me-1" />
                  Edit
                </CButton>
              </div>
            </div>

            {/* ================= BASIC INFORMATION ================= */}
            <section title="Basic Information" icon={cilInfo}>
              <div label="Vendor Type" value={vendor.vendor_type} />
              <div label="Onboarding Date" value={vendor.onboarding_date} />
              <div label="Organization ID" value={vendor.organization_id} />
              <div label="Empanelment ID" value={vendor.empanelment_id_fk} />
            </section>

            {/* ================= CONTACT DETAILS ================= */}
            <section title="Contact Details" icon={cilUser}>
              <div label="Contact Person" value={vendor.contact_person} />
              <div label="Email" value={vendor.contact_email} />
              <div label="Phone" value={vendor.contact_phone} />
              <div label="Website" value={vendor.website} />
            </section>

            {/* ================= ADDRESS ================= */}
            <section title="Address" icon={cilLocationPin}>
              <div label="Address Line 1" value={vendor.address_line1} />
              <div label="Address Line 2" value={vendor.address_line2} />
              <div label="City" value={vendor.city} />
              <div label="State" value={vendor.state} />
              <div label="Country" value={vendor.country} />
              <div label="Pincode" value={vendor.pincode} />
            </section>

            {/* ================= BANK DETAILS ================= */}
            <section title="Bank Details" icon={cilBank}>
              <div label="Bank Name" value={vendor.bank_name} />
              <div label="Account Number" value={vendor.account_number} />
              <div label="IFSC Code" value={vendor.ifsc_code} />
              <div label="Branch Name" value={vendor.branch_name} />
            </section>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default VendorPreview
