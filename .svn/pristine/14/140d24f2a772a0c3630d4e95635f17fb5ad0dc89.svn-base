import { CButton } from '@coreui/react'
import ExportDropdown from './ExportDropdown'
import ExpandableSearch from './expandable-search'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload, cilPlus } from '@coreui/icons'

const PageHeader = ({
  title,
  onSearchChange,
  onAddClick,
  addLabel = 'Add',
  onExportPDF,
  onExportExcel,
  showExport = false,
}) => {
  return (
    <div
      className="mb-4 p-3 mt-4 rounded-3"
      style={{
        backgroundColor: '#f4f6f9',
        borderLeft: '4px solid #1b4f72',
      }}
    >
      <div className="d-flex justify-content-between align-items-center">
        <div>
          <h5 className="fw-bold mb-1 text-dark">{title}</h5>
        </div>

        <div className="d-flex gap-3 align-items-center">
          {onSearchChange && (
            <ExpandableSearch onSearchChange={onSearchChange} placeholder={`Search ${title}...`} />
          )}

          {/* {showExport && <ExportDropdown onExportPDF={onExportPDF} onExportExcel={onExportExcel} />}

          {onAddClick && (
            <CButton color="primary" size="sm" onClick={onAddClick}>
              {addLabel}
            </CButton>
          )} */}

          <div className="d-flex align-items-center gap-2">
            {showExport && (
              <ExportDropdown
                onExportPDF={onExportPDF}
                onExportExcel={onExportExcel}
                mobileOnlyIcon
              />
            )}

            {onAddClick && (
              <CButton color="primary" size="sm" onClick={onAddClick}>
                <CIcon icon={cilPlus} />

                <span className="d-none d-md-inline ms-2">{addLabel}</span>
              </CButton>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}

export default PageHeader
