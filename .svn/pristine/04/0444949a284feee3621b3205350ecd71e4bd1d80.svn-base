const {SalaryAddonMaster} =  require("../../../models");

const AppError = require("../../../utils/appError");

// Get List
exports.index = async (queryOptions) => {
  return await SalaryAddonMaster.findAndCountAll({
    ...queryOptions,
  });
};

// Get By ID
exports.dataById = async (id) => {
  return await SalaryAddonMaster.findOne({
    where: {
      id,
      is_deleted: false,
    },
  });
};

// Create
exports.create = async (payload) => {
  // Duplicate code check
  const existing = await SalaryAddonMaster.findOne({
    where: {
      code: payload.code,
      is_deleted: false,
    },
  });

  if (existing) {
    throw new AppError("Salary Addon code already exists", 409);
  }

  return await SalaryAddonMaster.create({
    ...payload,
    is_active: true,
    is_deleted: false,
    created_at: new Date(),
    updated_at: new Date(),
  });
};

// Update
exports.edit = async (id, updates) => {
  const record = await SalaryAddonMaster.findOne({
    where: {
      id,
      is_deleted: false,
    },
  });

  if (!record) {
    throw new AppError("Salary Addon not found", 404);
  }

  // Duplicate check if code updated
  if (
    updates.code &&
    updates.code !== record.code
  ) {
    const duplicate = await SalaryAddonMaster.findOne({
      where: {
        code: updates.code,
        is_deleted: false,
      },
    });

    if (duplicate && duplicate.id !== record.id) {
      throw new AppError("Salary Addon code already exists", 409);
    }
  }

  await record.update({
    ...updates,
    updated_at: new Date(),
  });

  return record;
};

// Soft Delete
exports.deleteById = async (id) => {
  const record = await SalaryAddonMaster.findOne({
    where: {
      id,
      is_deleted: false,
    },
  });

  if (!record) {
    throw new AppError("Salary Addon not found", 404);
  }

  await record.update({
    is_deleted: true,
    is_active: false,
    updated_at: new Date(),
  });

  return true;
};