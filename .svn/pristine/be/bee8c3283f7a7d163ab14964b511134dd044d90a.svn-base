import React, { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { toast } from 'react-toastify'
import CIcon from '@coreui/icons-react'
import { uploadEmployeeDocument } from '../../services/employeeDocuments'
import BasicInfo from './modules/basic-info'
import Address from './modules/address'
import OfficeAddress from './modules/office-address'
import Qualification from './modules/qualification'
import Bank from './modules/bank'
import Insurance from './modules/insurance'
import Screening from './modules/screening'
import Experience from './modules/experience'
import Ltc from './modules/ltc'
import Documents from './modules/document'

import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
  cilBuilding,
  cilMap,
} from '@coreui/icons'

import api from '../../api/axios'

const Add = () => {
  const navigate = useNavigate()

  const [step, setStep] = useState(0)
  const [employeeId, setEmployeeId] = useState(null)
  const [selectedDocType, setSelectedDocType] = useState('')
  const [documents, setDocuments] = useState([])
  const [selectedFile, setSelectedFile] = useState(null)

  const stepConfig = [
    { label: 'Basic Information', icon: cilUser },
    { label: 'Address', icon: cilLocationPin },
    { label: 'Office Address', icon: cilBuilding },
    { label: 'Qualification', icon: cilEducation },
    { label: 'Bank Details', icon: cilBank },
    { label: 'Insurance', icon: cilShieldAlt },
    { label: 'Screening Test', icon: cilClipboard },
    { label: 'Experience', icon: cilBriefcase },
    { label: 'LTC', icon: cilMap },
    { label: 'Documents', icon: cilFile },
  ]

  // ================= INITIAL STATES =================

  const [employeeDetails, setEmployeeDetails] = useState({})

  const createAddress = (type) => ({
    address_type: type,
    address_line1: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
    is_primary: false,
  })

  const [employeeAddress, setEmployeeAddress] = useState({
    correspondence: createAddress('CORRESPONDENCE'),
    permanent: createAddress('PERMANENT'),
    office: createAddress('OFFICE'),
    client_office: createAddress('CLIENT_OFFICE'),
  })

  const [employeeQualification, setEmployeeQualification] = useState([
    {
      qualification_type: '',
      qualification_name: '',
      specialization: '',
      institute_name: '',
      board_university: '',
      year_of_passing: '',
      grade: '',
      percentage: '',
      document: null,
    },
  ])

  const [experiences, setExperiences] = useState([
    {
      company_name: '',
      designation: '',
      start_date: '',
      end_date: '',
      total_years: '',
      description: '',
      document: null,
    },
  ])

  const [employeeBank, setEmployeeBank] = useState({})
  const [familyMembers, setFamilyMembers] = useState([])
  const [insurance, setInsurance] = useState({})
  const [screening, setScreening] = useState({})
  const [ltcData, setLtcData] = useState({})
  const [ltcLocked, setLtcLocked] = useState(false)

  // ================= HANDLE SUBMIT =================
  const handleSubmit = async () => {
    try {
      // STEP 0 - Basic Info
      if (step === 0) {
        const response = await api.post('/employee', employeeDetails)

        const id = response.data?.data?.id || response.data?.data?.employee_id || response.data?.id

        if (!id) {
          toast.error('Employee ID not received')
          return
        }

        setEmployeeId(id)
        toast.success('Basic info saved')
      }

      // STEP 1 - Address
      else if (step === 1) {
        const url = `/employee/${employeeId}/address`

        await api.post(url, employeeAddress.correspondence)
        await api.post(url, employeeAddress.permanent)

        toast.success('Address saved')
      }

      // STEP 2 - Office Address
      else if (step === 2) {
        const url = `/employee/${employeeId}/address`

        await api.post(url, employeeAddress.office)
        await api.post(url, employeeAddress.client_office)

        toast.success('Office address saved')
      }

      // STEP 3 - Qualification
      else if (step === 3) {
        const url = `/employee/${employeeId}/qualification`

        for (const q of employeeQualification) {
          await api.post(url, q)
        }

        toast.success('Qualification saved')
      }

      // STEP 4 - Bank
      else if (step === 4) {
        await api.post(`/employee/${employeeId}/bankId`, employeeBank)
        toast.success('Bank saved')
      }

      // STEP 5 - Insurance
      else if (step === 5) {
        await api.post(`/employee/${employeeId}/insurance`, insurance)
        toast.success('Insurance saved')
      }

      // STEP 6 - Screening
      else if (step === 6) {
        await api.post(`/employee/${employeeId}/screeningtest`, screening)
        toast.success('Screening saved')
      }

      // STEP 7 - Experience
      else if (step === 7) {
        const url = `/employee/${employeeId}/experiences`

        for (const exp of experiences) {
          await api.post(url, exp)
        }

        toast.success('Experience saved')
      }

      // STEP 8 - LTC
      else if (step === 8) {
        await api.post(`/employee/${employeeId}/ltc`, ltcData)
        toast.success('LTC saved')
      }

      setStep((prev) => prev + 1)
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Error saving data')
    }
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
        {/* 🔹 Stepper */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => {
                if (index > step) {
                  toast.error('Please complete previous steps first')
                  return
                }
                setStep(index)
              }}
              style={{ cursor: 'pointer' }}
            >
              <CIcon icon={item.icon} className="stepper-icon" />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* 🔹 Steps */}
        {step === 0 && (
          <BasicInfo employeeDetails={employeeDetails} setEmployeeDetails={setEmployeeDetails} />
        )}

        {step === 1 && (
          <Address
            employeeId={employeeId}
            employeeAddress={employeeAddress}
            setEmployeeAddress={setEmployeeAddress}
          />
        )}

        {step === 2 && (
          <OfficeAddress
            employeeId={employeeId}
            employeeAddress={employeeAddress}
            setEmployeeAddress={setEmployeeAddress}
          />
        )}

        {step === 3 && (
          <Qualification
            step={step}
            employeeQualification={employeeQualification}
            setEmployeeQualification={setEmployeeQualification}
          />
        )}

        {step === 4 && (
          <Bank step={step} employeeBank={employeeBank} setEmployeeBank={setEmployeeBank} />
        )}

        {step === 5 && (
          <Insurance
            step={step}
            insurance={insurance}
            setInsurance={setInsurance}
            familyMembers={familyMembers}
            setFamilyMembers={setFamilyMembers}
          />
        )}

        {step === 6 && <Screening step={step} screening={screening} setScreening={setScreening} />}

        {step === 7 && (
          <Experience step={step} experiences={experiences} setExperiences={setExperiences} />
        )}

        {step === 8 && (
          <Ltc step={step} ltcData={ltcData} setLtcData={setLtcData} ltcLocked={ltcLocked} />
        )}

        <Documents
          step={step}
          selectedDocType={selectedDocType}
          setSelectedDocType={setSelectedDocType}
          selectedFile={selectedFile}
          setSelectedFile={setSelectedFile}
          documents={documents}
          setDocuments={setDocuments}
        />

        {/* 🔹 Footer */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          {/* Previous / Finish */}
          
          {async () => {
            // 👉 FINAL STEP (Documents)
            if (step === stepConfig.length - 1) {
              try {
                if (!employeeId) {
                  toast.error('Employee not created yet')
                  return
                }

                if (documents.length === 0) {
                  toast.error('Please upload at least one document')
                  return
                }

                const url = `/employee/${employeeId}/documents`

                for (const doc of documents) {
                  console.log('Uploading:', doc) // 🔍 debug

                  const formData = new FormData()
                  formData.append('file', doc.file) // ✅ important
                  formData.append('type', doc.type) // ✅ backend key

                  await api.post(url, formData)
                }

                toast.success('Documents uploaded successfully')

                // 👉 Redirect
                navigate('/hrm')
              } catch (error) {
                console.error(error)
                toast.error(error.response?.data?.message || 'Failed to upload documents')
              }
            } else {
              // 👉 Previous button behavior
              setStep((prev) => prev - 1)
            }
          }}
          {/* Next */}
          {step !== stepConfig.length - 1 && (
            <button className="btn btn-primary" onClick={handleSubmit}>
              Next
            </button>
          )}
        </div>
      </div>
    </div>
  )
}

export default Add
