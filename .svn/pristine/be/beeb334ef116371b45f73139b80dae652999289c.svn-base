const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const RoleMaster = sequelize.define('RoleMaster', {

    id: {
        type: DataTypes.BIGINT,
        primaryKey: true,
        autoIncrement: true
    },

    role_code: {
        type: DataTypes.STRING(50),
        allowNull: false
    },

    role_name: {
        type: DataTypes.STRING(100),
        allowNull: false
    },

    description: {
        type: DataTypes.TEXT
    },

    is_system_role: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },

    is_super_admin: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },

    role_level: {
        type: DataTypes.INTEGER,
        allowNull: false
    },

    is_active: {
        type: DataTypes.BOOLEAN,
        defaultValue: true
    },
   is_deleted: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },
    organization_id: {
        type: DataTypes.BIGINT,
        allowNull: true,
        references: {
            model: {
                tableName: 'organizations',
                schema: 'pmu'
            },
            key: 'id'
        }
    }

}, {
    tableName: 'roles',
    schema: 'pmu',
    timestamps: true,
    createdAt: 'created_at',
    updatedAt: 'updated_at',

    indexes: [
        {
            unique: true,
            fields: ['role_code', 'organization_id']
        },
        {
            fields: ['organization_id']
        }
    ]
});

RoleMaster.associate = (models) => {

    // Role → Organization
    RoleMaster.belongsTo(models.Organization, {
        foreignKey: 'organization_id'
    });

    // Role → EmployeeRole
    RoleMaster.hasMany(models.EmployeeRole, {
        foreignKey: 'role_id'
    });

    // Role ↔ Employee (Many-to-Many)
    RoleMaster.belongsToMany(models.Employee, {
        through: models.EmployeeRole,
        foreignKey: 'role_id',
        otherKey: 'employee_id'
    });

    RoleMaster.belongsToMany(models.Permission, {
        through: models.RolePermission,
        foreignKey: 'role_id',
        otherKey: 'permission_id'
    });
};

module.exports = RoleMaster;

