----------------------------------------------------------LTC (Leave Travel Concession)---------------------------------------------------------------------------
CREATE TABLE pmu.employee_ltc (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT UNIQUE 
        REFERENCES pmu.employees(id) 
        ON DELETE CASCADE,

    hometown VARCHAR(100),
    state VARCHAR(100),
    district VARCHAR(100),
    nearest_railway VARCHAR(150),
    nearest_airport VARCHAR(150),
    can_update BOOLEAN DEFAULT true,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

Alter TABLE pmu.employees
ADD COLUMN mode_of_working VARCHAR(100);

Alter TABLE pmu.employees
ADD COLUMN state_of_working VARCHAR(100);

Alter TABLE pmu.employees
ADD COLUMN employee_category VARCHAR(100);

Alter TABLE pmu.employees
ADD COLUMN is_gazetted boolean DEFAULT false;

ALTER TABLE pmu.gst_master
ADD COLUMN transaction_type character varying(10) 
    CHECK (transaction_type IN ('INTRA', 'INTER'))
    DEFAULT 'INTRA';
	
ALTER TABLE pmu.empanelment_master
DROP CONSTRAINT empanelment_master_organization_id_fkey;

ALTER TABLE pmu.empanelment_master
RENAME COLUMN organization_id TO company_id;

ALTER TABLE pmu.empanelment_master
ADD CONSTRAINT empanelment_master_company_id_fkey
FOREIGN KEY (company_id)
REFERENCES pmu.company_master(id)
ON UPDATE NO ACTION
ON DELETE CASCADE;

COMMIT;

