BEGIN;
CREATE SCHEMA IF NOT EXISTS pmu;

----------------------------------------------------------------- Organizations ----------------------------------------------------------------- 

CREATE TABLE pmu.organizations (
    id BIGSERIAL PRIMARY KEY,

    org_name VARCHAR(200) NOT NULL,
    org_code VARCHAR(50) UNIQUE NOT NULL,

    contact_email VARCHAR(120),
    contact_phone VARCHAR(30),

    address TEXT,

    is_active BOOLEAN DEFAULT true,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------- Company ----------------------------------------------------------------- 

CREATE TABLE pmu.company_master (
    id BIGSERIAL PRIMARY KEY,
	organization_id BIGINT REFERENCES pmu.organizations(id)	ON DELETE CASCADE,
    company_name VARCHAR(255) NOT NULL,
    company_code VARCHAR(50) UNIQUE,

    company_type VARCHAR(50) CHECK (
        company_type IN (
            'PRIVATE_LIMITED',
            'PUBLIC_LIMITED',
            'LLP',
            'PROPRIETORSHIP',
            'PARTNERSHIP',
            'GOVERNMENT',
            'NGO',
            'OTHER'
        )
    ),

    incorporation_date DATE,
    official_email VARCHAR(150),
    official_phone VARCHAR(30),
    website VARCHAR(150),

    address_line1 TEXT,
    address_line2 TEXT,
    city VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100) DEFAULT 'India',
    pincode VARCHAR(15),

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);





-------------------------------- GST  --------------------------------------------------

CREATE TABLE pmu.gst_master (
    id              BIGSERIAL PRIMARY KEY,
    code_type       CHARACTER VARYING(10) NOT NULL,      
    code            CHARACTER VARYING(10) NOT NULL,      
    description     TEXT NOT NULL,              
    gst_rate        NUMERIC(5,2) DEFAULT 0.00, 
    cgst_rate       NUMERIC(5,2) DEFAULT 0.00,
    sgst_rate       NUMERIC(5,2) DEFAULT 0.00,
    igst_rate       NUMERIC(5,2) DEFAULT 0.00,
    cess_rate       NUMERIC(5,2) DEFAULT 0.00,
	other_rate      NUMERIC(5,2) DEFAULT 0.00,
    effective_from  DATE NOT NULL,
    effective_to    DATE,
    is_active       BOOLEAN DEFAULT TRUE,
    created     	TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      TIMESTAMP WITH TIME ZONE DEFAULT now(),
	UNIQUE (code_type, code),
	
	CONSTRAINT gst_master_effective_date_check
    CHECK (effective_to IS NULL OR effective_to >= effective_from)
);


-------------------------------- EMPANELMENT  --------------------------------------------------

CREATE TABLE pmu.empanelment_master (
    id                  BIGSERIAL PRIMARY KEY,
	organization_id 	BIGINT REFERENCES pmu.organizations(id)	ON DELETE CASCADE,
    category            CHARACTER VARYING(20) NOT NULL,    
    empanelment_no      CHARACTER VARYING(50) NOT NULL,
	amc					NUMERIC(5,2) DEFAULT 0.00,
	agm					NUMERIC(5,2) DEFAULT 0.00,	
	date        		DATE NOT NULL,
	shortcode			CHARACTER VARYING(255) NOT NULL,
	rfe					CHARACTER VARYING(255) NOT NULL,
    effective_from      DATE NOT NULL,
    effective_to        DATE,
	leaves_per_month  	NUMERIC(3,1) NOT NULL CHECK (leaves_per_month >= 0), 
	carry_forward		BOOLEAN DEFAULT FALSE,
	leave_category		CHARACTER VARYING(150) NOT NULL,
	maternity_leaves	BOOLEAN,
	remarks				TEXT,
	doc_path			CHARACTER VARYING(255),
	is_active           BOOLEAN DEFAULT TRUE,
    created     		TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      	TIMESTAMP WITH TIME ZONE DEFAULT now(),
	
	CONSTRAINT empanelment_master_effective_date_check
    CHECK (effective_to IS NULL OR effective_to >= effective_from)
);

CREATE TABLE pmu.emp_ext_mapping (
    id                  BIGSERIAL PRIMARY KEY, 
    empanelment_id_fk   BIGINT REFERENCES pmu.empanelment_master(id) ON DELETE CASCADE NOT NULL,
	ext_date        	DATE,
	doc_path			CHARACTER VARYING(255),
    created     		TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      	TIMESTAMP WITH TIME ZONE DEFAULT now()
);

CREATE TABLE pmu.empanelment_designation (
    id              	BIGSERIAL PRIMARY KEY,
	empanelment_id_fk   BIGINT REFERENCES pmu.empanelment_master(id) ON DELETE CASCADE NOT NULL,
    type            	CHARACTER VARYING(100) NOT NULL,      
    designation     	CHARACTER VARYING(150) NOT NULL,      
    qualification   	TEXT NOT NULL, 
    exp_in_years    	NUMERIC(4,1) NOT NULL, 
    is_active       	BOOLEAN DEFAULT TRUE,
    created     		TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      	TIMESTAMP WITH TIME ZONE DEFAULT now()
);

CREATE TABLE pmu.resource_rate (
    id                          	BIGSERIAL PRIMARY KEY,
    desgn_id_fk                 	BIGINT REFERENCES pmu.empanelment_designation(id) ON DELETE CASCADE NOT NULL,
    unit_rate_incl_agency_margin 	NUMERIC(15,2) NOT NULL,
    agency_margin_percent       	NUMERIC(5,2) DEFAULT 0.00,
    agency_amount               	NUMERIC(15,2) DEFAULT 0.00,
    unit_rate_excl_agency_margin 	NUMERIC(15,2) NOT NULL,
    nicsi_margin_percent        	NUMERIC(5,2) DEFAULT 0.00,
    nicsi_margin_amount         	NUMERIC(15,2) DEFAULT 0.00,
    total_amount                	NUMERIC(15,2) NOT NULL,
    gst_code_fk                		BIGINT REFERENCES pmu.gst_master(id) ON DELETE CASCADE NOT NULL,
    cgst_amount                 	NUMERIC(15,2) DEFAULT 0.00,
    sgst_amount                 	NUMERIC(15,2) DEFAULT 0.00,
    igst_amount                 	NUMERIC(15,2) DEFAULT 0.00,
    total_gst_amount            	NUMERIC(15,2) DEFAULT 0.00,
    final_amount                	NUMERIC(15,2) NOT NULL,
	is_active       				BOOLEAN DEFAULT TRUE,
    created                     	TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at                    	TIMESTAMP WITH TIME ZONE DEFAULT now()
);


-------------------------------- VENDOR  --------------------------------------------------

CREATE TABLE pmu.vendor_master (
    id BIGSERIAL PRIMARY KEY,
	organization_id BIGINT REFERENCES pmu.organizations(id)	ON DELETE CASCADE,
	empanelment_id_fk BIGINT REFERENCES pmu.empanelment_master(id) ON DELETE CASCADE NOT NULL,
    vendor_name VARCHAR(255) NOT NULL,
    vendor_code VARCHAR(50) UNIQUE ,

    vendor_type VARCHAR(50) CHECK (
        vendor_type IN (
            'INDIVIDUAL',
            'PROPRIETORSHIP',
            'PARTNERSHIP',
            'LLP',
            'PRIVATE_LIMITED',
            'PUBLIC_LIMITED',
            'GOVERNMENT',
            'NGO',
            'OTHER'
        )
    ),

    contact_person VARCHAR(150),
    contact_email VARCHAR(150),
    contact_phone VARCHAR(30),

    website VARCHAR(150),

    address_line1 TEXT,
    address_line2 TEXT,
    city VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100) DEFAULT 'India',
    pincode VARCHAR(15),

    bank_name VARCHAR(150),
    account_number VARCHAR(50),
    ifsc_code VARCHAR(20),
    branch_name VARCHAR(150),

    onboarding_date DATE DEFAULT CURRENT_DATE,
    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);





----------------------------------------------------------------- Work Order  --------------------------------------------------------------------------------

CREATE TABLE IF NOT EXISTS pmu.work_order (
    id 					BIGSERIAL PRIMARY KEY,
	empanelment_id_fk   BIGINT REFERENCES pmu.empanelment_master(id) ON DELETE CASCADE NOT NULL,
    work_order_no       CHARACTER VARYING(255) UNIQUE NOT NULL,
    work_order_date     DATE NOT NULL,
    project_no          CHARACTER VARYING(255) NOT NULL,
    pi_number           CHARACTER VARYING(255),
    project_name        CHARACTER VARYING(255) NOT NULL,
	vendor_id_fk      	BIGINT NOT NULL REFERENCES pmu.vendor_master(id) ON DELETE CASCADE,
    issued_to_name      CHARACTER VARYING(255) NOT NULL,
    issued_to_address   TEXT NOT NULL,
    issued_to_contact   CHARACTER VARYING(255) NOT NULL,
    issued_to_phone     CHARACTER VARYING(50) NOT NULL,
    issued_to_email     CHARACTER VARYING(255) NOT NULL,
    contact_name        CHARACTER VARYING(255) NOT NULL,
    contact_number      TEXT NOT NULL,
    contact_email       TEXT NOT NULL,
    total_amt           NUMERIC(15,2) NOT NULL,
    total_cgst_amt      NUMERIC(15,2) NOT NULL,
    total_sgst_amt      NUMERIC(15,2) NOT NULL,
    total_igst_amt      NUMERIC(15,2) NOT NULL,
    grand_total         NUMERIC(15,2) NOT NULL,
	doc_path			CHARACTER VARYING(255),
	remarks				TEXT,
    is_active          	BOOLEAN DEFAULT true,
    created     		TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      	TIMESTAMP WITH TIME ZONE DEFAULT now(),
    created_by          INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS pmu.wo_desgn_mapping (
    id 					BIGSERIAL PRIMARY KEY,
    work_order_id      	BIGINT REFERENCES pmu.work_order(id) ON DELETE CASCADE NOT NULL,
    sac_code           	CHARACTER VARYING(10) NOT NULL,
	desgn_id_fk			BIGINT REFERENCES pmu.empanelment_designation(id) ON DELETE CASCADE NOT NULL,
    description        	TEXT,
    req_person_count   	INTEGER NOT NULL,
    duration_days      	TEXT NOT NULL,
    monthly_unit_rate  	NUMERIC(15,2) NOT NULL,
    deployment_from    	DATE NOT NULL,
    deployment_to      	DATE NOT NULL,
    cgst_amount        	NUMERIC(15,2) NOT NULL,
    sgst_amount        	NUMERIC(15,2) NOT NULL,
    igst_amount        	NUMERIC(15,2) NOT NULL,
    is_active        	BOOLEAN DEFAULT true,
    created     		TIMESTAMP WITH TIME ZONE DEFAULT now(),
    updated_at      	TIMESTAMP WITH TIME ZONE DEFAULT now(),
    created_by         	BIGINT NOT NULL,
	modified_by         BIGINT
);


ALTER TABLE pmu.wo_desgn_mapping
ALTER COLUMN sac_code TYPE BIGINT USING sac_code::BIGINT;

ALTER TABLE pmu.wo_desgn_mapping
ADD CONSTRAINT fk_wo_desgn_gst
FOREIGN KEY (sac_code)
REFERENCES pmu.gst_master(id)
ON DELETE RESTRICT;




----------------------------------------------------------------- Employees  --------------------------------------------------------------------------------

CREATE TABLE pmu.employees (
    id BIGSERIAL PRIMARY KEY,

    -- System IDs
    employee_code VARCHAR(30) UNIQUE NOT NULL,
    attendance_code VARCHAR(20) UNIQUE,

    -- Authentication
    password_hash VARCHAR(255) NOT NULL,

    -- Name (minimal needed for UI + login)
    salutation VARCHAR(10) CHECK (salutation IN ('Mr','Ms','Mrs','Dr')),
    first_name VARCHAR(50) NOT NULL,
    middle_name VARCHAR(50),
    last_name VARCHAR(50) NOT NULL,

    -- Contact for login
    email VARCHAR(120) UNIQUE NOT NULL,
    contact_no VARCHAR(20) NOT NULL,

    -- Employment lifecycle
    date_of_joining DATE NOT NULL,
    probation_end_date DATE,
    confirmation_date DATE,
    date_of_exit DATE,
    notice_period_days INTEGER,

    -- HR workflow status
    account_status VARCHAR(20) CHECK (account_status IN ('PENDING','ACTIVE','REJECTED','EXITED')) DEFAULT 'PENDING', -- PENDING / ACTIVE / REJECTED / EXITED
    hr_verified BOOLEAN DEFAULT false,
    verified_by BIGINT REFERENCES pmu.employees(id),
    verified_at TIMESTAMP,

    -- Flags
    is_active BOOLEAN DEFAULT true,
    is_deleted BOOLEAN DEFAULT false,

    -- Audit
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX idx_emp_email ON pmu.employees(email);
CREATE INDEX idx_emp_contact ON pmu.employees(contact_no);

ALTER TABLE pmu.employees
ADD COLUMN organization_id BIGINT
REFERENCES pmu.organizations(id);

Alter TABLE pmu.employees
ADD COLUMN must_change_password boolean DEFAULT true;
----------------------------------------------------------------- Role Master ----------------------------------------------------------------- 

CREATE TABLE pmu.roles (
    id BIGSERIAL PRIMARY KEY,

    role_code VARCHAR(50) NOT NULL,   
    role_name VARCHAR(100) NOT NULL,
    description TEXT,

    is_system_role BOOLEAN DEFAULT false, -- cannot be deleted
	role_level INT NOT NULL, -- Lower number = higher authority
	is_super_admin BOOLEAN DEFAULT FALSE, -- bypass all permission checks
    is_active BOOLEAN DEFAULT TRUE,
    organization_id BIGINT, -- NULL = global role -- NOT NULL = org-specific role

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	
	UNIQUE (role_code, organization_id)
);

CREATE INDEX idx_roles_org ON pmu.roles(organization_id);
CREATE INDEX idx_roles_org_code ON pmu.roles(organization_id, role_code);

ALTER TABLE pmu.roles
ADD CONSTRAINT fk_roles_organization
FOREIGN KEY (organization_id)
REFERENCES pmu.organizations(id)
ON DELETE CASCADE
ON UPDATE CASCADE;

INSERT INTO pmu.roles (role_code, role_name, is_system_role,is_super_admin, role_level,organization_id) VALUES
('SAAS_ADMIN','System Administrator', true,true, 1, null),
('ORG_ADMIN','Super Administrator', true,false, 2, null),
('HR_ADMIN','HR Administrator', true,false, 3, null),
('MANAGER','Manager', true,false, 4, null),
('EMPLOYEE','Employee', true,false, 5, null);

-----------------------------------------------------------------  Employee Roles ----------------------------------------------------------------- 

CREATE TABLE pmu.employee_roles (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL
        REFERENCES pmu.employees(id)
        ON DELETE CASCADE,

    role_id BIGINT NOT NULL
        REFERENCES pmu.roles(id)
        ON DELETE CASCADE,
		
	organization_id BIGINT
		REFERENCES pmu.organizations(id)
		ON DELETE CASCADE,

    assigned_by BIGINT
        REFERENCES pmu.employees(id),

    assigned_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    UNIQUE (employee_id, role_id)
);

CREATE INDEX idx_emp_roles_emp ON pmu.employee_roles(employee_id);
CREATE INDEX idx_emp_roles_role ON pmu.employee_roles(role_id);


----------------------------------------------------------------- Refresh Token ----------------------------------------------------------------- 

CREATE TABLE pmu.employee_refresh_tokens (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL
        REFERENCES pmu.employees(id)
        ON DELETE CASCADE,

    token_hash CHAR(64) NOT NULL,
    expires_at TIMESTAMP NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    revoked BOOLEAN DEFAULT false
);

CREATE INDEX idx_refresh_emp ON pmu.employee_refresh_tokens(employee_id);



----------------------------------------------------------------- Employee details --------------------------------------------------------------------------------

CREATE TABLE pmu.employee_details (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT UNIQUE
    REFERENCES pmu.employees(id)
    ON DELETE CASCADE,

    -- Personal details
    dob DATE NOT NULL,
    birth_place VARCHAR(100),
    gender VARCHAR(20) CHECK (gender IN ('Male','Female','Other')) NOT NULL,

    marital_status VARCHAR(20)
        CHECK (marital_status IN ('SINGLE','MARRIED','DIVORCED','WIDOWED','SEPARATED')),
    marriage_date DATE,

    father_name VARCHAR(150),
    mother_name VARCHAR(150),

    religion VARCHAR(50),
    nationality VARCHAR(50),

    alternate_email VARCHAR(120),
    emergency_contact_no VARCHAR(20),

    blood_group VARCHAR(10),

    -- 🔐 Sensitive IDs (Encryption-ready pattern)

    pan_enc BYTEA,
    pan_iv BYTEA,
    pan_hash CHAR(64) UNIQUE,

    aadhaar_enc BYTEA,
    aadhaar_iv BYTEA,
    aadhaar_hash CHAR(64) UNIQUE,

    voter_enc BYTEA,
    voter_iv BYTEA,
    voter_hash CHAR(64) UNIQUE,

    passport_enc BYTEA,
    passport_iv BYTEA,
    passport_hash CHAR(64) UNIQUE,

    -- Other statutory numbers (less sensitive)
	
	visa VARCHAR(30),
    pran_number VARCHAR(30),
    esic_number VARCHAR(30),
    mgnrega_number VARCHAR(40),
    epfo_number VARCHAR(30),
    eps_number VARCHAR(30),
	
	-- PF
	uan_number VARCHAR(30),
	pf_number VARCHAR(30),
    pf_joining_date DATE,
    pf_exit_date DATE,

    -- Compliance
    lwf BOOLEAN DEFAULT false,
    professional_tax BOOLEAN DEFAULT false,

    -- Vendor / contract
    vendor_code VARCHAR(30),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

------------------------------------------------------------------------ Employee Bank Details --------------------------------------------------------------------

CREATE TABLE pmu.employee_bank_details (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT UNIQUE REFERENCES pmu.employees(id) ON DELETE CASCADE,

    bank_name VARCHAR(120),
    branch_name VARCHAR(120),
    bank_address TEXT,
    account_number VARCHAR(40),
    ifsc VARCHAR(20),
    micr_code VARCHAR(20),
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-------------------------------------------------------------- Employee family members ----------------------------------------------------------------------------

CREATE TABLE pmu.employee_family_members (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT REFERENCES pmu.employees(id) ON DELETE CASCADE,

    relation VARCHAR(30) CHECK (relation IN ('SPOUSE','CHILD','FATHER','MOTHER','SIBLING')), 

    name VARCHAR(150),
    dob DATE,
    gender VARCHAR(20),
    pan_number VARCHAR(20),
    is_dependent BOOLEAN,
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE pmu.employee_insurances (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT REFERENCES pmu.employees(id) ON DELETE CASCADE,

    insurance_company VARCHAR(150),
    policy_number VARCHAR(100),
    from_date DATE,
    to_date DATE,

    sum_insured NUMERIC(14,2),
    policy_premium NUMERIC(14,2),
    family_members_covered TEXT,
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

---------------------------------------------------------------- Employee Screening Tests -------------------------------------------------------------------------

CREATE TABLE pmu.employee_screening_tests (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT UNIQUE REFERENCES pmu.employees(id) ON DELETE CASCADE,

    test_scheduled_date DATE,
    test_given_date DATE,
    marks_secured NUMERIC(6,2),
    result VARCHAR(10) CHECK (result IN ('PASS','FAIL')),
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-------------------------------------------------------------------- Employee Address ----------------------------------------------------------------------------

CREATE TABLE pmu.employee_addresses (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT REFERENCES pmu.employees(id) ON DELETE CASCADE,

    address_type VARCHAR(30) NOT NULL,  
    -- CORRESPONDENCE / PERMANENT / OFFICE / CLIENT_OFFICE

    address_line1 TEXT NOT NULL,
    address_line2 TEXT,
    landmark TEXT,

    city VARCHAR(100),
    district VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100) DEFAULT 'India',

    pin_code VARCHAR(10),

    is_primary BOOLEAN DEFAULT FALSE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX uniq_emp_addr_type
ON pmu.employee_addresses(employee_id, address_type);

ALTER TABLE pmu.employee_addresses
ADD CONSTRAINT chk_address_type
CHECK (address_type IN (
 'CORRESPONDENCE','PERMANENT','OFFICE','CLIENT_OFFICE'
));

-------------------------------------------------------------------- Employee Qualifications ----------------------------------------------------------------------------
CREATE TABLE pmu.employee_qualifications (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT REFERENCES  pmu.employees(id) ON DELETE CASCADE,

    qualification_type VARCHAR(50),  
    -- DEGREE / CERTIFICATION / DIPLOMA / TRAINING

    qualification_name VARCHAR(200) NOT NULL,
    specialization VARCHAR(150),

    institute_name VARCHAR(200),
    board_university VARCHAR(200),

    year_of_passing INT,
    grade VARCHAR(50),
    percentage NUMERIC(5,2),

    duration_months INT,
    is_highest BOOLEAN DEFAULT FALSE,

    remarks TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_qual_emp ON pmu.employee_qualifications(employee_id);

-------------------------------------------------------------------- Employee Experiences ----------------------------------------------------------------------------

CREATE TABLE pmu.employee_experiences (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT REFERENCES pmu.employees(id) ON DELETE CASCADE,

    company_name VARCHAR(200),
    designation VARCHAR(150),

    start_date DATE,
    end_date DATE,

    total_years NUMERIC(4,1),

    description TEXT,
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_exp_emp ON pmu.employee_experiences(employee_id);

--------------------------------------------------------------------- employee Skill table ------------------------------------------------------------------------

CREATE TABLE pmu.employee_skills (
    id BIGSERIAL PRIMARY KEY,

    -- Relation
    employee_id BIGINT NOT NULL
        REFERENCES pmu.employees(id)
        ON DELETE CASCADE,

    -- Skill details
    skill_name VARCHAR(100) NOT NULL,
    experience_years NUMERIC(4,1) CHECK (experience_years >= 0),
    remarks VARCHAR(255),
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    -- Prevent duplicate skill for same employee
    UNIQUE (employee_id, skill_name)
);

--------------------------------------------------------------------- employee health table ------------------------------------------------------------------------

CREATE TABLE pmu.employee_health (
    id BIGSERIAL PRIMARY KEY,

    -- Relation
    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    -- Physical details
    height_cm NUMERIC(5,2) CHECK (height_cm > 0),
    weight_kg NUMERIC(5,2) CHECK (weight_kg > 0),

    -- Health flags
    has_health_issues BOOLEAN DEFAULT false,
    is_handicapped BOOLEAN DEFAULT false,

    -- Disability details
    physical_disability_category VARCHAR(100),

    -- Remarks
    health_issue_remarks TEXT,
    identification_mark TEXT,
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    -- One health record per employee
    UNIQUE (employee_id)
);

----------------------------------------------------------------- employee vaccination -----------------------------------------------------------------------------

CREATE TABLE pmu.employee_vaccinations (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    vaccination_name VARCHAR(100) NOT NULL,
    vaccination_date DATE,
    vaccination_document VARCHAR(255),
	
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

------------------------------------------------------------------  emp_vehicle -------------------------------------------------------------------------------

CREATE TABLE pmu.employee_vehicles (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    vehicle_details TEXT,
    driving_license_number VARCHAR(30),
    driving_license_issue_date DATE,
    driving_license_expiry_date DATE,
    vehicle_category VARCHAR(30),

    professional_membership_details TEXT,

    emt_registration_expiry_date DATE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

--------------------------------------------------------------------- emp_hobbies --------------------------------------------------------------------------------

CREATE TABLE pmu.employee_hobbies (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    hobby VARCHAR(100),
    remarks TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

------------------------------------------------------------- emp_achievement ---------------------------------------------------------------------------

CREATE TABLE pmu.employee_achievements (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    achievement_date DATE,
    achievement TEXT,
    achievement_remarks TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- emp_assests --------------------------------------------------------------------------------

CREATE TABLE pmu.employee_assets (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    asset_name VARCHAR(150),
    asset_code VARCHAR(50),
    asset_issue_date DATE,
    asset_return_date DATE,

    quantity_issued INTEGER,
    should_be_returned BOOLEAN,

    return_expected_by DATE,
    quantity_returned INTEGER,
    remarks TEXT,
    total_damage_worth NUMERIC(12,2),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

---------------------------------------------------------------- emp_language -----------------------------------------------------------------------------------

CREATE TABLE pmu.employee_languages (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    language_name VARCHAR(50),
    can_read BOOLEAN,
    can_write BOOLEAN,
    can_speak BOOLEAN,
    proficiency TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-------------------------------------------------------------   emp_discipline ---------------------------------------------------------------------------------

CREATE TABLE pmu.employee_discipline (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    offence TEXT,
    offence_date DATE,
    disciplinary_action TEXT,
    remarks TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- emp_passport_visa_details ---------------------------------------------------------------------

CREATE TABLE pmu.employee_passport_visa_details (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,

    passport_number VARCHAR(30),
    passport_issue_date DATE,
    passport_expiry_date DATE,
    passport_place_of_issue VARCHAR(100),
    passport_issuing_country VARCHAR(100),
    passport_type VARCHAR(30),

    visa_issuing_authority VARCHAR(150),
    visa_start_date DATE,
    visa_end_date DATE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- Employee documents  --------------------------------------------------------------------------------

CREATE TABLE pmu.documents (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL
        REFERENCES pmu.employees(id)
        ON DELETE CASCADE,

    doc_type VARCHAR(50) NOT NULL
        CHECK (doc_type IN (
            'PHOTO','RESUME','PAN_FILE','AADHAAR_FILE','VOTER_ID_FILE',
            'QUALIFICATION_CERT','EXPERIENCE_CERT',
            'BIRTH_CERT','DRIVING_LICENSE','WORK_PERMIT',
            'CANCEL_CHEQUE','POLICY_DOCUMENT','SCREENING_MAIL_COPY',
            'SALARY_SLIP','FORM16','POLICE_VERIFICATION',
            'DECLARATION','OTHER_DOC'
        )),

    file_name TEXT,
    file_path TEXT,
    file_size BIGINT,
    mime_type VARCHAR(100),
	
	file_hash CHAR(64),
	is_encrypted BOOLEAN DEFAULT true,

    -- Foreign Keys
    qualification_id BIGINT REFERENCES pmu.employee_qualifications(id) ON DELETE CASCADE,
    experience_id BIGINT REFERENCES pmu.employee_experiences(id) ON DELETE CASCADE,
    bank_details_id BIGINT REFERENCES pmu.employee_bank_details(id) ON DELETE CASCADE,
    screening_test_id BIGINT REFERENCES pmu.employee_screening_tests(id) ON DELETE CASCADE,

    document_verification BOOLEAN DEFAULT false,
    document_verification_date DATE,
    document_verified_by BIGINT REFERENCES pmu.employees(id),

    remarks TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	is_deleted BOOLEAN DEFAULT false,

    CONSTRAINT chk_qualification_doc
        CHECK (
            (doc_type = 'QUALIFICATION_CERT' AND qualification_id IS NOT NULL)
            OR doc_type <> 'QUALIFICATION_CERT'
        ),

    CONSTRAINT chk_experience_doc
        CHECK (
            (doc_type = 'EXPERIENCE_CERT' AND experience_id IS NOT NULL)
            OR doc_type <> 'EXPERIENCE_CERT'
        )
);

----------------------------------------------------------------- Employee Designation -----------------------------------------------------------------------------

CREATE TABLE pmu.designations (
    id BIGSERIAL PRIMARY KEY,
    organization_id BIGINT NOT NULL REFERENCES pmu.organizations(id) ON DELETE CASCADE,
    designation_name VARCHAR(150) NOT NULL,
    designation_code VARCHAR(50),
    level INTEGER,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (organization_id, designation_name)
);

Alter TABLE pmu.designations
ADD COLUMN is_deleted boolean DEFAULT false;

CREATE TABLE pmu.employee_designations (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,
    designation_id BIGINT NOT NULL REFERENCES pmu.designations(id) ON DELETE CASCADE,
    effective_from DATE NOT NULL,
    effective_to DATE,
    is_current BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- Employee Division --------------------------------------------------------------------------------

CREATE TABLE pmu.divisions (
    id BIGSERIAL PRIMARY KEY,
    organization_id BIGINT NOT NULL REFERENCES pmu.organizations(id) ON DELETE CASCADE,
    division_name VARCHAR(150) NOT NULL,
    division_code VARCHAR(50),
    parent_division_id BIGINT REFERENCES pmu.divisions(id),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (organization_id, parent_division_id, division_name)
);

Alter TABLE pmu.divisions
ADD COLUMN is_deleted boolean DEFAULT false;

CREATE TABLE pmu.employee_divisions (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,
    division_id BIGINT NOT NULL REFERENCES pmu.divisions(id) ON DELETE CASCADE,
    effective_from DATE NOT NULL,
    effective_to DATE,
    is_current BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- Employee Examination -----------------------------------------------------------------------------
CREATE TABLE pmu.examinations (
    id BIGSERIAL PRIMARY KEY,
    organization_id BIGINT NOT NULL REFERENCES pmu.organizations(id) ON DELETE CASCADE,
    exam_name VARCHAR(200) NOT NULL,
    exam_type VARCHAR(100),
    passing_marks INTEGER,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (organization_id, exam_name)
);

Alter TABLE pmu.examinations
ADD COLUMN is_deleted boolean DEFAULT false;

CREATE TABLE pmu.employee_examinations (
    id BIGSERIAL PRIMARY KEY,
    employee_id BIGINT NOT NULL REFERENCES pmu.employees(id) ON DELETE CASCADE,
    examination_id BIGINT NOT NULL REFERENCES pmu.examinations(id) ON DELETE CASCADE,
    exam_date DATE,
    marks_obtained INTEGER,
    result_status VARCHAR(50), -- PASS / FAIL
    certificate_number VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

----------------------------------------------------------------- Employee Training --------------------------------------------------------------------------------
CREATE TABLE pmu.employee_trainings (
    id BIGSERIAL PRIMARY KEY,

    employee_id BIGINT NOT NULL,

    training_name VARCHAR(255) NOT NULL,
    training_provider VARCHAR(255),

    training_start_date DATE,
    training_end_date DATE,

    certificate_file VARCHAR(500),

    training_type VARCHAR(20) NOT NULL DEFAULT 'SELF'
        CHECK (training_type IN ('SELF', 'COMPANY')),

    description TEXT,

    created_by BIGINT NOT NULL,
    updated_by BIGINT,

    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_employee_trainings_employee
        FOREIGN KEY (employee_id)
        REFERENCES pmu.employees(id)
        ON DELETE CASCADE
);


------------------------------------------Employee Work Order Deployment --------------------------

CREATE TABLE employee_work_order_deployment (
    id BIGSERIAL PRIMARY KEY,

    wo_desgn_id BIGINT NOT NULL REFERENCES pmu.work_order_desgn(id) ON DELETE CASCADE,
    employee_id BIGINT NOT NULL REFERENCES employee(id) ON DELETE RESTRICT,

    joining_date DATE NOT NULL,
    relieving_date DATE,

    is_deleted BOOLEAN DEFAULT FALSE,

    created_by BIGINT NOT NULL,
    updated_by BIGINT,

    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,


);





------------------------------------------------------------------------------------------------ module-level permission ------------------------------------------------------------------------------------------------

CREATE TABLE pmu.modules (
    id BIGSERIAL PRIMARY KEY,
    module_name VARCHAR(100) NOT NULL,
    module_code VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE pmu.permissions (
    id BIGSERIAL PRIMARY KEY,
    module_id BIGINT REFERENCES pmu.modules(id) ON DELETE CASCADE,
    action VARCHAR(50) NOT NULL,
    permission_key VARCHAR(150) UNIQUE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE pmu.role_permissions (
    id BIGSERIAL PRIMARY KEY,
    role_id BIGINT REFERENCES pmu.roles(id) ON DELETE CASCADE,
    permission_id BIGINT REFERENCES pmu.permissions(id) ON DELETE CASCADE,
    organization_id BIGINT,
    UNIQUE (role_id, permission_id, organization_id)
);

