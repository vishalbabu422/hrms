CREATE INDEX ON pmu.resource_rate (desgn_id_fk);
CREATE INDEX ON pmu.work_order (empanelment_id_fk);
CREATE INDEX ON pmu.wo_desgn_mapping (work_order_id);

CREATE INDEX idx_doc_emp_active ON pmu.documents(employee_id) WHERE is_deleted = false;
CREATE INDEX idx_doc_type ON pmu.documents(doc_type);

CREATE INDEX idx_skill_emp ON pmu.employee_skills(employee_id);
CREATE INDEX idx_assets_emp ON pmu.employee_assets(employee_id);
