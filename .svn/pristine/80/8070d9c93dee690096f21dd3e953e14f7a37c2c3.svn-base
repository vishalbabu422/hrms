CREATE INDEX idx_lang_emp ON pmu.employee_languages(employee_id);
CREATE INDEX idx_vendor_name ON pmu.vendor_master(vendor_name);



-----------------------TRIGGERS--------------------------

CREATE OR REPLACE FUNCTION pmu.set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_emp_upd
BEFORE UPDATE ON pmu.employees
FOR EACH ROW EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_emp_details_upd
BEFORE UPDATE ON pmu.employee_details
FOR EACH ROW EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_gst_master_modified
BEFORE UPDATE ON pmu.gst_master
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_empanelment_master_modified
BEFORE UPDATE ON pmu.empanelment_master
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_emp_ext_mapping_modified
BEFORE UPDATE ON pmu.emp_ext_mapping
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_empanelment_designation_modified
BEFORE UPDATE ON pmu.empanelment_designation
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_resource_rate_modified
BEFORE UPDATE ON pmu.resource_rate
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_work_order_modified
BEFORE UPDATE ON pmu.work_order
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_wo_desgn_mapping_modified
BEFORE UPDATE ON pmu.wo_desgn_mapping
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_company_master_upd
BEFORE UPDATE ON pmu.company_master
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_vendor_master_upd
BEFORE UPDATE ON pmu.vendor_master
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

CREATE TRIGGER trg_employee_trainings_updated_at
BEFORE UPDATE ON employee_trainings
FOR EACH ROW
EXECUTE FUNCTION pmu.set_updated_at();

