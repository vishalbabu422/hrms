import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import {
  CContainer,
  CCard,
  CCardBody,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CSpinner,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilCheckCircle, cilXCircle, cilDescription } from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import api from '../../api/axios'

import SortableHeaderCell from '../components/sort-table-header'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'
import PageHeader from '../components/form-header'
import ActionButton from '../components/action-button'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')
  const [workOrder, setWorkOrder] = useState([])
  const [loading, setLoading] = useState(false)

  /* ================= FETCH ================= */

  const fetchWorkOrder = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/workorder/index', { params })

      setWorkOrder(response.data?.data?.workOrderList || [])
      setTotalPages(response.data?.totalPages || 1)
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch Work Order')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchWorkOrder()
    }
  }, [search, sort, page])

  /* ================= SORT ================= */

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Work Order?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/workorder/delete/${id}`)
      toast.success('Work Order deleted successfully')
      fetchWorkOrder()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Delete failed')
    }
  }

  /* ================= UI ================= */

  return (
    <CContainer fluid className="py-4">
      {/* ================= PAGE HEADER ================= */}

      <PageHeader
        title="Work Order"
        searchValue={search}
        onSearchChange={setSearch}
        onAddClick={() => navigate('/workorder/add')}
        addLabel="Add Work Order"
      />

      {/* ================= TABLE CARD ================= */}
      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <SimpleBar>
            <CTable hover responsive align="middle" className="rounded overflow-hidden">
              <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
                <SortableHeaderCell
                  label="Work Order No"
                  sortKey="work_order_no"
                  sort={sort}
                  onSort={handleSort}
                />
                <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} />
                <SortableHeaderCell
                  label="Project No"
                  sortKey="project_no"
                  sort={sort}
                  onSort={handleSort}
                />
                <SortableHeaderCell label="PI No" sortKey="pi_no" sort={sort} onSort={handleSort} />
                <SortableHeaderCell
                  label="Project Name"
                  sortKey="project_name"
                  sort={sort}
                  onSort={handleSort}
                />
                <SortableHeaderCell
                  label="Status"
                  sortKey="is_active"
                  sort={sort}
                  onSort={handleSort}
                />
                <CTableHeaderCell className="text-center">Action</CTableHeaderCell>
              </CTableHead>

              <CTableBody>
                {loading ? (
                  <CTableRow>
                    <CTableDataCell colSpan={7} className="text-center py-4">
                      <CSpinner size="sm" />
                    </CTableDataCell>
                  </CTableRow>
                ) : workOrder.length > 0 ? (
                  workOrder.map((item) => (
                    <CTableRow key={item.id}>
                      <CTableDataCell>{item.work_order_no}</CTableDataCell>
                      <CTableDataCell>{item.date}</CTableDataCell>
                      <CTableDataCell>{item.project_no}</CTableDataCell>
                      <CTableDataCell>{item.pi_no}</CTableDataCell>
                      <CTableDataCell>{item.project_name}</CTableDataCell>
                      <CTableDataCell>
                        {item.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      <CTableDataCell>
                        <div className="d-flex justify-content-center gap-2">
                          <CTooltip content="Preview">
                            <div>
                              <ActionButton
                                color="primary"
                                icon={cilDescription}
                                onClick={() => navigate(`/workorder/preview/${item.id}`)}
                              />
                            </div>
                          </CTooltip>

                          <CTooltip content="Edit">
                            <div>
                              <ActionButton
                                color="primary"
                                icon={cilPencil}
                                onClick={() => navigate(`/workorder/edit/${item.id}`)}
                              />
                            </div>
                          </CTooltip>

                          {item.is_active && (
                            <CTooltip content="Delete">
                              <div>
                                <ActionButton
                                  color="danger"
                                  icon={cilTrash}
                                  onClick={() => confirmDelete(item.id)}
                                />
                              </div>
                            </CTooltip>
                          )}
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))
                ) : (
                  <TableEmptyState colSpan={7} />
                )}
              </CTableBody>
            </CTable>
          </SimpleBar>
          <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index

/* ================= ACTION BUTTON ================= */
