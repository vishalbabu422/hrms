.employee-highlight {
  animation: employeeFlash 1.5s ease;
}

@keyframes employeeFlash {

  0% {
    color: #4338ca;
    transform: scale(1.02);
  }

  50% {
    color: #2563eb;
    transform: scale(1.05);
  }

  100% {
    color: #111827;
    transform: scale(1);
  }
}

.table-highlight {
  animation: tableGlow 1.5s ease;
}

@keyframes tableGlow {

  0% {
    box-shadow:
      0 0 0 rgba(59, 130, 246, 0);
  }

  50% {
    box-shadow:
      0 0 25px rgba(59, 130, 246, 0.25);
  }

  100% {
    box-shadow: none;
  }
}


/* ================= PROJECTED MONTHS HEADER ================= */

.projected-header {
  color: #9ca3af !important;
  font-style: italic !important;
  font-weight: 600 !important;
}

/* ================= PROJECTED FUTURE CELLS ================= */

.projected-cell {
  background: #eef0f3 !important;
}

.projected-cell .financial-amount {
  color: #94a3b8 !important;
  font-style: italic !important;
  font-size: 14px !important;
  font-weight: 400 !important;
}
/* ================= NORMAL AMOUNTS ================= */

.financial-amount {
  font-size: 14px;
  font-weight: 500;
  color: #64748b;
  display: inline-block;
  width: 100%;
  text-align: center;
  line-height: 1.4;
}
/* ================= NET SALARY ================= */

.net-salary-cell .financial-amount {
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
}

/* ================= TOTAL COLUMN ================= */

.total-column {
  background: #eef2ff !important;
  color: #4338ca !important;
  font-weight: 700;
}


.total-value {
  font-size: 14px;
  font-weight: 600;
  color: #111827;
  display: inline-block;
  width: 100%;
  text-align: center;
}

/* ================= HOVER ================= */

.financial-table td:hover {
  background: #f9fafb;
  transition: 0.2s ease;
}
/* ================= EMPLOYEE NAME HIGHLIGHT ================= */

.employee-highlight {
  animation: employeeFlash 1.5s ease;
}

@keyframes employeeFlash {

  0% {
    color: #4338ca;
    transform: scale(1.02);
  }

  50% {
    color: #2563eb;
    transform: scale(1.05);
  }

  100% {
    color: #111827;
    transform: scale(1);
  }
}

/* ================= TABLE GLOW ================= */

.table-highlight {
  animation: tableGlow 1.5s ease;
}

@keyframes tableGlow {

  0% {
    box-shadow:
      0 0 0 rgba(59, 130, 246, 0);
  }

  50% {
    box-shadow:
      0 0 25px rgba(59, 130, 246, 0.25);
  }

  100% {
    box-shadow: none;
  }
}

/* ================= TABLE UX ================= */

.financial-table {

  border-radius: 16px;

  overflow: hidden;

  border: 1px solid #edf1f5;

  transition: all 0.3s ease;
}

/* ================= HOVER EFFECT ================= */

.financial-table td:hover {

  background: #f9fafb;

  transition: 0.2s ease;
}

/* ================= HEADER STYLING ================= */

.financial-table thead th {

  position: sticky;

  top: 0;

  z-index: 1;
}

/* ================= NET PAY ROW ================= */

.net-pay-row {

  background: #f5f7ff !important;

  font-weight: 700;
}

/* ================= TOTAL COLUMN ================= */

.total-column {

  background: #eef2ff !important;

  color: #4338ca !important;

  font-weight: 700;
}

/* ================= SMOOTH CELL TRANSITION ================= */

.financial-table td,
.financial-table th {

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.2s ease;
}