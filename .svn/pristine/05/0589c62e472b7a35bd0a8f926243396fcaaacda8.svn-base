import React, { useState } from 'react'
import { toast } from 'react-toastify'
import CIcon from '@coreui/icons-react'
import BasicInfo from './modules/basic-info'
import Address from './modules/address'
import OfficeAddress from './modules/office-address'
import Qualification from './modules/qualification'
import Bank from './modules/bank'
import Insurance from './modules/insurance'
import Screening from './modules/screening'
import Experience from './modules/experience'
import Ltc from './modules/ltc'
import Documents from './modules/document'

import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilPeople,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
  cilBuilding,
  cilMap,
  cilChart,
} from '@coreui/icons'
import api from '../../api/axios'

const Add = () => {
  const [step, setStep] = useState(0)
  const [employeeId, setEmployeeId] = useState(null)
  const [profileImage, setProfileImage] = useState(null)
  const [cancelledCheque, setCancelledCheque] = useState(null)
  const [screeningMail, setScreeningMail] = useState(null)
  const [policyDocument, setPolicyDocument] = useState(null)
  const [selectedDocType, setSelectedDocType] = useState('')
  const [documents, setDocuments] = useState([])
  const [selectedFile, setSelectedFile] = useState(null)

  const stepConfig = [
    { label: 'Basic Information', icon: cilUser, url: '/employee' },
    { label: 'Address', icon: cilLocationPin, url: '/employee/{employeeId}/address' },
    { label: 'Office Address', icon: cilBuilding, url: '/employee/{employeeId}/address' },
    { label: 'Qualification', icon: cilEducation, url: '/employee/{employeeId}/qualification' },
    { label: 'Bank Details', icon: cilBank, url: '/employee/{employeeId}/bankId' },
    { label: 'Insurance', icon: cilShieldAlt, url: `/employee/${employeeId}/insurance` },
    { label: 'Screening Test', icon: cilClipboard },
    { label: 'Experience', icon: cilBriefcase },
    { label: 'LTC', icon: cilMap },
    { label: 'Documents', icon: cilFile },
  ]
  const initialBasicDetails = {
    employee_code: '',
    attendance_code: '',
    password_hash: '',
    salutation: '',
    first_name: '',
    middle_name: '',
    last_name: '',
    email: '',
    contact_no: '',
    date_of_joining: null,
    probation_end_date: null,
    confirmation_date: null,
    resignation_date: null,
    notice_period_days: null,
    employee_type: '',
    designation: '',
    division: '',
    mode_of_working: '',
    state_of_working: '',
    employee_category: '',
    date_of_birth: '',
    fathersName: '',
    mothersName: '',
    maritalStatus: '',
    gender: '',
    relieving_date: '',
    gazetted: false,
  }

  const initialDesignation = {
    designation_id: '',
    effective_from: new Date().toISOString().split('T')[0],
  }

  const initialDivision = {
    division_id: '',
    effective_from: new Date().toISOString().split('T')[0],
  }

  const [employeeDetails, setEmployeeDetails] = useState(initialBasicDetails)
  const [employeeDesignation, setEmployeeDesignation] = useState(initialDesignation)
  const [employeeDivision, setEmployeeDivision] = useState(initialDivision)

  const createAddress = (type, isPrimary = false) => ({
    address_type: type,
    address: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: '',
    pin_code: '',
    is_primary: isPrimary,
  })

  const initialAddressDetails = {
    correspondence: createAddress('CORRESPONDENCE', true),
    permanent: createAddress('PERMANENT'),
    office: createAddress('OFFICE'),
    client_office: createAddress('CLIENT_OFFICE'),
  }

  const emptyAddress = {
    address_line1: '',
    address_line2: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
  }

  const [employeeAddress, setEmployeeAddress] = useState(initialAddressDetails)

  const [employeeQualification, setEmployeeQualification] = useState([
    {
      qualification_type: '',
      qualification_name: '',
      specialization: '',
      institute_name: '',
      board_university: '',
      year_of_passing: '',
      grade: '',
      percentage: '',
      document: null,
    },
  ])

  // Experience //

  const [experiences, setExperiences] = useState([
    {
      company_name: '',
      designation: '',
      start_date: '',
      end_date: '',
      total_years: '',
      description: '',
      document: null,
    },
  ])
  // Bank //

  const [employeeBank, setEmployeeBank] = useState({
    bank_name: '',
    branch_name: '',
    bank_address: '',
    account_number: '',
    ifsc: '',
    micr_code: '',
    cancelled_cheque: null,
  })

  // FAMILY MEMBERS STATE
  const [familyMembers, setFamilyMembers] = useState([
    {
      relation: '',
      name: '',
      dob: '',
      gender: '',
      pan_number: '',
      is_dependent: false,
    },
  ])

  // INSURANCE STATE
  const [insurance, setInsurance] = useState({
    insurance_company: '',
    policy_number: '',
    from_date: '',
    to_date: '',
    sum_insured: '',
    policy_premium: '',
    family_members_covered: '',
    policy_document: null,
  })

  // Screening Test//

  const [screening, setScreening] = useState({
    test_scheduled_date: '',
    test_given_date: '',
    marks_secured: '',
    result: '',
    screening_mail: null,
  })

  const handleLtcChange = (e) => {
    const { name, value } = e.target

    setLtcData((prev) => ({
      ...prev,
      [name]: value,
    }))
  }

  // const handleFamilyChange = (index, field, value) => {
  //   const updated = [...familyMembers]
  //   updated[index][field] = value
  //   setFamilyMembers(updated)
  // }

  // const addFamilyMember = () => {
  //   setFamilyMembers([
  //     ...familyMembers,
  //     {
  //       relation: '',
  //       name: '',
  //       dob: '',
  //       gender: '',
  //       pan_number: '',
  //       is_dependent: false,
  //     },
  //   ])
  // }

  // const removeFamilyMember = (index) => {
  //   setFamilyMembers(familyMembers.filter((_, i) => i !== index))
  // }

  // const handleFileSelect = (file) => {
  //   if (!file) return
  //   setSelectedFile(file)
  // }

  // const handleDrop = (e) => {
  //   e.preventDefault()
  //   const file = e.dataTransfer.files[0]
  //   if (file) setSelectedFile(file)
  // }

  // const handleDragOver = (e) => {
  //   e.preventDefault()
  // }

  // const handleAddDocument = () => {
  //   if (!selectedDocType || !selectedFile) {
  //     alert('Please select document type and file.')
  //     return
  //   }

  //   setDocuments((prev) => [
  //     ...prev,
  //     {
  //       type: selectedDocType,
  //       file: selectedFile,
  //     },
  //   ])

  //   // Reset
  //   setSelectedFile(null)
  //   setSelectedDocType('')

  //   const input = document.getElementById('hiddenFileInput')
  //   if (input) input.value = ''
  // }

  // const handleRemoveDocument = (indexToRemove) => {
  //   setDocuments((prev) => prev.filter((_, index) => index !== indexToRemove))

  //   const input = document.getElementById('hiddenFileInput')
  //   if (input) input.value = ''
  // }

  // LTC

  const [ltcData, setLtcData] = useState({
    hometown: '',
    district: '',
    state: '',
    nearest_railway: '',
    nearest_airport: '',
  })

  const [ltcLocked, setLtcLocked] = useState(false)

  const handleSubmit = async () => {
    try {
      if (step === 0) {
        const response = await api.post('/employee', employeeDetails)

        const id = response.data?.data?.id || response.data?.id
        setEmployeeId(id)

        toast.success('Basic info saved')

        const today = new Date().toISOString().split('T')[0]

        if (employeeDetails.designation) {
          await api.post(`/employee/${id}/designations`, {
            designation_id: employeeDetails.designation,
            effective_from: today,
          })
        }

       if (employeeDetails.division) {
         await api.post(`/employee/${id}/divisions`, {
           division_id: employeeDetails.division,
            effective_from: today,
          })
        }

        setStep((prev) => prev + 1)
      }

      // STEP 1 - Correspondence + Permanent Address
      else if (step === 1) {
        const url = `/employee/${employeeId}/address`

        const addresses = [employeeAddress.correspondence, employeeAddress.permanent]

        for (const addr of addresses) {
          const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

          if (isEmpty) continue

          await api.post(url, addr)
        }

        toast.success('Addresses saved')
      }

      // STEP 2 - Office + Client Office Address
      else if (step === 2) {
        const url = `/employee/${employeeId}/address`

        const addresses = [employeeAddress.office, employeeAddress.client_office]

        for (const addr of addresses) {
          const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

          if (isEmpty) continue

          await api.post(url, addr)
        }

        toast.success('Office Addresses saved')
      }

      // STEP 3 - Qualification
      else if (step === 3) {
        const url = `/employee/${employeeId}/qualification`

        for (const qual of employeeQualification) {
          const isEmpty = !qual.qualification_name

          if (isEmpty) continue

          await api.post(url, qual)
        }

        toast.success('Qualification saved')
      }

      // STEP 4 - Bank
      else if (step === 4) {
        const url = `/employee/${employeeId}/bankId`

        if (!employeeBank.bank_name || !employeeBank.account_number) {
          toast.error('Bank name and account number are required')
          return
        }

        await api.post(url, employeeBank)

        toast.success('Bank details saved')
      }

      // STEP 5 - Insurance
      else if (step === 5) {
        const url = `/employee/${employeeId}/insurance`

        await api.post(url, insurance)

        toast.success('Insurance details saved')
      }

      // STEP 6 - Screening
      else if (step === 6) {
        const url = `/employee/${employeeId}/screeningtest`

        await api.post(url, screening)

        toast.success('Screening test saved')
      }

      // STEP 7 - Experience
      else if (step === 7) {
        const url = `/employee/${employeeId}/experiences`

        for (const exp of experiences) {
          const isEmpty = !exp.company_name
          if (isEmpty) continue

          await api.post(url, exp)
        }

        toast.success('Experience saved')
      }

      // STEP 8 - LTC
      else if (step === 8) {
        const url = `/employee/${employeeId}/ltc`

        await api.post(url, ltcData)

        setLtcLocked(true)

        toast.success('LTC details saved')

        // STEP 9 - Document
      } else if (step === 9) {
        const url = `/employee/${employeeId}/documents`

        for (const doc of documents) {
          await api.post(url, doc)
        }

        toast.success('Documents uploaded')
      }

      setStep((prev) => prev + 1)
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to submit step')
    }
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
        {/* 🔹 UNDERLINE STEPPER */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => setStep(index)}
            >
              <CIcon icon={item.icon} className="stepper-icon" />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* 🔹 STEP 1 */}
        {step === 0 && (
          <BasicInfo employeeDetails={employeeDetails} setEmployeeDetails={setEmployeeDetails} />
        )}

        {/* STEP 1 */}

        {step === 1 && (
          <Address
            employeeId={employeeId}
            employeeAddress={employeeAddress}
            setEmployeeAddress={setEmployeeAddress}
          />
        )}

        {/* 🔹 Office address */}

        {/* STEP 2 */}
        {step === 2 && (
          <OfficeAddress
            employeeId={employeeId}
            employeeAddress={employeeAddress}
            setEmployeeAddress={setEmployeeAddress}
          />
        )}

        {/* 🔹 Qualification */}

        {step === 3 && (
          <Qualification
            step={step}
            employeeQualification={employeeQualification}
            setEmployeeQualification={setEmployeeQualification}
          />
        )}

        {step === 4 && (
          <Bank step={step} employeeBank={employeeBank} setEmployeeBank={setEmployeeBank} />
        )}

        {step === 5 && (
          <Insurance
            step={step}
            insurance={insurance}
            setInsurance={setInsurance}
            familyMembers={familyMembers}
            setFamilyMembers={setFamilyMembers}
          />
        )}

        {step === 6 && <Screening step={step} screening={screening} setScreening={setScreening} />}

        {step === 7 && (
          <Experience step={step} experiences={experiences} setExperiences={setExperiences} />
        )}

        {step === 8 && (
          <Ltc step={step} ltcData={ltcData} setLtcData={setLtcData} ltcLocked={ltcLocked} />
        )}

        <Documents
          step={step}
          selectedDocType={selectedDocType}
          setSelectedDocType={setSelectedDocType}
          selectedFile={selectedFile}
          setSelectedFile={setSelectedFile}
          documents={documents}
          setDocuments={setDocuments}
        />

        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>
          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => handleSubmit(step)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
