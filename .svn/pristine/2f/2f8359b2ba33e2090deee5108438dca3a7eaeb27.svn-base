import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import {
  CContainer,
  CCard,
  CCardBody,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CSpinner,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import {
  cilPencil,
  cilTrash,
  cilCheckCircle,
  cilXCircle,
  cilDescription,
} from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

import SortableHeaderCell from '../components/sort-table-header'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'
import PageHeader from '../components/form-header'
import ActionButton from '../components/action-button'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [page, setPage] = useState(1)
  const [totalPages, setTotalPages] = useState(1)
  const [search, setSearch] = useState('')
  const [division, setDivision] = useState([])
  const [loading, setLoading] = useState(false)

  /* ================= FETCH ================= */

  const fetchDivision = () => {
    setLoading(true)

    let storedData =
      JSON.parse(localStorage.getItem('divisions')) || []

    // Search (minimum 3 characters)
    if (search.length >= 3) {
      storedData = storedData.filter(
        (item) =>
          item.division_name?.toLowerCase().includes(search.toLowerCase()) ||
          item.division_code?.toLowerCase().includes(search.toLowerCase())
      )
    }

    // Sorting
    storedData.sort((a, b) => {
      const valueA = a[sort.key] ?? ''
      const valueB = b[sort.key] ?? ''

      if (sort.order === 'asc') {
        return valueA > valueB ? 1 : -1
      } else {
        return valueA < valueB ? 1 : -1
      }
    })

    setDivision(storedData)
    setTotalPages(1)
    setLoading(false)
  }

  useEffect(() => {
    fetchDivision()
  }, [search, sort])

  /* ================= SORT ================= */

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= GET PARENT NAME ================= */

  const getParentName = (parentId) => {
    if (!parentId) return '-'

    const allDivisions =
      JSON.parse(localStorage.getItem('divisions')) || []

    const parent = allDivisions.find((d) => d.id === parentId)
    return parent ? parent.division_name : '-'
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Division?')) return

    const storedData =
      JSON.parse(localStorage.getItem('divisions')) || []

    const filtered = storedData.filter((item) => item.id !== id)

    localStorage.setItem('divisions', JSON.stringify(filtered))

    toast.success('Division deleted successfully')
    fetchDivision()
  }

  /* ================= EXPORT PDF ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 20

    doc.setFontSize(16)
    doc.text('Division List', 10, 10)

    doc.setFontSize(11)

    division.forEach((item, index) => {
      doc.text(
        `${index + 1}. ${item.division_name} (${item.division_code || '-'}) | Parent: ${getParentName(
          item.parent_division
        )} | ${item.is_active ? 'Active' : 'Inactive'}`,
        10,
        y
      )
      y += 8
    })

    doc.save('division-list.pdf')
  }

  /* ================= EXPORT EXCEL ================= */

  const handleExportExcel = () => {
    const formattedData = division.map((item, index) => ({
      'Sr No': index + 1,
      'Division Name': item.division_name,
      'Division Code': item.division_code || '-',
      'Parent Division': getParentName(item.parent_division),
      Status: item.is_active ? 'Active' : 'Inactive',
    }))

    const worksheet = XLSX.utils.json_to_sheet(formattedData)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Divisions')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type:
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'division-list.xlsx')
  }

  return (
    <CContainer fluid className="py-4">
      <PageHeader
        title="Division"
        onSearchChange={setSearch}
        onAddClick={() => navigate('/division/add')}
        addLabel="Add Division"
        onExportPDF={handleExportPDF}
        onExportExcel={handleExportExcel}
        showExport
      />

      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <SimpleBar autoHide>
            <CTable hover responsive align="middle">
              <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
                <CTableRow>
                  <SortableHeaderCell
                    label="Division Name"
                    sortKey="division_name"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Division Code"
                    sortKey="division_code"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Parent Division"
                    sortKey="parent_division"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Status"
                    sortKey="is_active"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <CTableHeaderCell className="text-center">
                    Action
                  </CTableHeaderCell>
                </CTableRow>
              </CTableHead>

              <CTableBody>
                {loading ? (
                  <CTableRow>
                    <CTableDataCell colSpan={5} className="text-center py-4">
                      <CSpinner size="sm" />
                    </CTableDataCell>
                  </CTableRow>
                ) : division.length > 0 ? (
                  division.map((item) => (
                    <CTableRow key={item.id}>
                      <CTableDataCell>
                        {item.division_name}
                      </CTableDataCell>

                      <CTableDataCell>
                        {item.division_code || '-'}
                      </CTableDataCell>

                      <CTableDataCell>
                        {getParentName(item.parent_division)}
                      </CTableDataCell>

                      <CTableDataCell>
                        {item.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      <CTableDataCell>
                        <div className="d-flex justify-content-center gap-2">
                          <ActionButton
                            color="primary"
                            icon={cilDescription}
                            onClick={() =>
                              navigate(`/division/preview/${item.id}`)
                            }
                          />
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() =>
                              navigate(`/division/edit/${item.id}`)
                            }
                          />
                          <ActionButton
                            color="danger"
                            icon={cilTrash}
                            onClick={() => confirmDelete(item.id)}
                          />
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))
                ) : (
                  <TableEmptyState colSpan={5} />
                )}
              </CTableBody>
            </CTable>
          </SimpleBar>

          <AppPagination
            page={page}
            totalPages={totalPages}
            onPageChange={setPage}
          />
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index