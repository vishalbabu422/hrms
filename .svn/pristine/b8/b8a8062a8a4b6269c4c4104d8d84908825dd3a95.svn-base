import React, { useEffect, useState } from 'react'
import {
  CModal,
  CModalHeader,
  CModalTitle,
  CModalBody,
  CButton,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CSpinner,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash } from '@coreui/icons'
import api from '../../api/axios'
import TableEmptyState from './table-empty'

const DeploymentTableModal = ({
  visible,
  tableVisible,
  setTableVisible,
  deployment,
  onEdit,
  onSuccess,
}) => {
  const [employees, setEmployees] = useState([])
  const [loading, setLoading] = useState(false)

  const fetchEmployeeTableList = async () => {
    try {
      setLoading(true)
      if (deployment != null) {
        const response = await api.get(
          `/employee?models=EmployeeWorkOrderDeployment&modelFilter=%7B%0A%20%20%22EmployeeWorkOrderDeployment%22%3A%20%7B%0A%20%20%20%20%22wo_desgn_id%22%3A%20${deployment}%2C%20%22is_deleted%22%3Afalse%0A%0A%20%20%7D%0A%7D`,
        )

        if (response.data?.data.length === 0) setTableVisible(false)

        setEmployees(response.data?.data)
      }
    } catch (error) {
      console.error('Failed to fetch deployment:', error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchEmployeeTableList()
  }, [deployment, tableVisible, visible])

  const deleteHandle = async (deploymentId) => {
    try {
      const confirmDelete = window.confirm('Are you sure you want to remove this deployment?')

      if (!confirmDelete) return

      await api.delete(`/admin/workorder-desgn/deployment/${deploymentId}`)

      fetchEmployeeTableList() // Refresh table
      onSuccess() // refresh parent data
    } catch (error) {
      console.error('Failed to delete deployment:', error)
    }
  }

  return (
    <CModal visible={tableVisible} onClose={() => setTableVisible(false)} size="lg">
      <CModalHeader>
        <CModalTitle>Deployed Employees</CModalTitle>
      </CModalHeader>

      <CModalBody>
        <CTable bordered hover>
          <CTableHead>
            <CTableRow>
              <CTableHeaderCell>Name</CTableHeaderCell>
              <CTableHeaderCell>Email</CTableHeaderCell>
              <CTableHeaderCell>Contact</CTableHeaderCell>
              <CTableHeaderCell>Joining</CTableHeaderCell>
              <CTableHeaderCell>Relieving</CTableHeaderCell>
              <CTableHeaderCell>Action</CTableHeaderCell>
            </CTableRow>
          </CTableHead>

          <CTableBody>
            {loading ? (
              <CTableRow>
                <CTableDataCell colSpan={5} className="text-center py-4">
                  <CSpinner size="sm" />
                </CTableDataCell>
              </CTableRow>
            ) : employees?.length > 0 ? (
              employees?.map((emp) => (
                <CTableRow key={emp.id}>
                  <CTableDataCell>{`${emp.first_name} ${emp.middle_name} ${emp.last_name}`}</CTableDataCell>
                  <CTableDataCell>{emp.email}</CTableDataCell>
                  <CTableDataCell>{emp.contact_no}</CTableDataCell>
                  <CTableDataCell>{emp.EmployeeWorkOrderDeployment.joining_date}</CTableDataCell>
                  <CTableDataCell>{emp.EmployeeWorkOrderDeployment.relieving_date}</CTableDataCell>

                  <CTableDataCell>
                    <CButton
                      size="sm"
                      variant="ghost"
                      color="primary"
                      onClick={() => onEdit(emp.EmployeeWorkOrderDeployment.id, emp)}
                    >
                      <CIcon icon={cilPencil} />
                    </CButton>

                    <CButton
                      size="sm"
                      variant="ghost"
                      color="danger"
                      className="ms-2"
                      onClick={() => deleteHandle(emp.EmployeeWorkOrderDeployment.id)}
                    >
                      <CIcon icon={cilTrash} />
                    </CButton>
                  </CTableDataCell>
                </CTableRow>
              ))
            ) : (
              <TableEmptyState colSpan={6} />
            )}
          </CTableBody>
        </CTable>
      </CModalBody>
    </CModal>
  )
}

export default DeploymentTableModal
