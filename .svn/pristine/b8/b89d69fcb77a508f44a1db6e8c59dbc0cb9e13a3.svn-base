import React, { useState, useEffect, useRef } from 'react'
import {
  CCard,
  CCardBody,
  CRow,
  CCol,
  CFormSelect,
  CButton,
} from '@coreui/react'

import './mpr.css'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'

const MPR = () => {
  const [workOrder, setWorkOrder] = useState('')
  const [month, setMonth] = useState('')
  const [selectedEmployees, setSelectedEmployees] = useState([])
  const [showDropdown, setShowDropdown] = useState(false)
  const [isGenerated, setIsGenerated] = useState(false)
  const [generatedFile, setGeneratedFile] = useState(null)

  const dropdownRef = useRef(null)

  const workOrderEmployees = {
    'WO-001': ['Shrikant', 'Vishal', 'Akansha'],
    'WO-002': ['Paras', 'Sarita'],
  }

  const employeesList = workOrder ? workOrderEmployees[workOrder] || [] : []

  const isAllSelected =
    employeesList.length > 0 &&
    selectedEmployees.length === employeesList.length

  // 🔹 Reset when Work Order changes
  useEffect(() => {
    setSelectedEmployees([])
    setIsGenerated(false)
    setGeneratedFile(null)
  }, [workOrder])

  // 🔹 Reset when Month or Employees change
  useEffect(() => {
    setIsGenerated(false)
    setGeneratedFile(null)
  }, [month, selectedEmployees])

  // 🔹 Close dropdown
  useEffect(() => {
    const handleClickOutside = (e) => {
      if (dropdownRef.current && !dropdownRef.current.contains(e.target)) {
        setShowDropdown(false)
      }
    }
    document.addEventListener('mousedown', handleClickOutside)
    return () => document.removeEventListener('mousedown', handleClickOutside)
  }, [])

  const handleEmployeeToggle = (emp) => {
    if (selectedEmployees.includes(emp)) {
      setSelectedEmployees(selectedEmployees.filter((e) => e !== emp))
    } else {
      setSelectedEmployees([...selectedEmployees, emp])
    }
  }

  const handleSelectAll = () => {
    if (isAllSelected) {
      setSelectedEmployees([])
    } else {
      setSelectedEmployees(employeesList)
    }
  }

  // 🔹 Generate
  const handleGenerate = () => {
    if (!workOrder || !month || selectedEmployees.length === 0) {
      alert('Select all fields first')
      return
    }

    setIsGenerated(true)

    const content = `
MPR REPORT

Work Order: ${workOrder}
Month: ${month}

Employees:
${selectedEmployees.join('\n')}
`

    const blob = new Blob([content], { type: 'application/pdf' })
    const url = URL.createObjectURL(blob)

    setGeneratedFile(url)
  }

  const showTable =
    workOrder && month && selectedEmployees.length > 0

  return (
    <div className="mpr-container">
      <CCard className="mpr-card">
        <CCardBody>

          <h4 className="mb-3">MPR</h4>

          {/* Filters */}
          <CRow className="mb-3">

            {/* Work Order */}
            <CCol md={4}>
              <CFormSelect
                value={workOrder}
                onChange={(e) => setWorkOrder(e.target.value)}
              >
                <option value="">Select Work Order</option>
                <option value="WO-001">WO-001</option>
                <option value="WO-002">WO-002</option>
              </CFormSelect>
            </CCol>

            {/* Employee Dropdown */}
            <CCol md={4}>
              <div ref={dropdownRef} className="dropdown-wrapper">

                <div
                  className={`form-select custom-multiselect ${
                    showDropdown ? 'open' : ''
                  }`}
                  onClick={() => setShowDropdown(!showDropdown)}
                >
                  {selectedEmployees.length === 0
                    ? 'Select Employee'
                    : selectedEmployees.slice(0, 2).join(', ') +
                      (selectedEmployees.length > 2
                        ? ` +${selectedEmployees.length - 2} more`
                        : '')}
                </div>

                {showDropdown && (
                  <div className="multi-select-dropdown">

                    <div className="dropdown-item">
                      <input
                        type="checkbox"
                        checked={isAllSelected}
                        onChange={handleSelectAll}
                      /> Select All
                    </div>

                    <hr />

                    {employeesList.map((emp, index) => (
                      <div key={index} className="dropdown-item">
                        <input
                          type="checkbox"
                          checked={selectedEmployees.includes(emp)}
                          onChange={() => handleEmployeeToggle(emp)}
                        /> {emp}
                      </div>
                    ))}
                  </div>
                )}

              </div>
            </CCol>

            {/* Month */}
            <CCol md={4}>
              <CFormSelect
                value={month}
                onChange={(e) => setMonth(e.target.value)}
              >
                <option value="">Select Month</option>
                <option>Jan 2026</option>
                <option>Feb 2026</option>
              </CFormSelect>
            </CCol>

          </CRow>

          {/* Generate Button */}
          <CButton color="primary" onClick={handleGenerate}>
            Generate
          </CButton>

          {/* Table */}
          {showTable && (
            <div className="mpr-table">

              <table className="table">
                <thead>
                  <tr>
                    <th>Emp Name</th>
                    <th>Leave Granted</th>
                    <th>Leave Taken</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  {selectedEmployees.map((emp, i) => (
                    <tr key={i}>
                      <td>{emp}</td>
                      <td>5</td>
                      <td>{i + 1}</td>

                      <td>
                        {isGenerated && generatedFile && (
                          <a href={generatedFile} download="mpr.pdf">
                            <CIcon icon={cilCloudDownload} size="lg" />
                          </a>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>

              </table>

            </div>
          )}

        </CCardBody>
      </CCard>
    </div>
  )
}

export default MPR