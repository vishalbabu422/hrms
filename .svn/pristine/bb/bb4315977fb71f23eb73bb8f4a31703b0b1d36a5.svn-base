import DivisionFormComponent from './form-component'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const Add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        id: Date.now(), // generate dummy ID
        ...payload,
        created_at: new Date().toISOString(),
      }

      // Get existing divisions from localStorage
      const existingDivisions =
        JSON.parse(localStorage.getItem('divisions')) || []

      // Add new division
      const updatedDivisions = [...existingDivisions, normalizedPayload]

      // Save back to localStorage
      localStorage.setItem('divisions', JSON.stringify(updatedDivisions))

      toast.success('Division created successfully')

      navigate('/division')
    } catch (error) {
      console.error(error)
      toast.error('Failed to create Division')
    }
  }

  const initialData = {
    division: '',
    is_active: true,
  }

  return (
    <DivisionFormComponent
      initialData={initialData}
      mode="create"
      onSubmit={handleSubmit}
    />
  )
}

export default Add