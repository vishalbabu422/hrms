.employee-highlight {
  animation: employeeFlash 1.5s ease;
}

@keyframes employeeFlash {

  0% {
    color: #4338ca;
    transform: scale(1.02);
  }

  50% {
    color: #2563eb;
    transform: scale(1.05);
  }

  100% {
    color: #111827;
    transform: scale(1);
  }
}

.table-highlight {
  animation: tableGlow 1.5s ease;
}

@keyframes tableGlow {

  0% {
    box-shadow:
      0 0 0 rgba(59, 130, 246, 0);
  }

  50% {
    box-shadow:
      0 0 25px rgba(59, 130, 246, 0.25);
  }

  100% {
    box-shadow: none;
  }
}