import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle } from '@coreui/icons'
import { CSpinner } from '@coreui/react'
import { useState, useEffect } from 'react'
import api from '../../api/axios'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [page, setPage] = useState(1)
  const [limit] = useState(2)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')
  const [debouncedSearch, setDebouncedSearch] = useState('')

  // gst codes and loader
  const [gstCodes, setGstCodes] = useState([])
  const [loading, setLoading] = useState(false)

  // fetch all the availale gst codes
  const fetchGstCodes = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (debouncedSearch.length >= 3) {
        params.search = debouncedSearch
      }

      const response = await api.get('/admin/gst-code/index', { params })
      setGstCodes(response.data.data.GstCodeList)
      setTotalPages(response.data.totalPages)
    } catch (error) {
      console.error(error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedSearch(search)
    }, 400)

    return () => clearTimeout(timer)
  }, [search])

  useEffect(() => {
    setPage(1)
  }, [debouncedSearch, sort])

  useEffect(() => {
    if (debouncedSearch.length === 0 || debouncedSearch.length >= 3) {
      fetchGstCodes()
    }
  }, [debouncedSearch, sort, page])

  // sort
  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // delete
  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this GST Code?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/gst-code/delete/${id}`)

      toast.success('GST Code deleted successfully')

      fetchGstCodes()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete GST Code')
    }
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>GST Codes</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search By Code or Code Type"
              />
              <CTooltip content="Add GST Code" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/gst-code/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide={true} style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Code Type"
                      sortKey="code_type"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Code"
                      sortKey="code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Description"
                      sortKey="description"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="GST Rate"
                      sortKey="gst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="CGST Rate"
                      sortKey="cgst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="SGST Rate"
                      sortKey="sgst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="IGST Rate"
                      sortKey="igst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Cess Rate"
                      sortKey="cess_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    {/* <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} /> */}

                    <SortableHeaderCell
                      label="Effective From"
                      sortKey="effective_from"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Effective To"
                      sortKey="effective_to"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Status"
                      sortKey="is_active"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>
                <CTableBody>
                  {loading ? (
                    <CTableRow>
                      <CTableDataCell colSpan={13} className="text-center py-4">
                        <CSpinner size="sm" />
                      </CTableDataCell>
                    </CTableRow>
                  ) : gstCodes.length > 0 ? (
                    gstCodes.map((item) => (
                      <CTableRow key={item.id}>
                        <CTableDataCell>{item.code_type}</CTableDataCell>
                        <CTableDataCell>{item.code}</CTableDataCell>
                        <CTableDataCell>{item.description}</CTableDataCell>

                        <CTableDataCell>{Number(item.gst_rate).toFixed(2)}%</CTableDataCell>
                        <CTableDataCell>{Number(item.cgst_rate).toFixed(2)}%</CTableDataCell>
                        <CTableDataCell>{Number(item.sgst_rate).toFixed(2)}%</CTableDataCell>
                        <CTableDataCell>{Number(item.igst_rate).toFixed(2)}%</CTableDataCell>
                        <CTableDataCell>{Number(item.cess_rate).toFixed(2)}%</CTableDataCell>

                        <CTableDataCell>
                          {item.effective_from
                            ? new Date(item.effective_from).toLocaleDateString('en-IN', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric',
                              })
                            : '-'}
                        </CTableDataCell>

                        <CTableDataCell>
                          {item.effective_to
                            ? new Date(item.effective_to).toLocaleDateString('en-IN', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric',
                              })
                            : '-'}
                        </CTableDataCell>

                        <CTableDataCell>
                          {item.is_active ? (
                            <CIcon icon={cilCheckCircle} className="text-success" />
                          ) : (
                            <CIcon icon={cilXCircle} className="text-danger" />
                          )}
                        </CTableDataCell>

                        <CTableDataCell>
                          <div className="d-flex gap-2">
                            <CTooltip content="Edit" placement="left">
                              <CButton
                                color="primary"
                                size="sm"
                                variant="ghost"
                                onClick={() => navigate(`/gst-code/edit/${item.id}`)}
                              >
                                <CIcon icon={cilPencil} />
                              </CButton>
                            </CTooltip>
                            {item.is_active && (
                              <CTooltip content="Delete" placement="right">
                                <CButton
                                  color="danger"
                                  size="sm"
                                  variant="ghost"
                                  onClick={() => confirmDelete(item.id)}
                                >
                                  <CIcon icon={cilTrash} />
                                </CButton>
                              </CTooltip>
                            )}
                          </div>
                        </CTableDataCell>
                      </CTableRow>
                    ))
                  ) : (
                    <TableEmptyState colSpan={13} />
                  )}
                </CTableBody>
              </CTable>
            </SimpleBar>
            <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
