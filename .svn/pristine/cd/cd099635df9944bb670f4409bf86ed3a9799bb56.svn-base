        "description": "Generates one combined PDF for selected employees and maps it to each employee",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["employee_ids", "month", "year", "created_by"],
              "properties": {
                "employee_ids": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "example": [1, 2, 3]
                },
                "month": {
                  "type": "string",
                  "enum": [
                    "Jan",
                    "Feb",
                    "Mar",
                    "Apr",
                    "May",
                    "Jun",
                    "Jul",
                    "Aug",
                    "Sep",
                    "Oct",
                    "Nov",
                    "Dec"
                  ],
                  "example": "Jan"
                },
                "year": {
                  "type": "string",
                  "example": "2026"
                },
                "created_by": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "MPR generated and mapped to employees",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "MPR generated successfully"
                },
                "count": {
                  "type": "integer",
                  "example": 3
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/EmployeeWOMpr"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input / Duplicate record"
          },
          "404": {
            "description": "Employee or Work Order not found"
          }
        }
      }
    },
    "/workorder/{id}/employee-work-order-mpr/upload": {
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Employee WO MPR"],
        "summary": "Upload MPR for selected employees (single PDF)",
        "description": "Upload one combined PDF for selected employees and map it to each employee",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "MPR PDF file (max 5MB)"
          },
          {
            "name": "employee_ids",
            "in": "formData",
            "required": true,
            "type": "array",
            "items": {
              "type": "integer"
            },
            "collectionFormat": "multi",
            "description": "List of employee IDs (send multiple values)",
            "example": [1, 2, 3]
          },
          {
            "name": "month",
            "in": "formData",
            "required": true,
            "type": "string",
            "enum": [
              "jan",
              "feb",
              "mar",
              "apr",
              "may",
              "jun",
              "jul",
              "aug",
              "sep",
              "oct",
              "nov",
              "dec"
            ],
            "example": "mar",
            "description": "Month (short name)"
          },
          {
            "name": "year",
            "in": "formData",
            "required": true,
            "type": "integer",
            "example": 2026
          },
          {
            "name": "created_by",
            "in": "formData",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "201": {
            "description": "MPR uploaded and mapped successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "MPR uploaded and mapped successfully"
                },
                "total_requested": {
                  "type": "integer",
                  "example": 5
                },
                "created_count": {
                  "type": "integer",
                  "example": 3
                },
                "skipped_duplicates": {
                  "type": "integer",
                  "example": 2
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/EmployeeWOMpr"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input / Validation error",
            "schema": {
              "example": {
                "status": "fail",
                "message": "employee_ids are required"
              }
            }
          },
          "404": {
            "description": "Employee or Work Order not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
