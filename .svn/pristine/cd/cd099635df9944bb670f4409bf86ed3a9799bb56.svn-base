                "$ref": "#/definitions/EmployeeSalaryStructureCreate"
              },
              "example": [
                {
                  "employee_id": 1,
                  "salary_structure_id": 2,
                  "ctc": 500000,
                  "effective_from": "2026-04-01",
                  "created_by": 1
                },
                {
                  "employee_id": 2,
                  "salary_structure_id": 3,
                  "ctc": 600000,
                  "effective_from": "2026-04-01",
                  "created_by": 1
                }
              ]
            }
          }
        ],
        "responses": {
          "201": {
