    "/employee-salary-addon/create": {
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Employee Salary Addon"],
        "summary": "Create Employee Salary Addon(s)",
        "description": "Create single or multiple employee salary addon records",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "employee_id",
                  "salary_addon_master_id",
                  "amount",
                  "effective_from"
                ],
                "properties": {
                  "employee_id": {
                    "type": "integer",
                    "example": 37
                  },
                  "salary_addon_master_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "amount": {
                    "type": "number",
                    "example": 5000
                  },
                  "recurrence_type": {
                    "type": "string",
                    "enum": ["ONE_TIME", "MONTHLY", "QUARTERLY", "YEARLY"],
                    "example": "MONTHLY"
                  },
                  "effective_from": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-05-01"
                  },
                  "effective_to": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-12-31"
                  },
                  "remarks": {
                    "type": "string",
                    "example": "Monthly performance incentive"
                  },
                  "created_by": {
                    "type": "integer",
                    "example": 1
                  }
                }
              },
              "example": [
                {
                  "employee_id": 37,
                  "salary_addon_master_id": 1,
                  "amount": 5000,
                  "recurrence_type": "MONTHLY",
                  "effective_from": "2026-05-01",
                  "effective_to": "2026-12-31",
                  "remarks": "Monthly performance incentive",
                  "created_by": 1
                },
                {
                  "employee_id": 37,
                  "salary_addon_master_id": 2,
                  "amount": 2500,
                  "recurrence_type": "ONE_TIME",
                  "effective_from": "2026-05-01",
                  "remarks": "One time bonus",
                  "created_by": 1
                }
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Employee Salary Addon(s) created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "results": {
                  "type": "integer",
                  "example": 2
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/EmployeeSalaryAddonResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },

