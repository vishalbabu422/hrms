        "security": [
          {
            "Authorization": []
          }
        ],
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "type": "integer"
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "Document file to upload"
          },
          {
            "name": "doc_type",
            "in": "formData",
            "required": true,
            "type": "string",
            "enum": [
              "PHOTO",
              "RESUME",
              "PAN_FILE",
              "AADHAAR_FILE",
              "VOTER_ID_FILE",
              "QUALIFICATION_CERT",
              "EXPERIENCE_CERT",
              "TRAINING_CERT",
              "BIRTH_CERT",
              "DRIVING_LICENSE",
              "WORK_PERMIT",
              "CANCEL_CHEQUE",
              "POLICY_DOCUMENT",
              "SCREENING_MAIL_COPY",
              "SALARY_SLIP",
              "FORM16",
              "POLICE_VERIFICATION",
              "DECLARATION",
              "OTHER_DOC"
            ]
          },
          {
            "name": "qualification_id",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "experience_id",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "bank_details_id",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "screening_test_id",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "training_id",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "remarks",
            "in": "formData",
            "type": "string"
          }
        ],
        "responses": {
          "201": {
            "description": "Document uploaded successfully"
          },
          "400": {
            "description": "File is required"
          },
          "404": {
            "description": "Employee not found"
          }
        }
      }
    },
