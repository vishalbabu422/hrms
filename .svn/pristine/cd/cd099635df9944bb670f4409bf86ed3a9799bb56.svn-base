    "/employee/{employeeId}/designations": {
      "get": {
        "tags": ["Employee Designation"],
        "summary": "Get employee designation history",
        "description": "Returns designation history of a specific employee. Non-super-admin users can only access employees of their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Employee designation history fetched successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/EmployeeDesignation"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": ["Employee Designation"],
        "summary": "Assign designation to employee",
        "description": "Assigns a new designation to an employee. Automatically closes previous current designation.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EmployeeDesignationCreate"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Designation assigned successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Designation assigned successfully"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / Cross organization assignment"
          },
          "404": {
            "description": "Employee or designation not found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
