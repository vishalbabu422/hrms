                  "type": "string",
                  "example": "ABC Consulting Pvt Ltd"
                },
                "vendor_code": {
                  "type": "string",
                  "example": "VEND001"
                },
                "vendor_type": {
                  "type": "string",
                  "enum": [
                    "INDIVIDUAL",
                    "PROPRIETORSHIP",
                    "PARTNERSHIP",
                    "LLP",
                    "PRIVATE_LIMITED",
                    "PUBLIC_LIMITED",
                    "GOVERNMENT",
                    "NGO",
                    "OTHER"
                  ],
                  "example": "PRIVATE_LIMITED"
                },
                "contact_person": {
                  "type": "string",
                  "example": "Rahul Sharma"
                },
                "contact_email": {
                  "type": "string",
                  "format": "email",
                  "example": "contact@abc.com"
                },
                "contact_phone": {
                  "type": "string",
                  "example": "9876543210"
                },
                "website": {
                  "type": "string",
                  "example": "https://abc.com"
                },
                "address_line1": {
                  "type": "string",
                  "example": "Sector 10"
                },
                "address_line2": {
                  "type": "string",
                  "example": "Industrial Area"
                },
                "city": {
                  "type": "string",
                  "example": "Delhi"
                },
                "state": {
                  "type": "string",
                  "example": "Delhi"
                },
                "country": {
                  "type": "string",
                  "example": "India"
                },
                "pincode": {
                  "type": "string",
                  "example": "110001"
                },
                "bank_name": {
                  "type": "string",
                  "example": "State Bank of India"
                },
                "account_number": {
                  "type": "string",
                  "example": "123456789012"
                },
                "ifsc_code": {
                  "type": "string",
                  "example": "SBIN0001234"
                },
                "branch_name": {
                  "type": "string",
                  "example": "Connaught Place"
                },
                "onboarding_date": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-01-01"
                }
              }
            }
          }
        ],
        "responses": {
