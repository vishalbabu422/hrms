import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import OrganizationSelect from '../components/organization-select'


const CompanyFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={12}>
                <OrganizationSelect
                  name="organization_id"
                  value={formData?.organization_id}
                  onChange={handleChange}
                  label="Organization"
                  placeholder="Select Organisation"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Name</CFormLabel>
                <CFormInput
                  name="company_name"
                  value={formData?.company_name || ''}
                  onChange={handleChange}
                  placeholder="Company name"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Code</CFormLabel>
                <CFormInput
                  name="company_code"
                  value={formData?.company_code || ''}
                  onChange={handleChange}
                  placeholder="Code"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Company Type</CFormLabel>
                <CFormSelect
                  name="company_type"
                  value={formData?.company_type || ''}
                  onChange={handleChange}
                >
                  <option value="PRIVATE_LIMITED">Private Limited</option>
                  <option value="PUBLIC_LIMITED">Public Limited</option>
                  <option value="LLP">LLP</option>
                  <option value="PROPRIETORSHIP">Proprietorship</option>
                  <option value="PARTNERSHIP">Partnership</option>
                  <option value="GOVERNMENT">Government</option>
                  <option value="NGO">NGO</option>
                  <option value="OTHER">Other</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>Incorporation Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="incorporation_date"
                  value={formData?.incorporation_date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Email</CFormLabel>
                <CFormInput
                  name="official_email"
                  value={formData?.official_email || ''}
                  onChange={handleChange}
                  placeholder="Email"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Phone</CFormLabel>
                <CFormInput
                  name="official_phone"
                  value={formData?.official_phone || ''}
                  onChange={handleChange}
                  placeholder="Phone"
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Address</CFormLabel>
                <CFormInput
                  name="address_line1"
                  value={formData?.address_line1 || ''}
                  onChange={handleChange}
                  placeholder="Address"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>City</CFormLabel>
                <CFormInput name="city" value={formData?.city || ''} onChange={handleChange} />
              </CCol>

              <CCol md={3}>
                <CFormLabel>State</CFormLabel>
                <CFormSelect name="state" value={String(formData?.state)} onChange={handleChange}>
                  <option value="">Select State</option>
                  <option value="mp">Madhya Pradesh</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Country</CFormLabel>
                <CFormSelect
                  name="country"
                  value={String(formData?.country)}
                  onChange={handleChange}
                >
                  <option value="">Select Country</option>
                  <option value="india">India</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Pincode</CFormLabel>
                <CFormInput
                  name="pincode"
                  value={formData?.pincode || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData?.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default CompanyFormComponent
