import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import api from '../../api/axios'

const RateFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [designationList, setDesignationList] = useState([])
  const [gstCodeList, setGstCodeList] = useState([])

  useEffect(() => {
    const fetchDesignation = async () => {
      const params = {
        fields: 'id,designation',
      }

      try {
        const response = await api.get('/admin/designation/index', { params })
        setDesignationList(response.data.data.DesignationList)
      } catch (error) {
        console.error('Failed to fetch designations:', error)
      }
    }

    const fetchGstCodes = async () => {
      const params = {
        fields: 'id,code',
      }

      try {
        const response = await api.get('/admin/gst-code/index', { params })
        setGstCodeList(response.data.data.GstCodeList)
      } catch (error) {
        console.error('Failed to fetch gst code:', error)
      }
    }

    fetchDesignation()
    fetchGstCodes()
  }, [])

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  const calculateFields = (data, changedField) => {
    let updated = { ...data }

    const agencyPercent = Number(updated.agency_margin_percent) || 0
    const nicsiPercent = Number(updated.nicsi_margin_percent) || 0

    let unitIncl = Number(updated.unit_rate_incl_agency_margin) || 0
    let unitExcl = Number(updated.unit_rate_excl_agency_margin) || 0

    // ===== AGENCY LOGIC =====

    if (changedField === 'unit_rate_incl_agency_margin' && unitIncl > 0) {
      const agencyAmount = (unitIncl * agencyPercent) / 100
      updated.agency_amount = Number(agencyAmount.toFixed(2))
      updated.unit_rate_excl_agency_margin = Number((unitIncl - agencyAmount).toFixed(2))
    }

    if (
      (changedField === 'unit_rate_excl_agency_margin' && unitExcl > 0) ||
      (changedField === 'agency_margin_percent' && unitExcl > 0)
    ) {
      const agencyAmount = (unitExcl * agencyPercent) / 100
      const newUnitIncl = unitExcl + agencyAmount

      updated.agency_amount = Number(agencyAmount.toFixed(2))
      updated.unit_rate_incl_agency_margin = Number(newUnitIncl.toFixed(2))
    }

    // ===== NICSI LOGIC =====
    unitIncl = Number(updated.unit_rate_incl_agency_margin) || 0

    if (unitIncl > 0 && nicsiPercent > 0) {
      const nicsiAmount = (unitIncl * nicsiPercent) / 100
      updated.nicsi_margin_amount = Number(nicsiAmount.toFixed(2))
    }

    // ===== TOTAL AMOUNT =====
    const nicsiAmountFinal = Number(updated.nicsi_margin_amount) || 0
    updated.total_amount = Number((unitIncl + nicsiAmountFinal).toFixed(2))

    // ===== GST LOGIC =====
    const totalAmount = Number(updated.total_amount) || 0
    const cgstPercent = Number(updated.cgst_percent) || 0
    const sgstPercent = Number(updated.sgst_percent) || 0
    const igstPercent = Number(updated.igst_percent) || 0

    updated.cgst_amount = Number(((totalAmount * cgstPercent) / 100).toFixed(2))
    updated.sgst_amount = Number(((totalAmount * sgstPercent) / 100).toFixed(2))
    updated.igst_amount = Number(((totalAmount * igstPercent) / 100).toFixed(2))

    updated.total_gst_amount = Number(
      (updated.cgst_amount + updated.sgst_amount + updated.igst_amount).toFixed(2),
    )

    updated.final_amount = Number((totalAmount + updated.total_gst_amount).toFixed(2))

    return updated
  }

  // Fetch GST percentages on code change
  useEffect(() => {
    if (!formData?.gst_code_fk) return

    const fetchGstPercentages = async () => {
      try {
        const response = await api.get(`/admin/gst-code/${formData.gst_code_fk}`)
        const gst = response.data.data

        setFormData((prev) => {
          const updated = {
            ...prev,
            cgst_percent: gst.cgst_rate || 0,
            sgst_percent: gst.sgst_rate || 0,
            igst_percent: gst.igst_rate || 0,
          }

          // IMPORTANT: recalculate after setting percentages
          return calculateFields(updated, 'gst_percent_update')
        })
      } catch (error) {
        console.error('Failed to fetch gst percentages:', error)
      }
    }

    fetchGstPercentages()
  }, [formData?.gst_code_fk])

  useEffect(() => {
    if (!formData?.desgn_id_fk) return

    const fetchByDesignation = async () => {
      try {
        const response = await api.get(`/admin/designation/${formData.desgn_id_fk}`)
        const data = response.data.data

        setFormData((prev) =>
          calculateFields(
            {
              ...prev,
              agency_margin_percent: data.empanelment.agm || 0,
            },
            'agency_margin_percent',
          ),
        )
      } catch (error) {
        console.error(error)
      }
    }

    fetchByDesignation()
  }, [formData?.desgn_id_fk])

  if (!formData) return null

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => {
      const updated = {
        ...prev,
        [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
      }

      return calculateFields(updated, name)
    })
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CForm className="row" onSubmit={handleSubmit}>
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={12}>
                <CFormLabel>Designation</CFormLabel>
                <CFormSelect
                  name="desgn_id_fk"
                  value={String(formData.desgn_id_fk)}
                  onChange={handleChange}
                  required
                >
                  <option value="">Select Designation</option>
                  {designationList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.designation}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Agency Margin (%)</CFormLabel>
                <CFormInput
                  name="agency_margin_percent"
                  value={formData.agency_margin_percent || ''}
                  onChange={handleChange}
                  placeholder="Enter Agency Margin (%)"
                  type="number"
                  min="0"
                  max="99.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Unit Rate (Including A.M)</CFormLabel>
                <CFormInput
                  name="unit_rate_incl_agency_margin"
                  value={formData.unit_rate_incl_agency_margin || ''}
                  onChange={handleChange}
                  placeholder="Enter Unit Rate (Including A.M)"
                  type="number"
                  required
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Unit Rate (Excluding A.M)</CFormLabel>
                <CFormInput
                  name="unit_rate_excl_agency_margin"
                  value={formData.unit_rate_excl_agency_margin || ''}
                  onChange={handleChange}
                  placeholder="Enter Unit Rate (Excluding A.M)"
                  type="number"
                  required
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Agency Amount</CFormLabel>
                <CFormInput
                  name="agency_amount"
                  value={formData.agency_amount || ''}
                  placeholder="Enter Agency Amount"
                  onChange={handleChange}
                  type="number"
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>NICSI Margin (%)</CFormLabel>

                <CFormSelect
                  name="nicsi_margin_percent"
                  value={String(formData.nicsi_margin_percent)}
                  onChange={handleChange}
                  required
                >
                  <option value={5}>5 %</option>
                  <option value={6}>6 %</option>
                  <option value={7}>7 %</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>NICSI Margin Amount</CFormLabel>
                <CFormInput
                  type="number"
                  name="nicsi_margin_amount"
                  placeholder="Enter Margin Amount"
                  value={formData.nicsi_margin_amount || ''}
                  onChange={handleChange}
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>
                  <strong>Total Amount</strong>
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="total_amount"
                  placeholder="Enter Total Amount"
                  value={formData.total_amount || ''}
                  onChange={handleChange}
                  required
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>

        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={3}>
                <CFormLabel>GST Code</CFormLabel>
                <CFormSelect
                  name="gst_code_fk"
                  value={String(formData.gst_code_fk)}
                  onChange={handleChange}
                  required
                >
                  <option value="">Select GST Code</option>
                  {gstCodeList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.code}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>
                  CGST Amount {formData.cgst_percent ? `(${formData.cgst_percent} %)` : ''}
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="cgst_amount"
                  placeholder="Enter CGST Amount"
                  value={formData.cgst_amount ?? ''}
                  onChange={handleChange}
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>
                  SGST Amount {formData.sgst_percent ? `(${formData.sgst_percent} %)` : ''}
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="sgst_amount"
                  placeholder="Enter SGST Amount"
                  value={formData.sgst_amount ?? ''}
                  onChange={handleChange}
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>
                  IGST Amount {formData.igst_percent ? `(${formData.igst_percent} %)` : ''}
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="igst_amount"
                  placeholder="Enter IGST Amount"
                  value={formData.igst_amount ?? ''}
                  onChange={handleChange}
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>
                  <strong>Total GST Amount</strong>
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="total_gst_amount"
                  placeholder="Enter Total GST Amount"
                  value={formData.total_gst_amount ?? ''}
                  onChange={handleChange}
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={6}>
                <CFormLabel>
                  <strong>Final Amount</strong>
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="final_amount"
                  placeholder="Enter Final Amount"
                  value={formData.final_amount || ''}
                  onChange={handleChange}
                  required
                  min="0"
                  max="9999999999999.99"
                  step="0.01"
                />
              </CCol>
              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                  required
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>
              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>
      </CForm>
    </CRow>
  )
}

export default RateFormComponent
