import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import {
  CCol,
  CCard,
  CCardBody,
  CCardHeader,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'
import api from '../../../api/axios'

const HealthView = () => {
  const { employeeId } = useParams()

  const [employee, setEmployee] = useState({})
  const [loading, setLoading] = useState(false)

  const fetchHealth = async () => {
    try {
      setLoading(true)

      const response = await api.get(`/employee/${employeeId}/health`)

      // ⚠️ adjust if API structure differs
      const data = response.data?.data || response.data || {}

      setEmployee(data)
    } catch (error) {
      console.error('Error fetching health data:', error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchHealth()
  }, [employeeId])

  return (
    <CCol xs={12} sm={12} md={9} lg={10}>
      <CCardBody style={{ minHeight: '400px' }}>
        {/* ===== Header ===== */}
        <div className="section-header mb-4">
          <div className="section-accent"></div>
          <h5 className="section-title">Health</h5>
        </div>

       
        {loading && <p>Loading health details...</p>}

    
        {!loading && Object.keys(employee).length === 0 && (
          <p className="text-muted">No health data available</p>
        )}

        {/* ================= HEALTH DETAILS ================= */}
        {!loading && (
          <>
            <CCard className="border-0 shadow-sm mb-4">
              <CCardHeader className="bg-light fw-semibold">
                Health Details
              </CCardHeader>

              <CCardBody>
                <div className="row g-4">
                  <div className="col-md-6">
                    <small className="text-muted">Height (cm)</small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.height ?? '-'}
                    </div>
                  </div>

                  <div className="col-md-6">
                    <small className="text-muted">Weight (kg)</small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.weight ?? '-'}
                    </div>
                  </div>

                  <div className="col-md-6">
                    <small className="text-muted">Has Health Issues</small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.hasHealthIssues ? 'Yes' : 'No'}
                    </div>
                  </div>

                  <div className="col-md-6">
                    <small className="text-muted">
                      Is Physically Handicapped
                    </small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.isHandicapped ? 'Yes' : 'No'}
                    </div>
                  </div>

                  <div className="col-12">
                    <small className="text-muted">
                      Identification Mark
                    </small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.identificationMark || '-'}
                    </div>
                  </div>
                </div>
              </CCardBody>
            </CCard>

            {/* ================= VACCINATION DETAILS ================= */}
            <CCard className="border-0 shadow-sm">
              <CCardHeader className="bg-light fw-semibold">
                Vaccination Details
              </CCardHeader>

              <CCardBody>
                <div className="row g-4">
                  <div className="col-md-4">
                    <small className="text-muted">Vaccination Name</small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.vaccinationName || '-'}
                    </div>
                  </div>

                  <div className="col-md-4">
                    <small className="text-muted">Vaccination Date</small>
                    <div className="fw-semibold border-bottom pb-2">
                      {employee.vaccinationDate || '-'}
                    </div>
                  </div>

                  <div className="col-md-4">
                    <div className="d-flex justify-content-between align-items-center">
                      <div>
                        <small className="text-muted">Document</small>
                        <div className="fw-semibold">
                          {employee.vaccinationDocumentName || 'No document uploaded'}
                        </div>
                      </div>

                      {employee.vaccinationDocument && (
                        <CButton
                          size="sm"
                          variant="outline"
                          href={employee.vaccinationDocument}
                          download
                        >
                          <CIcon icon={cilCloudDownload} />
                        </CButton>
                      )}
                    </div>
                  </div>
                </div>
              </CCardBody>
            </CCard>
          </>
        )}
      </CCardBody>
    </CCol>
  )
}

export default HealthView