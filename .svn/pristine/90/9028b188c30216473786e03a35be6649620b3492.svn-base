const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Models
const Designation = require("../models/designation");
const EmpanelmentMaster = require("../models/empanelmentMaster");
const { Op } = require("sequelize");

// Get Empanelment List (Index)
const index = catchAsync(async (req, res, next) => {
  const features = new APIFeatures(req.query)
    .filter()
    .sort()
    .limitFields()
    .join()
    .paginate();

  const page = req.query.page * 1 || 1;
  const limit = req.query.limit * 1 || 10;

  if (!features.query.where) features.query.where = {};

  if (req.query.search && req.query.search.trim().length >= 3) {
    const search = req.query.search.trim();

    features.query.where[Op.or] = [
      { "$empanelment.empanelment_no$": { [Op.iLike]: `%${search}%` } },
      { designation: { [Op.iLike]: `%${search}%` } },
    ];
  }

  const { rows: DesignationList, count } = await Designation.findAndCountAll({
    ...features.query,
    include: [
      {
        model: EmpanelmentMaster,
        as: "empanelment",
        attributes: ["empanelment_no"],
      },
    ],
    distinct: true,
    subQuery: false,
  });

  res.status(200).json({
    status: "success",
    message: "Get Designation List!",
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: DesignationList.length,
    data: { DesignationList },
  });
});

const dataById = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const { is_active } = req.query;

  const where = { id };

  if (is_active !== undefined) {
    where.is_active = is_active === "true";
  }

  const empanelmentdesgn = await Designation.findOne({ where });

  if (!empanelmentdesgn) {
    return res.status(404).json({
      status: "fail",
      message: "Empanelment Designation not found",
    });
  }

  res.status(200).json({
    status: "success",
    data: empanelmentdesgn,
  });
});

const create = catchAsync(async (req, res, next) => {
  const payload = req.body;

  // prevent duplicate active empanelment
  const existing = await Designation.findOne({
    where: {
      empanelment_id_fk: payload.empanelment_id_fk,
      designation: payload.designation,
      is_active: true,
    },
  });

  if (existing) {
    return res.status(409).json({
      status: "fail",
      message: "Empanelment Designation already exists for this empanelment",
    });
  }

  const empanelmentdesgn = await Designation.create({
    ...payload,
    is_active: true,
    created: new Date(),
    modified: new Date(),
  });

  res.status(201).json({
    status: "success",
    data: empanelmentdesgn,
  });
});

const edit = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const updates = req.body;

  const empanelmentDesgn = await Designation.findByPk(id);

  if (!empanelmentDesgn) {
    return res.status(404).json({
      status: "fail",
      message: "Empanelment Designation not found",
    });
  }

  // Duplicate active check
  // Only if empanelment_id_fk OR designation is changing
  if (
    (updates.empanelment_id_fk &&
      updates.empanelment_id_fk !== empanelmentDesgn.empanelment_id_fk) ||
    (updates.designation &&
      updates.designation !== empanelmentDesgn.designation)
  ) {
    const duplicate = await Designation.findOne({
      where: {
        empanelment_id_fk:
          updates.empanelment_id_fk || empanelmentDesgn.empanelment_id_fk,
        designation: updates.designation || empanelmentDesgn.designation,
        is_active: true,
      },
    });

    if (duplicate && duplicate.id !== empanelmentDesgn.id) {
      return res.status(409).json({
        status: "fail",
        message: "Empanelment Designation already exists for this empanelment",
      });
    }
  }

  // Apply updates
  await empanelmentDesgn.update({
    ...updates,
    modified: new Date(),
  });

  res.status(200).json({
    status: "success",
    data: empanelmentDesgn,
  });
});

const deleteById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  // Check record exists
  const empanelmentDesgn = await Designation.findByPk(id);

  if (!empanelmentDesgn) {
    return res.status(404).json({
      status: "fail",
      message: "Empanelment Designation not found",
    });
  }

  // Prevent double delete
  if (empanelmentDesgn.is_active === false) {
    return res.status(409).json({
      status: "fail",
      message: "Empanelment Designation is already inactive",
    });
  }

  // Soft delete
  await empanelmentDesgn.update({
    is_active: false,
    modified: new Date(),
  });

  return res.status(200).json({
    status: "success",
    message: "Empanelment Designation deleted successfully",
  });
});

module.exports = {
  index,
  dataById,
  create,
  edit,
  deleteById,
};
