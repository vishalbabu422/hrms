import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import { validateEmpSalaryStructure } from '../../validations/empSalaryStructureValidation'

const EmpSalaryStructureForm = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [errors, setErrors] = useState({})

  // 🔹 Dummy data (replace with API later)
  const employeeList = [
    { id: 1, name: 'John Doe' },
    { id: 2, name: 'Jane Smith' },
  ]

  const structureList = [
    { id: 1, name: 'Structure A' },
    { id: 2, name: 'Structure B' },
  ]

  useEffect(() => {
    if (initialData) setFormData(initialData)
  }, [initialData])

  const handleChange = (e) => {
    const { name, value } = e.target

    let updatedValue = value

    if (name === 'is_active') {
      updatedValue = value === 'true'
    }

    setFormData((prev) => ({
      ...prev,
      [name]: updatedValue === '' ? null : updatedValue,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    const validationErrors = validateEmpSalaryStructure(formData)
    setErrors(validationErrors)

    if (Object.keys(validationErrors).length > 0) return

    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="shadow border-0 rounded-4">
          <CCardBody>

            <CForm onSubmit={handleSubmit} className="row g-3">

              {/* Employee */}
              <CCol md={6}>
                <CFormLabel>
                  Employee <span className="text-danger">*</span>
                </CFormLabel>
                <CFormSelect
                  name="employee_id"
                  value={formData.employee_id || ''}
                  onChange={handleChange}
                >
                  <option value="">Select Employee</option>
                  {employeeList.map((e) => (
                    <option key={e.id} value={e.id}>{e.name}</option>
                  ))}
                </CFormSelect>
                {errors.employee_id && <div className="text-danger">{errors.employee_id}</div>}
              </CCol>

              {/* Structure */}
              <CCol md={6}>
                <CFormLabel>
                  Salary Structure <span className="text-danger">*</span>
                </CFormLabel>
                <CFormSelect
                  name="salary_structure_id"
                  value={formData.salary_structure_id || ''}
                  onChange={handleChange}
                >
                  <option value="">Select Structure</option>
                  {structureList.map((s) => (
                    <option key={s.id} value={s.id}>{s.name}</option>
                  ))}
                </CFormSelect>
                {errors.salary_structure_id && <div className="text-danger">{errors.salary_structure_id}</div>}
              </CCol>

              {/* CTC */}
              <CCol md={6}>
                <CFormLabel>
                  CTC <span className="text-danger">*</span>
                </CFormLabel>
                <CFormInput
                  type="number"
                  name="ctc"
                  value={formData.ctc || ''}
                  onChange={handleChange}
                />
                {errors.ctc && <div className="text-danger">{errors.ctc}</div>}
              </CCol>

              {/* Effective Date */}
              <CCol md={6}>
                <CFormLabel>
                  Effective From <span className="text-danger">*</span>
                </CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from || ''}
                  onChange={handleChange}
                />
                {errors.effective_from && <div className="text-danger">{errors.effective_from}</div>}
              </CCol>

              {/* Status */}
              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">Active</option>
                  <option value="false">Inactive</option>
                </CFormSelect>
              </CCol>

              {/* Submit */}
              <CCol xs={12}>
                <CButton type="submit" color="primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>

            </CForm>

          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default EmpSalaryStructureForm