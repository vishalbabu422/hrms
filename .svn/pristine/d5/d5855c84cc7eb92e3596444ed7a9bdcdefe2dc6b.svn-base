import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import OrganizationSelect from '../components/organization-select'
import { validateCompany } from '../../validations/companyValidation'
import StateSelect from '../components/state-dropdown'
const CompanyFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [errors, setErrors] = useState({})

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  // const handleSubmit = (e) => {
  //   e.preventDefault()
  //   onSubmit(formData)
  // }

  const handleSubmit = (e) => {
    e.preventDefault()

    const validationErrors = validateCompany(formData)
    setErrors(validationErrors)

    if (Object.keys(validationErrors).length) return

    const cleanedData = Object.fromEntries(
      Object.entries(formData).map(([k, v]) => [k, typeof v === 'string' ? v.trim() : v]),
    )

    const finalData = Object.fromEntries(Object.entries(cleanedData).filter(([_, v]) => v !== ''))

    onSubmit(finalData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <OrganizationSelect
                name="organization_id"
                value={formData?.organization_id}
                onChange={handleChange}
                label="Organization"
                placeholder="Select Organization"
                colSize={12}
              />

              <CCol md={6}>
                <CFormLabel>
                  Company Name <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  name="company_name"
                  value={formData?.company_name || ''}
                  onChange={handleChange}
                  invalid={!!errors.company_name}
                  feedback={errors.company_name}
                  placeholder="Enter company name"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Code</CFormLabel>
                <CFormInput
                  name="company_code"
                  value={formData?.company_code || ''}
                  onChange={handleChange}
                  placeholder="Code"
                  maxLength={50}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>
                  Company Type <span className="text-danger">*</span>
                </CFormLabel>

                <CFormSelect
                  name="company_type"
                  value={formData?.company_type || ''}
                  onChange={handleChange}
                  invalid={!!errors.company_type}
                  feedback={errors.company_type}
                >
                  <option value="">Select Company Type</option>
                  <option value="GOVERNMENT">Government</option>
                  <option value="LLP">LLP</option>
                  <option value="NGO">NGO</option>
                  <option value="OTHER">Other</option>
                  <option value="PARTNERSHIP">Partnership</option>
                  <option value="PRIVATE_LIMITED">Private Limited</option>
                  <option value="PROPRIETORSHIP">Proprietorship</option>
                  <option value="PUBLIC_LIMITED">Public Limited</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>Incorporation Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="incorporation_date"
                  value={formData?.incorporation_date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Email</CFormLabel>
                <CFormInput
                  name="official_email"
                  value={formData?.official_email || ''}
                  onChange={handleChange}
                  placeholder="Email"
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Phone</CFormLabel>
                <CFormInput
                  name="official_phone"
                  value={formData?.official_phone || ''}
                  onChange={handleChange}
                  placeholder="Phone"
                  maxLength={30}
                  pattern="[0-9]{10,15}"
                  title="Enter valid phone number (10-15 digits)"
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Address</CFormLabel>
                <CFormInput
                  name="address_line1"
                  value={formData?.address_line1 || ''}
                  onChange={handleChange}
                  placeholder="Address"
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>City</CFormLabel>
                <CFormInput
                  name="city"
                  value={formData?.city || ''}
                  onChange={handleChange}
                  placeholder="Enter city"
                  maxLength={100}
                />
              </CCol>

              <StateSelect name="state" value={formData?.state} onChange={handleChange} />

              <CCol md={3}>
                <CFormLabel>Country</CFormLabel>
                <CFormSelect
                  name="country"
                  value={String(formData?.country)}
                  onChange={handleChange}
                  maxLength={100}
                >
                  <option value="">Select Country</option>
                  <option value="india">India</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Pincode</CFormLabel>
                <CFormInput
                  name="pincode"
                  value={formData?.pincode || ''}
                  onChange={handleChange}
                  placeholder="Enter pincode"
                  maxLength={15}
                  pattern="[0-9]{4,10}"
                  title="Enter valid pincode"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>
                  Status <span className="text-danger">*</span>
                </CFormLabel>

                <CFormSelect
                  name="is_active"
                  value={String(formData?.is_active ?? '')}
                  onChange={handleChange}
                  invalid={!!errors.is_active}
                  feedback={errors.is_active}
                >
                  <option value="">Select Status</option>
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default CompanyFormComponent
