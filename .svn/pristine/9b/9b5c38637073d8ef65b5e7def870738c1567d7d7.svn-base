import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import {
  CCol,
  CCardBody,
  CAccordion,
  CAccordionItem,
  CAccordionHeader,
  CAccordionBody,
} from '@coreui/react'
import { getEmployeeAchievements } from '../../../services/achievementService'

const AchievementsView = () => {
  const { employeeId } = useParams()

  const [achievementData, setAchievementData] = useState([])
  const [loading, setLoading] = useState(false)

  const fetchAchievements = async () => {
    try {
      setLoading(true)

      const response = await getEmployeeAchievements(employeeId)

      const data = response.data?.data || response.data || []
      setAchievementData(data)
    } catch (error) {
      console.error('Error fetching achievements:', error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchAchievements()
  }, [employeeId])

  return (
    <CCol xs={12} md={10}>
      <CCardBody>
        {/* Header */}
        <div className="section-header mb-4">
          <div className="section-accent"></div>
          <h5 className="section-title">Achievements</h5>
        </div>

        {/* 🔄 Loading */}
        {loading && <p>Loading achievements...</p>}

        {/* ❌ Empty */}
        {!loading && achievementData.length === 0 && (
          <p className="text-muted">No achievements available</p>
        )}

        {/* ✅ Data */}
        {!loading && achievementData.length > 0 && (
          <CAccordion alwaysOpen>
            {achievementData.map((item, index) => (
              <CAccordionItem
                key={item.id || index}
                itemKey={index}
                className="mb-3 shadow-sm"
              >
                <CAccordionHeader>
                  <div className="fw-bold">
                    {item.achievement || 'N/A'}
                  </div>
                </CAccordionHeader>

                <CAccordionBody>
                  <div className="row g-4">
                    {/* LEFT */}
                    <div className="col-md-6">
                      <div className="mb-4">
                        <small className="text-muted">Achievement Type</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {item.type || '-'}
                        </div>
                      </div>

                      <div className="mb-4">
                        <small className="text-muted">Achievement Date</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {item.date
                            ? new Date(item.date).toLocaleDateString()
                            : '-'}
                        </div>
                      </div>

                      <div className="mb-4">
                        <small className="text-muted">Achievement</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {item.achievement || '-'}
                        </div>
                      </div>
                    </div>

                    {/* RIGHT */}
                    <div className="col-md-6">
                      <div className="mb-4">
                        <small className="text-muted">Status</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {item.status || '-'}
                        </div>
                      </div>

                      <div className="mb-4">
                        <small className="text-muted">Remarks</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {item.remarks || '-'}
                        </div>
                      </div>
                    </div>
                  </div>
                </CAccordionBody>
              </CAccordionItem>
            ))}
          </CAccordion>
        )}
      </CCardBody>
    </CCol>
  )
}

export default AchievementsView