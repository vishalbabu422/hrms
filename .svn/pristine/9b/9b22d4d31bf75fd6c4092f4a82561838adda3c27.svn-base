const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Model
const CompanyMaster = require("../models/companyMaster");
const { Op } = require("sequelize");
const Organizations = require("../models/organization");

// Get Company List (Index)
const index = catchAsync(async (req, res, next) => {
  const features = new APIFeatures(req.query)
    .filter()
    .sort()
    .limitFields()
    .join()
    .paginate();

  const page = req.query.page * 1 || 1;
  const limit = req.query.limit * 1 || 10;

  if (!features.query.where) features.query.where = {};

  if (req.query.search && req.query.search.trim().length >= 3) {
    const search = req.query.search.trim();

    features.query.where[Op.or] = [
      { company_name: { [Op.iLike]: `%${search}%` } },
      { company_code: { [Op.iLike]: `%${search}%` } },
      { official_email: { [Op.iLike]: `%${search}%` } },
      { city: { [Op.iLike]: `%${search}%` } },
    ];
  }

  const { rows: companyList, count } = await CompanyMaster.findAndCountAll({
    ...features.query,
    include: [
      {
        model: Organizations,
        as: "organisation",
        attributes: ["org_name"],
      },
    ],
  });

  res.status(200).json({
    status: "success",
    message: "Get Company List!",
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: companyList.length,
    data: { companyList },
  });
});

// Get Company By ID
const dataById = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const { is_active } = req.query;

  const where = { id };

  if (is_active !== undefined) {
    where.is_active = is_active === "true";
  }

  const company = await CompanyMaster.findOne({ where });

  if (!company) {
    return res.status(404).json({
      status: "fail",
      message: "Company not found",
    });
  }

  res.status(200).json({
    status: "success",
    data: company,
  });
});

// Create Company
const create = catchAsync(async (req, res, next) => {
  const payload = req.body;

  // Duplicate check (company_code unique)
  if (payload.company_code) {
    const existing = await CompanyMaster.findOne({
      where: {
        company_code: payload.company_code,
        is_active: true,
      },
    });

    if (existing) {
      return res.status(409).json({
        status: "fail",
        message: "Company code already exists",
      });
    }
  }

  const company = await CompanyMaster.create({
    ...payload,
    is_active: true,
    created_at: new Date(),
    updated_at: new Date(),
  });

  res.status(201).json({
    status: "success",
    data: company,
  });
});

// Edit Company
const edit = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const updates = req.body;

  const company = await CompanyMaster.findByPk(id);

  if (!company) {
    return res.status(404).json({
      status: "fail",
      message: "Company not found",
    });
  }

  // Duplicate check only if company_code changing
  if (updates.company_code && updates.company_code !== company.company_code) {
    const duplicate = await CompanyMaster.findOne({
      where: {
        company_code: updates.company_code,
        is_active: true,
      },
    });

    if (duplicate && duplicate.id !== company.id) {
      return res.status(409).json({
        status: "fail",
        message: "Company code already exists",
      });
    }
  }

  await company.update({
    ...updates,
    updated_at: new Date(),
  });

  res.status(200).json({
    status: "success",
    data: company,
  });
});

// Soft Delete Company
const deleteById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  const company = await CompanyMaster.findByPk(id);

  if (!company) {
    return res.status(404).json({
      status: "fail",
      message: "Company not found",
    });
  }

  if (company.is_active === false) {
    return res.status(409).json({
      status: "fail",
      message: "Company already inactive",
    });
  }

  await company.update({
    is_active: false,
    updated_at: new Date(),
  });

  return res.status(200).json({
    status: "success",
    message: "Company deleted successfully",
  });
});

module.exports = {
  index,
  dataById,
  create,
  edit,
  deleteById,
};
