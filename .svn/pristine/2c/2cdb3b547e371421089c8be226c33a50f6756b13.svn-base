import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'

import { useEffect, useState } from 'react'

const OrganisationFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    // e.preventDefault()
    // onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={6}>
                <CFormLabel htmlFor="orgName">Organization Name</CFormLabel>
                <CFormInput
                  name="org_name"
                  id="orgName"
                  placeholder="Enter organization name"
                  value={formData.org_name || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Code</CFormLabel>
                <CFormInput
                  name="code"
                  value={formData.code || ''}
                  onChange={handleChange}
                  disabled={mode === 'edit'}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Description</CFormLabel>
                <CFormTextarea
                  name="description"
                  value={formData.description || ''}
                  onChange={handleChange}
                />
              </CCol>

              {['gst', 'cgst', 'sgst', 'igst', 'cess', 'other'].map((f) => (
                <CCol md={4} key={f}>
                  <CFormLabel>{f.toUpperCase()} Rate (%)</CFormLabel>
                  <CFormInput
                    type="number"
                    name={f + '_rate'}
                    value={formData[f + '_rate'] ?? ''}
                    onChange={handleChange}
                    placeholder="0.00"
                  />
                </CCol>
              ))}

              <CCol md={4}>
                <CFormLabel>Effective From</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Effective To</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_to"
                  value={formData.effective_to || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={4}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default OrganisationFormComponent
