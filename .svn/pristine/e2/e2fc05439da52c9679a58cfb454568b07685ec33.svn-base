const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const SalaryStructure = sequelize.define(
  "SalaryStructure",
  {
    id: {
      type: DataTypes.BIGINT,
      primaryKey: true,
      autoIncrement: true,
    },

    name: {
      type: DataTypes.STRING(150),
      allowNull: false,
      unique: true,
    },

    description: {
      type: DataTypes.TEXT,
      allowNull: true,
    },

    is_active: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    is_deleted: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    created_by: {
      type: DataTypes.BIGINT,
    },

    updated_by: {
      type: DataTypes.BIGINT,
    },
  
   org_id: {
     type: DataTypes.BIGINT,
     allowNull: false,
    }
  },
  {
    tableName: "salary_structure",
    schema: "pmu",
    timestamps: true,
    createdAt: "created_at",
    updatedAt: "updated_at",
  }
);

// Associations
SalaryStructure.associate = (models) => {
  SalaryStructure.hasMany(models.SalaryStructureComponent, {
    foreignKey: "salary_structure_id",
    as: "structureComponents",
  });

  // Many-to-Many (through table)
  SalaryStructure.belongsToMany(models.SalaryComponent, {
    through: models.SalaryStructureComponent,
    foreignKey: "salary_structure_id",
    otherKey: "salary_component_id",
    as: "components",
  });
};

module.exports = SalaryStructure;