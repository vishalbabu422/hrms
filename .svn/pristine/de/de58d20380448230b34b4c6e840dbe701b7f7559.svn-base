import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'
import { useState } from 'react'

const EmpSalaryStructureForm = ({ onSubmit }) => {
  const [selectedStructure, setSelectedStructure] = useState('')
  const [selectedGroup, setSelectedGroup] = useState('')
  const [selectedEmployees, setSelectedEmployees] = useState({})
  const [selectAll, setSelectAll] = useState(false)
  const [dates, setDates] = useState({
    effective_from: '',
    effective_to: '',
  })

  /* ================= DATA ================= */

  const orgEmployees = [
    { id: 1, name: 'Shrikant' },
    { id: 2, name: 'Vishal' },
    { id: 3, name: 'Akansha' },
    { id: 4, name: 'Saurabh' },
  ]

  const workEmployees = [
    { id: 101, name: 'Sarita' },
    { id: 102, name: 'Paras' },
    { id: 103, name: 'Sanjay' },
    { id: 104, name: 'Atul' },
  ]

  const structureList = [
    { id: 1, name: 'Structure A' },
    { id: 2, name: 'Structure B' },
  ]

  const employeeList =
    selectedGroup === 'org' ? orgEmployees : selectedGroup === 'work' ? workEmployees : []

  /* ================= HANDLERS ================= */

  const handleGroupChange = (value) => {
    setSelectedGroup(value)
    setSelectedEmployees({})
    setSelectAll(false)
  }

  const handleCheckbox = (id) => {
    setSelectedEmployees((prev) => ({
      ...prev,
      [id]: {
        ...prev[id],
        checked: !prev[id]?.checked,
      },
    }))
  }

  const handleCTCChange = (id, value) => {
    setSelectedEmployees((prev) => ({
      ...prev,
      [id]: {
        ...prev[id],
        value,
      },
    }))
  }

  const handleSelectAll = () => {
    const newValue = !selectAll
    setSelectAll(newValue)

    const updated = {}
    employeeList.forEach((emp) => {
      updated[emp.id] = {
        ...selectedEmployees[emp.id],
        checked: newValue,
      }
    })

    setSelectedEmployees(updated)
  }

  const handleDateChange = (e) => {
    const { name, value } = e.target
    setDates((prev) => ({ ...prev, [name]: value }))
  }

  const selectedCount = Object.values(selectedEmployees).filter((e) => e?.checked).length

  const handleSubmit = (e) => {
    e.preventDefault()

    const finalData = Object.entries(selectedEmployees)
      .filter(([_, v]) => v.checked)
      .map(([id, v]) => ({
        employee_id: Number(id),
        ctc: v.value,
        salary_structure_id: selectedStructure,
        group: selectedGroup,
        ...dates,
      }))

    onSubmit(finalData)
  }

  const showEmployees = selectedGroup && selectedStructure

  /* ================= UI ================= */

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        {/* TOP */}
        <CCol md={12}>
          <CCard className="shadow-sm border-0 rounded-4 mb-4">
            <CCardBody>
              <CRow>
                <CCol md={6}>
                  <CFormLabel>Emp Group</CFormLabel>
                  <CFormSelect
                    value={selectedGroup}
                    onChange={(e) => handleGroupChange(e.target.value)}
                  >
                    <option value="">Select</option>
                    <option value="org">Organisation</option>
                    <option value="work">Work Order</option>
                  </CFormSelect>
                </CCol>

                <CCol md={6}>
                  <CFormLabel>Salary Structure</CFormLabel>
                  <CFormSelect
                    value={selectedStructure}
                    onChange={(e) => setSelectedStructure(e.target.value)}
                  >
                    <option value="">Select</option>
                    {structureList.map((s) => (
                      <option key={s.id} value={s.id}>
                        {s.name}
                      </option>
                    ))}
                  </CFormSelect>
                </CCol>
              </CRow>
            </CCardBody>
          </CCard>
        </CCol>

        {/* TABLE */}
        {showEmployees && (
          <CCol md={12}>
            <CCard className="shadow-sm border-0 rounded-4">
              <CCardBody>
                {/* HEADER */}
                <div className="d-flex justify-content-between mb-3"></div>

                {/* TABLE HEADER */}
                <div className="row fw-semibold py-2 border-bottom bg-light rounded-2 mb-2">
                  <div className="col-md-1 text-center">
                    <input type="checkbox" />
                  </div>
                  <div className="col-md-5 text-center">Employee Name</div>
                  <div className="col-md-6 text-center">CTC</div>
                </div>

                {/* ROWS */}
                {employeeList.map((emp) => {
                  const selected = selectedEmployees[emp.id] || {}

                  return (
                    <div key={emp.id} className="row align-items-center py-2 border-bottom">
                      {/* Checkbox */}
                      <div className="col-md-1 text-center">
                        <input
                          type="checkbox"
                          checked={!!selected.checked}
                          onChange={() => handleCheckbox(emp.id)}
                        />
                      </div>

                      {/* Name */}
                      <div className="col-md-5">{emp.name}</div>

                      {/* CTC (ALWAYS VISIBLE) */}
                      <div className="col-md-6">
                        <div className="input-group">
                          <span className="input-group-text">₹</span>
                          <CFormInput
                            type="number"
                            placeholder="Enter CTC"
                            value={selected.value || ''}
                            onChange={(e) => handleCTCChange(emp.id, e.target.value)}
                          />
                        </div>
                      </div>
                    </div>
                  )
                })}

                {/* DATES */}
                <CRow className="mt-4">
                  <CCol md={6}>
                    <CFormLabel>Effective From</CFormLabel>
                    <CFormInput
                      type="date"
                      name="effective_from"
                      value={dates.effective_from}
                      onChange={handleDateChange}
                    />
                  </CCol>

                  <CCol md={6}>
                    <CFormLabel>Effective To</CFormLabel>
                    <CFormInput
                      type="date"
                      name="effective_to"
                      value={dates.effective_to}
                      onChange={handleDateChange}
                    />
                  </CCol>
                </CRow>

                {/* BUTTON */}
                <div className="d-flex justify-content-end mt-4 border-top pt-3">
                  <CButton color="primary">Save</CButton>
                </div>
              </CCardBody>
            </CCard>
          </CCol>
        )}
      </CRow>
    </CForm>
  )
}

export default EmpSalaryStructureForm
