import React, { useState, useEffect } from 'react'
import {
  CCard,
  CCardBody,
  CForm,
  CFormLabel,
  CFormInput,
  CFormSelect,
  CButton,
  CRow,
  CCol,
} from '@coreui/react'

const EmployeeDesignationFormComponent = ({ initialData, onSubmit, mode }) => {
  const [formData, setFormData] = useState(initialData)

  useEffect(() => {
    setFormData(initialData)
  }, [initialData])

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => ({
      ...prev,
      [name]:
        value === ''
          ? ''
          : name === 'employee_id' || name === 'designation_id'
            ? Number(value)
            : value,
    }))
  }

  const handleFormSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CCard>
      <CCardBody>
        <CForm onSubmit={handleFormSubmit}>
          <CRow>
            {/* Employee */}
            <CCol md={6}>
              <CFormLabel>Employee</CFormLabel>
              <CFormSelect
                name="employee_id"
                value={formData.employee_id || ''}
                onChange={handleChange}
              >
                <option value="">Select Employee</option>
                {/* Replace with dynamic API data */}
                <option value="1">EMP-1015 - Rahul Verma</option>
                <option value="2">EMP-1016 - Aman Singh</option>
              </CFormSelect>
            </CCol>

            {/* Designation */}
            <CCol md={6}>
              <CFormLabel>Designation</CFormLabel>
              <CFormSelect
                name="designation_id"
                value={formData.designation_id || ''}
                onChange={handleChange}
              >
                <option value="">Select Designation</option>
                {/* Replace with dynamic API data */}
                <option value="1">Senior Analyst</option>
                <option value="2">Project Manager</option>
              </CFormSelect>
            </CCol>

            {/* <CCol md={6}>
              <CFormLabel>Effective From</CFormLabel>
              <CFormInput
                type="date"
                name="effective_from"
                value={formData.effective_from || ''}
                onChange={handleChange}
              />
            </CCol>

           
            <CCol md={6}>
              <CFormLabel>Effective To</CFormLabel>
              <CFormInput
                type="date"
                name="effective_to"
                value={formData.effective_to || ''}
                onChange={handleChange}
              />
            </CCol> */}
          </CRow>

          <div className="mt-3">
            <CButton type="submit" color="primary">
              {mode === 'create' ? 'Save' : 'Update'}
            </CButton>
          </div>
        </CForm>
      </CCardBody>
    </CCard>
  )
}

export default EmployeeDesignationFormComponent
