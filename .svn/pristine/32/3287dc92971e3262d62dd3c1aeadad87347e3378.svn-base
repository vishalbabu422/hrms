import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'

import { useParams } from 'react-router-dom'

import { toast } from 'react-toastify'

import api from '../../api/axios'

import { validateEmployeeAddon } from '../../validations/employeeAddonValidation'
import { useSelector } from 'react-redux'

const EmployeeAddon = () => {
  /* ================= PARAMS ================= */

  const { id } = useParams()
  const user = useSelector((state) => state.auth.user)

  /* ================= STATES ================= */

  const [workorderOptions, setWorkorderOptions] = useState([])

  const [employeeOptions, setEmployeeOptions] = useState([])

  const [loading, setLoading] = useState(false)

  const [errors, setErrors] = useState({})

  /* ================= FORM ================= */

  const [formData, setFormData] = useState({
    workorder_id: '',
    employee_id: [],
    salary_addon_master_id: id || '',
    amount: '',
    effective_from: '',
    effective_to: '',
    is_active: true,
  })

  /* ================= INITIAL LOAD ================= */

  useEffect(() => {
    fetchWorkorders()
  }, [])

  useEffect(() => {
    if (formData.workorder_id) {
      fetchEmployees()
    } else {
      setEmployeeOptions([])
    }
  }, [formData.workorder_id])

  /* ================= FETCH WORKORDERS ================= */

  const fetchWorkorders = async () => {
    try {
      const response = await api.get('/admin/workorder/index')

      const list = response.data?.data?.workOrderList || []

      const formatted = list.map((item) => ({
        value: item.id,
        label: item.work_order_no,
      }))

      setWorkorderOptions(formatted)
    } catch (error) {
      console.error(error)

      toast.error('Failed to fetch Workorders')
    }
  }

  /* ================= FETCH EMPLOYEES ================= */

  const fetchEmployees = async () => {
    try {
      const params = {
        models: 'employeeWorkOrderDeployment.WoDesgnMapping,employeeSalaryAddon',

        is_active: true,
      }

      const modelFilter = {}

      /* ================= WORK ORDER FILTER ================= */

      if (formData.workorder_id) {
        modelFilter.WoDesgnMapping = {
          work_order_id: Number(formData.workorder_id),
        }

        modelFilter.employeeWorkOrderDeployment = {
          required: true,
        }
      }

      /* ================= APPLY FILTER ================= */

      if (Object.keys(modelFilter).length > 0) {
        params.modelFilter = JSON.stringify(modelFilter)
      }

      const response = await api.get('/employee', {
        params,
      })

      const list = response.data?.data || []

      const filteredList = list.filter((employee) => {
        const addons = employee.employeeSalaryAddon || []

        const alreadyMapped = addons.some(
          (addon) =>
            Number(addon.salary_addon_master_id) === Number(formData.salary_addon_master_id),
        )

        return !alreadyMapped
      })

      const formatted = filteredList.map((item) => ({
        value: String(item.id),

        label: `${item.first_name || ''} ${item.last_name || ''}`,
      }))

      setEmployeeOptions(formatted)
    } catch (error) {
      console.error(error)

      toast.error('Failed to fetch Employees')
    }
  }

  /* ================= HANDLE CHANGE ================= */

  const handleChange = (e) => {
    const { name, value } = e.target

    let updatedValue = value

    /* BOOLEAN */

    if (name === 'is_active') {
      updatedValue = value === 'true'
    }

    /* ONLY NUMBER */

    if (name === 'amount') {
      updatedValue = value.replace(/[^0-9.]/g, '')
    }

    /* WORKORDER CHANGE */

    if (name === 'workorder_id') {
      setFormData((prev) => ({
        ...prev,
        workorder_id: value,
        employee_id: [],
      }))

      return
    }

    setFormData((prev) => ({
      ...prev,
      [name]: updatedValue,
    }))
  }

  /* ================= VALIDATION ================= */

  const validateForm = () => {
    const validationErrors = validateEmployeeAddon(formData)
    console.log(validationErrors)

    setErrors(validationErrors)

    return Object.keys(validationErrors).length === 0
  }

  /* ================= SUBMIT ================= */

  const handleSubmit = async (e) => {
    e.preventDefault()

    const isValid = validateForm()
    if (!isValid) return

    try {
      setLoading(true)

      const payload = formData.employee_id.map((empId) => ({
        employee_id: Number(empId),

        work_order_id: Number(formData.workorder_id),

        salary_addon_master_id: Number(formData.salary_addon_master_id),

        amount: Number(formData.amount),

        recurrence_type: 'ONCE',

        effective_from: formData.effective_from,

        effective_to: formData.effective_to || null,

        remarks: '',

        created_by: user?.id,
      }))

      const response = await api.post('/employee-salary-addon/create', payload)

      toast.success('Employee Salary Addon created successfully')

      /* RESET FORM */

      setFormData({
        workorder_id: '',
        employee_id: [],
        salary_addon_master_id: id || '',
        amount: '',
        effective_from: '',
        effective_to: '',
        is_active: true,
      })
    } catch (error) {
      console.error(error)

      console.log('SUBMIT ERROR : ', error.response?.data)

      toast.error(error.response?.data?.message || 'Failed to create Employee Salary Addon')
    } finally {
      setLoading(false)
    }
  }

  /* ================= UI ================= */

  return (
    <CRow>
      <CCol xs={12}>
        <CCard>
          <CCardBody>
            <CForm onSubmit={handleSubmit} className="row g-3">
              {/* WORKORDER */}

              <CCol md={6}>
                <CFormLabel>
                  Workorder <span className="text-danger">*</span>
                </CFormLabel>

                <CFormSelect
                  name="workorder_id"
                  value={formData.workorder_id}
                  onChange={handleChange}
                  invalid={!!errors.workorder_id}
                >
                  <option value="">Select Workorder</option>

                  {workorderOptions.map((item) => (
                    <option key={item.value} value={item.value}>
                      {item.label}
                    </option>
                  ))}
                </CFormSelect>

                {errors.workorder_id && (
                  <div className="text-danger mt-1 small">{errors.workorder_id}</div>
                )}
              </CCol>

              {/* EMPLOYEE */}

              <CCol md={6}>
                <CFormLabel>
                  Employee <span className="text-danger">*</span>
                </CFormLabel>

                {/* SELECT */}

                <CFormSelect
                  value=""
                  onChange={(e) => {
                    const selectedId = e.target.value

                    if (!selectedId) return

                    const alreadyExists = formData.employee_id.includes(selectedId)

                    if (alreadyExists) return

                    setFormData((prev) => ({
                      ...prev,

                      employee_id: [...prev.employee_id, selectedId],
                    }))
                  }}
                >
                  <option value="">Select Employee</option>

                  {formData.workorder_id &&
                    employeeOptions
                      .filter((item) => !formData.employee_id.includes(String(item.value)))
                      .map((item) => (
                        <option key={item.value} value={item.value}>
                          {item.label}
                        </option>
                      ))}
                </CFormSelect>

                {/* SELECTED EMPLOYEES */}

                {formData.employee_id.length > 0 && (
                  <div className="d-flex flex-wrap gap-2 mt-2">
                    {formData.employee_id.map((empId) => {
                      const emp = employeeOptions.find((e) => String(e.value) === String(empId))

                      return (
                        <div
                          key={empId}
                          className="d-flex align-items-center"
                          style={{
                            background: '#eef2ff',

                            color: '#4338ca',

                            borderRadius: '20px',

                            padding: '6px 12px',

                            fontSize: '13px',

                            fontWeight: '500',
                          }}
                        >
                          {emp?.label}

                          <span
                            style={{
                              marginLeft: '8px',

                              cursor: 'pointer',

                              fontWeight: '700',
                            }}
                            onClick={() => {
                              setFormData((prev) => ({
                                ...prev,

                                employee_id: prev.employee_id.filter((id) => id !== empId),
                              }))
                            }}
                          >
                            ×
                          </span>
                        </div>
                      )
                    })}
                  </div>
                )}

                {errors.employee_id && (
                  <div className="text-danger mt-1 small">{errors.employee_id}</div>
                )}
              </CCol>

              {/* AMOUNT */}

              <CCol md={6}>
                <CFormLabel>
                  Amount <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  type="text"
                  name="amount"
                  placeholder="Enter Amount"
                  value={formData.amount}
                  onChange={handleChange}
                  invalid={!!errors.amount}
                />

                {errors.amount && <div className="text-danger mt-1 small">{errors.amount}</div>}
              </CCol>

              {/* EFFECTIVE FROM */}

              <CCol md={6}>
                <CFormLabel>
                  Effective From <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from}
                  onChange={handleChange}
                  invalid={!!errors.effective_from}
                />

                {errors.effective_from && (
                  <div className="text-danger mt-1 small">{errors.effective_from}</div>
                )}
              </CCol>

              {/* EFFECTIVE TO */}

              <CCol md={6}>
                <CFormLabel>Effective To</CFormLabel>

                <CFormInput
                  type="date"
                  name="effective_to"
                  value={formData.effective_to}
                  onChange={handleChange}
                />
              </CCol>

              {/* STATUS */}

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>

                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">Active</option>

                  <option value="false">Inactive</option>
                </CFormSelect>
              </CCol>

              {/* SUBMIT */}

              <CCol xs={12}>
                <CButton type="submit" color="primary" disabled={loading}>
                  {loading ? 'Submitting...' : 'Submit'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default EmployeeAddon
