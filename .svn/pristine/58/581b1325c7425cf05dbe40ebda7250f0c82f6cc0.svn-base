import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CTooltip,

CModal,
CModalBody,
CModalFooter,
CModalHeader,
CModalTitle,

} from '@coreui/react'
import { useEffect, useState } from 'react'
import { toast } from 'react-toastify'
import { cilHistory, cilPlus, cilViewColumn, cilDescription } from '@coreui/icons'
import { validateEmpSalaryStructure } from '../../validations/empSalaryStructureValidation'
import api from '../../api/axios'
import { useSelector } from 'react-redux'
import { useParams } from 'react-router-dom'
import CIcon from '@coreui/icons-react'
import IncrementModal from './IncrementModal'
import CtcHistoryModal from './CtcHistoryModal'
import SalaryBreakdownView from './SalaryBreakdownView'

const EmpSalaryStructureForm = ({ onSubmit }) => {
  const { id: salaryStructureId } = useParams()

  const [workOrder, setWorkOrder] = useState([])
  const [selectedWorkOrder, setSelectedWorkOrder] = useState('')
  const [employees, setEmployees] = useState([])
  const [selectedEmployees, setSelectedEmployees] = useState({})
  const [selectAll, setSelectAll] = useState(false)
  const [globalDate, setGlobalDate] = useState('')
  const [errors, setErrors] = useState({})
  const [incrementModal, setIncrementModal] = useState(false)
  const [selectedEmployee, setSelectedEmployee] = useState(null)
  const [historyModal, setHistoryModal] = useState(false)
  const [historyEmployee, setHistoryEmployee] = useState(null)
  const [viewModal, setViewModal] = useState(false)
  const [viewEmployee, setViewEmployee] = useState(null)

  const user = useSelector((state) => state.auth.user)

  const fetchWorkOrder = async () => {
    try {
      const response = await api.get('admin/workorder/index?is_active=true')
      setWorkOrder(response?.data?.data?.workOrderList || [])
    } catch (error) {
      console.error(error)
    }
  }

  const fetchEmployees = async (workOrderId) => {
    try {
      const res = await api.get(
        `employee-salary-structure/${salaryStructureId}/workorder/${workOrderId}`,
      )

      const list = res?.data?.data || []

      const prefillMap = {}

      list.forEach((emp) => {
        if (emp.ctc || emp.effective_from) {
          prefillMap[emp.employee_id] = {
            checked: false,
            value: emp.ctc,
            effective_from: emp.effective_from,
          }
        }
      })

      setEmployees(list)
      setSelectedEmployees(prefillMap)
    } catch (error) {
      console.error(error)
    }
  }

  useEffect(() => {
    fetchWorkOrder()
  }, [])

  useEffect(() => {
    if (selectedWorkOrder) {
      fetchEmployees(selectedWorkOrder)
    } else {
      setEmployees([])
    }

    setSelectedEmployees({})
    setSelectAll(false)
  }, [selectedWorkOrder])

  const show = selectedWorkOrder && salaryStructureId

  /* ================= HANDLERS ================= */

  const handleCheckbox = (id) => {
    const updated = {
      ...selectedEmployees,
      [id]: {
        ...selectedEmployees[id],
        checked: !selectedEmployees[id]?.checked,
      },
    }

    setSelectedEmployees(updated)

    const allSelected = employees.every((emp) => updated[emp.employee_id]?.checked)
    setSelectAll(allSelected)
  }

  const handleSelectAll = () => {
    const newValue = !selectAll
    setSelectAll(newValue)

    const updated = {}
    employees.forEach((emp) => {
      updated[emp.employee_id] = {
        ...selectedEmployees[emp.employee_id],
        checked: newValue,
      }
    })

    setSelectedEmployees(updated)
  }

  const handleChange = (id, field, value) => {
    setSelectedEmployees((prev) => ({
      ...prev,
      [id]: {
        ...prev[id],
        [field]: value,
      },
    }))
  }

  const handleApplyDateToSelected = () => {
    if (!globalDate) {
      alert('Please select a date first')
      return
    }

    const updated = { ...selectedEmployees }

    employees.forEach((emp) => {
      if (updated[emp.employee_id]?.checked) {
        updated[emp.employee_id].effective_from = globalDate
      }
    })

    setSelectedEmployees(updated)
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    const validationErrors = validateEmpSalaryStructure(selectedEmployees)
    setErrors(validationErrors)

    if (Object.keys(validationErrors).length > 0) return

    const finalData = Object.entries(selectedEmployees)
      .filter(([_, v]) => v.checked)
      .map(([id, v]) => ({
        employee_id: Number(id),
        salary_structure_id: Number(salaryStructureId),
        ctc: v.value,
        effective_from: v.effective_from,
        created_by: user?.id,
      }))

    onSubmit(finalData)
  }

  const selectedCount = Object.values(selectedEmployees).filter((e) => e?.checked).length

  /* ================= UI ================= */

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        <CCol md={12}>
          <CCard className="mb-3">
            <CCardBody>
              <CRow>
                <CCol md={6}>
                  <CFormLabel>Work Orders</CFormLabel>
                  <CFormSelect
                    value={selectedWorkOrder}
                    onChange={(e) => setSelectedWorkOrder(e.target.value)}
                  >
                    <option value="">Select</option>
                    {workOrder.map((item) => (
                      <option key={item.id} value={item.id}>
                        {item.work_order_no}
                      </option>
                    ))}
                  </CFormSelect>
                </CCol>
              </CRow>
            </CCardBody>
          </CCard>
        </CCol>

        {show && (
          <CCol md={12}>
            <CCard>
              <CCardBody>
                <div className="d-flex justify-content-between align-items-center mb-3">
                  <h6>Employees</h6>

                  <div className="d-flex align-items-center gap-2">
                    <span>Effective Date:</span>

                    <CFormInput
                      type="date"
                      value={globalDate}
                      onChange={(e) => setGlobalDate(e.target.value)}
                      style={{ width: '180px' }}
                    />

                    <CButton
                      size="sm"
                      color="primary"
                      onClick={handleApplyDateToSelected}
                      disabled={selectedCount === 0}
                    >
                      Apply to Selected
                    </CButton>

                    <span className="text-muted">Selected: {selectedCount}</span>
                  </div>
                </div>

                <table className="table table-bordered align-middle">
                  <thead>
                    <tr>
                      <th className="text-center">
                        <input type="checkbox" checked={selectAll} onChange={handleSelectAll} />
                      </th>

                      <th>Employee Name</th>

                      <th>CTC</th>

                      <th>Effective From</th>

                      <th className="text-center">Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    {employees.map((emp) => {
                      const selected = selectedEmployees[emp.employee_id] || {}

                      return (
                        <tr
                          key={emp.employee_id}
                          style={{
                            background: selected.checked ? '#e7f1ff' : 'transparent',
                          }}
                        >
                          {/* CHECKBOX */}
                          <td className="text-center">
                            <input
                              type="checkbox"
                              checked={!!selected.checked}
                              onChange={() => handleCheckbox(emp.employee_id)}
                            />
                          </td>

                          {/* EMPLOYEE NAME */}
                          <td>{emp.name}</td>

                          {/* CTC */}
                          <td>
                            <div className="input-group">
                              <span className="input-group-text">₹</span>

                              <CFormInput
                                type="number"
                                value={selected.value || ''}
                                readOnly={!selected.checked}
                                className={errors[emp.employee_id]?.ctc ? 'is-invalid' : ''}
                                onChange={(e) =>
                                  handleChange(emp.employee_id, 'value', e.target.value)
                                }
                              />
                            </div>

                            {errors[emp.employee_id]?.ctc && (
                              <div className="text-danger small">{errors[emp.employee_id].ctc}</div>
                            )}
                          </td>

                          {/* EFFECTIVE FROM */}
                          <td>
                            <CFormInput
                              type="date"
                              value={selected.effective_from || ''}
                              readOnly={!selected.checked}
                              className={
                                errors[emp.employee_id]?.effective_from ? 'is-invalid' : ''
                              }
                              onChange={(e) =>
                                handleChange(emp.employee_id, 'effective_from', e.target.value)
                              }
                            />

                            {errors[emp.employee_id]?.effective_from && (
                              <div className="text-danger small">
                                {errors[emp.employee_id].effective_from}
                              </div>
                            )}
                          </td>

                          {/* ACTIONS */}
                          <td className="text-center">
                            <div className="d-flex justify-content-center gap-2">
                              {/* INCREMENT */}
                              <CTooltip content="Add Increment" placement="top">
                                <div>
                                  <CButton
                                    type="button"
                                    size="sm"
                                    style={{
                                      background: '#f4f4f5',
                                      border: '1px solid #d4d4d8',
                                      color: '#4b5563',
                                      width: '32px',
                                      height: '30px',
                                      padding: 0,
                                      transition: 'all 0.2s ease',
                                    }}
                                    onMouseEnter={(e) => {
                                      e.currentTarget.style.background = '#6f63e9'
                                      e.currentTarget.style.color = '#fff'
                                      e.currentTarget.style.border = '1px solid #6f63e9'
                                    }}
                                    onMouseLeave={(e) => {
                                      e.currentTarget.style.background = '#f4f4f5'
                                      e.currentTarget.style.color = '#4b5563'
                                      e.currentTarget.style.border = '1px solid #d4d4d8'
                                    }}
                                    onClick={() => {
                                      setSelectedEmployee(emp)
                                      setIncrementModal(true)
                                    }}
                                  >
                                    <CIcon icon={cilPlus} size="sm" />
                                  </CButton>
                                </div>
                              </CTooltip>

                              {/* HISTORY */}
                              <CTooltip content="History" placement="top">
                                <div>
                                  <CButton
                                    type="button"
                                    size="sm"
                                    style={{
                                      background: '#f4f4f5',
                                      border: '1px solid #d4d4d8',
                                      color: '#4b5563',
                                      width: '32px',
                                      height: '30px',
                                      padding: 0,
                                      transition: 'all 0.2s ease',
                                    }}
                                    onMouseEnter={(e) => {
                                      e.currentTarget.style.background = '#6f63e9'
                                      e.currentTarget.style.color = '#fff'
                                      e.currentTarget.style.border = '1px solid #6f63e9'
                                    }}
                                    onMouseLeave={(e) => {
                                      e.currentTarget.style.background = '#f4f4f5'
                                      e.currentTarget.style.color = '#4b5563'
                                      e.currentTarget.style.border = '1px solid #d4d4d8'
                                    }}
                                    onClick={() => {
                                      setHistoryEmployee(emp)
                                      setHistoryModal(true)
                                    }}
                                  >
                                    <CIcon icon={cilHistory} size="sm" />
                                  </CButton>
                                </div>
                              </CTooltip>


{/* VIEW BREAKDOWN */}
<CTooltip content="View Salary Breakdown" placement="top">
  <div>
    <CButton
      type="button"
      size="sm"
      style={{
        background: '#f4f4f5',
        border: '1px solid #d4d4d8',
        color: '#4b5563',
        width: '32px',
        height: '30px',
        padding: 0,
        transition: 'all 0.2s ease',
      }}
      onMouseEnter={(e) => {
        e.currentTarget.style.background = '#6f63e9'
        e.currentTarget.style.color = '#fff'
        e.currentTarget.style.border = '1px solid #6f63e9'
      }}
      onMouseLeave={(e) => {
        e.currentTarget.style.background = '#f4f4f5'
        e.currentTarget.style.color = '#4b5563'
        e.currentTarget.style.border = '1px solid #d4d4d8'
      }}
      onClick={() => {
        setViewEmployee(emp)
        setViewModal(true)
      }}
    >
      <CIcon icon={cilDescription} size="sm" />
    </CButton>
  </div>
</CTooltip>



                            </div>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>

                <div className="text-end mt-3">
                  <CButton type="submit" color="primary" disabled={selectedCount === 0}>
                    Save
                  </CButton>
                </div>
              </CCardBody>
            </CCard>
          </CCol>
        )}
      </CRow>

      <IncrementModal
        visible={incrementModal}
        employee={selectedEmployee}
        onClose={() => {
          setIncrementModal(false)
          setSelectedEmployee(null)
        }}
        onSave={(data) => {
          console.log('Increment Saved', data)

          toast.success('Increment added successfully')

          setIncrementModal(false)
          setSelectedEmployee(null)
        }}
      />

      <CtcHistoryModal
        visible={historyModal}
        employee={historyEmployee}
        onClose={() => {
          setHistoryModal(false)
          setHistoryEmployee(null)
        }}
      />
      <CModal
  visible={viewModal}
  size="xl"
  alignment="center"
  scrollable
  onClose={() => {
    setViewModal(false)
    setViewEmployee(null)
  }}
>
  <CModalHeader>
    <CModalTitle>
      Salary Breakdown
      {viewEmployee?.name ? ` - ${viewEmployee.name}` : ''}
    </CModalTitle>
  </CModalHeader>

  <CModalBody>
    <SalaryBreakdownView />
  </CModalBody>

  <CModalFooter>
    <CButton
      color="secondary"
      onClick={() => {
        setViewModal(false)
        setViewEmployee(null)
      }}
    >
      Close
    </CButton>
  </CModalFooter>
</CModal>
    </CForm>
  )
}

export default EmpSalaryStructureForm
