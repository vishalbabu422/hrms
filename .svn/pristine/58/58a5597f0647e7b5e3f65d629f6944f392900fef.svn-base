import { CCol,CFormLabel, CFormSelect } from '@coreui/react'
import { useEffect, useState } from 'react'
import api from '../../api/axios'
import Select from 'react-select'
import './select.css'

const CompanySelect = ({
  name = 'company_id',
  value = '',
  onChange,
  label = 'Company',
  placeholder = 'Select Company',
  disabled = false,
  colSize = 12,
}) => {
  const [companyList, setCompanyList] = useState([])

  useEffect(() => {
    const fetchCompany = async () => {
      try {
        const response = await api.get('/admin/company/index?is_active=true&sort=company_name', {
          params: {
            fields: 'id,company_name',
          },
        })

        setCompanyList(response?.data?.data?.companyList || [])
      } catch (error) {
        console.error('Failed to fetch Company:', error)
      }
    }

    fetchCompany()
  }, [])

  const options = companyList.map((item) => ({
    value: item.id,
    label: item.company_name,
  }))

    return (
    <CCol md={colSize}>
      <CFormLabel>{label}</CFormLabel>

      <Select
        name={name}
        options={options}
        placeholder={placeholder}
        isSearchable
        isClearable
        isDisabled={disabled}
        classNamePrefix="react-select"
        value={options.find((option) => String(option.value) === String(value)) || null}
        onChange={(selected) =>
          onChange({
            target: {
              name,
              value: selected ? selected.value : '',
            },
          })
        }
      />
    </CCol>
  )
}

export default CompanySelect