import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CButton, CCard, CCardHeader, CCardBody } from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'
import {  getEmployeeDocuments, downloadEmployeeDocument,} from '../../../services/employeeDocuments'

const DocumentsView = () => {
  const { employeeId } = useParams()

  const [documents, setDocuments] = useState([])
  const [loading, setLoading] = useState(false)

  /* ================= FETCH DOCUMENTS ================= */
getEmployeeDocuments(employeeId)
  .then((res) => {
    console.log('DOCUMENT RESPONSE:', res.data)

    const data = res.data?.data || {}
    const docs = data.EmployeeDocuments || []

    setDocuments(docs)
  })
  /* ================= DOWNLOAD ================= */
  const handleDownload = async (doc) => {
    try {
      const res = await downloadEmployeeDocument(employeeId, doc.id)

      const url = window.URL.createObjectURL(new Blob([res.data]))
      const link = document.createElement('a')

      link.href = url
      link.setAttribute(
        'download',
        doc.file_name || doc.document_type || 'file'
      )

      document.body.appendChild(link)
      link.click()
    } catch (err) {
      console.error('Download error:', err)
    }
  }

  return (
    <div className="row g-4">
      <div className="col-12">
        <CCard className="border-0 shadow-sm">
          <CCardHeader className="bg-light fw-semibold">
            Documents
          </CCardHeader>

          <CCardBody>

            {/* LOADING */}
            {loading && (
              <div className="text-muted">Loading documents...</div>
            )}

            {/* EMPTY */}
            {!loading && documents.length === 0 && (
              <div className="text-muted">No documents found</div>
            )}

            {/* LIST */}
            {!loading &&
              documents.map((doc) => (
                <div
                  key={doc.id}
                  className="mb-4 d-flex justify-content-between align-items-center border-bottom pb-2"
                >
                  <div>
                    <small className="text-muted">
                      {doc.document_type || 'Document'}
                    </small>

                    <div className="fw-semibold">
                      {doc.file_name || 'No document uploaded'}
                    </div>
                  </div>

                  <CButton
                    size="sm"
                    variant="outline"
                    onClick={() => handleDownload(doc)}
                  >
                    <CIcon icon={cilCloudDownload} />
                  </CButton>
                </div>
              ))}

          </CCardBody>
        </CCard>
      </div>
    </div>
  )
}

export default DocumentsView