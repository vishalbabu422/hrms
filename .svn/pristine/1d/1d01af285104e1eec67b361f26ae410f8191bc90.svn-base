import { useState, useEffect, forwardRef, useImperativeHandle } from 'react'
import api from '../../../api/axios'
import { toast } from 'react-toastify'

const Address = forwardRef(({ employeeId, isEdit }, ref) => {
  const [loading, setLoading] = useState(false)

  const createAddress = (type, isPrimary = false) => ({
    address_type: type,
    address: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: '',
    pin_code: '',
    is_primary: isPrimary,
  })

  const initialAddressDetails = {
    correspondence: createAddress('CORRESPONDENCE', true),
    permanent: createAddress('PERMANENT'),
  }

  const [employeeAddress, setEmployeeAddress] = useState(initialAddressDetails)
  const [sameAddress, setSameAddress] = useState(false)

  // ================= FETCH ADDRESS =================
  useEffect(() => {
    if (!employeeId) return

    const fetchAddress = async () => {
      try {
        const response = await api.get(`/employee/${employeeId}/address`)

        const data = response.data?.data || response.data
        const correspondence = data.find((a) => a.address_type === 'CORRESPONDENCE')

        const permanent = data.find((a) => a.address_type === 'PERMANENT')

        setEmployeeAddress({
          correspondence: correspondence || initialAddressDetails.correspondence,
          permanent: permanent || initialAddressDetails.permanent,
        })
      } catch (error) {
        console.error('Error fetching address', error)
      }
    }

    fetchAddress()
  }, [employeeId])

  // EXPOSE SUBMIT TO PARENT
  useImperativeHandle(ref, () => ({
    submit: async () => {
      try {
        setLoading(true)

        const url = `/employee/${employeeId}/address`
        const addresses = [employeeAddress.correspondence, employeeAddress.permanent]

        for (const addr of addresses) {
          const isEmpty = !addr.address_line1 && !addr.city && !addr.state && !addr.pin_code

          if (isEmpty) continue
          if (addr.id) {
            await api.post(url + '/' + addr.id, addr)
          } else {
            await api.post(url, addr)
          }
        }

        toast.success('Address saved successfully')
        return true
      } catch (error) {
        console.error(error)
        toast.error(error.response?.data?.message || 'Failed to save addresses')
        return false
      } finally {
        setLoading(false)
      }
    },
  }))

  // ================= HANDLE CORRESPONDENCE =================

  const handleCorrespondenceChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      correspondence: {
        ...prev?.correspondence,
        [name]: value,
      },
    }))

    if (sameAddress) {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: {
          ...prev?.permanent,
          [name]: value,
        },
      }))
    }
  }

  // ================= HANDLE PERMANENT =================

  const handlePermanentChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      permanent: {
        ...prev?.permanent,
        [name]: value,
      },
    }))
  }

  // ================= SAME ADDRESS =================

  const handleSameAddressToggle = () => {
    const checked = !sameAddress
    setSameAddress(checked)

    if (checked) {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: {
          ...prev?.correspondence,
          address_type: 'PERMANENT',
          is_primary: false,
        },
      }))
    } else {
      setEmployeeAddress((prev) => ({
        ...prev,
        permanent: initialAddressDetails.permanent,
      }))
    }
  }

  const addressFields = ['landmark', 'city', 'district', 'state', 'country', 'pin_code']

  return (
    <>
      {/* ================= Correspondence ================= */}
      <div className="card mb-4 shadow-sm">
        <div className="card-header bg-light fw-semibold">Correspondence Address</div>

        <div className="card-body">
          <div className="row g-3">
            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.correspondence?.address_line1 || ''}
                onChange={handleCorrespondenceChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.correspondence?.[field] || ''}
                  onChange={handleCorrespondenceChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ================= Permanent ================= */}
      <div className="card shadow-sm">
        <div className="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
          Permanent Address
          <div className="form-check mb-0">
            <input
              className="form-check-input"
              type="checkbox"
              checked={sameAddress}
              onChange={handleSameAddressToggle}
            />

            <label className="form-check-label small">Same as Correspondence</label>
          </div>
        </div>

        <div className="card-body">
          <div className="row g-3">
            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.permanent?.address_line1 || ''}
                onChange={handlePermanentChange}
                disabled={sameAddress}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.permanent?.[field] || ''}
                  onChange={handlePermanentChange}
                  placeholder={`Enter ${field}`}
                  disabled={sameAddress}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </>
  )
})

export default Address
