const router = require('express').Router();
const EmployeeController = require('./employee.controller');

const {
    protect,
    restrictTo,
    checkPermission,
    checkOrgScope,
    injectOrgScope
} = require("../../middlewares/authMiddleware");

const ROLES = ["ORG_ADMIN", "SUPER_ADMIN"];
/*
|--------------------------------------------------------------------------
| Employee Dependent Routes
|--------------------------------------------------------------------------
*/
router.use("/:employeeId/examinations", require("./exam/employeeExamination.routes"));
router.use("/:employeeId/divisions", require("./division/employeeDivision.routes"));
router.use("/:employeeId/designations", require("./designation/employeeDesignation.routes"));
router.use("/:employeeId/address", require("./address/address.routes"));
router.use("/:employeeId/family", require("./family/family.routes"));
router.use("/:employeeId/qualification", require("./qualification/qualification.routes"));
router.use("/:employeeId/experiences", require("./experience/experience.routes"));
router.use("/:employeeId/bankId", require("./bank/bank.routes"));
router.use("/:employeeId/Insurance", require("./insurance/insurance.routes"));
router.use("/:employeeId/screeningtest", require("./screeningTest/screeningTest.routes"));
router.use("/:employeeId/ltc", require("./ltc/ltc.routes"));
router.use("/:employeeId/documents", require("./document/document.routes"));
router.use("/:employeeId/skills", require("./skills/skills.routes"));
router.use("/:employeeId/health", require("./health/health.routes"));
router.use("/:employeeId/vaccination", require("./vaccination/vaccination.routes"));
router.use("/:employeeId/vehicles", require("./vehicle/vehicle.routes"));
router.use("/:employeeId/hobbies", require("./hobby/hobby.routes"));
router.use("/:employeeId/achievements", require("./achievement/achievement.routes"));
router.use("/:employeeId/assets", require("./asset/asset.routes"));
router.use("/:employeeId/languages", require("./language/language.routes"));
router.use("/:employeeId/passport-visa", require("./passportVisa/passportVisa.routes"));
router.use("/:employeeId/discipline", require("./discipline/discipline.routes"));
router.use("/:employeeId/details", require("./detail/detail.routes"));
router.use("/:employeeId/trainings", require("./training/training.routes"));


/*
|--------------------------------------------------------------------------
| Employee Collection Routes
|--------------------------------------------------------------------------
*/

router
    .route("/")
    .get(
        protect,
        restrictTo(...ROLES),
        // checkPermission("EMPLOYEE.READ"),
        injectOrgScope(),
        EmployeeController.getEmployeeList
    )
    .post(
        protect,
        // restrictTo(...ROLES),
        // checkPermission("EMPLOYEE.CREATE"),
        injectOrgScope(),
        EmployeeController.create
    );


/*
|--------------------------------------------------------------------------
| Employee Single Record Routes
|--------------------------------------------------------------------------
*/

router
    .route("/:id")
    .get(
        protect,
        restrictTo(...ROLES),
        checkPermission("EMPLOYEE.READ"),
        injectOrgScope(),
        EmployeeController.getEmployeeById
    )
    .patch(
        protect,
        restrictTo(...ROLES),
        checkPermission("EMPLOYEE.UPDATE"),
        EmployeeController.editById
    )
    .delete(
        protect,
        restrictTo(...ROLES),
        checkPermission("EMPLOYEE.DELETE"),
        EmployeeController.deleteById
    );

router
    .route("/:id/status")
    .patch(
        protect,
        restrictTo(...ROLES),
        checkPermission("EMPLOYEE.APPROVE"),
        EmployeeController.updateStatus
    );

module.exports = router;
