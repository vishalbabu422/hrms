import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormTextarea,
  CRow,
} from '@coreui/react'
import { useEffect, useMemo, useState } from 'react'
import api from '../../api/axios'
import GstSelect from '../components/gst-select'
import WoDesignationSelect from '../components/wo-designation-select'
import { useNavigate, useParams } from 'react-router-dom'
import { toast } from 'react-toastify'
import { calculateAmounts, calculateDuration } from '../../utils/workOrderCalculations'

const emptyReplica = {
  sac_code: '',
  description: '',
  desgn_id_fk: '',
  req_person_count: '',
  duration_days: '',
  monthly_unit_rate: '',
  deployment_from: '',
  deployment_to: '',

  cgst_amount: 0,
  sgst_amount: 0,
  igst_amount: 0,

  totalDays: 0,
  months: 0,
  days: 0,
  dayMonthDays: 0,

  cgst_percent: 0,
  sgst_percent: 0,
  igst_percent: 0,
}

const defaultInitialData = {
  workOrderId: '',
  deployments: [],
}

