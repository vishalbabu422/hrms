import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle,cilDescription } from '@coreui/icons'
import { CSpinner } from '@coreui/react'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import api from '../../api/axios'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')

  // designation list and loader
  const [designation, setDesignation] = useState([])
  const [loading, setLoading] = useState(false)

  // fetch all the availale gst codes
  const fetchDesignation = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/designation/index', { params })
      setDesignation(response.data.data.DesignationList)

      setTotalPages(response.data.totalPages)
    } catch (error) {
      console.error(error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchDesignation()
    }
  }, [search, sort, page])

  //sort
  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // delete
  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Designation?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/designation/delete/${id}`)

      toast.success('Designation deleted successfully')

      fetchDesignation()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete Designation')
    }
  }

  const navigate = useNavigate()


const ActionButton = ({ color, icon, onClick }) => (
  <CButton
    size="sm"
    color={color}
    variant="ghost"
    onClick={onClick}
    className="rounded-circle"
  >
    <CIcon icon={icon} />
  </CButton>
)


  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Designation</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch onSearch={setSearch} placeholder="Search By Designation" />
              <CTooltip content="Add Designation" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/designation/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide={true} style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Empanelment No"
                      sortKey="empanelment_no"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Type"
                      sortKey="type"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Designation"
                      sortKey="designation"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Qualification"
                      sortKey="qualification"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Exp(in yrs)"
                      sortKey="qualification"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Status"
                      sortKey="status"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>
                <CTableBody>
                  {loading ? (
                    <CTableRow>
                      <CTableDataCell colSpan={13} className="text-center py-4">
                        <CSpinner size="sm" />
                      </CTableDataCell>
                    </CTableRow>
                  ) : designation?.length > 0 ? (
                    designation.map((item) => (
                      <CTableRow key={item.id}>
                        <CTableDataCell>{item.empanelment.empanelment_no}</CTableDataCell>
                        <CTableDataCell>{item.type}</CTableDataCell>
                        <CTableDataCell>{item.designation}</CTableDataCell>
                        <CTableDataCell>{item.qualification}</CTableDataCell>
                        <CTableDataCell>{item.exp_in_years}</CTableDataCell>

                        <CTableDataCell>
                          {item.is_active ? (
                            <CIcon icon={cilCheckCircle} className="text-success" />
                          ) : (
                            <CIcon icon={cilXCircle} className="text-danger" />
                          )}
                        </CTableDataCell>

                        <CTableDataCell>
                          <div className="d-flex gap-2">
                            <CTooltip content="Preview" placement="top">
                              <div>
                                <ActionButton
                                  color="primary"
                                  icon={cilDescription}
                                  onClick={() => navigate(`/designation/preview/${item.id}`)}
                                />
                              </div>
                            </CTooltip>
                            <CTooltip content="Edit" placement="left">
                              <CButton
                                color="primary"
                                size="sm"
                                variant="ghost"
                                onClick={() => navigate(`/designation/edit/${item.id}`)}
                              >
                                <CIcon icon={cilPencil} />
                              </CButton>
                            </CTooltip>
                            {item.is_active && (
                              <CTooltip content="Delete" placement="right">
                                <CButton
                                  color="danger"
                                  size="sm"
                                  variant="ghost"
                                  onClick={() => confirmDelete(item.id)}
                                >
                                  <CIcon icon={cilTrash} />
                                </CButton>
                              </CTooltip>
                            )}
                          </div>
                        </CTableDataCell>
                      </CTableRow>
                    ))
                  ) : (
                    <TableEmptyState colSpan={13} />
                  )}
                </CTableBody>
              </CTable>
            </SimpleBar>
            <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
