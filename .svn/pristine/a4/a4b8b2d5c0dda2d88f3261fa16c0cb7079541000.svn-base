const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Model
const {
  WorkOrder,
  WoDesgnMapping,
  Employee,
  EmployeeWorkOrderDeployment,
} = require("../models");
const sequelize = require("../utils/database");
const { Sequelize } = require("sequelize");

const getByWorkOrderId = catchAsync(async (req, res, next) => {
  const { work_order_id } = req.params;

  if (!work_order_id) {
    return res.status(400).json({
      status: "fail",
      message: "work_order_id is required",
    });
  }

  // Optional but good practice: validate WorkOrder exists
  const workOrder = await WorkOrder.findByPk(work_order_id);

  if (!workOrder) {
    return res.status(404).json({
      status: "fail",
      message: "Work Order not found",
    });
  }

  const deployments = await WoDesgnMapping.findAll({
    where: {
      work_order_id,
      is_active: true,
    },
    order: [["id", "ASC"]],
  });

  return res.status(200).json({
    status: "success",
    results: deployments.length,
    data: {
      workOrderDesgnList: deployments,
    },
  });
});

const create = catchAsync(async (req, res, next) => {
  const { work_order_id, deployments } = req.body;

  if (!work_order_id) {
    return res.status(400).json({
      status: "fail",
      message: "work_order_id is required",
    });
  }

  if (!Array.isArray(deployments)) {
    return res.status(400).json({
      status: "fail",
      message: "deployments must be an array",
    });
  }

  const transaction = await sequelize.transaction();

  try {
    // Validate Work Order exists
    const workOrder = await WorkOrder.findByPk(work_order_id, { transaction });

    if (!workOrder) {
      await transaction.rollback();
      return res.status(404).json({
        status: "fail",
        message: "Work Order not found",
      });
    }

    // Delete existing deployments
    await WoDesgnMapping.destroy({
      where: { work_order_id },
      transaction,
    });

    // Prepare new records
    const deploymentData = deployments.map((d) => ({
      work_order_id,
      sac_code: d.sac_code,
      description: d.description,
      desgn_id_fk: d.desgn_id_fk,
      req_person_count: d.req_person_count,
      duration_days: d.duration_days,
      monthly_unit_rate: d.monthly_unit_rate,
      deployment_from: d.deployment_from,
      deployment_to: d.deployment_to,
      cgst_amount: d.cgst_amount,
      sgst_amount: d.sgst_amount,
      igst_amount: d.igst_amount,
      created_by: 1,
      is_active: true,
    }));

    // Insert new deployments (only if any exist)
    let inserted = [];
    if (deploymentData.length > 0) {
      inserted = await WoDesgnMapping.bulkCreate(deploymentData, {
        transaction,
      });
    }

    await transaction.commit();

    return res.status(200).json({
      status: "success",
      message: "Deployments saved successfully",
      data: inserted,
    });
  } catch (error) {
    await transaction.rollback();
    throw error;
  }
});

const createDeployment = async (req, res) => {
  const transaction = await sequelize.transaction();

  try {
    const {
      wo_desgn_id,
      employee_id,
      joining_date,
      relieving_date,
      created_by,
    } = req.body;

    const userId = req.user?.id || null;

    if (!wo_desgn_id || !employee_id || !joining_date) {
      return res.status(400).json({
        message: "wo_desgn_id, employee_id and joining_date are required",
      });
    }

    // Check designation exists
    const designation = await WoDesgnMapping.findByPk(wo_desgn_id, {
      transaction,
    });

    if (!designation) {
      await transaction.rollback();
      return res
        .status(404)
        .json({ message: "Work order designation not found" });
    }

    // Check employee exists
    const employee = await Employee.findByPk(employee_id, { transaction });

    if (!employee) {
      await transaction.rollback();
      return res.status(404).json({ message: "Employee not found" });
    }

    // Optional: prevent duplicate deployment
    const existingDeployment = await EmployeeWorkOrderDeployment.findOne({
      where: {
        wo_desgn_id,
        employee_id,
        is_deleted: false,
      },
      transaction,
    });

    if (existingDeployment) {
      await transaction.rollback();
      return res.status(400).json({
        message: "Employee already deployed for this designation",
      });
    }

    const deployment = await EmployeeWorkOrderDeployment.create(
      {
        wo_desgn_id,
        employee_id,
        joining_date,
        relieving_date: relieving_date || null,
        created_by,
      },
      { transaction },
    );

    await transaction.commit();

    return res.status(201).json({
      message: "Employee deployed successfully",
      data: deployment,
    });
  } catch (error) {
    await transaction.rollback();
    console.error(error);

    return res.status(500).json({
      message: "Failed to create deployment",
      error: error.message,
    });
  }
};

const patchDeployment = async (req, res) => {
  const transaction = await sequelize.transaction();

  try {
    const { id } = req.params;

    const {
      wo_desgn_id,
      employee_id,
      joining_date,
      relieving_date,
      is_deleted,
      updated_by,
    } = req.body;

    const userId = req.user?.id || null;

    const deployment = await EmployeeWorkOrderDeployment.findByPk(id, {
      transaction,
    });

    if (!deployment) {
      await transaction.rollback();
      return res.status(404).json({
        message: "Deployment not found",
      });
    }

    // Validate designation if changing
    if (wo_desgn_id && wo_desgn_id !== deployment.wo_desgn_id) {
      const designation = await WoDesgnMapping.findByPk(wo_desgn_id, {
        transaction,
      });

      if (!designation) {
        await transaction.rollback();
        return res.status(404).json({
          message: "Work order designation not found",
        });
      }
    }

    // Validate employee if changing
    if (employee_id && employee_id !== deployment.employee_id) {
      const employee = await Employee.findByPk(employee_id, {
        transaction,
      });

      if (!employee) {
        await transaction.rollback();
        return res.status(404).json({
          message: "Employee not found",
        });
      }
    }

    // Prevent duplicate deployment
    if (wo_desgn_id || employee_id) {
      const checkWoDesgnId = wo_desgn_id || deployment.wo_desgn_id;
      const checkEmployeeId = employee_id || deployment.employee_id;

      const existingDeployment = await EmployeeWorkOrderDeployment.findOne({
        where: {
          wo_desgn_id: checkWoDesgnId,
          employee_id: checkEmployeeId,
          is_deleted: false,
          id: { [Sequelize.Op.ne]: id },
        },
        transaction,
      });

      if (existingDeployment) {
        await transaction.rollback();
        return res.status(400).json({
          message: "Employee already deployed for this designation",
        });
      }
    }

    // Apply updates only if provided
    if (wo_desgn_id !== undefined) deployment.wo_desgn_id = wo_desgn_id;
    if (employee_id !== undefined) deployment.employee_id = employee_id;
    if (joining_date !== undefined) deployment.joining_date = joining_date;
    if (relieving_date !== undefined)
      deployment.relieving_date = relieving_date || null;
    if (is_deleted !== undefined) deployment.is_deleted = is_deleted;

    deployment.updated_by = updated_by || userId;

    await deployment.save({ transaction });

    await transaction.commit();

    return res.status(200).json({
      message: "Deployment updated successfully",
      data: deployment,
    });
  } catch (error) {
    await transaction.rollback();
    console.error(error);

    return res.status(500).json({
      message: "Failed to update deployment",
      error: error.message,
    });
  }
};

const deleteDeployment = async (req, res, next) => {
  try {
    const { id } = req.params;

    const deployment = await EmployeeWorkOrderDeployment.findByPk(id);

    if (!deployment) {
      return res.status(404).json({
        status: "error",
        message: "Deployment not found",
      });
    }

    await deployment.update({
      is_deleted: true,
      updated_by: req.user?.id || null,
    });

    res.status(200).json({
      status: "success",
      message: "Deployment deleted successfully",
    });
  } catch (error) {
    next(error);
  }
};

module.exports = {
  getByWorkOrderId,
  create,
  createDeployment,
  patchDeployment,
  deleteDeployment,
};
