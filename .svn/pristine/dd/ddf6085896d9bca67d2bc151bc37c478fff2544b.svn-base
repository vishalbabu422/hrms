import React, { useEffect, useState } from 'react'
import { CFormSelect } from '@coreui/react'
import api from '../../../api/axios'

const WorkOrderSelect = ({ workOrder, setWorkOrder }) => {
  const [workOrders, setWorkOrders] = useState([])
  const [loading, setLoading] = useState(false)

  useEffect(() => {
    const fetchWorkOrders = async () => {
      try {
        setLoading(true)
        const res = await api.get('/admin/workorder/index?is_active=true')

        setWorkOrders(res.data?.data?.workOrderList || [])
      } catch (err) {
        console.error('Error fetching work orders', err)
      } finally {
        setLoading(false)
      }
    }

    fetchWorkOrders()
  }, [])

  return (
    <CFormSelect
      value={workOrder}
      onChange={(e) => setWorkOrder(e.target.value)}
      disabled={loading}
    >
      <option value="">{loading ? 'Loading Work Orders...' : 'Select Work Order'}</option>

      {workOrders.map((wo) => (
        <option key={wo.id} value={wo.id}>
          {wo.work_order_no} — {wo.project_name}
        </option>
      ))}
    </CFormSelect>
  )
}

export default WorkOrderSelect
