const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const EmpSalaryStructure = sequelize.define("EmpSalaryStructure", {

    id: {
        type: DataTypes.BIGINT,
        primaryKey: true,
        autoIncrement: true
    },

    employee_id: {
        type: DataTypes.BIGINT,
        allowNull: false
    },

    salary_structure_id: {
        type: DataTypes.BIGINT,
        allowNull: false,
        references: {
            model: {
                tableName: "salary_structure",
                schema: "pmu"
            },
            key: "id"
        },
        onUpdate: "NO ACTION",
        onDelete: "NO ACTION"
    },

    ctc: {
        type: DataTypes.DECIMAL(14, 2),
        allowNull: false
    },

    effective_from: {
        type: DataTypes.DATEONLY,
        allowNull: false
    },

    is_deleted: {
        type: DataTypes.BOOLEAN,
        defaultValue: false
    },

    created_by: {
        type: DataTypes.BIGINT
    },

    updated_by: {
        type: DataTypes.BIGINT
    }

}, {
    tableName: "employee_salary_structure",
    schema: "pmu",
    timestamps: true,
    createdAt: "created_at",
    updatedAt: "updated_at",

    indexes: [
        {
            unique: true,
            fields: ["employee_id", "effective_from"]
        }
    ]
});


// ================= ASSOCIATIONS =================
EmpSalaryStructure.associate = (models) => {

    // Optional relation (since DB me FK nahi hai)
    EmpSalaryStructure.belongsTo(models.Employee, {
        foreignKey: "employee_id",
        as: "employee",
        constraints: false   
    });

    EmpSalaryStructure.belongsTo(models.SalaryStructure, {
        foreignKey: "salary_structure_id",
        as: "salaryStructure"
    });
    

};

module.exports = EmpSalaryStructure;
