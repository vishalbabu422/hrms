import React, { useState } from 'react'
import {
  CCard,
  CCardBody,
  CCardHeader,
  CForm,
  CFormLabel,
  CFormInput,
  CFormSelect,
  CButton,
  CRow,
  CCol,
} from '@coreui/react'

import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

const DivisionFormComponent = ({
  initialData,
  onSubmit,
  mode,
  exportData = [],
}) => {
  const [formData, setFormData] = useState(initialData)

  const handleChange = (e) => {
    const { name, value }

    = e.target

    setFormData((prev) => ({
      ...prev,
      [name]: name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    if (!formData.division.trim()) {
      alert('Division is required')
      return
    }

    onSubmit(formData)
  }

  /* ================= EXPORT ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15

    doc.setFontSize(14)
    doc.text('Division List', 10, 10)

    exportData.forEach((item, index) => {
      doc.text(
        `${index + 1}. ${item.division} - ${
          item.is_active ? 'Active' : 'Inactive'
        }`,
        10,
        y
      )
      y += 8
    })

    doc.save('division-list.pdf')
  }

  const handleExportExcel = () => {
    const formattedData = exportData.map((item, index) => ({
      'Sr No': index + 1,
      Division: item.division,
      Status: item.is_active ? 'Active' : 'Inactive',
    }))

    const worksheet = XLSX.utils.json_to_sheet(formattedData)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Divisions')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type:
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'division-list.xlsx')
  }

  return (
    <CCard>

      {/* Header with Export */}
      <CCardHeader className="d-flex justify-content-between align-items-center">
        <strong>
          {mode === 'create' ? 'Add Division' : 'Edit Division'}
        </strong>

        {exportData.length > 0 && (
          <div className="d-flex gap-2">
            <CButton size="sm" color="secondary" onClick={handleExportPDF}>
              Export PDF
            </CButton>
            <CButton size="sm" color="success" onClick={handleExportExcel}>
              Export Excel
            </CButton>
          </div>
        )}
      </CCardHeader>

      <CCardBody>
        <CForm onSubmit={handleSubmit}>
          <CRow>

            <CCol md={6}>
              <CFormLabel>Division</CFormLabel>
              <CFormInput
                type="text"
                name="division"
                value={formData.division}
                onChange={handleChange}
                placeholder="Enter division name"
              />
            </CCol>

            <CCol md={6}>
              <CFormLabel>Status</CFormLabel>
              <CFormSelect
                name="is_active"
                value={formData.is_active}
                onChange={handleChange}
              >
                <option value={true}>Active</option>
                <option value={false}>Inactive</option>
              </CFormSelect>
            </CCol>

          </CRow>

          <div className="mt-3">
            <CButton type="submit" color="primary">
              {mode === 'create' ? 'Save' : 'Update'}
            </CButton>
          </div>

        </CForm>
      </CCardBody>
    </CCard>
  )
}

export default DivisionFormComponent