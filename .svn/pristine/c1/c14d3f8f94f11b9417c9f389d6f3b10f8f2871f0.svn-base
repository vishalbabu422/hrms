                },
                "total": {
                  "type": "integer",
                  "example": 42
                },
                "results": {
                  "type": "integer",
                  "example": 10
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/workflowRoleResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowRole"],
        "summary": "Create Workflow Role",
        "description": "Create a new workflow role record.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Workflow role data to be created",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "workflowRole": {
                  "$ref": "#/definitions/workflowRoleCreate"
                }
              },
              "required": ["workflowRole"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Workflow Role successfully created",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Workflow Role Created!"
                },
                "data": {
                  "type": "object",
