    "/admin/trashList": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-Trash"],
        "summary": "Get Trash List",
        "description": "Get all the Trash List by passing parameters!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "is_deleted",
            "description": "Filter any field (Ex. is_deleted : true)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "deleted_by",
            "description": "Filter any field (Ex. deleted_by : 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "description": "Ex. (id desc)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "description": "Ex. (workflow_state_id,status,created_by,modified_by,created,modified,...)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "models",
            "description": "Join with ContentCatalogField, Ex. (ContentCatalogField.title,ContentMetadataMappings.value,ContentMetadataMappings.metadata_id,...)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "modelFilter",
            "description": "Filter by type, Ex. {\"ContentCatalogField\":{\"type\":[2],...},\"ContentMetadataMappings\":{\"metadata_id\":\"7\",...},...}",
            "in": "query",
            "required": false,
            "type": "object"
          },
          {
            "name": "page",
            "description": "Pagination page no. (Ex. 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "Pagination limit. (Ex. 10)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/contentCatalogResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-Trash"],
        "summary": "Delete Multiple Trash Items",
        "description": "Permanently delete one or more trashed ContentCatalog records. Only items with `is_deleted = true` will be removed.",
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Array of ContentCatalog IDs to permanently delete",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "example": 5
                  },
                  "example": [1, 2, 3]
                }
              },
              "required": ["ids"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful deletion",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "3 trash item(s) permanently deleted."
                }
              }
            }
          },
          "400": {
            "description": "Invalid input — when IDs are missing or not an array",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "No matching trash items found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-Trash"],
        "summary": "Restore Multiple Trash Items",
        "description": "Restore one or more trashed ContentCatalog records by setting `is_deleted = false`.",
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Array of ContentCatalog IDs to restore",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "example": 5
                  },
                  "example": [1, 2, 3]
                }
              },
              "required": ["ids"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful restore",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "3 trash item(s) restored successfully."
                }
              }
            }
          },
          "400": {
            "description": "Invalid input — when IDs are missing or not an array",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "No matching trashed items found",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/trashList/{id}": {
      "delete": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-Trash"],
        "summary": "Delete Trash",
        "description": "Delete Trash",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ContentCatalog id that needs to be deleted",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/contentCatalogResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-Trash"],
        "summary": "Restore Trash",
        "description": "Restore Trash",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ContentCatalog id that needs to be Restore",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/contentCatalogResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/workflowAction": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowAction"],
        "summary": "Get Workflow Actions",
        "description": "Retrieve a paginated, filtered, and sorted list of workflow actions. Excludes deleted records (`is_deleted = 0`).",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "action_name",
            "in": "query",
            "description": "Filter fields (e.g., action_name:Share)",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting order, e.g., (id desc)",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated list of fields to include (e.g., id,action_name,status)",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Pagination page number (e.g., 1)",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page (e.g., 10)",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow actions retrieved successfully.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Workflow actions retrieved successfully."
                },
                "total": {
                  "type": "integer",
                  "example": 42
                },
                "results": {
                  "type": "integer",
                  "example": 10
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/workflowActionResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No workflow actions found.",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowAction"],
        "summary": "Create Workflow Action",
        "description": "Creates a new workflow action record in the system. Only accessible by authorized users (e.g., System Admin).",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Workflow Action data to be created",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "WorkflowAction": {
                  "type": "object",
                  "properties": {
                    "action_name": {
                      "type": "string",
                      "example": "Submit"
                    }
                  }
                }
              },
              "required": ["WorkflowAction"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Workflow Action successfully created",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Workflow Action Created!"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 101
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input — 'workflowAction' object is required",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/workflowAction/{id}": {
      "put": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowAction"],
        "summary": "Update Workflow Action",
        "description": "Update details of a specific workflow action record by ID.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the workflow action to update",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Fields to update in the workflow action",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "action_name": {
                  "type": "string",
                  "example": "Review Document"
                },
                "status": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow Action Updated Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Workflow Action Updated!"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 10
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing ID",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "Workflow Action not found or no changes applied",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowAction"],
        "summary": "Delete Workflow Action(s)",
        "description": "Permanently delete one or more workflow actions by ID(s). Only inactive actions (status = false) can be deleted.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of a single workflow action to delete (optional if 'ids' array is sent in body)",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Provide one or more IDs to delete",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "example": 5
                  },
                  "example": [5, 6, 7]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow Action(s) deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "3 workflow action(s) permanently deleted."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — No IDs provided",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "404": {
            "description": "No matching workflow actions found or actions are active",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/admin/workflowRole": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Admin-WorkflowRole"],
        "summary": "Get Workflow Roles",
