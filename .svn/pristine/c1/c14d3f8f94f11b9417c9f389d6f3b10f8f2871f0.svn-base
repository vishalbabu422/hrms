            "type": "string"
          },
          {
            "name": "role_id",
            "description": "Filter any field (Ex. role_id : 2)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "description": "Ex. (id desc)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "description": "Ex. (employee_id, role_id)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "Pagination page no. (Ex. 1)",
            "in": "query",
            "required": false,
