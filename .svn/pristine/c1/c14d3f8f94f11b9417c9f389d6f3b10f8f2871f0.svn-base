      "type": "apiKey",
      "name": "authorization",
      "in": "header",
      "description": "Authentication token"
    }
  },
  "paths": {
    "/users/login": {
      "post": {
        "tags": ["Users"],
        "summary": "Login KMS Application",
        "description": "Login with login_id and password",
        "produces": ["application/json"],
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "login object",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "object",
                  "$ref": "#/definitions/Login"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/users/logout": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Users"],
        "summary": "Logout KMS Application",
        "description": "Logout",
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Users"],
        "summary": "Get Users",
        "description": "Get all the users or single user by passing parameters!",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "employee_id",
            "description": "Filter any field (Ex. employee_id : 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "login_id",
            "description": "Filter any field (Ex. login_id : cams.eoffice)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sort",
            "description": "Ex. (full_name asc)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "description": "Ex. (org_unit_id,post_detail_id,post_id,employee_id,global_org_id)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "Pagination page no. (Ex. 1)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "Pagination limit. (Ex. 10)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/usersResponse"
              }
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },
    "/users/userRoleMapping": {
      "get": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Users"],
        "summary": "List of User Role Mapping",
        "description": "List of User Role Mapping",
        "produces": ["application/json"],
        "parameters": [
          {
