                        },
                        "name": {
                          "type": "string",
                          "example": "Head Office"
                        },
                        "parent_id": {
                          "type": "integer",
                          "example": 0
                        },
                        "Parent": {
                          "type": ["object", "null"],
                          "example": null
                        },
                        "Children": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1435
                              },
                              "organisation_code": {
                                "type": "string",
                                "example": "ORG002"
                              },
                              "name": {
                                "type": "string",
                                "example": "Software Development Unit, Pune"
                              },
                              "parent_id": {
                                "type": "integer",
                                "example": 1072
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
