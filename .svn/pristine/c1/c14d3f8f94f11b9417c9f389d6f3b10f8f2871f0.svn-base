          },
          {
            "name": "limit",
            "description": "Pagination limit. (Ex. 10)",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Invalid status value",
