              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": ["Users"],
        "summary": "Create a User Role",
        "description": "Create a User Role",
        "produces": ["application/json"],
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
