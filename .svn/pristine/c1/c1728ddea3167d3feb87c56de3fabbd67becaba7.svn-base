import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'
import { useEffect, useState } from 'react'
import OrganizationSelect from '../components/organization-select'
import EmpanelmentSelect from '../components/empanelment-select'
import { validateVendor } from '../../validations/vendorValidation'
import StateSelect from '../components/state-dropdown'
const VendorFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [errors, setErrors] = useState({})

  useEffect(() => {
    setFormData(initialData)
  }, [initialData])

  if (!formData) return null

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => ({
      ...prev,
      [name]: name === 'is_active' ? (value === 'true' ? true : false) : value,
    }))
  }

  // const handleSubmit = (e) => {
  //   e.preventDefault()
  //   onSubmit(formData)
  // }

  const handleSubmit = (e) => {
    e.preventDefault()

    const validationErrors = validateVendor(formData)
    setErrors(validationErrors)

    if (Object.keys(validationErrors).length) return

    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              {/* ================= Foreign Keys ================= */}

              <OrganizationSelect
                name="organization_id"
                value={formData.organization_id}
                onChange={handleChange}
                label="Organisation"
                placeholder="Select Organisation"
                colSize={6}
              />

              <CCol md={6}>
                <EmpanelmentSelect
                  name="empanelment_id_fk"
                  value={formData.empanelment_id_fk}
                  onChange={handleChange}
                  label="Empanelment"
                  placeholder="Select Empanelment"
                />
              </CCol>

              {/* ================= Vendor Info ================= */}
              <CCol md={6}>
                <CFormLabel>
                  Vendor Name <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  name="vendor_name"
                  value={formData.vendor_name || ''}
                  onChange={handleChange}
                  invalid={!!errors.vendor_name}
                  feedback={errors.vendor_name}
                  placeholder="Enter vendor name"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Vendor Code</CFormLabel>
                <CFormInput
                  name="vendor_code"
                  value={formData.vendor_code || ''}
                  onChange={handleChange}
                  placeholder="Enter vendor code"
                  maxLength={50}
                  minLength={2}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Vendor Type</CFormLabel>
                <CFormSelect
                  name="vendor_type"
                  value={formData.vendor_type || ''}
                  onChange={handleChange}
                  maxLength={50}
                >
                  <option value="">Select Type</option>
                  <option value="INDIVIDUAL">Individual</option>
                  <option value="PROPRIETORSHIP">Proprietorship</option>
                  <option value="PARTNERSHIP">Partnership</option>
                  <option value="LLP">LLP</option>
                  <option value="PRIVATE_LIMITED">Private Limited</option>
                  <option value="PUBLIC_LIMITED">Public Limited</option>
                  <option value="GOVERNMENT">Government</option>
                  <option value="NGO">NGO</option>
                  <option value="OTHER">Other</option>
                </CFormSelect>
              </CCol>

              {/* ================= Contact ================= */}
              <CCol md={6}>
                <CFormLabel>Contact Person</CFormLabel>
                <CFormInput
                  name="contact_person"
                  placeholder="Contact Person"
                  value={formData.contact_person || ''}
                  onChange={handleChange}
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Contact Email</CFormLabel>
                <CFormInput
                  type="email"
                  name="contact_email"
                  value={formData.contact_email || ''}
                  onChange={handleChange}
                  placeholder="Enter email"
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Contact Phone</CFormLabel>

                <CFormInput
                  name="contact_phone"
                  value={formData.contact_phone || ''}
                  onChange={(e) => {
                    const value = e.target.value.replace(/\D/g, '')

                    handleChange({
                      target: {
                        name: 'contact_phone',
                        value,
                      },
                    })
                  }}
                  onBlur={() => {
                    if (formData.contact_phone && formData.contact_phone.length !== 10) {
                      setErrors((prev) => ({
                        ...prev,
                        contact_phone: 'Phone number must be 10 digits',
                      }))
                    } else {
                      setErrors((prev) => ({
                        ...prev,
                        contact_phone: '',
                      }))
                    }
                  }}
                  placeholder="Enter phone number"
                  maxLength={10}
                  invalid={!!errors.contact_phone}
                />

                {errors.contact_phone && (
                  <div className="text-danger mt-1" style={{ fontSize: '12px' }}>
                    {errors.contact_phone}
                  </div>
                )}
              </CCol>

              <CCol md={6}>
                <CFormLabel>Website</CFormLabel>
                <CFormInput
                  name="website"
                  value={formData.website || ''}
                  onChange={handleChange}
                  placeholder="Enter website URL"
                  maxLength={150}
                />
              </CCol>

              {/* ================= Address ================= */}
              <CCol md={6}>
                <CFormLabel>Address Line 1</CFormLabel>
                <CFormTextarea
                  name="address_line1"
                  placeholder="Enter Address"
                  rows={2}
                  value={formData.address_line1 || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Address Line 2</CFormLabel>
                <CFormTextarea
                  name="address_line2"
                  rows={2}
                  value={formData.address_line2 || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>City</CFormLabel>
                <CFormInput
                  name="city"
                  placeholder="Enter City"
                  value={formData.city || ''}
                  onChange={handleChange}
                  maxLength={100}
                />
              </CCol>

              <StateSelect
                name="state"
                value={formData?.state}
                onChange={(name, value) =>
                  handleChange({
                    target: {
                      name,
                      value,
                    },
                  })
                }
                colSize={6}
              />

              <CCol md={6}>
                <CFormLabel>Country</CFormLabel>
                <CFormInput
                  name="country"
                  value={formData.country || ''}
                  onChange={handleChange}
                  maxLength={100}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Pincode</CFormLabel>
                <CFormInput
                  name="pincode"
                  value={formData.pincode || ''}
                  onChange={handleChange}
                  placeholder="Enter pincode"
                  maxLength={15}
                  pattern="[0-9]{4,10}"
                  title="Enter valid pincode"
                />
              </CCol>

              {/* ================= Bank Details ================= */}
              <CCol md={6}>
                <CFormLabel>Bank Name</CFormLabel>
                <CFormInput
                  name="bank_name"
                  placeholder="Enter Bank Name"
                  value={formData.bank_name || ''}
                  onChange={handleChange}
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Account Number</CFormLabel>
                <CFormInput
                  name="account_number"
                  placeholder="Enter Account Number"
                  value={formData.account_number || ''}
                  onChange={handleChange}
                  maxLength={50}
                  pattern="[0-9]{9,18}"
                  title="Enter valid account number"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>IFSC Code</CFormLabel>
                <CFormInput
                  name="ifsc_code"
                  placeholder="Enter IFSC Code"
                  value={formData.ifsc_code || ''}
                  onChange={handleChange}
                  maxLength={20}
                  pattern="^[A-Z]{4}0[A-Z0-9]{6}$"
                  title="Enter valid IFSC code"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Branch Name</CFormLabel>
                <CFormInput
                  name="branch_name"
                  placeholder="Enter Branch Name"
                  value={formData.branch_name || ''}
                  onChange={handleChange}
                  maxLength={150}
                />
              </CCol>

              {/* ================= Onboarding ================= */}
              <CCol md={6}>
                <CFormLabel>Onboarding Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="onboarding_date"
                  value={formData.onboarding_date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                  required
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" color="primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default VendorFormComponent
