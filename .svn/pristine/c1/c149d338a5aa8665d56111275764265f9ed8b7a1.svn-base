import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import {
  cilPencil,
  cilTrash,
  cilPlus,
  cilCheckCircle,
  cilXCircle,
} from '@coreui/icons'

import { useState } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // Dummy data (Company Master)
  const companies = [
    {
      id: 1,
      company_name: 'TechNova Private Limited',
      company_code: 'CMP001',
      company_type: 'PRIVATE_LIMITED',
      official_email: 'info@technova.com',
      official_phone: '9876543210',
      city: 'Delhi',
      state: 'Delhi',
      is_active: true,
    },
    {
      id: 2,
      company_name: 'National Infra LLP',
      company_code: 'CMP002',
      company_type: 'LLP',
      official_email: 'contact@infra.com',
      official_phone: '9123456780',
      city: 'Mumbai',
      state: 'Maharashtra',
      is_active: false,
    },
  ]

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Company</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search Vendor..."
              />

              <CTooltip content="Add Vendor" placement="bottom">
                <CButton
                  color="primary"
                  size="sm"
                  onClick={() => navigate('/vendor/add')}
                >
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped responsive>
                <CTableHead>
                  <CTableRow>

                    <SortableHeaderCell
                      label="Sno"
                      sortKey="id"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Company Name"
                      sortKey="company_name"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Company Code"
                      sortKey="company_code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Company Type"
                      sortKey="company_type"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Official Email"
                      sortKey="official_email"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Official Phone"
                      sortKey="official_phone"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Location"
                      sortKey="city"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell>Status</CTableHeaderCell>
                    <CTableHeaderCell>Action</CTableHeaderCell>

                  </CTableRow>
                </CTableHead>

                <CTableBody>
                  {companies.map((company, index) => (
                    <CTableRow key={company.id}>
                      <CTableHeaderCell scope="row">
                        {index + 1}
                      </CTableHeaderCell>

                      <CTableDataCell>{company.company_name}</CTableDataCell>
                      <CTableDataCell>{company.company_code}</CTableDataCell>
                      <CTableDataCell>{company.company_type}</CTableDataCell>
                      <CTableDataCell>{company.official_email || '-'}</CTableDataCell>
                      <CTableDataCell>{company.official_phone || '-'}</CTableDataCell>
                      <CTableDataCell>
                        {company.city}, {company.state}
                      </CTableDataCell>

                      {/* STATUS ICON SAME */}
                      <CTableDataCell>
                        {company.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      {/* ACTION ICONS SAME */}
                      <CTableDataCell>
                        <div className="d-flex gap-2">
                          <CTooltip content="Edit" placement="left">
                            <CButton
                              color="primary"
                              size="sm"
                              variant="ghost"
                              onClick={() =>
                                navigate(`/vendor/edit/${company.id}`)
                              }
                            >
                              <CIcon icon={cilPencil} />
                            </CButton>
                          </CTooltip>

                          <CTooltip content="Delete" placement="right">
                            <CButton color="danger" size="sm" variant="ghost">
                              <CIcon icon={cilTrash} />
                            </CButton>
                          </CTooltip>
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <CPagination className="justify-content-end">
              <CPaginationItem disabled>&laquo;</CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem disabled>&raquo;</CPaginationItem>
            </CPagination>

          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Index
