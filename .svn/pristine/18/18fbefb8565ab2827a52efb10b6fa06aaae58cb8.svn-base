import React, { useState, useEffect, useRef } from 'react'
import { CCard, CCardBody, CRow, CCol, CButton, CContainer } from '@coreui/react'

import PageHeader from '../components/form-header'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload, cilTrash } from '@coreui/icons'

import './mpr.css'

// reuse your existing components
import WorkOrderSelect from '../components/leave-mpr/WorkOrderSelect'
import EmployeeMultiSelect from '../components/leave-mpr/EmployeeMultiSelect'
import MonthYearSelect from '../components/leave-mpr/MonthYearSelect'
import { getMonthMeta } from '../components/leave-mpr/leaveCalculation'

// reuse hook
import useLeaveMprForm from '../../hooks/useWoMpr'
import { useSelector } from 'react-redux'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import ActionButton from '../components/action-button'

const MPR = () => {
  const FILE_BASE_URL = import.meta.env.VITE_FILE_BASE_URL

  const user = useSelector((state) => state.auth.user)
  const {
    workOrder,
    setWorkOrder,
    month,
    setMonth,
    monthOptions,
    selectedEmployees,
    setSelectedEmployees,
    filteredEmployees,
    isReady,
    refetch,
  } = useLeaveMprForm(true)

  const [checkedEmployees, setCheckedEmployees] = useState([])
  const [generatedFiles, setGeneratedFiles] = useState({})
  const [uploadedFiles, setUploadedFiles] = useState({})

  const isAllChecked =
    filteredEmployees.length > 0 &&
    filteredEmployees.every((emp) =>
      checkedEmployees.some((c) => c.id === (emp.id || emp.employee_id)),
    )

  //  Reset when workOrder changes
  useEffect(() => {
    setCheckedEmployees([])
  }, [workOrder])

  // Row checkbox toggle
  const handleRowCheck = (emp) => {
    const empId = emp.id || emp.employee_id

    if (checkedEmployees.some((e) => e.id === empId)) {
      setCheckedEmployees((prev) => prev.filter((e) => e.id !== empId))
    } else {
      setCheckedEmployees((prev) => [...prev, { id: empId, name: emp.name }])
    }
  }

  // Header select all
  const handleHeaderCheck = () => {
    if (isAllChecked) {
      setCheckedEmployees([])
    } else {
      const all = filteredEmployees.map((emp) => ({
        id: emp.id || emp.employee_id,
        name: emp.name || `${emp.first_name || ''} ${emp.middle_name || ''} ${emp.last_name || ''}`,
      }))
      setCheckedEmployees(all)
    }
  }

  // Generate per employee
  const handleGenerate = async () => {
    if (checkedEmployees.length === 0) {
      alert('Select employees first')
      return
    }

    if (!workOrder || !month) {
      alert('Select work order and month')
      return
    }

    try {
      const { monthName, year } = getMonthMeta(month)

      const payload = {
        employee_ids: checkedEmployees.map((emp) => emp.id),
        month: monthName,
        year: year,
        created_by: user?.id,
      }
      const response = await api.post(`workorder/${workOrder}/employee-work-order-mpr`, payload)
      await refetch()
      toast.success('MPR generated successfully')
    } catch (error) {
      console.error(error)
      alert('Error generating MPR')
    }
  }

  const handleFileUpload = async (e) => {
    const file = e.target.files[0]
    if (!file) return

    if (checkedEmployees.length === 0) {
      alert('Select employees first')
      return
    }

    if (!workOrder || !month) {
      alert('Select work order and month')
      return
    }

    try {
      const { monthName, year } = getMonthMeta(month)

      const formData = new FormData()

      // file
      formData.append('file', file)

      // multiple employee_ids (IMPORTANT)
      checkedEmployees.forEach((emp) => {
        formData.append('employee_ids', emp.id)
      })

      formData.append('month', monthName)
      formData.append('year', year)
      formData.append('created_by', user?.id)

      const response = await api.post(
        `workorder/${workOrder}/employee-work-order-mpr/upload`,
        formData,
        {
          headers: {
            'Content-Type': 'multipart/form-data',
          },
        },
      )

      await refetch() // update table immediately

      toast.success('File uploaded successfully')
    } catch (error) {
      console.error(error)
      toast.error('Upload failed')
    }
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this MPR?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/workorder/${workOrder}/employee-work-order-mpr/${id}`)
      toast.success('MPR deleted successfully')
      await refetch()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Delete failed')
    }
  }

  const allEligible =
    checkedEmployees.length > 0 &&
    checkedEmployees.every((selected) => {
      const emp = filteredEmployees.find((e) => e.id === selected.id)
      const hasMpr = emp?.employeeWorkOrderMprs?.length > 0
      return !hasMpr
    })

  return (
    <CContainer fluid>
      <PageHeader title="MPR" />

      <CCard className="mpr-card">
        <CCardBody className="mpr-card-body">
          {/* Filters */}
          <CRow className="g-3 mb-2">
            <CCol md={4}>
              <WorkOrderSelect workOrder={workOrder} setWorkOrder={setWorkOrder} />
            </CCol>
            <CCol md={4}>
              <MonthYearSelect month={month} setMonth={setMonth} options={monthOptions} />
            </CCol>
            <CCol md={4}>
              <EmployeeMultiSelect
                workOrder={workOrder}
                month={month}
                selectedEmployees={selectedEmployees}
                setSelectedEmployees={setSelectedEmployees}
              />
            </CCol>
          </CRow>

          {/* Table */}
          {isReady && (
            <div className="mpr-table">
              <table className="table">
                <thead>
                  <tr>
                    <th>
                      <input type="checkbox" checked={isAllChecked} onChange={handleHeaderCheck} />{' '}
                      Emp Name
                    </th>
                    <th>Designation</th>
                    <th>Leave Granted</th>
                    <th>Leave Taken</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  {filteredEmployees.map((emp, i) => {
                    const empId = emp.id
                    const empName = `${emp.first_name || ''} ${emp.middle_name || ''} ${emp.last_name || ''}`
                    const leaveGranted = emp?.employeeWorkOrderLeaves?.[0]?.leave_granted
                    const leaveTaken = emp?.employeeWorkOrderLeaves?.[0]?.leave_taken
                    const designation =
                      emp?.EmployeeWorkOrderDeployment?.[0]?.WoDesgnMapping?.Designation?.designat
                    const mprId = emp?.employeeWorkOrderMprs?.[0]?.id
                    const mprFileUrl = emp?.employeeWorkOrderMprs?.[0]?.mpr_file_path

                    return (
                      <tr key={empId}>
                        <td>
                          <input
                            type="checkbox"
                            checked={checkedEmployees.some((e) => e.id === empId)}
                            onChange={() => handleRowCheck(emp)}
                          />{' '}
                          {empName}
                        </td>

                        {/*  Replace with real API later */}
                        <td>{designation ?? '-'}</td>
                        <td>{leaveGranted ?? '-'}</td>
                        <td>{leaveTaken ?? '-'}</td>

                        <td>
                          {mprFileUrl ? (
                            <>
                              <a href={`${FILE_BASE_URL}${mprFileUrl}`} download target="_blank">
                                <CIcon icon={cilCloudDownload} size="lg" />
                              </a>

                              <CButton
                                size="lg"
                                color="danger"
                                variant="ghost"
                                onClick={() => confirmDelete(mprId)}
                                className="ms-1 pt-0"
                              >
                                <CIcon icon={cilTrash} />
                              </CButton>
                            </>
                          ) : (
                            ''
                          )}
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>

              {/* Actions */}
              <div className="mt-3 d-flex gap-2">
                <CButton color="primary" onClick={handleGenerate} disabled={!allEligible}>
                  Generate
                </CButton>

                <label className="btn btn-light mb-0">
                  Upload
                  <input
                    type="file"
                    hidden
                    accept=".pdf"
                    onChange={handleFileUpload}
                    disabled={!allEligible}
                  />
                </label>
              </div>
            </div>
          )}
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default MPR
