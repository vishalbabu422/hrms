import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import {
  cilPencil,
  cilTrash,
  cilPlus,
  cilCheckCircle,
  cilXCircle,
} from '@coreui/icons'

import { useState } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc', // fixed
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // Dummy data (replace with API later)
  const organizations = [
    {
      id: 1,
      org_name: 'Internal Central Pool For E Office',
      org_code: 'ORG001',
      contact_email: 'admin@centralpool.com',
      contact_phone: '9876543210',
      address: 'New Delhi, India',
      is_active: true,
    },
    {
      id: 2,
      org_name: 'National IT Services',
      org_code: 'ORG002',
      contact_email: 'info@nits.com',
      contact_phone: '9123456780',
      address: 'Mumbai, India',
      is_active: false,
    },
  ]

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Organization</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search organizations..."
              />

              <CTooltip content="Add Organization" placement="bottom">
                <CButton
                  color="primary"
                  size="sm"
                  onClick={() => navigate('/organization/add')}
                >
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped responsive>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Sno"
                      sortKey="id"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Organization Name"
                      sortKey="org_name"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Organization Code"
                      sortKey="org_code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Contact Email"
                      sortKey="contact_email"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Contact No"
                      sortKey="contact_phone"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Address"
                      sortKey="address"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell>Status</CTableHeaderCell>
                    <CTableHeaderCell>Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>

                <CTableBody>
                  {organizations.map((org, index) => (
                    <CTableRow key={org.id}>
                      <CTableHeaderCell scope="row">
                        {index + 1}
                      </CTableHeaderCell>

                      <CTableDataCell>{org.org_name}</CTableDataCell>
                      <CTableDataCell>{org.org_code}</CTableDataCell>
                      <CTableDataCell>{org.contact_email || '-'}</CTableDataCell>
                      <CTableDataCell>{org.contact_phone || '-'}</CTableDataCell>
                      <CTableDataCell>{org.address || '-'}</CTableDataCell>

                      {/* STATUS ICON SAME */}
                      <CTableDataCell>
                        {org.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      {/* ACTION ICONS SAME */}
                      <CTableDataCell>
                        <div className="d-flex gap-2">
                          <CTooltip content="Edit" placement="left">
                            <CButton
                              color="primary"
                              size="sm"
                              variant="ghost"
                              onClick={() =>
                                navigate(`/organization/edit/${org.id}`)
                              }
                            >
                              <CIcon icon={cilPencil} />
                            </CButton>
                          </CTooltip>

                          <CTooltip content="Delete" placement="right">
                            <CButton color="danger" size="sm" variant="ghost">
                              <CIcon icon={cilTrash} />
                            </CButton>
                          </CTooltip>
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <CPagination className="justify-content-end">
              <CPaginationItem disabled>
                &laquo;
              </CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem disabled>
                &raquo;
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Index
