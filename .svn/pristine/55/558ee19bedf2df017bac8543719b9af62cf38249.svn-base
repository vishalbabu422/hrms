import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CButton,
  CSpinner,
  CPagination,
  CPaginationItem,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import {
  cilPencil,
  cilTrash,
  cilPlus,
  cilCheckCircle,
  cilXCircle,
  cilDescription,
} from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import api from '../../api/axios'

import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'

import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

const Index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)
  const [search, setSearch] = useState('')
  const [company, setCompany] = useState([])
  const [loading, setLoading] = useState(false)

  const navigate = useNavigate()

  /* ================= FETCH COMPANY ================= */
  const fetchCompany = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/company/index', { params })

      setCompany(response.data.data.companyList || [])
      setTotalPages(response.data.totalPages || 1)
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch companies')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchCompany()
    }
  }, [search, sort, page])

  /* ================= SORT ================= */
  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= DELETE ================= */
  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Company?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/company/delete/${id}`)
      toast.success('Company deleted successfully')
      fetchCompany()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete Company')
    }
  }

  /* ================= ACTION BUTTON ================= */
  const ActionButton = ({ color, icon, onClick }) => (
    <CButton size="sm" color={color} variant="ghost" onClick={onClick} className="rounded-circle">
      <CIcon icon={icon} />
    </CButton>
  )

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Company</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch onSearch={setSearch} placeholder="Search By Company" />

              <CTooltip content="Add Company" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/company/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Organisation"
                      sortKey="organization_id"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <SortableHeaderCell
                      label="Company Name"
                      sortKey="company_name"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <SortableHeaderCell
                      label="Company Code"
                      sortKey="company_code"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <SortableHeaderCell
                      label="Company Type"
                      sortKey="company_type"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <SortableHeaderCell
                      label="Email"
                      sortKey="official_email"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <SortableHeaderCell
                      label="Phone"
                      sortKey="official_phone"
                      sort={sort}
                      onSort={handleSort}
                    />
                    {/* <SortableHeaderCell
                      label="Website"
                      sortKey="website"
                      sort={sort}
                      onSort={handleSort}
                    /> */}
                    <CTableHeaderCell>Status</CTableHeaderCell>
                    <CTableHeaderCell>Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>

                <CTableBody>
                  {loading ? (
                    <CTableRow>
                      <CTableDataCell colSpan={9} className="text-center py-4">
                        <CSpinner size="sm" />
                      </CTableDataCell>
                    </CTableRow>
                  ) : company.length > 0 ? (
                    company.map((item) => (
                      <CTableRow key={item.id}>
                        <CTableDataCell>{item?.organisation?.org_name ?? '-'}</CTableDataCell>
                        <CTableDataCell>{item.company_name}</CTableDataCell>
                        <CTableDataCell>{item.company_code}</CTableDataCell>
                        <CTableDataCell>{item.company_type}</CTableDataCell>
                        <CTableDataCell>{item.official_email}</CTableDataCell>
                        <CTableDataCell>{item.official_phone}</CTableDataCell>
                        {/* <CTableDataCell>{item.website}</CTableDataCell> */}
                        <CTableDataCell>
                          {item.is_active ? (
                            <CIcon icon={cilCheckCircle} className="text-success" />
                          ) : (
                            <CIcon icon={cilXCircle} className="text-danger" />
                          )}
                        </CTableDataCell>

                        <CTableDataCell>
                          <div className="d-flex gap-2">
                            <CTooltip content="Preview" placement="top">
                              <div>
                                <ActionButton
                                  color="primary"
                                  icon={cilDescription}
                                  onClick={() => navigate(`/company/preview/${item.id}`)}
                                />
                              </div>
                            </CTooltip>

                            <CTooltip content="Edit" placement="left">
                              <CButton
                                color="primary"
                                size="sm"
                                variant="ghost"
                                onClick={() => navigate(`/company/edit/${item.id}`)}
                              >
                                <CIcon icon={cilPencil} />
                              </CButton>
                            </CTooltip>

                            {item.is_active && (
                              <CTooltip content="Delete" placement="right">
                                <CButton
                                  color="danger"
                                  size="sm"
                                  variant="ghost"
                                  onClick={() => confirmDelete(item.id)}
                                >
                                  <CIcon icon={cilTrash} />
                                </CButton>
                              </CTooltip>
                            )}
                          </div>
                        </CTableDataCell>
                      </CTableRow>
                    ))
                  ) : (
                    <TableEmptyState colSpan={9} />
                  )}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <CPagination className="justify-content-end mt-3">
              <CPaginationItem disabled={page === 1} onClick={() => setPage(page - 1)}>
                &laquo;
              </CPaginationItem>

              {[...Array(totalPages)].map((_, index) => (
                <CPaginationItem
                  key={index + 1}
                  active={page === index + 1}
                  onClick={() => setPage(index + 1)}
                >
                  {index + 1}
                </CPaginationItem>
              ))}

              <CPaginationItem disabled={page === totalPages} onClick={() => setPage(page + 1)}>
                &raquo;
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Index
