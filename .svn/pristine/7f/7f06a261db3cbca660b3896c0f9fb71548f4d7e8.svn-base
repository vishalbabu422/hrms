const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Models
const GstCodeMaster = require("./../models/GstCodeMaster");
const { Op } = require("sequelize");

const index = catchAsync(async (req, res, next) => {
  const features = new APIFeatures(req.query)
    .filter()
    .sort()
    .limitFields()
    .join()
    .paginate();

  const page = req.query.page * 1 || 1;
  const limit = req.query.limit * 1 || 10;

  if (!features.query.where) features.query.where = {};

  if (req.query.search && req.query.search.trim().length >= 3) {
    const search = req.query.search.trim();

    features.query.where[Op.or] = [
      { code: { [Op.iLike]: `%${search}%` } },
      { code_type: { [Op.iLike]: `%${search}%` } },
    ];
  }

  const { rows: GstCodeList, count } = await GstCodeMaster.findAndCountAll(
    features.query,
  );

  res.status(200).json({
    status: "success",
    message: "Get GST Code List!",
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: GstCodeList.length,
    data: { GstCodeList },
  });
});

const dataById = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const { is_active } = req.query;

  const where = { id };

  if (is_active !== undefined) {
    where.is_active = is_active === "true";
  }

  const gstCode = await GstCodeMaster.findOne({ where });

  if (!gstCode) {
    return res.status(404).json({
      status: "fail",
      message: "GST Code not found",
    });
  }

  res.status(200).json({
    status: "success",
    data: gstCode,
  });
});

const create = catchAsync(async (req, res, next) => {
  const payload = req.body;

  // prevent duplicate active code for same code_type
  const existing = await GstCodeMaster.findOne({
    where: {
      code_type: payload.code_type,
      code: payload.code,
      is_active: true,
    },
  });

  if (existing) {
    return res.status(409).json({
      status: "fail",
      message: "GST code already exists for this code type",
    });
  }

  // Insert record
  const gstCode = await GstCodeMaster.create({
    ...payload,
    created: new Date(),
    modified: new Date(),
  });

  return res.status(201).json({
    status: "success",
    data: gstCode,
  });
});

const edit = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const updates = req.body;

  // Check record exists
  const gstCode = await GstCodeMaster.findByPk(id);

  if (!gstCode) {
    return res.status(404).json({
      status: "fail",
      message: "GST Code not found",
    });
  }

  // prevent duplicate active code_type + code
  if (updates.code_type || updates.code) {
    const codeType = updates.code_type ?? gstCode.code_type;
    const code = updates.code ?? gstCode.code;

    const duplicate = await GstCodeMaster.findOne({
      where: {
        code_type: codeType,
        code: code,
        is_active: true,
      },
    });

    if (duplicate && duplicate.id !== gstCode.id) {
      return res.status(409).json({
        status: "fail",
        message: "GST Code already exists for this code type",
      });
    }
  }

  // Apply updates
  await gstCode.update({
    ...updates,
    modified: new Date(),
  });

  return res.status(200).json({
    status: "success",
    data: gstCode,
  });
});

const deleteById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  // Check record exists
  const gstCode = await GstCodeMaster.findByPk(id);

  if (!gstCode) {
    return res.status(404).json({
      status: "fail",
      message: "GST Code not found",
    });
  }

  // Prevent double delete
  if (gstCode.is_active === false) {
    return res.status(409).json({
      status: "fail",
      message: "GST Code is already inactive",
    });
  }

  // Soft delete
  await gstCode.update({
    is_active: false,
    modified: new Date(),
  });

  return res.status(200).json({
    status: "success",
    message: "GST Code deleted successfully",
  });
});

// exports
module.exports = {
  index,
  dataById,
  create,
  edit,
  deleteById,
};
