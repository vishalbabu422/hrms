import {
  CCard,
  CCardBody,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CButton,
  CContainer,
  CDropdown,
  CDropdownToggle,
  CDropdownMenu,
  CDropdownItem,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { CTooltip } from '@coreui/react'
import ExpandableSearch from '../components/expandable-search'

import {
  cilPencil,
  cilTrash,
  cilPlus,
  cilCheckCircle,
  cilXCircle,
  cilDescription,
  cilCloudDownload,
} from '@coreui/icons'

import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

const WorkOrderDesignationIndex = () => {
  const navigate = useNavigate()
  const [search, setSearch] = useState('')

  const designationList = [
    {
      id: 1,
      work_order_no: 'M2508011',
      code: 'DES001',
      description: 'Senior Engineer',
      req_person_count: 5,
      duration_days: 180,
      monthly_unit_rate: 45000,
      deployment_from: '01-01-2026',
      deployment_to: '30-06-2026',
      is_active: true,
    },
    {
      id: 2,
      work_order_no: 'M2508012',
      code: 'DES002',
      description: 'Junior Engineer',
      req_person_count: 3,
      duration_days: 120,
      monthly_unit_rate: 30000,
      deployment_from: '01-02-2026',
      deployment_to: '31-05-2026',
      is_active: false,
    },
  ]

  /* ================= EXPORT FUNCTIONS ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15

    doc.setFontSize(14)
    doc.text('Work Order Designation Mapping', 10, 10)

    designationList.forEach((item, index) => {
      doc.text(
        `${index + 1}. ${item.work_order_no} - ${item.code} - ${item.description}`,
        10,
        y
      )
      y += 8
    })

    doc.save('work-order-designation-list.pdf')
  }

  const handleExportExcel = () => {
    const worksheet = XLSX.utils.json_to_sheet(designationList)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'WorkOrderDesignation')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type:
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'work-order-designation-list.xlsx')
  }

  return (
    <CContainer fluid className="py-4">

      {/* ================= PAGE HEADER ================= */}
      <div
        className="mb-4 p-3 rounded-3"
        style={{
          backgroundColor: '#f4f6f9',
          borderLeft: '4px solid #1b4f72',
        }}
      >
        <div className="d-flex justify-content-between align-items-center">
          <div>
            <h5 className="fw-bold mb-1 text-dark">
              Work Order Designation Mapping
            </h5>
          </div>

          <div className="d-flex gap-3 align-items-center">
            <ExpandableSearch
              value={search}
              onChange={setSearch}
              placeholder="Search designation mapping..."
            />

            {/* EXPORT DROPDOWN */}
            <CDropdown>
              <CDropdownToggle color="primary" size="sm">
                <CIcon icon={cilCloudDownload} className="me-1" />
                Export
              </CDropdownToggle>
              <CDropdownMenu>
                <CDropdownItem onClick={handleExportPDF}>
                  Download PDF
                </CDropdownItem>
                <CDropdownItem onClick={handleExportExcel}>
                  Download Excel
                </CDropdownItem>
              </CDropdownMenu>
            </CDropdown>

            <CButton
              color="primary"
              size="sm"
              onClick={() => navigate('/work-order-desgn/add')}
            >
              <CIcon icon={cilPlus} className="me-1" />
              Add Mapping
            </CButton>
          </div>
        </div>
      </div>

      {/* ================= TABLE CARD ================= */}
      <CCard className="shadow border-0 rounded-4">
        <CCardBody>

          <CTable hover responsive align="middle" className="rounded overflow-hidden">
            <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
              <CTableRow>
                <CTableHeaderCell>S.no</CTableHeaderCell>
                <CTableHeaderCell>Work Order No</CTableHeaderCell>
                <CTableHeaderCell>Code</CTableHeaderCell>
                <CTableHeaderCell>Description</CTableHeaderCell>
                <CTableHeaderCell>Person Count</CTableHeaderCell>
                <CTableHeaderCell>Duration</CTableHeaderCell>
                <CTableHeaderCell>Monthly Unit Rate</CTableHeaderCell>
                <CTableHeaderCell>Deployment From</CTableHeaderCell>
                <CTableHeaderCell>Deployment Till</CTableHeaderCell>
                <CTableHeaderCell className="text-center">
                  Status
                </CTableHeaderCell>
                <CTableHeaderCell className="text-center">
                  Action
                </CTableHeaderCell>
              </CTableRow>
            </CTableHead>

            <CTableBody>
              {designationList.map((item, index) => (
                <CTableRow key={item.id}>
                  <CTableDataCell>{index + 1}</CTableDataCell>
                  <CTableDataCell className="fw-semibold">
                    {item.work_order_no}
                  </CTableDataCell>
                  <CTableDataCell>{item.code}</CTableDataCell>
                  <CTableDataCell>{item.description}</CTableDataCell>
                  <CTableDataCell>{item.req_person_count}</CTableDataCell>
                  <CTableDataCell>{item.duration_days}</CTableDataCell>
                  <CTableDataCell>
                    ₹ {item.monthly_unit_rate}
                  </CTableDataCell>
                  <CTableDataCell>{item.deployment_from}</CTableDataCell>
                  <CTableDataCell>{item.deployment_to}</CTableDataCell>

                  <CTableDataCell className="text-center">
                    {item.is_active ? (
                      <CIcon icon={cilCheckCircle} className="text-success" size="lg" />
                    ) : (
                      <CIcon icon={cilXCircle} className="text-danger" size="lg" />
                    )}
                  </CTableDataCell>

                  <CTableDataCell>
                    <div className="d-flex justify-content-center gap-2">
                      <CTooltip content="Preview">
                        <div>
                          <ActionButton
                            color="primary"
                          
                            onClick={() =>
                              navigate(`/work-order-desgn/preview/${item.id}`)
                            }
                          />
                        </div>
                      </CTooltip>

                      <CTooltip content="Edit">
                        <div>
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() =>
                              navigate(`/work-order-desgn/edit/${item.id}`)
                            }
                          />
                        </div>
                      </CTooltip>

                      <CTooltip content="Delete">
                        <div>
                          <ActionButton color="danger" icon={cilTrash} />
                        </div>
                      </CTooltip>
                    </div>
                  </CTableDataCell>
                </CTableRow>
              ))}
            </CTableBody>
          </CTable>

          <CPagination className="justify-content-end mt-3">
            <CPaginationItem disabled>&laquo;</CPaginationItem>
            <CPaginationItem active>1</CPaginationItem>
            <CPaginationItem disabled>&raquo;</CPaginationItem>
          </CPagination>

        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default WorkOrderDesignationIndex

const ActionButton = ({ color, icon, onClick }) => (
  <CButton
    size="sm"
    color={color}
    variant="ghost"
    onClick={onClick}
    className="rounded-circle"
  >
    <CIcon icon={icon} />
  </CButton>
)
