import RateFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
      }

      await api.post('/admin/resourcerate/create', normalizedPayload)
      toast.success('Resource Rate created successfully')
      navigate('/rate')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to create Resource Rate')
    }
  }

  const initialData = {
    desgn_id_fk: '',
    unit_rate_incl_agency_margin: '',
    agency_margin_percent: '',
    agency_amount: '',
    unit_rate_excl_agency_margin: '',
    nicsi_margin_percent: '',
    nicsi_margin_amount: '',
    total_amount: '',
    hsn_sac_code: '',
    cgst_amount: '',
    sgst_amount: '',
    igst_amount: '',
    total_gst_amount: '',
    final_amount: '',
    is_active: true,
  }

  return <RateFormComponent initialData={initialData} mode="create" onSubmit={handleSubmit} />
}

export default add
