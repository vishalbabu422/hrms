const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Model
const { WorkOrder, WoDesgnMapping,Designation } = require("../models");
const sequelize = require("../utils/database");

const getByWorkOrderId = catchAsync(async (req, res, next) => {
  const { work_order_id } = req.params;

  if (!work_order_id) {
    return res.status(400).json({
      status: "fail",
      message: "work_order_id is required",
    });
  }

  // Optional but good practice: validate WorkOrder exists
  const workOrder = await WorkOrder.findByPk(work_order_id);

  if (!workOrder) {
    return res.status(404).json({
      status: "fail",
      message: "Work Order not found",
    });
  }

  const deployments = await WoDesgnMapping.findAll({
    where: {
      work_order_id,
      is_active: true,
    },
    order: [["id", "ASC"]],
  });

  return res.status(200).json({
    status: "success",
    results: deployments.length,
    data: {
      workOrderDesgnList: deployments,
    },
  });
});

const create = catchAsync(async (req, res, next) => {
  const { work_order_id, deployments } = req.body;

  if (!work_order_id) {
    return res.status(400).json({
      status: "fail",
      message: "work_order_id is required",
    });
  }

  if (!Array.isArray(deployments)) {
    return res.status(400).json({
      status: "fail",
      message: "deployments must be an array",
    });
  }

  const transaction = await sequelize.transaction();

  try {
    // Validate Work Order exists
    const workOrder = await WorkOrder.findByPk(work_order_id, { transaction });

    if (!workOrder) {
      await transaction.rollback();
      return res.status(404).json({
        status: "fail",
        message: "Work Order not found",
      });
    }

    // Delete existing deployments
    await WoDesgnMapping.destroy({
      where: { work_order_id },
      transaction,
    });

    // Prepare new records
    const deploymentData = deployments.map((d) => ({
      work_order_id,
      sac_code: d.sac_code,
      description: d.description,
      desgn_id_fk: d.desgn_id_fk,
      req_person_count: d.req_person_count,
      duration_days: d.duration_days,
      monthly_unit_rate: d.monthly_unit_rate,
      deployment_from: d.deployment_from,
      deployment_to: d.deployment_to,
      cgst_amount: d.cgst_amount,
      sgst_amount: d.sgst_amount,
      igst_amount: d.igst_amount,
      created_by: 1,
      is_active: true,
    }));

    // Insert new deployments (only if any exist)
    let inserted = [];
    if (deploymentData.length > 0) {
      inserted = await WoDesgnMapping.bulkCreate(deploymentData, {
        transaction,
      });
    }

    await transaction.commit();

    return res.status(200).json({
      status: "success",
      message: "Deployments saved successfully",
      data: inserted,
    });
  } catch (error) {
    await transaction.rollback();
    throw error;
  }
});

module.exports = {
  getByWorkOrderId,
  create,
};
