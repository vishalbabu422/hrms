import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import {
  CContainer,
  CCard,
  CCardBody,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CSpinner,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilCheckCircle, cilXCircle } from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'

import SortableHeaderCell from '../components/sort-table-header'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'
import PageHeader from '../components/form-header'
import ActionButton from '../components/action-button'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({ key: 'id', order: 'desc' })
  const [page, setPage] = useState(1)
  const [limit] = useState(10)
  const [totalPages, setTotalPages] = useState(1)
  const [search, setSearch] = useState('')
  const [list, setList] = useState([])
  const [loading, setLoading] = useState(false)

  /* ================= DUMMY MASTER DATA ================= */

  const employeeList = [
    { id: 1, name: 'John Doe' },
    { id: 2, name: 'Jane Smith' },
    { id: 3, name: 'Amit Sharma' },
  ]

  const structureList = [
    { id: 1, name: 'Structure A' },
    { id: 2, name: 'Structure B' },
  ]

  /* ================= FETCH FROM LOCAL STORAGE ================= */

  const fetchData = () => {
    try {
      setLoading(true)

      let data = JSON.parse(localStorage.getItem('empSalaryStructure')) || []

      //  search
      if (search.length >= 3) {
        data = data.filter((item) =>
          String(item.employee_id).toLowerCase().includes(search.toLowerCase()),
        )
      }

      //  sort
      data.sort((a, b) => {
        const key = sort.key
        const order = sort.order === 'asc' ? 1 : -1

        if (a[key] > b[key]) return 1 * order
        if (a[key] < b[key]) return -1 * order
        return 0
      })

      setList(data)
      setTotalPages(1)
    } catch (error) {
      console.error(error)
      toast.error('Failed to load data')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    fetchData()
  }, [search, sort, page])

  /* ================= HELPERS ================= */

  const getEmployeeName = (id) => {
    return employeeList.find((e) => e.id === Number(id))?.name || id
  }

  const getStructureName = (id) => {
    return structureList.find((s) => s.id === Number(id))?.name || id
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Delete this record?')) return
    handleDelete(id)
  }

  const handleDelete = (id) => {
    let data = JSON.parse(localStorage.getItem('empSalaryStructure')) || []

    data = data.filter((item) => item.id !== id)

    localStorage.setItem('empSalaryStructure', JSON.stringify(data))

    toast.success('Deleted successfully')
    fetchData()
  }

  /* ================= SORT ================= */

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= UI ================= */

  return (
    <CContainer fluid>
      <PageHeader
        title="Employee Salary Structure"
        onSearchChange={setSearch}
        onAddClick={() => navigate('/emp-salary-structure/add')}
        addLabel="Add Structure"
      />

      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <SimpleBar>
            <CTable hover responsive align="middle">
              <CTableHead>
                <CTableRow>
                  <CTableHeaderCell>Employee</CTableHeaderCell>
                  <CTableHeaderCell>Structure</CTableHeaderCell>

                  <SortableHeaderCell label="CTC" sortKey="ctc" sort={sort} onSort={handleSort} />

                  <SortableHeaderCell
                    label="Effective From"
                    sortKey="effective_from"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Status"
                    sortKey="is_active"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <CTableHeaderCell className="text-center">Action</CTableHeaderCell>
                </CTableRow>
              </CTableHead>

              <CTableBody>
                {loading ? (
                  <CTableRow>
                    <CTableDataCell colSpan={6} className="text-center py-4">
                      <CSpinner size="sm" />
                    </CTableDataCell>
                  </CTableRow>
                ) : list.length > 0 ? (
                  list.map((item) => (
                    <CTableRow key={item.id}>
                      {/* <CTableDataCell>{getEmployeeName(item.employee_id)}</CTableDataCell> */}
                      <CTableDataCell>
                        {item.employee_name ?? getEmployeeName(item.employee_id)}
                      </CTableDataCell>

                      <CTableDataCell>{getStructureName(item.salary_structure_id)}</CTableDataCell>

                      <CTableDataCell>{item.ctc}</CTableDataCell>

                      <CTableDataCell>{item.effective_from}</CTableDataCell>

                      <CTableDataCell>
                        {item.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      <CTableDataCell>
                        <div className="d-flex justify-content-center gap-2">
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() => navigate(`/emp-salary-structure/edit/${item.id}`)}
                          />
                          <ActionButton
                            color="danger"
                            icon={cilTrash}
                            onClick={() => confirmDelete(item.id)}
                          />
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))
                ) : (
                  <TableEmptyState colSpan={6} />
                )}
              </CTableBody>
            </CTable>
          </SimpleBar>

          <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index
