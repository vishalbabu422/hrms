            "description": "Vendor created successfully",
            "schema": {
              "$ref": "#/definitions/VendorResponse"
            }
          },
          "409": {
            "description": "Vendor code already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    },

    "/admin/vendor/edit/{id}": {
      "patch": {
        "security": [{ "Authorization": [] }],
        "tags": ["Vendor Master"],
        "summary": "Update Vendor",
        "description": "Update an existing Vendor record (Partial update supported)",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "organization_id": {
                  "type": "integer",
                  "example": 1
                },
                "empanelment_id_fk": {
                  "type": "integer",
                  "example": 5
                },
                "vendor_name": {
                  "type": "string",
                  "example": "XYZ Solutions Pvt Ltd"
                },
                "vendor_code": {
                  "type": "string",
                  "example": "VEND002"
                },
                "vendor_type": {
                  "type": "string",
                  "enum": [
                    "INDIVIDUAL",
                    "PROPRIETORSHIP",
                    "PARTNERSHIP",
                    "LLP",
                    "PRIVATE_LIMITED",
                    "PUBLIC_LIMITED",
                    "GOVERNMENT",
                    "NGO",
                    "OTHER"
                  ],
                  "example": "PRIVATE_LIMITED"
                },
                "contact_person": {
                  "type": "string",
                  "example": "Rahul Sharma"
                },
                "contact_email": {
                  "type": "string",
                  "format": "email",
                  "example": "rahul.sharma@xyz.com"
                },
                "contact_phone": {
                  "type": "string",
                  "example": "+91-9876543210"
                },
                "website": {
                  "type": "string",
                  "example": "https://www.xyzsolutions.com"
                },
                "address_line1": {
                  "type": "string",
                  "example": "45 Industrial Area"
                },
                "address_line2": {
                  "type": "string",
                  "example": "Phase 2"
                },
                "city": {
                  "type": "string",
                  "example": "Delhi"
                },
                "state": {
                  "type": "string",
                  "example": "Delhi"
                },
                "country": {
                  "type": "string",
                  "example": "India"
                },
                "pincode": {
                  "type": "string",
                  "example": "110020"
                },
                "bank_name": {
                  "type": "string",
                  "example": "State Bank of India"
                },
                "account_number": {
                  "type": "string",
                  "example": "123456789012"
                },
                "ifsc_code": {
                  "type": "string",
                  "example": "SBIN0001234"
                },
                "branch_name": {
                  "type": "string",
                  "example": "Nehru Place Branch"
                },
                "onboarding_date": {
                  "type": "string",
                  "format": "date",
                  "example": "2023-06-15"
                },
                "is_active": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor updated successfully",
            "schema": {
              "$ref": "#/definitions/VendorResponse"
            }
          },
          "404": {
            "description": "Vendor not found"
          },
          "409": {
            "description": "Duplicate Vendor code"
          }
        }
      }
    },

    "/admin/vendor/delete/{id}": {
      "delete": {
        "security": [{ "Authorization": [] }],
        "tags": ["Vendor Master"],
        "summary": "Delete Vendor",
        "description": "Soft delete a Vendor by ID",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor deleted successfully"
          },
          "404": {
            "description": "Vendor not found"
          },
          "409": {
            "description": "Vendor already inactive"
          }
        }
      }
    }
  },
  "definitions": {
    "UserResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "System Admin"
        },
        "email": {
          "type": "string",
          "example": "admin@saas.com"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "example": "SAAS_ADMIN"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Organization deleted successfully"
        },
        "404": {
          "description": "Organization not found"
        },
        "409": {
          "description": "Organization already inactive"
        }
      }
    },
    "EmpanelmentResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },

        "category": {
          "type": "string",
          "maxLength": 20
        },

        "empanelment_no": {
          "type": "string",
          "maxLength": 50
        },

        "date": {
          "type": "string",
          "format": "date"
        },

        "shortcode": {
          "type": "string",
          "maxLength": 255
        },

        "rfe": {
          "type": "string",
          "maxLength": 255
        },

        "effective_from": {
          "type": "string",
          "format": "date"
        },

        "effective_to": {
          "type": "string",
          "format": "date"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "category",
        "empanelment_no",
        "date",
        "shortcode",
        "rfe",
        "effective_from"
      ]
    },

