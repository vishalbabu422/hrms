        "cgst_amount": {
          "type": "number",
          "format": "float"
        },

        "sgst_amount": {
          "type": "number",
          "format": "float"
        },

        "igst_amount": {
          "type": "number",
          "format": "float"
        },

        "total_gst_amount": {
          "type": "number",
          "format": "float"
        },

        "final_amount": {
          "type": "number",
          "format": "float",
          "description": "Final amount including GST"
        },

        "is_active": {
          "type": "boolean",
          "default": true
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
