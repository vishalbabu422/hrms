import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CButton } from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'
import Field from '../../components/field'
import { getEmployeeBank } from '../../../services/employeeBank'

const BankView = () => {
  const { employeeId } = useParams()
  const [bank, setBank] = useState({})

  useEffect(() => {
    if (!employeeId) return

    getEmployeeBank(employeeId)
      .then((res) => {
        console.log('BANK RESPONSE:', res.data)

        const data = res.data?.data || {}

        setBank({
          bankName: data[0].bank_name,
          branchName: data.branch_name,
          bankAddress: data.bank_address,
          accountNumber: data.account_number,
          ifscCode: data.ifsc,
          micrCode: data.micr_code,
          chequeDocument: data.cheque_document,
          chequeFileName: data.cheque_document ? data.cheque_document.split('/').pop() : '',
        })
      })
      .catch((err) => {
        console.error('BANK ERROR:', err)
      })
  }, [employeeId])
  return (
    <div className="row g-4">
      {/* LEFT */}
      <div className="col-md-6">
        <Field label="Bank Name" value={bank.bankName} />
        <Field label="Bank Address" value={bank.bankAddress} />
        <Field label="IFSC Code" value={bank.ifscCode} />
      </div>

      {/* RIGHT */}
      <div className="col-md-6">
        <Field label="Branch Name" value={bank.branchName} />
        <Field label="Account Number" value={bank.accountNumber} />
        <Field label="MICR Code" value={bank.micrCode} />
      </div>

      {/* DOCUMENT */}
      <div className="col-12">
        <div className="d-flex justify-content-between align-items-center">
          <div>
            <small className="text-muted">Cancelled Cheque</small>
            <div className="fw-semibold">{bank.chequeFileName || 'No document uploaded'}</div>
          </div>

          {bank.chequeDocument && (
            <CButton size="sm" variant="outline" href={bank.chequeDocument} download>
              <CIcon icon={cilCloudDownload} />
            </CButton>
          )}
        </div>
      </div>
    </div>
  )
}

export default BankView
