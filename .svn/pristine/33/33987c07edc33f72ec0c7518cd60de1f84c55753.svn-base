/* Main Card */
.leave-card {
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  border: none;
}

/* Dropdown Input */
.multi-select-input {
  min-height: 42px;
  cursor: pointer;
  border-radius: 8px;
  padding: 6px 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  transition: all 0.2s ease;
}

.multi-select-input:hover {
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);
}

/* Dropdown Panel */
.multi-select-dropdown {
  position: absolute;
  width: 100%;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  z-index: 1000;
  margin-top: 6px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  padding: 12px;
}

/* Checkbox Items */
.dropdown-item {
  padding: 6px 4px;
  border-radius: 6px;
  transition: background 0.2s ease;
}

.dropdown-item:hover {
  background: #f3f4f6;
}

/* Employee Card */
.employee-card {
  border-radius: 12px;
  padding: 16px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  border: 1px solid #f1f1f1;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.employee-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

/* Employee Name */
.employee-header {
  font-weight: 600;
  font-size: 15px;
  color: #2c3e50;
  margin-bottom: 10px;
}

/* Table Styling */
.table-clean th {
  background-color: #f8fafc;
  font-weight: 600;
}

.table-clean td,
.table-clean th {
  vertical-align: middle;
  padding: 10px;
}

.table-clean tbody tr:hover {
  background: #f9fafb;
}

/* Inputs */
.input-clean input {
  border-radius: 6px;
  transition: all 0.2s ease;
}

.input-clean input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.15);
}

/* Badges */
.badge {
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 6px;
}

/* Save Button */
.save-btn {
  padding: 8px 20px;
  border-radius: 8px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.save-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}