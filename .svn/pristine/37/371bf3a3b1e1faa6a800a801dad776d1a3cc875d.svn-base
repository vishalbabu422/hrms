import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import api from '../../api/axios'

const DesignationFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [empanelmentList, setEmpanelmentList] = useState([])

  useEffect(() => {
    const fetchEmpanelments = async () => {
      const params = {
        fields: 'id,empanelment_no',
      }

      try {
        const response = await api.get('/admin/empanelment/index', { params })
        setEmpanelmentList(response.data.data.EmpanelmentList)
      } catch (error) {
        console.error('Failed to fetch empanelments:', error)
      }
    }

    fetchEmpanelments()
  }, [])

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  if (!formData) return null

  

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={6}>
                <CFormLabel>Type</CFormLabel>
                <CFormInput
                  name="type"
                  placeholder="Enter Type"
                  value={formData.type || ''}
                  onChange={handleChange}
                  maxLength={20}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Empanelment</CFormLabel>
                <CFormSelect
                  name="empanelment_id_fk"
                  value={String(formData.empanelment_id_fk)}
                  onChange={handleChange}
                >
                  <option value="">Select Empanelment</option>
                  {empanelmentList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.empanelment_no}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>Designation</CFormLabel>
                <CFormInput
                  name="designation"
                  value={formData.designation || ''}
                  onChange={handleChange}
                  placeholder="Enter Designation"
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Qualification</CFormLabel>
                <CFormInput
                  name="qualification"
                  value={formData.qualification || ''}
                  placeholder="Enter Qualification"
                  onChange={handleChange}
                  maxLength={500}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Experience</CFormLabel>
                <CFormInput
                  type="number"
                  name="exp_in_years"
                  placeholder="Enter experience"
                  value={formData.exp_in_years || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default DesignationFormComponent
