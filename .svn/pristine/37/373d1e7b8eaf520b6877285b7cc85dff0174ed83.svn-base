import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CCol, CCardBody } from '@coreui/react'

// ✅ SERVICE IMPORT
import { getEmployeeVehicles } from '../../../services/employeeVehicles'
const VehicleView = () => {
  const { employeeId } = useParams()

  const [vehicle, setVehicle] = useState({})
  const [loading, setLoading] = useState(false)

  const fetchVehicle = async () => {
    try {
      setLoading(true)

      // 🔍 DEBUG (you can remove later)
      console.log('employeeId:', employeeId)

      const response = await getEmployeeVehicles(employeeId)

      const data = response.data?.data || response.data || {}

      // ✅ HANDLE ARRAY OR OBJECT
      setVehicle(Array.isArray(data) ? data[0] : data)
    } catch (error) {
      console.error('Error fetching vehicle:', error.response?.data || error.message)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    // ✅ IMPORTANT FIX (prevents 500 error)
    if (employeeId) {
      fetchVehicle()
    }
  }, [employeeId])

  return (
    <CCol xs={12} sm={12} md={9} lg={10}>
      <CCardBody style={{ minHeight: '400px' }}>
        {/* Header */}
        <div className="section-header mb-4">
          <div className="section-accent"></div>
          <h5 className="section-title">Vehicle Details</h5>
        </div>

        {/* Loading */}
        {loading && <p>Loading vehicle details...</p>}

        {/* Empty */}
        {!loading && Object.keys(vehicle).length === 0 && (
          <p className="text-muted">No vehicle data available</p>
        )}

        {/* Data */}
        {!loading && Object.keys(vehicle).length > 0 && (
          <div className="row g-4">
            {/* LEFT */}
            <div className="col-12 col-md-6">
              <div className="mb-4">
                <small className="text-muted">Vehicle Details</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.vehicle_details
                    ? `${vehicle.vehicle_details} – ${vehicle.vehicle_registration_number}`
                    : '-'}
                </div>
              </div>

              <div className="mb-4">
  <small className="text-muted">Vehicle Category</small>
  <div className="fw-semibold border-bottom pb-2">
    {vehicle.vehicle_category || '-'}
  </div>
</div>


              <div className="mb-4">
                <small className="text-muted">Registration Issue Date</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.registration_issue_date
                    ? new Date(vehicle.registration_issue_date).toLocaleDateString()
                    : '-'}
                </div>
              </div>
            </div>

            {/* RIGHT */}
            <div className="col-12 col-md-6">
 <div className="mb-4">
                <small className="text-muted">Vehicle Registration Number</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.vehicle_registration_number || '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">Registration Expiry Date</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.registration_expiry_date
                    ? new Date(vehicle.registration_expiry_date).toLocaleDateString()
                    : '-'}
                </div>
              </div>


             
            </div>
            {/*  */}
          </div>
        )}
      </CCardBody>
    </CCol>
  )
}

export default VehicleView
