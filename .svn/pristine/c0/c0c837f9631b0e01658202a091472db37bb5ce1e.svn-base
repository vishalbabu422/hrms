import api from '../api/axios'

export const getDivisions = async (organizationId) => {
  const params = new URLSearchParams({
    is_active: true,
    sort: 'division_name',
    fields: 'id,division_name',
  })

  if (organizationId) {
    params.append('organization_id', organizationId)
  }

  return await api.get(`/division?${params.toString()}`)
}

export const getDesignations = async (organizationId) => {
  const params = new URLSearchParams({
    is_active: true,
    sort: 'designation_name',
    fields: 'id,designation_name',
  })

  if (organizationId) {
    params.append('organization_id', organizationId)
  }

  return await api.get(`/designation?${params.toString()}`)
}

export const createEmployee = async (payload) => {
  return await api.post('/employee', payload)
}
