const catchAsync = require("../../../utils/catchAsync");
const APIFeatures = require("../../../utils/apiFeature");
const SalaryAddonMasterService = require("./salaryAddonMaster.service");
const { Op } = require("sequelize");

// Get Salary Addon List
const index = catchAsync(async (req, res, next) => {
  const features = new APIFeatures(req.query)
    .filter()
    .sort()
    .limitFields()
    .join()
    .paginate();

  const page = req.query.page * 1 || 1;
  const limit = req.query.limit * 1 || 10;

  if (!features.query.where) features.query.where = {};

  features.query.where.is_deleted = false;

  if (req.query.search && req.query.search.trim().length >= 3) {
    const search = req.query.search.trim();

    features.query.where[Op.or] = [
      { name: { [Op.iLike]: `%${search}%` } },
      { code: { [Op.iLike]: `%${search}%` } },
      { addon_type: { [Op.iLike]: `%${search}%` } }
    ];
  }

  const { rows, count } =
    await SalaryAddonMasterService.index(features.query);

  res.status(200).json({
    status: "success",
    message: "Salary Addon List fetched successfully",
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: rows.length,
    data: { salaryAddonList: rows },
  });
});

// Get By ID
const dataById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  const result = await SalaryAddonMasterService.dataById(id);

  if (!result) {
    return res.status(404).json({
      status: "fail",
      message: "Salary Addon not found",
    });
  }

  res.status(200).json({
    status: "success",
    data: result,
  });
});

// Create
const create = catchAsync(async (req, res, next) => {
  const payload = req.body;

  const result = await SalaryAddonMasterService.create(payload);

  res.status(201).json({
    status: "success",
    data: result,
  });
});

// Update
const edit = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  const result = await SalaryAddonMasterService.edit(id, req.body);

  res.status(200).json({
    status: "success",
    data: result,
  });
});

// Soft Delete
const deleteById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  await SalaryAddonMasterService.deleteById(id);

  res.status(200).json({
    status: "success",
    message: "Salary Addon deleted successfully",
  });
});

module.exports = {
  index,
  dataById,
  create,
  edit,
  deleteById,
};