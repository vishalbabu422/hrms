.stepper-underline {
  display: flex;
  gap: 34px;
  border-bottom: 1px solid #ddd;
  margin-bottom: 24px;
  overflow-x: auto;
  flex-wrap: nowrap;
  scrollbar-width: none;
}

.stepper-underline::-webkit-scrollbar {
  display: none;
}

.stepper-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 0;
  cursor: pointer;
  white-space: nowrap;
  font-size: 14px;
  flex-shrink: 0;
}

.stepper-icon {
  font-size: 18px;
  color: inherit;
}

/* Active step */
.stepper-item.active {
  color: #5856d6; /* purple */
  font-weight: 600;
}

/* Underline indicator */
.stepper-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 100%;
  height: 3px;
  background-color: #5856d6;
  border-radius: 2px;
}

/* Hover effect */
.stepper-item:hover {
  color: #5856d6;
}

.step-content {
  animation: fadeInUp 0.25s ease-in-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.avatar-upload {
  cursor: pointer;
}

.avatar-1 {
  width: 120px;
  height: 120px;
  border-radius: 20%;
  border: 2px dashed #cfcfcf;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: auto;
  font-size: 24px;
  color: #777;
  background: #fafafa;
}

.avatar-1 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-box {
  border: 2px dashed #cfcfcf;
  padding: 18px;
  border-radius: 8px;
  text-align: center;
  background: #fafafa;
}

.upload-box input[type='file'] {
  width: 100%;
}

.form-control,
.form-select {
  font-size: 14px;
}

@media (max-width: 768px) {
  .stepper-item span {
    display: none; /* icon only on mobile */
  }
}

.preview-avatar {
  width: 90px;
  height: 90px;
  border-radius: 12px;
  overflow: hidden;
}

.preview-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.section-title {
  font-weight: 600;
  margin-bottom: 15px;
  border-bottom: 1px solid #e9ecef;
  padding-bottom: 6px;
}

.preview-box {
  background: #f8f9fa;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.nav-tabs .nav-link.active {
  color: #5856d6;
  font-weight: 600;
}

.nav-link {
  color: #4d4c4c;
}

.accordion-button:not(.collapsed) {
  color: var(--cui-accordion-active-color) !important;
  background-color: transparent !important;
  box-shadow: inset 0 calc(-1 * var(--cui-accordion-border-width)) 0
    var(--cui-accordion-border-color) !important;
}


/* ===== Section Header Styling ===== */

.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-accent {
  width: 4px;
  height: 28px;
  background-color: #5856d6;
  border-radius: 4px;
}

.section-title {
  margin: 0;
  font-weight: 700;
  color: #2c2c2c;
  border-bottom: none;
  
}

/* Responsive tweak */
@media (max-width: 768px) {
  .section-title {
    font-size: 16px;
  }
}


.permission-header {
  background-color: #d8e2f1;
  color: #000000;
  height: 32px;
}





/* Main Card */
.leave-card {
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  border: none;
}

/* Dropdown Input */
.multi-select-input {
  min-height: 42px;
  cursor: pointer;
  border-radius: 8px;
  padding: 6px 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  transition: all 0.2s ease;
}

.multi-select-input:hover {
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);
}

/* Dropdown Panel */
.multi-select-dropdown {
  position: absolute;
  width: 100%;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  z-index: 1000;
  margin-top: 6px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  padding: 12px;
}

/* Checkbox Items */
.dropdown-item {
  padding: 6px 4px;
  border-radius: 6px;
  transition: background 0.2s ease;
}

.dropdown-item:hover {
  background: #f3f4f6;
}

/* Employee Card */
.employee-card {
  border-radius: 12px;
  padding: 16px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  border: 1px solid #f1f1f1;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.employee-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

/* Employee Name */
.employee-header {
  font-weight: 600;
  font-size: 15px;
  color: #2c3e50;
  margin-bottom: 10px;
}

/* Table Styling */
.table-clean th {
  background-color: #f8fafc;
  font-weight: 600;
}

.table-clean td,
.table-clean th {
  vertical-align: middle;
  padding: 10px;
}

.table-clean tbody tr:hover {
  background: #f9fafb;
}

/* Inputs */
.input-clean input {
  border-radius: 6px;
  transition: all 0.2s ease;
}

.input-clean input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.15);
}

/* Badges */
.badge {
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 6px;
}

/* Save Button */
.save-btn {
  padding: 8px 20px;
  border-radius: 8px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.save-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}