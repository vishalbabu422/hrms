const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const WorkOrder = sequelize.define(
  "WorkOrder",
  {
    id: {
      type: DataTypes.BIGINT,
      allowNull: false,
      primaryKey: true,
      autoIncrement: true,
    },

    empanelment_id_fk: {
      type: DataTypes.BIGINT,
      allowNull: false,
    },

    work_order_no: {
      type: DataTypes.STRING(255),
      allowNull: false,
      unique: true,
    },

    work_order_date: {
      type: DataTypes.DATEONLY,
      allowNull: false,
    },

    project_no: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    pi_number: {
      type: DataTypes.STRING(255),
    },

    project_name: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    issued_to_name: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    issued_to_address: {
      type: DataTypes.TEXT,
      allowNull: false,
    },

    issued_to_contact: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    issued_to_phone: {
      type: DataTypes.STRING(50),
      allowNull: false,
    },

    issued_to_email: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    contact_name: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    contact_number: {
      type: DataTypes.TEXT,
      allowNull: false,
    },

    contact_email: {
      type: DataTypes.TEXT,
      allowNull: false,
    },

    total_amt: {
      type: DataTypes.DECIMAL(15, 2),
      allowNull: false,
    },

    total_cgst_amt: {
      type: DataTypes.DECIMAL(15, 2),
      allowNull: false,
    },

    total_sgst_amt: {
      type: DataTypes.DECIMAL(15, 2),
      allowNull: false,
    },

    total_igst_amt: {
      type: DataTypes.DECIMAL(15, 2),
      allowNull: false,
    },

    grand_total: {
      type: DataTypes.DECIMAL(15, 2),
      allowNull: false,
    },

    is_active: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    created: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    modified: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    created_by: {
      type: DataTypes.INTEGER,
      allowNull: false,
    },
  },
  {
    schema: "pmu",
    tableName: "work_order",
    timestamps: false,
  }
);

WorkOrder.associate = (models) => {
WorkOrder.hasMany(models.WoDesgnMapping, {
  foreignKey: "work_order_id",
  onDelete: "CASCADE",
});
}

module.exports = WorkOrder;