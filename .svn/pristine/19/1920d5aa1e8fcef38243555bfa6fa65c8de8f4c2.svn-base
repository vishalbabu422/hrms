const catchAsync = require("../../utils/catchAsync");
const APIFeatures = require("../../utils/apiFeature");

const employeeService = require("./employee.service");

// Get Employee List
const getEmployeeList = catchAsync(async (req, res, next) => {
    const features = new APIFeatures(req.query, ["employee_code", "first_name", "email", "contact_no"])
        .filter()
        .search()
        .sort()
        .limitFields()
        .join()
        .paginate();

    if (!features.query.where) features.query.where = {};

    if (!req.isSuperAdmin) {
        features.query.where = {
            ...features.query.where,
            organization_id: req.user.organization_id
        };
    }

    const result = await employeeService.getEmployeeList(features.query);

    res.status(200).json({
        status: "success",
        total: result.count,
        data: result.rows,
    });
});

// Get Employee By ID
const getEmployeeById = catchAsync(async (req, res, next) => {
    const whereCondition = {
        id: req.params.id
    };

    // If not super admin, restrict to same organization
    if (!req.isSuperAdmin) {
        whereCondition.organization_id = req.user.organization_id;
    }

    const result = await employeeService.getEmployeeById({ where: whereCondition });


    if (!result) {
        return res.status(404).json({
            status: "fail",
            message: "Employee not found"
        });
    }

    res.status(200).json({
        status: "success",
        data: result
    });
});


// Create Employee
const create = catchAsync(async (req, res, next) => {

    if (!req.isSuperAdmin) {
        req.body.organization_id = req.user.organization_id;
    }

    const result = await employeeService.createEmployee(req.body);

    res.status(201).json({
        status: "success",
        data: result.employee,
        temporary_password: result.temporaryPassword
    });
});

const deleteById = catchAsync(async (req, res, next) => {

    await employeeService.deleteEmployeeById(
        req.params.id,
        req.user,
        req.isSuperAdmin
    );

    res.status(200).json({
        status: "success",
        message: "Employee deleted successfully"
    });
});

const editById = catchAsync(async (req, res, next) => {

    const employee = await employeeService.updateEmployeeById(
        req.params.id,
        req.body,
        req.user,
        req.isSuperAdmin
    );

    res.status(200).json({
        status: "success",
        data: employee
    });
});

const updateStatus = catchAsync(async (req, res, next) => {

    const employee = await employeeService.updateEmployeeStatus(
        req.params.id,
        req.body,
        req.user,
        req.isSuperAdmin
    );

    res.status(200).json({
        status: "success",
        data: employee
    });
});

module.exports = {
    getEmployeeList,
    getEmployeeById,
    create,
    deleteById,
    editById,
    updateStatus
};