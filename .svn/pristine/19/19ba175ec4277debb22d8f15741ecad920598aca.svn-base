import {
  CCard,
  CCardBody,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CButton,
  CBadge,
  CDropdown,
  CDropdownToggle,
  CDropdownMenu,
  CDropdownItem,
  CContainer,
 
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import ExpandableSearch from '../components/expandable-search'
import { cilPencil, cilTrash, cilPlus, cilZoom, cilCloudDownload,cilCheckCircle, cilXCircle } from '@coreui/icons'

import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

const Index = () => {
  const navigate = useNavigate()


  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }







  const vendors = [
    {
      id: 1,
      vendor_name: 'ABC Solutions Pvt Ltd',
      vendor_code: 'VND001',
      vendor_type: 'PRIVATE_LIMITED',
      contact_person: 'John Doe',
      city: 'Delhi',
      state: 'Delhi',
      is_active: true,
    },
    {
      id: 2,
      vendor_name: 'National Infra LLP',
      vendor_code: 'VND002',
      vendor_type: 'LLP',
      contact_person: 'Rahul Sharma',
      city: 'Mumbai',
      state: 'Maharashtra',
      is_active: false,
    },
  ]

  const totalVendors = vendors.length
  const activeVendors = vendors.filter((v) => v.is_active).length
  const inactiveVendors = vendors.filter((v) => !v.is_active).length

  /* ================= EXPORT ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15
    doc.setFontSize(14)
    doc.text('Vendor List', 10, 10)

    vendors.forEach((v, i) => {
      doc.text(`${i + 1}. ${v.vendor_name} - ${v.vendor_code} - ${v.city}`, 10, y)
      y += 8
    })

    doc.save('vendor-list.pdf')
  }

  const handleExportExcel = () => {
    const worksheet = XLSX.utils.json_to_sheet(vendors)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Vendors')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'vendor-list.xlsx')
  }

  return (
    <CContainer fluid className="py-4">
      {/* ================= PAGE HEADER ================= */}
      <div
        className="mb-4 p-4 rounded-3"
        style={{
          backgroundColor: '#f4f6f9',
          borderLeft: '4px solid #1b4f72',
        }}
      >
        <div className="d-flex justify-content-between align-items-center">
          <div>
            <h5 className="fw-bold mb-1 text-dark">Vendor Management</h5>
            <small className="text-muted">Department Vendor Records</small>
          </div>

          <div className="d-flex gap-3">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search work orders..."
              />
            <CDropdown>
              <CDropdownToggle color="primary" size="sm">
                Export
              </CDropdownToggle>
              <CDropdownMenu>
                <CDropdownItem onClick={handleExportPDF}>Download PDF</CDropdownItem>
                <CDropdownItem onClick={handleExportExcel}>Download Excel</CDropdownItem>
              </CDropdownMenu>
            </CDropdown>

            <CButton color="primary" size="sm" onClick={() => navigate('/vendor/add')}>
              Add Vendor
            </CButton>
          </div>
        </div>
      </div>


      {/* ================= KPI CARDS ================= */}
      {/* <CRow className="mb-4">
        <StatCard title="Total Vendors" value={totalVendors} />
        <StatCard title="Active Vendors" value={activeVendors} />
        <StatCard title="Inactive Vendors" value={inactiveVendors} />
      </CRow> */}

      {/* ================= TABLE CARD ================= */}
      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <CTable hover responsive align="middle" className="rounded overflow-hidden">
            <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
              <CTableRow>
                <CTableHeaderCell>S.no</CTableHeaderCell>
                <CTableHeaderCell>Vendor Name</CTableHeaderCell>
                <CTableHeaderCell>Vendor Code</CTableHeaderCell>
                <CTableHeaderCell>Type</CTableHeaderCell>
                <CTableHeaderCell>Contact</CTableHeaderCell>
                <CTableHeaderCell>Location</CTableHeaderCell>
                <CTableHeaderCell>Status</CTableHeaderCell>
                <CTableHeaderCell>Action</CTableHeaderCell>
              </CTableRow>
            </CTableHead>

            <CTableBody>
              {vendors.map((vendor, index) => (
                <CTableRow key={vendor.id} style={{ transition: '0.2s' }}>
                  <CTableDataCell>{index + 1}</CTableDataCell>
                  <CTableDataCell className="fw-semibold text-dark">
                    {vendor.vendor_name}
                  </CTableDataCell>

                  <CTableDataCell>{vendor.vendor_code}</CTableDataCell>
                  <CTableDataCell>{vendor.vendor_type}</CTableDataCell>
                  <CTableDataCell>{vendor.contact_person}</CTableDataCell>

                  <CTableDataCell>
                    {vendor.city}, {vendor.state}
                  </CTableDataCell>

                  <CTableDataCell>
  {vendor.is_active ? (
    <CIcon icon={cilCheckCircle} className="text-success" size="lg" />
  ) : (
    <CIcon icon={cilXCircle} className="text-danger" size="lg" />
  )}
</CTableDataCell>


                  <CTableDataCell>
                    <div className="d-flex gap-2">
                      <ActionButton
                        color="info"
                        icon={cilZoom}
                        onClick={() => navigate(`/vendor/preview/${vendor.id}`)}
                      />
                      <ActionButton
                        color="primary"
                        icon={cilPencil}
                        onClick={() => navigate(`/vendor/edit/${vendor.id}`)}
                      />
                      <ActionButton color="danger" icon={cilTrash} />
                    </div>
                  </CTableDataCell>
                </CTableRow>
              ))}
            </CTableBody>
          </CTable>

          <CPagination className="justify-content-end mt-3">
            <CPaginationItem disabled>&laquo;</CPaginationItem>
            <CPaginationItem active>1</CPaginationItem>
            <CPaginationItem disabled>&raquo;</CPaginationItem>
          </CPagination>
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index

/* ================= STAT CARD ================= */

const StatCard = ({ title, value, color }) => (
  <CCol md={4}>
    <CCard className="border-0 shadow-sm rounded-4">
      <CCardBody>
        <small className="text-muted">{title}</small>
        <h3 className="fw-bold mt-2" style={{ color }}>
          {value}
        </h3>
      </CCardBody>
    </CCard>
  </CCol>
)

/* ================= ACTION BUTTON ================= */

const ActionButton = ({ color, icon, onClick }) => (
  <CButton size="sm" color={color} variant="ghost" onClick={onClick} className="rounded-circle">
    <CIcon icon={icon} />
  </CButton>
)
