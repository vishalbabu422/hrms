export const validateEmployeeAddon = (data) => {
  const errors = {}

  /* WORKORDER */
  if (!data.workorder_id) {
    errors.workorder_id = 'Workorder is required'
  }

  /* EMPLOYEE */
  if (!data.employees || !data.employees.length) {
    errors.employees = 'Employee is required'
  }

  /* SALARY ADDON */
  if (!data.salary_addon_id) {
    errors.salary_addon_id =
      'Salary Addon is required'
  }

  /* AMOUNT */
  if (!data.amount) {
    errors.amount = 'Amount is required'
  }

  if (
    data.amount &&
    isNaN(Number(data.amount))
  ) {
    errors.amount = 'Amount must be numeric'
  }

  /* EFFECTIVE FROM */
  if (!data.effective_from) {
    errors.effective_from =
      'Effective From is required'
  }

  /* EFFECTIVE TO */
  if (
    data.effective_from &&
    data.effective_to &&
    new Date(data.effective_to) <
      new Date(data.effective_from)
  ) {
    errors.effective_to =
      'Effective To cannot be before Effective From'
  }

  return errors
}