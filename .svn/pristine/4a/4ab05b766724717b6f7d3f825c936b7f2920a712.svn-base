import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle } from '@coreui/icons'
import { useState, useRef } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desv',
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Resource Rate</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search Resource Rate..."
              />
              <CTooltip content="Add Resource Rate" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/resrate/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <CTable striped hover>
              <CTableHead>
                <CTableRow>
                  <SortableHeaderCell label="Sno" sortKey="id" sort={sort} onSort={handleSort} />
                  <SortableHeaderCell
                    label="Designation"
                    sortKey="designation"
                    sort={sort}
                    onSort={handleSort}
                  />

                  {/* <SortableHeaderCell label="Code" sortKey="code" sort={sort} onSort={handleSort} /> */}

                  <SortableHeaderCell
                    label="Agency Margin (%)"
                    sortKey="agency_margin"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Unit Rate (Excluding A.M)"
                    sortKey="unit_rate"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Unit Rate (Including A.M)"
                    sortKey="unit_rate"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Agency Amount"
                    sortKey="agency_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="NICSI Margin (%)"
                    sortKey="nicsi_margin"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="NICSI Margin Amount"
                    sortKey="nicsi_margin_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Total Amount"
                    sortKey="total_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Hsn Code"
                    sortKey="hsn_code"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="CGST Amount"
                    sortKey="cgst_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="SGST Amount"
                    sortKey="sgst_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="IGST Amount"
                    sortKey="igst_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Total Amount"
                    sortKey="total_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  {/* <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} /> */}

                  <SortableHeaderCell
                    label="Final Amount"
                    sortKey="final_amount"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Status"
                    sortKey="status"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                </CTableRow>
              </CTableHead>
              <CTableBody>
                <CTableRow>
                  <CTableDataCell scope="row">1</CTableDataCell>
                  <CTableDataCell>Developer</CTableDataCell>

                  <CTableDataCell>10%</CTableDataCell>
                  <CTableDataCell>50,000</CTableDataCell>
                  <CTableDataCell>55,000</CTableDataCell>
                  <CTableDataCell>5,000</CTableDataCell>

                  <CTableDataCell>5%</CTableDataCell>
                  <CTableDataCell>2,750</CTableDataCell>

                  <CTableDataCell>57,750</CTableDataCell>
                  <CTableDataCell>998313</CTableDataCell>

                  <CTableDataCell>5,197.50</CTableDataCell>
                  <CTableDataCell>5,197.50</CTableDataCell>
                  <CTableDataCell>0.00</CTableDataCell>

                  <CTableDataCell>10,395.00</CTableDataCell>
                  <CTableDataCell>68,145.00</CTableDataCell>
                  <CTableDataCell>
                    <CIcon icon={cilCheckCircle} className="text-success" />
                  </CTableDataCell>
                  <CTableDataCell>
                    <div className="d-flex gap-2">
                      <CTooltip content="Edit" placement="left">
                        <CButton color="primary" size="sm" variant="ghost">
                          <CIcon icon={cilPencil} />
                        </CButton>
                      </CTooltip>
                      <CTooltip content="Delete" placement="right">
                        <CButton color="danger" size="sm" variant="ghost">
                          <CIcon icon={cilTrash} />
                        </CButton>
                      </CTooltip>
                    </div>
                  </CTableDataCell>
                </CTableRow>
              </CTableBody>
            </CTable>
            <CPagination className="justify-content-end" aria-label="Page navigation example">
              <CPaginationItem aria-label="Previous" disabled>
                <span aria-hidden="true">&laquo;</span>
              </CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem aria-label="Next" disabled>
                <span aria-hidden="true">&raquo;</span>
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
