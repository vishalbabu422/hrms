import React, { forwardRef, useImperativeHandle, useState, useEffect } from 'react'
import api from '../../../api/axios'
import { validateLtc } from '../../../validations/ltcValidation'

const Ltc = forwardRef(({ employeeId }, ref) => {
  const [loading, setLoading] = useState(false)
  const [isExisting, setIsExisting] = useState(false)
  const [errors, setErrors] = useState({})

  const [ltcData, setLtcData] = useState({
    hometown: '',
    district: '',
    state: '',
    nearest_railway: '',
    nearest_airport: '',
  })

  // ================= FETCH =================
  useEffect(() => {
    if (!employeeId) return

    const fetchLtc = async () => {
      try {
        const res = await api.get(`/employee/${employeeId}/ltc`)
        const data = res.data?.data

        if (data) {
          setLtcData(data)
          setIsExisting(true)
        }
      } catch (err) {
        console.error('Fetch LTC error', err)
      }
    }

    fetchLtc()
  }, [employeeId])

  // ================= HANDLE =================
  const handleChange = (field, value) => {
    setLtcData((prev) => ({
      ...prev,
      [field]: value,
    }))

    // clear error
    setErrors((prev) => ({
      ...prev,
      [field]: '',
    }))
  }

  // ================= SUBMIT =================
  useImperativeHandle(ref, () => ({
    submit: async () => {
      try {
        setLoading(true)

        // ✅ VALIDATION
        const validationErrors = validateLtc(ltcData, "LTC")

        if (Object.keys(validationErrors).length > 0) {
          setErrors(validationErrors)
          return false
        }

        const url = `/employee/${employeeId}/ltc`
        

        if (isExisting) {
          await api.patch(url, ltcData)
        } else {
          await api.post(url, ltcData)
        }

        return true // ✅ IMPORTANT FOR NEXT

      } catch (error) {
        console.error(error)
        return false
      } finally {
        setLoading(false)
      }
    },
  }))

  return (
    <div className="step-content">
      <div className="border rounded p-3 mb-3">
        <div className="row g-3">

          {/* Hometown */}
          <div className="col-md-6">
            <label className="form-label">
              Hometown <span className="text-danger">*</span>
            </label>

            <input
              className={`form-control ${errors.hometown ? 'is-invalid' : ''}`}
              value={ltcData.hometown || ''}
              onChange={(e) => handleChange('hometown', e.target.value)}
            />

            <div className="invalid-feedback">{errors.hometown}</div>
          </div>

          {/* District */}
          <div className="col-md-6">
            <label className="form-label">
              District <span className="text-danger">*</span>
            </label>

            <input
              className={`form-control ${errors.district ? 'is-invalid' : ''}`}
              value={ltcData.district || ''}
              onChange={(e) => handleChange('district', e.target.value)}
            />

            <div className="invalid-feedback">{errors.district}</div>
          </div>

          {/* State */}
          <div className="col-md-6">
            <label className="form-label">
              State <span className="text-danger">*</span>
            </label>

            <input
              className={`form-control ${errors.state ? 'is-invalid' : ''}`}
              value={ltcData.state || ''}
              onChange={(e) => handleChange('state', e.target.value)}
            />

            <div className="invalid-feedback">{errors.state}</div>
          </div>

          {/* Railway */}
          <div className="col-md-6">
            <label className="form-label">Nearest Railway</label>

            <input
              className="form-control"
              value={ltcData.nearest_railway || ''}
              onChange={(e) => handleChange('nearest_railway', e.target.value)}
            />
          </div>

          {/* Airport */}
          <div className="col-md-6">
            <label className="form-label">Nearest Airport</label>

            <input
              className="form-control"
              value={ltcData.nearest_airport || ''}
              onChange={(e) => handleChange('nearest_airport', e.target.value)}
            />
          </div>

        </div>
      </div>
    </div>
  )
})

export default Ltc