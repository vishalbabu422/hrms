export const validateWorkOrder = (data) => {
  const errors = {};

  // Basic Info
  if (!data.empanelment_id_fk) {
    errors.empanelment_id_fk = "Empanelment is required";
  }

  if (!data.work_order_no || data.work_order_no.trim() === "") {
    errors.work_order_no = "Work Order No is required";
  }

  if (!data.work_order_date) {
    errors.work_order_date = "Date is required";
  }

  if (!data.project_no || data.project_no.trim() === "") {
    errors.project_no = "Project No is required";
  }

  if (!data.project_name || data.project_name.trim() === "") {
    errors.project_name = "Project Name is required";
  }

  // Vendor
  if (!data.vendor_id_fk) {
    errors.vendor_id_fk = "Vendor is required";
  }

  // Issued To (AUTO-FILLED but still REQUIRED)
  if (!data.issued_to_name) {
    errors.vendor_id_fk = "Vendor selection required (Issued To missing)";
  }

  if (!data.issued_to_address) {
    errors.vendor_id_fk = "Vendor address missing";
  }

  if (!data.issued_to_contact) {
    errors.vendor_id_fk = "Vendor contact missing";
  }

  if (!data.issued_to_phone) {
    errors.vendor_id_fk = "Vendor phone missing";
  }

  if (!data.issued_to_email) {
    errors.vendor_id_fk = "Vendor email missing";
  }

  // Contact Person
  if (!data.contact_name || data.contact_name.trim() === "") {
    errors.contact_name = "Contact name is required";
  }

  if (!data.contact_email || data.contact_email.trim() === "") {
    errors.contact_email = "Email is required";
  } else {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    if (!emailRegex.test(data.contact_email)) {
      errors.contact_email = "Enter valid email";
    }
  }

  if (!data.contact_number || data.contact_number.trim() === "") {
    errors.contact_number = "Phone number is required";
  } else {
    const phoneRegex = /^[0-9]{10,15}$/;
    if (!phoneRegex.test(data.contact_number)) {
      errors.contact_number = "Enter valid phone number";
    }
  }

  // Amounts
  if (!data.total_amt) {
    errors.total_amt = "Total amount is required";
  }

  if (!data.total_cgst_amt) {
    errors.total_cgst_amt = "CGST amount is required";
  }

  if (!data.total_sgst_amt) {
    errors.total_sgst_amt = "SGST amount is required";
  }

  if (!data.total_igst_amt) {
    errors.total_igst_amt = "IGST amount is required";
  }

  if (!data.grand_total) {
    errors.grand_total = "Grand total is required";
  }

  // Status
  if (!data.is_active && data.is_active !== false) {
    errors.is_active = "Status is required";
  }

  return errors;
};