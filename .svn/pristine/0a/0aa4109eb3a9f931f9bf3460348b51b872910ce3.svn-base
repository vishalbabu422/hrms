import CompanyFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate, useParams } from 'react-router-dom'
import { useEffect, useState } from 'react'

const edit = () => {
  const { id } = useParams()
  const navigate = useNavigate()
  const [initialData, setInitialData] = useState(null)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    const fetchData = async () => {
      try {
        // const res = await api.get(`/admin/company/${id}`)
        // setInitialData(mapApiToForm(res.data.data))
        const res = await api.get(`/admin/company/${id}`)

console.log("API Response:", res.data.data)

setInitialData(mapApiToForm(res.data.data))
      } catch (err) {
        toast.error('Failed to load Company')
        navigate('/company')
      } finally {
        setLoading(false)
      }
    }

    fetchData()
  }, [id])

  const mapApiToForm = (data) => ({
    
    organization_id: data.organization_id ?? '',
    company_name: data.company_name ?? '',
    company_code: data.company_code ?? '',
    company_type: data.company_type ?? '',

    incorporation_date: data.incorporation_date ?? null,

    official_email: data.official_email ?? '',
    official_phone: data.official_phone ?? '',
    website: data.website ?? '',

    address_line1: data.address_line1 ?? '',
    address_line2: data.address_line2 ?? '',
    city: data.city ?? '',
    state: data.state ?? '',
    country: data.country ?? 'India',
    pincode: data.pincode ?? '',

    is_active: data?.is_active !== undefined ? Boolean(data.is_active) : true,
  })

  const handleUpdate = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
      }

      await api.patch(`/admin/company/edit/${id}`, normalizedPayload)
      toast.success('Company updated successfully')
      navigate('/company')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to update company')
    }
  }

  return <CompanyFormComponent initialData={initialData} mode="edit" onSubmit={handleUpdate} />
}

export default edit
