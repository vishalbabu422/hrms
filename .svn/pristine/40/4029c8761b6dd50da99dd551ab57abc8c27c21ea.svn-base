const catchAsync = require("../../../utils/catchAsync");
const LtcService = require("./ltc.service");
const sequelize = require("../../../utils/database");

// Get LTC
const getLtcByEmployeeId = catchAsync(async (req, res, next) => {

    const whereCondition = {
        employee_id: req.params.employeeId
    };

    const result = await LtcService.getLtcByEmployeeId({ where: whereCondition });

    if (!result) {
        return res.status(404).json({
            status: "fail",
            message: "LTC record not found"
        });
    }

    res.status(200).json({
        status: "success",
        data: result
    });
});


// Assign LTC
const assignLtc = catchAsync(async (req, res, next) => {

    const { employeeId } = req.params;

   const result = await sequelize.transaction(async (t) => {
        return await LtcService.assignLtc(employeeId, req.body, t);
    });

    res.status(201).json({
        status: "success",
        message: "LTC added successfully",
        data : result
    });
});


// Update LTC
const updateLtc = catchAsync(async (req, res, next) => {

    const { employeeId } = req.params;

    const result = await sequelize.transaction(async (t) => {

        return await LtcService.updateLtc(
            employeeId,
            req.body,
            t
        );

    });

    res.status(200).json({
        status: "success",
         message: "LTC updated successfully",
        data: result
    });
});

module.exports = {
    getLtcByEmployeeId,
    assignLtc,
    updateLtc
};