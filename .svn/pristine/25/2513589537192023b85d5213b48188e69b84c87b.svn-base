const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const Document = sequelize.define(
  "Document",
  {
    id: {
      type: DataTypes.BIGINT,
      primaryKey: true,
      autoIncrement: true,
    },

    employee_id: {
      type: DataTypes.BIGINT,
      allowNull: false,
    },

    doc_type: {
      type: DataTypes.ENUM(
        "PHOTO",
        "RESUME",
        "PAN_FILE",
        "AADHAAR_FILE",
        "VOTER_ID_FILE",
        "QUALIFICATION_CERT",
        "EXPERIENCE_CERT",
        "BIRTH_CERT",
        "DRIVING_LICENSE",
        "WORK_PERMIT",
        "CANCEL_CHEQUE",
        "POLICY_DOCUMENT",
        "SCREENING_MAIL_COPY",
        "SALARY_SLIP",
        "FORM16",
        "POLICE_VERIFICATION",
        "DECLARATION",
        "OTHER_DOC"
      ),
      allowNull: false,
    },

    file_name: DataTypes.TEXT,
    file_path: DataTypes.TEXT,
    file_size: DataTypes.BIGINT,
    mime_type: DataTypes.STRING(100),
    file_hash: DataTypes.STRING(64),

    is_encrypted: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    qualification_id: DataTypes.BIGINT,
    experience_id: DataTypes.BIGINT,
    bank_details_id: DataTypes.BIGINT,
    screening_test_id: DataTypes.BIGINT,

    document_verification: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },

    document_verification_date: DataTypes.DATEONLY,

    document_verified_by: DataTypes.BIGINT,

    remarks: DataTypes.TEXT,

    is_deleted: {
      type: DataTypes.BOOLEAN,
      defaultValue: false,
    },
  },
  {
    tableName: "documents",
    schema: "pmu",
    timestamps: true,
    createdAt: "created_at",
    updatedAt: "updated_at",
  }
);

Document.associate = (models) => {

  Document.belongsTo(models.Employee, {
    foreignKey: "employee_id",
    onDelete: "CASCADE",
  });

  Document.belongsTo(models.Employee, {
    foreignKey: "document_verified_by",
    as: "VerifiedBy",
  });

  Document.belongsTo(models.EmployeeQualification, {
    foreignKey: "qualification_id",
    onDelete: "CASCADE",
  });

  Document.belongsTo(models.EmployeeExperience, {
    foreignKey: "experience_id",
    onDelete: "CASCADE",
  });

  Document.belongsTo(models.EmployeeBankDetail, {
    foreignKey: "bank_details_id",
    onDelete: "CASCADE",
  });

  Document.belongsTo(models.EmployeeScreeningTest, {
    foreignKey: "screening_test_id",
    onDelete: "CASCADE",
  });

};

module.exports = Document;
