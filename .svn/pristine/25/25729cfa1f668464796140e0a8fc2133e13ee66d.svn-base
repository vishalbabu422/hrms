.stepper-underline {
  display: flex;
  gap: 34px;
  border-bottom: 1px solid #ddd;
  margin-bottom: 24px;
  overflow-x: auto;
  flex-wrap: nowrap;
  scrollbar-width: none;
}

.stepper-underline::-webkit-scrollbar {
  display: none;
}

.stepper-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 0;
  cursor: pointer;
  white-space: nowrap;
  font-size: 14px;
  flex-shrink: 0;
}

.stepper-icon {
  font-size: 18px;
  color: inherit;
}

/* Active step */
.stepper-item.active {
  color: #5856d6; /* purple */
  font-weight: 600;
}

/* Underline indicator */
.stepper-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 100%;
  height: 3px;
  background-color: #5856d6;
  border-radius: 2px;
}

/* Hover effect */
.stepper-item:hover {
  color: #5856d6;
}

.step-content {
  animation: fadeInUp 0.25s ease-in-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.avatar-upload {
  cursor: pointer;
}

.avatar-1 {
  width: 120px;
  height: 120px;
  border-radius: 20%;
  border: 2px dashed #cfcfcf;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: auto;
  font-size: 24px;
  color: #777;
  background: #fafafa;
}

.avatar-1 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-box {
  border: 2px dashed #cfcfcf;
  padding: 18px;
  border-radius: 8px;
  text-align: center;
  background: #fafafa;
}

.upload-box input[type='file'] {
  width: 100%;
}

.form-control,
.form-select {
  font-size: 14px;
}

@media (max-width: 768px) {
  .stepper-item span {
    display: none; /* icon only on mobile */
  }
}

.preview-avatar {
  width: 90px;
  height: 90px;
  border-radius: 12px;
  overflow: hidden;
}

.preview-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.section-title {
  font-weight: 600;
  margin-bottom: 15px;
  border-bottom: 1px solid #e9ecef;
  padding-bottom: 6px;
}

.preview-box {
  background: #f8f9fa;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.nav-tabs .nav-link.active {
  color: #5856d6;
  font-weight: 600;
}

.nav-link {
  color: #4d4c4c;
}

.accordion-button:not(.collapsed) {
  color: var(--cui-accordion-active-color) !important;
  background-color: transparent !important;
  box-shadow: inset 0 calc(-1 * var(--cui-accordion-border-width)) 0
    var(--cui-accordion-border-color) !important;
}


/* ===== Section Header Styling ===== */

.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-accent {
  width: 4px;
  height: 28px;
  background-color: #5856d6;
  border-radius: 4px;
}

.section-title {
  margin: 0;
  font-weight: 700;
  color: #2c2c2c;
  border-bottom: none;
  
}

/* Responsive tweak */
@media (max-width: 768px) {
  .section-title {
    font-size: 16px;
  }
}


.permission-header {
  background-color: #d8e2f1;
  color: #000000;
  height: 32px;
}
