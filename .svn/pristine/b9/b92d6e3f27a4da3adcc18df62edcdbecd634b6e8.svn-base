import { CFormLabel, CFormSelect } from '@coreui/react'
import { useEffect, useState } from 'react'
import api from '../../api/axios'

const GstSelect = ({
  name = 'gst_code',
  value = '',
  onChange,
  label = 'GST Code',
  placeholder = 'Select GST Code',
  disabled = false,
}) => {
  const [gstList, setGstList] = useState([])

  useEffect(() => {
    const fetchGstCode = async () => {
      const params = {
        fields: 'id,code',
      }

      try {
        const response = await api.get('/admin/gst-code/index', { params })
        setGstList(response.data.data.GstCodeList)
      } catch (error) {
        console.error('Failed to fetch GST Code:', error)
      }
    }

    fetchGstCode()
  }, [])

  return (
    <>
      <CFormLabel>{label}</CFormLabel>
      <CFormSelect
        name={name}
        value={value === null || value === undefined ? '' : String(value)}
        onChange={onChange}
        disabled={disabled}
      >
        <option value="">{placeholder}</option>
        {gstList.map((item) => (
          <option key={item.id} value={item.id}>
            {item.code}
          </option>
        ))}
      </CFormSelect>
    </>
  )
}

export default GstSelect
