{
  "swagger": "2.0",
  "info": {
    "description": "PMU API Documentation",
    "version": "1.0",
    "title": "PMU API",
    "contact": {
      "email": "vishalbabu422@gmail.com"
    }
  },
  "schemes": [
    "http",
    "https"
  ],
  "host": "localhost:3100",
  "basePath": "/api/v1",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "Authorization": {
      "type": "apiKey",
      "name": "authorization",
      "in": "header",
      "description": "Enter: Bearer <JWT Token>"
    }
  },
  "paths": {
    "/employee": {
      "get": {
        "tags": [
          "Employee"
        ],
        "summary": "Get employee list",
        "description": "Returns paginated employee list. Non-super-admin users will only see employees of their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "employee_code",
            "in": "query",
            "type": "string"
          },
          {
            "name": "first_name",
            "in": "query",
            "type": "string"
          },
          {
            "name": "email",
            "in": "query",
            "type": "string"
          },
          {
            "name": "contact_no",
            "in": "query",
            "type": "string"
          },
          {
            "name": "search",
            "in": "query",
            "type": "string",
            "description": "Search across employee_code, first_name, email, contact_no"
          },
          {
            "name": "sort",
            "in": "query",
            "type": "string",
            "description": "Sort fields, e.g. first_name"
          },
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "default": 10
          },
          {
            "name": "fields",
            "in": "query",
            "type": "string",
            "description": "Select specific fields, e.g. id,first_name,email"
          }
        ],
        "responses": {
          "200": {
            "description": "Employee list fetched successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "total": {
                  "type": "integer",
                  "example": 50
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Employee"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Employee"
        ],
        "summary": "Create employee",
        "description": "Creates a new employee. HR/Admin can create employee. System generates a temporary password and forces password change on first login.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EmployeeCreate"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Employee created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "data": {
                  "$ref": "#/definitions/Employee"
                },
                "temporary_password": {
                  "type": "string",
                  "example": "a8f3d2c1",
                  "description": "Temporary password generated by system (shown only once)"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / duplicate email / duplicate employee code"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employee/{id}": {
      "get": {
        "tags": [
          "Employee"
        ],
        "summary": "Get employee by ID",
        "description": "Returns employee details by ID. Non-super-admin users can only access employees within their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Employee ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Employee fetched successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "data": {
                  "$ref": "#/definitions/Employee"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "404": {
            "description": "Employee not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "patch": {
        "tags": [
          "Employee"
        ],
        "summary": "Update employee",
        "description": "Updates employee details. Non-super-admin users can update employees only within their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Employee ID"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EmployeeUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "data": {
                  "$ref": "#/definitions/Employee"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / duplicate email / duplicate employee code"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Employee"
        ],
        "summary": "Delete employee (Soft Delete)",
        "description": "Soft deletes an employee. Non-super-admin users can delete employees only within their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Employee ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Employee deleted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "Employee deleted successfully"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "404": {
            "description": "Employee not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employee/{id}/status": {
      "patch": {
        "tags": [
          "Employee"
        ],
        "summary": "Update employee account status",
        "description": "Updates employee account workflow status (PENDING, ACTIVE, REJECTED, EXITED). Only authorized users with EMPLOYEE_APPROVE permission can perform this action. Non-super-admin users can update employees only within their organization.",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Employee ID"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EmployeeStatusUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee status updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "data": {
                  "$ref": "#/definitions/Employee"
                }
              }
            }
          },
          "400": {
            "description": "Invalid account status"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Permission denied"
          },
          "404": {
            "description": "Employee not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
