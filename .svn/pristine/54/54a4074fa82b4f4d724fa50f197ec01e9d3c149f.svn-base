            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "company_name"
              ],
              "properties": {
                "organization_id": {
                  "type": "integer",
                  "example": 1
                },
                "company_name": {
                  "type": "string",
                  "example": "ABC Private Limited"
                },
                "company_code": {
                  "type": "string",
                  "example": "ABC001"
                },
                "company_type": {
                  "type": "string",
                  "enum": [
                    "PRIVATE_LIMITED",
                    "PUBLIC_LIMITED",
                    "LLP",
                    "PROPRIETORSHIP",
                    "PARTNERSHIP",
                    "GOVERNMENT",
                    "NGO",
                    "OTHER"
                  ],
                  "example": "PRIVATE_LIMITED"
                },
                "incorporation_date": {
                  "type": "string",
                  "format": "date",
