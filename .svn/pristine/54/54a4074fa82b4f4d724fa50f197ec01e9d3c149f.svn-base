      "post": {
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Empanelment"
        ],
        "summary": "Create Empanelment",
        "description": "Create a new Empanelment record in the master table",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "category",
                "empanelment_no",
                "date",
                "shortcode",
                "rfe",
                "effective_from"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "maxLength": 20,
                  "example": "VENDOR"
                },
                "empanelment_no": {
                  "type": "string",
                  "maxLength": 50,
                  "example": "EMP-2024-001"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-15"
                },
                "shortcode": {
                  "type": "string",
                  "example": "EMP24"
                },
                "rfe": {
                  "type": "string",
                  "example": "RFE-IT-SERVICES"
                },
                "effective_from": {
                  "type": "string",
                  "format": "date",
                  "example": "2024-04-01"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-31"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Empanelment created successfully",
            "schema": {
              "$ref": "#/definitions/EmpanelmentResponse"
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "409": {
            "description": "Empanelment already exists",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
