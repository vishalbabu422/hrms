                  "format": "email",
                  "example": "info@abc.com"
                },
                "official_phone": {
                  "type": "string",
                  "example": "9876543210"
                },
                "website": {
                  "type": "string",
                  "example": "https://abc.com"
                },
                "address_line1": {
                  "type": "string",
                  "example": "Plot No 10, Sector 5"
                },
                "address_line2": {
                  "type": "string",
                  "example": "Near Metro Station"
                },
                "city": {
                  "type": "string",
                  "example": "New Delhi"
                },
                "state": {
                  "type": "string",
                  "example": "Delhi"
                },
                "country": {
                  "type": "string",
                  "example": "India"
                },
                "pincode": {
                  "type": "string",
                  "example": "110001"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Company created successfully",
            "schema": {
              "$ref": "#/definitions/CompanyResponse"
            }
          },
