import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CCol, CCardBody } from '@coreui/react'
import { getEmployeeLanguages } from '../../../services/languageService'

const LanguagesView = () => {
  const { employeeId } = useParams()

  const [languageData, setLanguageData] = useState([])
  const [loading, setLoading] = useState(false)

  const fetchLanguages = async () => {
    try {
      setLoading(true)

      const response = await getEmployeeLanguages(employeeId)

      const data = response.data?.data || response.data || []
      setLanguageData(data)
    } catch (error) {
      console.error('Error fetching languages:', error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchLanguages()
  }, [employeeId])

  return (
    <CCol xs={12} sm={12} md={9} lg={10}>
      <CCardBody style={{ minHeight: '400px' }}>
        {/* Header */}
        <div className="section-header mb-4">
          <div className="section-accent"></div>
          <h5 className="section-title">Languages</h5>
        </div>

        {/* Loading */}
        {loading && <p>Loading languages...</p>}

        {/* Empty */}
        {!loading && languageData.length === 0 && (
          <p className="text-muted">No languages available</p>
        )}

        {/* Data */}
        {!loading &&
          languageData.length > 0 &&
          languageData.map((item, index) => (
            <div key={item.id || index} className="mb-4">
              <div className="row align-items-center">
                {/* Language */}
                <div className="col-12 col-md-3">
                  <small className="text-muted">Language</small>
                  <div className="fw-semibold pb-2">
                    {item.language_name || '-'}
                  </div>
                </div>

                {/* Read */}
                <div className="col-6 col-md-2 mt-3 mt-md-0">
                  <div className="d-flex align-items-center gap-2">
                    <input
                      type="checkbox"
                      className="form-check-input"
                      checked={!!item.can_read}
                      disabled
                    />
                    <span>Read</span>
                  </div>
                </div>

                {/* Write */}
                <div className="col-6 col-md-2 mt-3 mt-md-0">
                  <div className="d-flex align-items-center gap-2">
                    <input
                      type="checkbox"
                      className="form-check-input"
                      checked={!!item.can_write}
                      disabled
                    />
                    <span>Write</span>
                  </div>
                </div>

                {/* Speak */}
                <div className="col-6 col-md-2 mt-3 mt-md-0">
                  <div className="d-flex align-items-center gap-2">
                    <input
                      type="checkbox"
                      className="form-check-input"
                      checked={!!item.can_speak}
                      disabled
                    />
                    <span>Speak</span>
                  </div>
                </div>

                {/* Proficiency */}
                <div className="col-12 col-md-3 mt-3 mt-md-0">
                  <small className="text-muted">Proficiency</small>
                  <div className="fw-semibold pb-2">
                    {item.proficiency || '-'}
                  </div>
                </div>
              </div>

              <hr className="mt-4" />
            </div>
          ))}
      </CCardBody>
    </CCol>
  )
}

export default LanguagesView