import GstFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const add = () => {
  const navigate = useNavigate()
  
  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
        gst_rate: Number(payload.gst_rate) || 0,
        cgst_rate: Number(payload.cgst_rate) || 0,
        sgst_rate: Number(payload.sgst_rate) || 0,
        igst_rate: Number(payload.igst_rate) || 0,
        cess_rate: Number(payload.cess_rate) || 0,
        other_rate: Number(payload.other_rate) || 0,
      }

      await api.post('/admin/gst-code/create', normalizedPayload)
      toast.success('GST Code created successfully')
      navigate('/gst-code')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to create GST Code')
    }
  }

  const initialData = {
    code_type: '',
    code: '',
    description: '',
    gst_rate: 0.00,
    cgst_rate: 0.00,
    sgst_rate: 0.00,
    igst_rate: 0.00,
    cess_rate: 0.00,
    other_rate: 0.00,
    effective_from: '',
    effective_to: null,
    is_active: true,
  }

  return <GstFormComponent initialData={initialData} mode="create" onSubmit={handleSubmit} />
}

export default add
