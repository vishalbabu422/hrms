import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'

const Add = () => {
  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3">
              <CCol md={12}>
                <CFormLabel htmlFor="inputCodetype">Code Type</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputCodetype"
                  name="codetype"
                  placeholder="Enter Code Type"
                  maxLength={10}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel htmlFor="inputCode">Code</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputCode"
                  name="Code"
                  placeholder="Enter Code"
                  inputMode="numeric"
                  maxLength={10}
                  onInput={(e) => {
                    e.target.value = e.target.value.replace(/\D/g, '')
                  }}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel htmlFor="description">Description</CFormLabel>
                <CFormTextarea
                  id="description"
                  name="description"
                  placeholder="Enter description"
                  rows={3}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="gstRate">GST Rate (%)</CFormLabel>
                <CFormInput type="number" id="gstRate" name="gst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="cgstRate">CGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="cgstRate" name="cgst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="sgstRate">SGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="sgstRate" name="sgst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="igstRate">IGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="igstRate" name="igst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={4}>
                <CFormLabel htmlFor="cessRate">CESS Rate (%)</CFormLabel>
                <CFormInput type="number" id="cessRate" name="cess_rate" placeholder="0.00" />
              </CCol>

              <CCol md={4}>
                <CFormLabel htmlFor="inputEffectiveFrom">Effective From</CFormLabel>
                <CFormInput type="date" id="inputEffectiveFrom" name="effectiveFrom" required />
              </CCol>

              <CCol md={4}>
                <CFormLabel htmlFor="inputEffectiveTo">Effective To</CFormLabel>
                <CFormInput type="date" id="inputEffectiveTo" name="effectiveTo" />
              </CCol>

              <CCol md={12}>
                <CFormLabel htmlFor="status">Status</CFormLabel>
                <CFormSelect id="status" name="status">
                  <option value="">Select</option>
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton color="primary" type="submit">
                  Submit
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Add
