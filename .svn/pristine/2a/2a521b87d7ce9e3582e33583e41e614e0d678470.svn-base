import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import {
  CContainer,
  CCard,
  CCardBody,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CSpinner,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilCheckCircle, cilXCircle, cilDescription } from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

import api from '../../api/axios'
import SortableHeaderCell from '../components/sort-table-header'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'
import PageHeader from '../components/form-header'
import ActionButton from '../components/action-button'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')
  const [empanelment, setEmpanelment] = useState([])
  const [loading, setLoading] = useState(false)

  /* ================= FETCH ================= */

  const fetchEmpanelments = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/empanelment/index', { params })

      setEmpanelment(response.data?.data?.EmpanelmentList ?? [])
      setTotalPages(response.data?.totalPages ?? 1)
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch Empanelment list')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchEmpanelments()
    }
  }, [search, sort, page])

  /* ================= SORT ================= */

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Empanelment?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/empanelment/delete/${id}`)
      toast.success('Empanelment deleted successfully')
      fetchEmpanelments()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete Empanelment')
    }
  }

  /* ================= EXPORT ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15

    doc.setFontSize(14)
    doc.text('Empanelment List', 10, 10)

    empanelment.forEach((item, index) => {
      doc.text(`${index + 1}. ${item.empanelment_no} - ${item.shortcode} - ${item.category}`, 10, y)
      y += 8
    })

    doc.save('empanelment-list.pdf')
  }

  const handleExportExcel = () => {
    const formattedData = empanelment.map((item, index) => ({
      'Sr No': index + 1,
      Category: item.category,
      'Empanelment No': item.empanelment_no,
      'Short Code': item.shortcode,
      RFE: item.rfe,
      Date: item.date,
      'Effective From': item.effective_from,
      'Effective To': item.effective_to,
      Status: item.is_active ? 'Active' : 'Inactive',
    }))

    const worksheet = XLSX.utils.json_to_sheet(formattedData)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Empanelments')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'empanelment-list.xlsx')
  }

  /* ================= UI ================= */

  return (
    <CContainer fluid>
      <PageHeader
        title="Empanelment"
        searchValue={search}
        onSearchChange={setSearch}
        onAddClick={() => navigate('/empanelment/add')}
        addLabel="Add Empanelment"
        showExport
        onExportPDF={handleExportPDF}
        onExportExcel={handleExportExcel}
      />

      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <SimpleBar autoHide>
            <CTable hover responsive align="middle">
              <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
                <CTableRow>
                  <SortableHeaderCell
                    label="Category"
                    sortKey="category"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <SortableHeaderCell
                    label="Empanelment No"
                    sortKey="empanelment_no"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <SortableHeaderCell
                    label="Short Code"
                    sortKey="shortcode"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <SortableHeaderCell label="RFE" sortKey="rfe" sort={sort} onSort={handleSort} />
                  <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} />
                  <SortableHeaderCell
                    label="Effective From"
                    sortKey="effective_from"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <SortableHeaderCell
                    label="Effective To"
                    sortKey="effective_to"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <SortableHeaderCell
                    label="Status"
                    sortKey="is_active"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <CTableHeaderCell className="text-center">Action</CTableHeaderCell>
                </CTableRow>
              </CTableHead>

              <CTableBody>
                {loading ? (
                  <CTableRow>
                    <CTableDataCell colSpan={10} className="text-center py-4">
                      <CSpinner size="sm" />
                    </CTableDataCell>
                  </CTableRow>
                ) : empanelment.length > 0 ? (
                  empanelment.map((item, index) => (
                    <CTableRow key={item.id}>
                      <CTableDataCell>{item.category}</CTableDataCell>
                      <CTableDataCell>{item.empanelment_no}</CTableDataCell>
                      <CTableDataCell>{item.shortcode}</CTableDataCell>
                      <CTableDataCell>{item.rfe}</CTableDataCell>
                      <CTableDataCell>{item.date}</CTableDataCell>
                      <CTableDataCell>{item.effective_from || '-'}</CTableDataCell>
                      <CTableDataCell>{item.effective_to || '-'}</CTableDataCell>
                      <CTableDataCell>
                        {item.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>
                      <CTableDataCell>
                        <div className="d-flex justify-content-center gap-2">
                          <ActionButton
                            color="primary"
                            icon={cilDescription}
                            onClick={() => navigate(`/empanelment/preview/${item.id}`)}
                          />
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() => navigate(`/empanelment/edit/${item.id}`)}
                          />
                          {item.is_active && (
                            <ActionButton
                              color="danger"
                              icon={cilTrash}
                              onClick={() => confirmDelete(item.id)}
                            />
                          )}
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))
                ) : (
                  <TableEmptyState colSpan={10} />
                )}
              </CTableBody>
            </CTable>
          </SimpleBar>

          <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index
