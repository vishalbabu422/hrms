import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'
import { useState } from 'react'

const EmpSalaryStructureForm = ({ onSubmit }) => {
  const [selectedStructure, setSelectedStructure] = useState('')
  const [selectedGroup, setSelectedGroup] = useState('')
  const [selectedEmployees, setSelectedEmployees] = useState({})
  const [selectAll, setSelectAll] = useState(false)

  const [sameDateForAll, setSameDateForAll] = useState(false)
  const [globalDate, setGlobalDate] = useState('')

  /* ================= DATA ================= */

  const orgEmployees = [
    { id: 1, name: 'Shrikant' },
    { id: 2, name: 'Vishal' },
    { id: 3, name: 'Akansha' },
    { id: 4, name: 'Saurabh' },
  ]

  const workEmployees = [
    { id: 101, name: 'Sarita' },
    { id: 102, name: 'Paras' },
    { id: 103, name: 'Sanjay' },
    { id: 104, name: 'Atul' },
  ]

  const structureList = [
    { id: 1, name: 'Structure A' },
    { id: 2, name: 'Structure B' },
  ]

  const employeeList =
    selectedGroup === 'org' ? orgEmployees : selectedGroup === 'work' ? workEmployees : []

  /* ================= HANDLERS ================= */

  const handleGroupChange = (value) => {
    setSelectedGroup(value)
    setSelectedEmployees({})
    setSelectAll(false)
    setSameDateForAll(false)
    setGlobalDate('')
  }

  const handleCheckbox = (id) => {
    const updated = {
      ...selectedEmployees,
      [id]: {
        ...selectedEmployees[id],
        checked: !selectedEmployees[id]?.checked,
      },
    }

    setSelectedEmployees(updated)

    const allSelected =
      employeeList.length > 0 && employeeList.every((emp) => updated[emp.id]?.checked)

    setSelectAll(allSelected)
  }

  const handleSelectAll = () => {
    const newValue = !selectAll
    setSelectAll(newValue)

    const updated = {}
    employeeList.forEach((emp) => {
      updated[emp.id] = {
        ...selectedEmployees[emp.id],
        checked: newValue,
        value: selectedEmployees[emp.id]?.value || '',
        effective_from: selectedEmployees[emp.id]?.effective_from || '',
      }
    })

    setSelectedEmployees(updated)
  }

  const handleChange = (id, field, value) => {
    setSelectedEmployees((prev) => ({
      ...prev,
      [id]: {
        ...prev[id],
        [field]: value,
      },
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    const finalData = Object.entries(selectedEmployees)
      .filter(([_, v]) => v.checked)
      .map(([id, v]) => ({
        employee_id: Number(id),
        ctc: v.value,
        effective_from: sameDateForAll ? globalDate : v.effective_from,
        salary_structure_id: selectedStructure,
        group: selectedGroup,
      }))

    onSubmit(finalData)
  }

  const showEmployees = selectedGroup && selectedStructure

  /* ================= UI ================= */

  return (
    <CForm onSubmit={handleSubmit}>
      <CRow>
        {/* TOP */}
        <CCol md={12}>
          <CCard
            className="mb-4 border-0"
            style={{
              background: '#f8f9ff',
              borderRadius: '12px',
              boxShadow: '0 2px 8px rgba(0,0,0,0.05)',
            }}
          >
            <CCardBody>
              <CRow>
                <CCol md={6}>
                  <CFormLabel className="fw-semibold">Emp Group</CFormLabel>
                  <CFormSelect
                    value={selectedGroup}
                    onChange={(e) => handleGroupChange(e.target.value)}
                  >
                    <option value="">Select</option>
                    <option value="org">Organisation</option>
                    <option value="work">Work Order</option>
                  </CFormSelect>
                </CCol>

                <CCol md={6}>
                  <CFormLabel className="fw-semibold">Salary Structure</CFormLabel>
                  <CFormSelect
                    value={selectedStructure}
                    onChange={(e) => setSelectedStructure(e.target.value)}
                  >
                    <option value="">Select</option>
                    {structureList.map((s) => (
                      <option key={s.id} value={s.id}>
                        {s.name}
                      </option>
                    ))}
                  </CFormSelect>
                </CCol>
              </CRow>
            </CCardBody>
          </CCard>
        </CCol>

        {/* TABLE */}
        {showEmployees && (
          <CCol md={12}>
            <CCard className="border-0 shadow-sm rounded-4">
              <CCardBody>
                {/* HEADER */}
                <div
                  className="row py-2 mb-2 align-items-center"
                  style={{
                    background: '#aab6d7',
                    borderRadius: '8px',
                    fontSize: '16px',
                    fontWeight: 600,
                    color: '#white',
                  }}
                >
                  <div className="col-md-1 text-center">
                    <input type="checkbox" checked={selectAll} onChange={handleSelectAll} />
                  </div>

                  <div className="col-md-4">Employee Name</div>
                  <div className="col-md-3">CTC</div>

                  <div className="col-md-4 d-flex align-items-center justify-content-between">
                    <span>Effective From</span>

                    <div className="d-flex align-items-center gap-2">
                      <input
                        type="checkbox"
                        checked={sameDateForAll}
                        onChange={(e) => setSameDateForAll(e.target.checked)}
                      />

                      <small>Same for all</small>

                      {sameDateForAll && (
                        <CFormInput
                          type="date"
                          value={globalDate}
                          onChange={(e) => setGlobalDate(e.target.value)}
                          style={{ width: '140px', height: '30px' }}
                        />
                      )}
                    </div>
                  </div>
                </div>

                {/* ROWS */}
                {employeeList.map((emp) => {
                  const selected = selectedEmployees[emp.id] || {}

                  return (
                    <div
                      key={emp.id}
                      className="row align-items-center py-3"
                      style={{
                        borderBottom: '1px solid #eee',
                        transition: '0.2s',
                      }}
                      onMouseEnter={(e) => (e.currentTarget.style.background = '#f9faff')}
                      onMouseLeave={(e) => (e.currentTarget.style.background = 'transparent')}
                    >
                      <div className="col-md-1 text-center">
                        <input
                          type="checkbox"
                          checked={!!selected.checked}
                          onChange={() => handleCheckbox(emp.id)}
                        />
                      </div>

                      <div className="col-md-4 fw-medium">{emp.name}</div>

                      <div className="col-md-3">
                        <div className="input-group" style={{ maxWidth: '220px' }}>
                          <span className="input-group-text">₹</span>
                          <CFormInput
                            type="number"
                            placeholder="CTC"
                            value={selected.value || ''}
                            onChange={(e) => handleChange(emp.id, 'value', e.target.value)}
                          />
                        </div>
                      </div>

                      <div className="col-md-4">
                        <CFormInput
                          type="date"
                          value={sameDateForAll ? globalDate : selected.effective_from || ''}
                          disabled={sameDateForAll}
                          onChange={(e) => handleChange(emp.id, 'effective_from', e.target.value)}
                          style={{ maxWidth: '180px' }}
                        />
                      </div>
                    </div>
                  )
                })}

                {/* FOOTER */}
                <div
                  className="d-flex justify-content-end mt-4 pt-3"
                 
                >
                  <CButton color="primary">Save</CButton>
                </div>
              </CCardBody>
            </CCard>
          </CCol>
        )}
      </CRow>
    </CForm>
  )
}

export default EmpSalaryStructureForm
