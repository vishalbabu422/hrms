import {
  CButton,
  CFormInput,
  CFormLabel,
  CModal,
  CModalBody,
  CModalFooter,
  CModalHeader,
  CModalTitle,
} from '@coreui/react'

const SalaryBulkDispatchModal = ({
  visible,
  onClose,
  handleBulkDispatch,

  applyAllTransactions,
  handleApplyAllTransactions,

  commonTransactionNo,
  setCommonTransactionNo,

  commonTransactionDate,
  setCommonTransactionDate,

  employeeTransactions,
  setEmployeeTransactions,

  selectedEmployees,
  salaryData,

  handleEmployeeTransactionChange,
}) => {
  return (
    <CModal visible={visible} alignment="center" size="lg" onClose={onClose}>
      {/* HEADER */}

      <CModalHeader
        style={{
          background: '#f8fafc',
          borderBottom: '1px solid #e2e8f0',
        }}
      >
        <CModalTitle
          style={{
            fontWeight: '700',
            color: '#1e293b',
            fontSize: '20px',
          }}
        >
          Bulk Dispatch
        </CModalTitle>
      </CModalHeader>

      {/* BODY */}

      <CModalBody
        style={{
          background: '#ffffff',
          padding: '24px',
        }}
      >
        {/* APPLY SAME */}

        <div
          className="rounded-3 p-3 mb-4"
          style={{
            background: '#f8fafc',
            border: '1px solid #dbe2ea',
          }}
        >
          <label className="d-flex align-items-center gap-2 mb-3">
            <input
              type="checkbox"
              checked={applyAllTransactions}
              onChange={(e) => handleApplyAllTransactions(e.target.checked)}
            />

            <span
              className="fw-semibold"
              style={{
                fontSize: '14px',
                color: '#334155',
              }}
            >
              Apply Same Transaction Number To All Employees
            </span>
          </label>

          <div className="row">
            {/* COMMON TRANSACTION NUMBER */}

            <div className="col-md-6 mb-3">
              <CFormLabel>Common Transaction Number</CFormLabel>

              <CFormInput
                value={commonTransactionNo}
                onChange={(e) => {
                  const value = e.target.value

                  setCommonTransactionNo(value)

                  if (applyAllTransactions) {
                    const updated = {
                      ...employeeTransactions,
                    }

                    salaryData
                      .filter((emp) => selectedEmployees.includes(emp.id))
                      .forEach((emp) => {
                        const existing = updated[emp.id]?.transaction_number

                        if (!existing) {
                          updated[emp.id] = {
                            ...updated[emp.id],

                            transaction_number: value,
                          }
                        }
                      })

                    setEmployeeTransactions(updated)
                  }
                }}
                placeholder="Enter Transaction Number"
              />
            </div>

            {/* COMMON DATE */}

            <div className="col-md-6 mb-3">
              <CFormLabel>Common Transaction Date</CFormLabel>

              <CFormInput
                type="date"
                value={commonTransactionDate}
                onChange={(e) => {
                  const value = e.target.value

                  setCommonTransactionDate(value)

                  if (applyAllTransactions) {
                    const updated = {
                      ...employeeTransactions,
                    }

                    salaryData
                      .filter((emp) => selectedEmployees.includes(emp.id))
                      .forEach((emp) => {
                        updated[emp.id] = {
                          ...updated[emp.id],

                          transaction_date: updated[emp.id]?.transaction_date || value,
                        }
                      })

                    setEmployeeTransactions(updated)
                  }
                }}
              />
            </div>
          </div>
        </div>

        {/* TABLE HEADER */}

        <div
          className="d-grid align-items-center px-3 py-2"
          style={{
            gridTemplateColumns: '1fr 1fr 180px',

            gap: '12px',

            background: '#e2e8f0',

            border: '1px solid #dbe2ea',

            borderRadius: '8px',

            fontWeight: '700',

            fontSize: '13px',

            color: '#334155',

            marginBottom: '10px',
          }}
        >
          <div>Employee</div>

          <div>Transaction Number</div>

          <div>Transaction Date</div>
        </div>

        {/* ROWS */}

        <div
          style={{
            maxHeight: '380px',
            overflowY: 'auto',
          }}
        >
          {salaryData
            .filter((emp) => selectedEmployees.includes(emp.id))
            .map((emp, index) => (
              <div
                key={emp.id}
                className="d-grid align-items-center px-3 py-2"
                style={{
                  gridTemplateColumns: '1fr 1fr 180px',

                  gap: '12px',

                  borderBottom:
                    index !== selectedEmployees.length - 1 ? '1px solid #e2e8f0' : 'none',
                }}
              >
                {/* EMPLOYEE */}

                <div>
                  <div
                    style={{
                      fontWeight: '600',
                      fontSize: '14px',
                      color: '#1e293b',
                    }}
                  >
                    {emp.first_name} {emp.last_name}
                  </div>

                  <div
                    style={{
                      fontSize: '12px',
                      color: '#64748b',
                    }}
                  >
                    {emp.employee_code}
                  </div>
                </div>

                {/* TRANSACTION NUMBER */}

                <CFormInput
                  value={employeeTransactions?.[emp.id]?.transaction_number || ''}
                  onChange={(e) =>
                    handleEmployeeTransactionChange(
                      emp.id,

                      'transaction_number',

                      e.target.value,
                    )
                  }
                  placeholder="Transaction Number"
                />

                {/* TRANSACTION DATE */}

                <CFormInput
                  type="date"
                  value={employeeTransactions?.[emp.id]?.transaction_date || ''}
                  onChange={(e) =>
                    handleEmployeeTransactionChange(
                      emp.id,

                      'transaction_date',

                      e.target.value,
                    )
                  }
                />
              </div>
            ))}
        </div>
      </CModalBody>

      {/* FOOTER */}

      <CModalFooter
        style={{
          background: '#f8fafc',
          borderTop: '1px solid #e2e8f0',
        }}
      >
        <CButton
          style={{
            background: '#64748b',
            border: 'none',
            color: '#fff',
          }}
          onClick={onClose}
        >
          Cancel
        </CButton>

        <CButton
          style={{
            background: '#1d4ed8',
            border: 'none',
            color: '#fff',
          }}
          onClick={handleBulkDispatch}
        >
          Submit
        </CButton>
      </CModalFooter>
    </CModal>
  )
}

export default SalaryBulkDispatchModal
