import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import {
  CContainer,
  CCard,
  CCardBody,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CSpinner,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilCheckCircle, cilXCircle, cilDescription,cilLockLocked} from '@coreui/icons'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

import SortableHeaderCell from '../components/sort-table-header'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'
import PageHeader from '../components/form-header'
import ActionButton from '../components/action-button'

const Index = () => {
  const navigate = useNavigate()

  const LIMIT = 10

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [page, setPage] = useState(1)
  const [search, setSearch] = useState('')
  const [modules, setModules] = useState([])
  const [loading, setLoading] = useState(false)
  const [totalPages, setTotalPages] = useState(1)

  /* ================= FETCH FROM LOCAL ================= */

  const fetchModules = () => {
    setLoading(true)

    const stored = JSON.parse(localStorage.getItem('modules')) || []

    let filtered = [...stored]

    // Search
    if (search.length >= 3) {
      filtered = filtered.filter((item) =>
        item.module_name?.toLowerCase().includes(search.toLowerCase()),
      )
    }

    // Sort
    filtered.sort((a, b) => {
      const valA = a[sort.key]
      const valB = b[sort.key]

      if (valA < valB) return sort.order === 'asc' ? -1 : 1
      if (valA > valB) return sort.order === 'asc' ? 1 : -1
      return 0
    })

    // Pagination
    const startIndex = (page - 1) * LIMIT
    const paginated = filtered.slice(startIndex, startIndex + LIMIT)

    setModules(paginated)
    setTotalPages(Math.ceil(filtered.length / LIMIT) || 1)

    setLoading(false)
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    fetchModules()
  }, [search, sort, page])

  /* ================= SORT ================= */

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return {
          key,
          order: prev.order === 'asc' ? 'desc' : 'asc',
        }
      }
      return { key, order: 'asc' }
    })
  }

  /* ================= DELETE ================= */

  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Module?')) return

    const stored = JSON.parse(localStorage.getItem('modules')) || []

    const updated = stored.filter((item) => item.id !== id)

    localStorage.setItem('modules', JSON.stringify(updated))

    toast.success('Module deleted successfully')
    fetchModules()
  }

  /* ================= EXPORT ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15

    doc.setFontSize(14)
    doc.text('Module List', 10, 10)

    modules.forEach((item, index) => {
      doc.text(`${index + 1}. ${item.module_name} - ${item.module_code}`, 10, y)
      y += 8
    })

    doc.save('module-list.pdf')
  }

  const handleExportExcel = () => {
    const formattedData = modules.map((item, index) => ({
      'Sr No': index + 1,
      'Module Name': item.module_name,
      'Module Code': item.module_code,
      Description: item.description,
      Status: item.is_active ? 'Active' : 'Inactive',
    }))

    const worksheet = XLSX.utils.json_to_sheet(formattedData)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Modules')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'module-list.xlsx')
  }

  /* ================= UI ================= */

  return (
    <CContainer fluid className="py-4">
      <PageHeader
        title="Modules"
        onSearchChange={setSearch}
        onAddClick={() => navigate('/roles-and-permissions/add')}
        addLabel="Add Module"
        onExportPDF={handleExportPDF}
        onExportExcel={handleExportExcel}
        showExport
      />

      <CCard className="shadow border-0 rounded-4">
        <CCardBody>
          <SimpleBar autoHide>
            <CTable hover responsive align="middle">
              <CTableHead>
                <CTableRow>
                  <SortableHeaderCell
                    label="Module Name"
                    sortKey="module_name"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Module Code"
                    sortKey="module_code"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Status"
                    sortKey="is_active"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <CTableHeaderCell className="text-center">Action</CTableHeaderCell>
                </CTableRow>
              </CTableHead>

              <CTableBody>
                {loading ? (
                  <CTableRow>
                    <CTableDataCell colSpan={4} className="text-center py-4">
                      <CSpinner size="sm" />
                    </CTableDataCell>
                  </CTableRow>
                ) : modules.length > 0 ? (
                  modules.map((item) => (
                    <CTableRow key={item.id}>
                      <CTableDataCell>{item.module_name}</CTableDataCell>

                      <CTableDataCell>{item.module_code}</CTableDataCell>

                      <CTableDataCell>
                        {item.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      <CTableDataCell>
                        <div className="d-flex justify-content-center gap-2">
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() => navigate(`/roles-and-permissions/edit/${item.id}`)}
                          />


                          <ActionButton
                            color="primary"
                            icon={cilLockLocked}
                            onClick={() => navigate(`/roles-and-permissions/permission/${item.id}`)}
                          />
                         

                          <ActionButton
                            color="danger"
                            icon={cilTrash}
                            onClick={() => confirmDelete(item.id)}
                          />
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))
                ) : (
                  <TableEmptyState colSpan={4} />
                )}
              </CTableBody>
            </CTable>
          </SimpleBar>

          <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default Index
