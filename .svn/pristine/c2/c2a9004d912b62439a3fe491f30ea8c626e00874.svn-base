import React, { useState } from 'react'
import CIcon from '@coreui/icons-react'
import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilPeople,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
} from '@coreui/icons'

const Add = () => {
  const [step, setStep] = useState(0)
  const [profileImage, setProfileImage] = useState(null)
  



  
  // ✅ STEP CONFIG (MUST BE OUTSIDE JSX)
  const stepConfig = [
    { label: 'Basic Information', icon: cilUser },
    { label: 'Address', icon: cilLocationPin },
    // { label: 'Qualification', icon: cilEducation },
    // { label: 'Experience', icon: cilBriefcase },
    // { label: 'Family Members', icon: cilPeople },
    { label: 'Bank Details', icon: cilBank },
    { label: 'Insurance', icon: cilShieldAlt },
    { label: 'Screening Test', icon: cilClipboard },
    { label: 'Documents', icon: cilFile },
  ]

  const handleImageUpload = (e) => {
    const file = e.target.files[0]
    if (!file) return
    const reader = new FileReader()
    reader.onload = () => setProfileImage(reader.result)
    reader.readAsDataURL(file)
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm">
        {/* 🔹 UNDERLINE STEPPER */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => setStep(index)}
            >
              <CIcon icon={item.icon} className="stepper-icon" />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* 🔹 STEP 1 */}
        {step === 0 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="row">
                <div className="col-md-3 ">
                  <label className="avatar-upload">
                    <input type="file" hidden accept="image/*" onChange={handleImageUpload} />
                    <div className="avatar-1">
                      {profileImage ? <img src={profileImage} alt="Profile" /> : <span>📷</span>}
                    </div>
                  </label>
                  <small className="text-muted d-block mt-2 mx-3">Upload Photo</small>
                </div>

                <div className="col-md-12">
                  <div className="row g-3 mt-2">
                    <div className="col-md-3">
                      <label className="form-label">Salutation</label>
                      <select className="form-select" name="salutation">
                        <option value="">Select</option>
                        <option value="Mr">Mr</option>
                        <option value="Ms">Ms</option>
                        <option value="Mrs">Mrs</option>
                        <option value="Dr">Dr</option>
                      </select>
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">First Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter First Name"
                        maxLength={20}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Middle Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Middle Name"
                        maxLength={50}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Last Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Last Name"
                        maxLength={50}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Email Address</label>
                      <input
                        type="email"
                        className="form-control"
                        placeholder="Enter Email Id"
                        maxLength={120}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Contact No</label>
                      <input
                        type="tel"
                        className="form-control"
                        placeholder="Ente Contact Number"
                        maxLength={15}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Date of Birth</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Gender</label>
                      <select className="form-select">
                        <option value="">Select </option>
                        <option>Male</option>
                        <option>Female</option>
                      </select>
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Marital Status</label>
                      <select className="form-select" name="marital_status" required>
                        <option value="">Select</option>
                        <option value="SINGLE">Single</option>
                        <option value="MARRIED">Married</option>
                        <option value="DIVORCED">Divorced</option>
                        <option value="WIDOWED">Widowed</option>
                        <option value="SEPARATED">Separated</option>
                      </select>
                    </div>

                    {/* 
<div className="col-md-3">
  <label className="form-label">Marriage Date</label>
  <input
    type="date"
    className="form-control"
    name="marriage_date"
    max={new Date().toISOString().split('T')[0]}
  />
</div> */}

                    <div className="col-md-3">
                      <label className="form-label">Date Of Joining</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Probation End Date</label>
                      <input type="date" className="form-control" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Confirmation Date</label>
                      <input type="date" className="form-control" name="confirmation_date" />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Notice Period (Days)</label>
                      <input
                        type="number"
                        className="form-control"
                        name="notice_period_days"
                        min={0}
                        max={180}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Fathers Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Fathers Name"
                        maxLength={150}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Mothers Name</label>
                      <input
                        type="text"
                        className="form-control"
                        placeholder="Enter Mothers Name"
                        maxLength={150}
                      />
                    </div>

                    <div className="col-md-3">
                      <label className="form-label">Blood Group</label>
                      <select className="form-select" name="blood_group">
                        <option value="">Select</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* 🔹 STEP 2 */}
        {step === 1 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Correspondence Address </label>
                <textarea className="form-control" name="permanent_address" rows="3"></textarea>
              </div>

              <div className="col-md-6">
                <label className="form-label">Permanent Address</label>
                <textarea
                  className="form-control"
                  name="correspondence_address"
                  rows="3"
                ></textarea>
              </div>

              {/* <div className="col-md-6 mt-2">
                <div className="form-check">
                  <input className="form-check-input" type="checkbox" id="sameAsPermanent" />
                  <label className="form-check-label" htmlFor="sameAsPermanent">
                    Correspondence address same as Permanent
                  </label>
                </div>
              </div> */}

              <div className="col-md-6">
                <label className="form-label">Landmark</label>
                <input
                  type="text"
                  className="form-control"
                  name="landmark"
                  placeholder="Enter nearby landmark"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">City</label>
                <input
                  type="text"
                  className="form-control"
                  name="city"
                  placeholder="Enter city"
                  maxLength={100}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">District</label>
                <input
                  type="text"
                  className="form-control"
                  name="district"
                  placeholder="Enter district"
                  maxLength={100}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">State</label>
                <input
                  type="text"
                  className="form-control"
                  name="state"
                  placeholder="Enter state"
                  maxLength={100}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Country</label>
                <input
                  type="text"
                  className="form-control"
                  name="country"
                  placeholder="Enter country"
                  maxLength={100}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Pincode</label>
                <input
                  type="text"
                  className="form-control"
                  name="pincode"
                  placeholder="Enter pincode"
                  maxLength={10}
                  inputMode="numeric"
                />
              </div>
            </div>
          </div>
        )}

        {/* 🔹 STEP 3
        {step === 2 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Qualification Type</label>
                <select className="form-select">
                  <option value="">Select </option>
                  <option>Degree</option>
                  <option>Certification</option>
                  <option>Diploma</option>
                  <option>Training</option>
                </select>
              </div>

              <div className="col-md-6">
                <label className="form-label">Qualification Name</label>
                <input type="text" className="form-control" maxLength={200} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Specialization</label>
                <input type="text" className="form-control" maxLength={150} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Institute Name</label>
                <input type="text" className="form-control" maxLength={200} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Board / University</label>
                <input type="text" className="form-control" maxLength={200} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Year of Passing</label>
                <input
                  type="number"
                  className="form-control"
                  min={1900}
                  max={new Date().getFullYear()}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Grade</label>
                <input type="text" className="form-control" maxLength={50} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Percentage (%)</label>
                <input type="number" className="form-control" min={0} max={100} step="0.01" />
              </div>
            </div>
          </div>
        )} */}

        {/* 🔹 STEP 3
        {step === 3 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Company Name</label>
                <input type="text" className="form-control" maxLength={200} />
              </div>
              <div className="col-md-6">
                <label className="form-label">Designation</label>
                <input type="text" className="form-control" maxLength={150} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Start Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">End Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-12">
                <label className="form-label">Total Experience (Years)</label>
                <input type="number" className="form-control" min={0} step="0.1" />
              </div>
            </div>
          </div>
        )} */}

        {/* 🔹 STEP 4
        {step === 4 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Relation</label>
                <select className="form-select">
                  <option value="">Select </option>
                  <option>Spouse</option>
                  <option>Child</option>
                  <option>Father</option>
                  <option>Mother</option>
                  <option>Sibling</option>
                </select>
              </div>
              <div className="col-md-6">
                <label className="form-label">Name</label>
                <input type="text" className="form-control" maxLength={150} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Date of Birth</label>
                <input
                  type="date"
                  className="form-control"
                  max={new Date().toISOString().split('T')[0]}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Gender</label>
                <select className="form-select">
                  <option value="">Select </option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                </select>
              </div>

              <div className="col-md-12">
                <label className="form-label">Pan No</label>
                <input type="text" className="form-control" maxLength={20} />
              </div>
            </div>
          </div>
        )} */}

        {/* 🔹 STEP 3 */}
        {step === 2 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Bank Name</label>
                <input
                  type="text"
                  className="form-control"
                  name="bank_name"
                  placeholder="Enter bank name"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Branch Name</label>
                <input
                  type="text"
                  className="form-control"
                  name="branch_name"
                  placeholder="Enter branch name"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Bank Address</label>
                <input
                  type="text"
                  className="form-control"
                  name="bank_address"
                  placeholder="Enter bank branch address"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Account Number</label>
                <input
                  type="text"
                  className="form-control"
                  name="account_number"
                  placeholder="Enter account number"
                  maxLength={150}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">IFSC Code</label>
                <input
                  type="text"
                  className="form-control"
                  name="ifsc_code"
                  placeholder="Enter IFSC code (e.g. SBIN0001234)"
                  maxLength={11}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">MICR Code</label>
                <input
                  type="text"
                  className="form-control"
                  name="micr_code"
                  placeholder="Enter MICR code"
                  maxLength={9}
                />
              </div>
            </div>
          </div>
        )}

        {/* 🔹 STEP 6 */}
        {step === 3 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Insurance Company</label>
                <input
                  type="text"
                  className="form-control"
                  placeholder="Enter Insurance Company"
                  maxLength={150}
                />
              </div>
              <div className="col-md-6">
                <label className="form-label">Policy No</label>
                <input
                  type="text"
                  className="form-control"
                  placeholder="Enter Policy No"
                  maxLength={100}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">From Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Sum Insured</label>
                <input type="number" className="form-control" min={0} step="0.01" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Policy Premium</label>
                <input type="number" className="form-control" min={0} step="0.01" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Family Members Covered</label>
                <input type="text" className="form-control" />
              </div>
            </div>
          </div>
        )}

        {/* 🔹 STEP 7 */}
        {step === 4 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Test Scheduled Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Test Given Date</label>
                <input type="date" className="form-control" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Marks Secured</label>
                <input type="number" className="form-control" min={0} step="0.01" />
              </div>

              <div className="col-md-6">
                <label className="form-label">Result</label>
                <select className="form-select">
                  <option value="">Select Result</option>
                  <option value="PASS">PASS</option>
                  <option value="FAIL">FAIL</option>
                </select>
              </div>
            </div>
          </div>
        )}

        {/* 🔹 STEP 8 */}
        {step === 5 && (
          <div className="step-content">
            <div className="row g-3 align-items-end">
              {/* Document Type */}
              <div className="col-md-6">
                <label className="form-label">Document Type</label>
                <select className="form-select">
                  <option value="">Select Document Type</option>
                  <option value="PHOTO">Photo</option>
                  <option value="RESUME">Resume</option>
                  <option value="PAN_FILE">PAN Card</option>
                  <option value="AADHAAR_FILE">Aadhaar Card</option>
                  <option value="VOTER_ID_FILE">Voter ID</option>
                  <option value="QUALIFICATION_CERT">Qualification Certificate</option>
                  <option value="EXPERIENCE_CERT">Experience Certificate</option>
                  <option value="BIRTH_CERT">Birth Certificate</option>
                  <option value="DRIVING_LICENSE">Driving License</option>
                  <option value="WORK_PERMIT">Work Permit</option>
                  <option value="CANCEL_CHEQUE">Cancelled Cheque</option>
                  <option value="POLICY_DOCUMENT">Policy Document</option>
                  <option value="SCREENING_MAIL_COPY">Screening Mail Copy</option>
                  <option value="SALARY_SLIP">Salary Slip</option>
                  <option value="FORM16">Form 16</option>
                  <option value="POLICE_VERIFICATION">Police Verification</option>
                  <option value="DECLARATION">Declaration</option>
                  <option value="OTHER_DOC">Other Document</option>
                </select>
              </div>

              {/* File Upload */}
              <div className="col-md-6">
                <label className="form-label">Upload File</label>
                <input type="file" className="form-control" accept=".pdf,.jpg,.jpeg,.png" />
              </div>
            </div>
          </div>
        )}

        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>
          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => setStep(step + 1)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
