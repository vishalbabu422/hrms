                            <div className="fw-semibold border-bottom pb-2">
                              {employee.visaAuthority || '-'}
                            </div>
                          </div>

                          <div className="col-md-4">
                            <small className="text-muted">Visa Start Date</small>
                            <div className="fw-semibold border-bottom pb-2">
                              {employee.visaStartDate || '-'}
                            </div>
                          </div>

                          <div className="col-md-4">
                            <small className="text-muted">Visa End Date</small>
                            <div className="fw-semibold border-bottom pb-2">
                              {employee.visaEndDate || '-'}
                            </div>
                          </div>
                        </div>
                      </CCardBody>
                    </CCard>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'discipline' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Disciplinary Record</h5>
                    </div>

                    <div className="row g-4">
                      {/* Offence */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Offence</small>
                        <div className="fw-semibold border-bottom pb-2">
                          Late reporting without prior notice
                        </div>
                      </div>

                      {/* Offence Date */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Offence Date</small>
                        <div className="fw-semibold border-bottom pb-2">15 February 2024</div>
                      </div>

                      {/* Disciplinary Action */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Disciplinary Action</small>
                        <div className="fw-semibold border-bottom pb-2 text-danger">
                          Written Warning Issued
                        </div>
                      </div>

                      {/* Remarks */}
                      <div className="col-6">
                        <small className="text-muted">Remarks</small>
                        <div className="fw-semibold border-bottom pb-2">
                          Employee counselled and advised to maintain punctuality.
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'exam' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Examination Details</h5>
                    </div>

                    <div className="row g-4">
                      {/* LEFT COLUMN */}
                      <div className="col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Examination Name</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.examName || '-'}
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Marks Obtained</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.marksObtained || '-'}
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Result</small>
                          <div
                            className={`fw-semibold border-bottom pb-2 ${
                              employee.examResult === 'Pass'
                                ? 'text-success'
                                : employee.examResult === 'Fail'
                                  ? 'text-danger'
                                  : ''
                            }`}
                          >
                            {employee.examResult || '-'}
                          </div>
                        </div>
                      </div>

                      {/* RIGHT COLUMN */}
                      <div className="col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Exam Date</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.examDate || '-'}
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Certificate Number</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.certificateNumber || '-'}
                          </div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'training' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Training Details</h5>
                    </div>

                    <div className="row g-4">
                      {/* LEFT COLUMN */}
                      <div className="col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Training Name</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.trainingName || '-'}
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Training Start Date</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.trainingStartDate || '-'}
                          </div>
                        </div>
                      </div>

                      {/* RIGHT COLUMN */}
                      <div className="col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Training Type</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.trainingType || '-'}
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Training End Date</small>
                          <div className="fw-semibold border-bottom pb-2">
                            {employee.trainingEndDate || '-'}
                          </div>
                        </div>
                      </div>

                      {/* CERTIFICATE */}
                      <div className="col-12">
                        <div className="d-flex justify-content-between align-items-center">
                          <div>
                            <small className="text-muted">Certificate</small>
                            <div className="fw-semibold">
                              {employee.trainingCertificateName || 'No document uploaded'}
                            </div>
                          </div>

                          {employee.trainingCertificate && (
                            <CButton
                              size="sm"
                              variant="outline"
                              href={employee.trainingCertificate}
                              download
                            >
                              <CIcon icon={cilCloudDownload} />
                            </CButton>
                          )}
                        </div>
                      </div>

                      {/* DESCRIPTION */}
                      <div className="col-12">
                        <small className="text-muted">Description</small>
                        <div className="fw-semibold border-bottom pb-2">
                          {employee.trainingDescription || '-'}
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}
            </CRow>
          </CCardBody>
        </CCard>
      </CContainer>
    </div>
  )
}

export default EmployeeProfile
