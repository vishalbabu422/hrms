import {
  CRow,
  CCol,
  CFormLabel,
  CFormSelect,
  CButton,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CCard,
  CCardBody,
} from '@coreui/react'

import { useState } from 'react'
import './FinancialRegister.css'

const months = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar']

const monthMap = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
  'Oct',
  'Nov',
  'Dec',
]

const FinancialRegister = () => {
  /* ================= DUMMY DATA ================= */

  const data = [
    /* ================= STRUCTURE A ================= */

    {
      employee_name: 'Aman Sharma',
      year: 2026,
      month: 4,
      salary_structure_id: 1,
      ctc: 50000,
      gross_earnings: 45000,
      total_deductions: 5000,
      net_salary: 40000,
    },

    {
      employee_name: 'Neha Sharma',
      year: 2026,
      month: 5,
      salary_structure_id: 1,
      ctc: 52000,
      gross_earnings: 47000,
      total_deductions: 6000,
      net_salary: 41000,
    },

    {
      employee_name: 'Atul Sharma',
      year: 2026,
      month: 6,
      salary_structure_id: 1,
      ctc: 55000,
      gross_earnings: 50000,
      total_deductions: 7000,
      net_salary: 43000,
    },

    /* ================= STRUCTURE B ================= */

    {
      employee_name: 'Rohit Verma',
      year: 2026,
      month: 4,
      salary_structure_id: 2,
      ctc: 60000,
      gross_earnings: 55000,
      total_deductions: 8000,
      net_salary: 47000,
    },

    {
      employee_name: 'Priya Singh',
      year: 2026,
      month: 5,
      salary_structure_id: 2,
      ctc: 62000,
      gross_earnings: 57000,
      total_deductions: 8500,
      net_salary: 48500,
    },

    {
      employee_name: 'Karan Mehta',
      year: 2026,
      month: 6,
      salary_structure_id: 2,
      ctc: 65000,
      gross_earnings: 59000,
      total_deductions: 9000,
      net_salary: 50000,
    },
  ]

  /* ================= STATES ================= */

  const [filters, setFilters] = useState({
    year: '2026',
    structure: '1',
    employee: '',
  })

  const [selectedEmployeeData, setSelectedEmployeeData] = useState(null)

  const [highlight, setHighlight] = useState(false)

  /* ================= HANDLE CHANGE ================= */

  const handleChange = (e) => {
    const { name, value } = e.target

    setFilters((prev) => ({
      ...prev,

      [name]: value,

      ...(name === 'structure' && {
        employee: '',
      }),
    }))
  }

  /* ================= SEARCH ================= */

  const handleSearch = () => {
    if (!filters.employee) {
      alert('Please select employee')

      return
    }

    const result = data.filter((item) => {
      return (
        item.employee_name === filters.employee &&
        item.year === Number(filters.year) &&
        item.salary_structure_id === Number(filters.structure)
      )
    })

    if (!result.length) {
      alert('No data found')

      setSelectedEmployeeData(null)

      return
    }

    const monthlyData = {}

    result.forEach((item) => {
      const m = monthMap[item.month - 1]

      monthlyData[m] = item
    })

    setSelectedEmployeeData({
      name: filters.employee,
      data: monthlyData,
    })

    /* ================= HIGHLIGHT EFFECT ================= */

    setHighlight(true)

    setTimeout(() => {
      setHighlight(false)
    }, 1500)
  }
  /* ================= DEFAULT VALUES ================= */

  const getDefault = (field) => {
    switch (field) {
      case 'ctc':
        return 50000

      case 'gross_earnings':
        return 45000

      case 'total_deductions':
        return 5000

      case 'net_salary':
        return 40000

      default:
        return 0
    }
  }

  /* ================= CARRY FORWARD ================= */

  const getCarryForward = (dataMap, field) => {
    let last = null

    const out = {}

    months.forEach((m) => {
      const val = dataMap[m]?.[field]

      if (val !== undefined && val !== null) {
        last = Number(val)

        out[m] = last
      } else {
        out[m] = last !== null ? last : getDefault(field)
      }
    })

    return out
  }

  /* ================= TABLE MAPS ================= */

  const mData = selectedEmployeeData?.data || {}

  const netMap = getCarryForward(mData, 'net_salary')

  const grossMap = getCarryForward(mData, 'gross_earnings')

  const dedMap = getCarryForward(mData, 'total_deductions')

  const ctcMap = getCarryForward(mData, 'ctc')

  /* ================= TOTAL ================= */

  const getTotal = (map) => {
    return months.reduce((sum, m) => sum + Number(map[m] || 0), 0)
  }

  const currentMonthIndex = 3

  return (
    <CCard className="border-0 shadow-sm rounded-4">
      <CCardBody
        className="p-4"
        style={{
          paddingBottom: '32px',
        }}
      >
        {/* ================= FILTERS ================= */}

        <CRow
          className="mb-4 p-3 rounded-4 align-items-end"
          style={{
            background: '#f8fafc',
            border: '1px solid #edf1f5',
          }}
        >
          {/* YEAR */}

          <CCol md={3}>
            <CFormLabel
              className="fw-semibold mb-2"
              style={{
                color: '#374151',
              }}
            >
              Year
            </CFormLabel>

            <CFormSelect
              name="year"
              value={filters.year}
              onChange={handleChange}
              style={{
                height: '45px',
                borderRadius: '10px',
              }}
            >
              <option value="2026">2026</option>

              <option value="2027">2027</option>
            </CFormSelect>
          </CCol>

          {/* SALARY STRUCTURE */}

          <CCol md={3}>
            <CFormLabel
              className="fw-semibold mb-2"
              style={{
                color: '#374151',
              }}
            >
              Salary Structure
            </CFormLabel>

            <CFormSelect
              name="structure"
              value={filters.structure}
              onChange={handleChange}
              style={{
                height: '45px',
                borderRadius: '10px',
              }}
            >
              <option value="1">Structure A</option>

              <option value="2">Structure B</option>
            </CFormSelect>
          </CCol>

          {/* EMPLOYEE */}

          <CCol md={3}>
            <CFormLabel
              className="fw-semibold mb-2"
              style={{
                color: '#374151',
              }}
            >
              Employee
            </CFormLabel>

            <CFormSelect
              name="employee"
              value={filters.employee}
              onChange={handleChange}
              style={{
                height: '45px',
                borderRadius: '10px',
              }}
            >
              <option value="">Select Employee</option>

              {/* STRUCTURE A */}

              {filters.structure === '1' && (
                <>
                  <option value="Aman Sharma">Aman Sharma</option>

                  <option value="Neha Sharma">Neha Sharma</option>

                  <option value="Atul Sharma">Atul Sharma</option>
                </>
              )}

              {/* STRUCTURE B */}

              {filters.structure === '2' && (
                <>
                  <option value="Rohit Verma">Rohit Verma</option>

                  <option value="Priya Singh">Priya Singh</option>

                  <option value="Karan Mehta">Karan Mehta</option>
                </>
              )}
            </CFormSelect>
          </CCol>

          {/* SEARCH */}

          <CCol md={3}>
            <CButton
              color="primary"
              onClick={handleSearch}
              style={{
                height: '45px',
                minWidth: '120px',
                borderRadius: '10px',
                fontWeight: '600',
              }}
            >
              Search
            </CButton>
          </CCol>
        </CRow>

        {/* ================= EMPLOYEE INFO ================= */}

        {selectedEmployeeData && (
          <>
            <div className="d-flex justify-content-between align-items-start mb-4 flex-wrap">
              <div>
                <div
                  style={{
                    fontSize: '13px',
                    color: '#6b7280',
                    marginBottom: '4px',
                  }}
                >
                  Employee Name
                </div>

                <h5 className={`fw-bold mb-0 ${highlight ? 'employee-highlight' : ''}`}>
                  {selectedEmployeeData.name}
                </h5>
              </div>

              <div
                className="px-3 py-2 rounded-3"
                style={{
                  background: '#eef2ff',
                  color: '#4338ca',
                  fontWeight: '600',
                  fontSize: '14px',
                  minWidth: '220px',
                  textAlign: 'center',
                }}
              >
                Financial Year : 2026 - 2027
              </div>
            </div>

            {/* ================= TABLE ================= */}

            <div
              className={highlight ? 'table-highlight' : ''}
              style={{
                borderRadius: '16px',
                overflow: 'hidden',
                border: '1px solid #edf1f5',
                marginBottom: '20px',
              }}
            >
              <CTable
                hover
                style={{
                  width: '100%',
                  borderCollapse: 'separate',
                  borderSpacing: 0,
                  background: '#fff',
                  tableLayout: 'fixed',
                  marginBottom: 0,
                }}
              >
                {/* HEADER */}

                <CTableHead>
                  <CTableRow>
                    <CTableHeaderCell
                      style={{
                        background: '#f8fafc',
                        width: '140px',
                        textAlign: 'center',
                        fontWeight: '700',
                        fontSize: '16px',
                        color: '#374151',
                        border: '1px solid #edf1f5',
                        padding: '12px',
                      }}
                    >
                      Salary Component
                    </CTableHeaderCell>

                    {months.map((m) => {
                      const isProjected = months.indexOf(m) > currentMonthIndex

                      return (
                        <CTableHeaderCell
                          key={m}
                          className={isProjected ? 'projected-cell' : ''}
                          style={{
                            background: '#f8fafc',

                            textAlign: 'center',

                            fontWeight: '600',

                            width: '82px',

                            fontSize: '14px',

                            border: '1px solid #edf1f5',

                            padding: '12px 10px',

                            color: isProjected ? '#9ca3af' : '#111827',

                            opacity: isProjected ? 0.85 : 1,
                          }}
                        >
                          {m}
                        </CTableHeaderCell>
                      )
                    })}

                    <CTableHeaderCell
                      style={{
                        background: '#eef2ff',
                        textAlign: 'center',
                        fontWeight: '700',
                        width: '110px',
                        color: '#4338ca',
                        border: '1px solid #dbe4ff',
                        padding: '12px',
                        fontSize: '14px',
                      }}
                    >
                      Total
                    </CTableHeaderCell>
                  </CTableRow>
                </CTableHead>

                {/* BODY */}
                <CTableBody>
                  {[
                    {
                      label: 'Basic',
                      calc: (m) => Math.round(ctcMap[m] * 0.5),
                    },

                    {
                      label: 'HRA',
                      calc: (m) => Math.round(ctcMap[m] * 0.25),
                    },

                    {
                      label: 'Transport',
                      calc: () => 1600,
                    },

                    {
                      label: 'Gross',
                      calc: (m) => grossMap[m],
                    },

                    {
                      label: 'Total Deduction',
                      calc: (m) => dedMap[m],
                    },

                    {
                      label: 'Net Pay',
                      calc: (m) => netMap[m],
                      highlight: true,
                    },
                  ].map((row, idx) => {
                    return (
                      <CTableRow
                        key={idx}
                        style={{
                          background: row.highlight ? '#f5f7ff' : idx % 2 ? '#fafbfc' : '#fff',
                        }}
                      >
                        {/* LABEL */}

                        <CTableDataCell
                          className="text-center fw-semibold"
                          style={{
                            border: '1px solid #edf1f5',
                            padding: '12px',
                            fontSize: row.highlight ? '15px' : '14px',
                          }}
                        >
                          {row.label}
                        </CTableDataCell>

                        {/* MONTH VALUES */}

                        {months.map((m) => {
                          const isProjected = months.indexOf(m) > currentMonthIndex

                          return (
                            <CTableDataCell
                              key={m}
                              className={`
                text-center
                ${row.highlight ? 'fw-bold' : ''}
                ${isProjected ? 'projected-cell' : ''}
              `}
                              style={{
                                border: '1px solid #edf1f5',

                                padding: '12px 10px',

                                fontSize: row.highlight ? '15px' : '14px',

                                background: isProjected
                                  ? '#f3f4f6'
                                  : row.highlight
                                    ? '#f5f7ff'
                                    : '#fff',

                                color: isProjected ? '#9ca3af' : '#111827',

                                opacity: isProjected ? 0.85 : 1,

                                transition: 'all 0.3s ease',
                              }}
                            >
                              ₹ {row.calc(m)}
                            </CTableDataCell>
                          )
                        })}

                        {/* TOTAL */}

                        <CTableDataCell
                          className="fw-bold text-center"
                          style={{
                            background: row.highlight ? '#dbe4ff' : '#fff',

                            border: '1px solid #edf1f5',

                            padding: '12px',

                            fontSize: row.highlight ? '15px' : '14px',
                          }}
                        >
                          ₹ {months.reduce((sum, m) => sum + row.calc(m), 0)}
                        </CTableDataCell>
                      </CTableRow>
                    )
                  })}
                </CTableBody>
              </CTable>
            </div>
          </>
        )}
      </CCardBody>
    </CCard>
  )
}

export default FinancialRegister
