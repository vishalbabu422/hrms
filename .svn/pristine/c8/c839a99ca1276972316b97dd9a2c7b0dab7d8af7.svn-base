import EmpanelmentFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
      }

      await api.post('/admin/empanelment/create', normalizedPayload)
      toast.success('GST Code created successfully')
      navigate('/cat-emp')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to create GST Code')
    }
  }

  const initialData = {
    category: '',
    empanelment_no: '',
    date: '',
    shortcode: '',
    rfe: '',
    effective_from: '',
    effective_to: null,
    is_active: true,
  }

  return (
    <EmpanelmentFormComponent initialData={initialData} mode="create" onSubmit={handleSubmit} />
  )
}

export default add
