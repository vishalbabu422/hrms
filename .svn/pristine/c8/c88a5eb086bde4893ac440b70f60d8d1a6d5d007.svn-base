                    <CListGroupItem
                      active={activeTab === 'projects'}
                      onClick={() => setActiveTab('projects')}
                      style={{ cursor: 'pointer' }}
                      className="d-flex align-items-center gap-2"
                    >
                      <CIcon icon={cilClipboard} />
                      Projects
                    </CListGroupItem>

                    <CListGroupItem
                      active={activeTab === 'leave'}
