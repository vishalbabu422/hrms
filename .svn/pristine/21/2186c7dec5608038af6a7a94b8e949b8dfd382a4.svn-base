import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'

import { useEffect, useState } from 'react'

const CompanyFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    // e.preventDefault()
    // onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={6}>
                <CFormLabel>Organization ID</CFormLabel>
                <CFormInput
                  name="organization_id"
                  value={formData.organization_id || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Company Code</CFormLabel>
                <CFormInput
                  name="company_code"
                  value={formData.company_code || ''}
                  onChange={handleChange}
                  disabled={mode === 'edit'}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Company Type</CFormLabel>
                <CFormSelect
                  name="company_type"
                  value={formData.company_type || ''}
                  onChange={handleChange}
                >
                  <option value="">Select Type</option>
                  <option value="PRIVATE_LIMITED">Private Limited</option>
                  <option value="PUBLIC_LIMITED">Public Limited</option>
                  <option value="LLP">LLP</option>
                  <option value="PROPRIETORSHIP">Proprietorship</option>
                  <option value="PARTNERSHIP">Partnership</option>
                  <option value="GOVERNMENT">Government</option>
                  <option value="NGO">NGO</option>
                  <option value="OTHER">Other</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>Incorporation Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="incorporation_date"
                  value={formData.incorporation_date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Official Phone</CFormLabel>
                <CFormInput
                  name="official_phone"
                  value={formData.official_phone || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Address Line 1</CFormLabel>
                <CFormTextarea
                  name="address_line1"
                  rows={2}
                  value={formData.address_line1 || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Address Line 2</CFormLabel>
                <CFormTextarea
                  name="address_line2"
                  rows={2}
                  value={formData.address_line2 || ''}
                  onChange={handleChange}
                />
              </CCol>


 <CCol md={6}>
                <CFormLabel>City</CFormLabel>
                <CFormInput
                  name="city"
                  value={formData.city || ''}
                  onChange={handleChange}
                />
              </CCol>


  <CCol md={6}>
                <CFormLabel>State</CFormLabel>
                <CFormInput
                  name="state"
                  value={formData.state || ''}
                  onChange={handleChange}
                />
              </CCol>


<CCol md={6}>
                <CFormLabel>Country</CFormLabel>
                <CFormInput
                  name="country"
                  value={formData.country || ''}
                  onChange={handleChange}
                />
              </CCol>


<CCol md={6}>
                <CFormLabel>Pincode</CFormLabel>
                <CFormInput
                  name="pincode"
                  value={formData.pincode || ''}
                  onChange={handleChange}
                />
              </CCol>       

           

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default CompanyFormComponent
