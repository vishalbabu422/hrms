import React, { useState } from 'react'
import {
  CContainer,
  CRow,
  CCol,
  CCard,
  CCardBody,
  CCardHeader,
  CButton,
  CFormInput,
  CBadge,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CFormSwitch,
  CModal,
  CModalHeader,
  CModalTitle,
  CModalBody,
  CModalFooter,
  CFormSelect,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash } from '@coreui/icons'

const Permission = () => {
  const [activeTab, setActiveTab] = useState('users')
  const [visible, setVisible] = useState(false)

  const [selectedUser, setSelectedUser] = useState('')
  const [selectedRole, setSelectedRole] = useState('')

  // ✅ FIX ADDED HERE
  const [selectedRoleTab, setSelectedRoleTab] = useState('')

  const [users, setUsers] = useState([
    {
      id: 1,
      name: 'Akansha',
      email: 'akansha231192@gmail.com',
      role: 'Admin',
      status: 'Active',
    },
    {
      id: 2,
      name: 'Parul',
      email: 'parul23@gmail.com',
      role: 'Developer',
      status: 'Active',
    },
  ])

  const roles = ['Admin', 'Developer', 'HR', 'Manager']

  // ================= Permission Logic =================

  const modules = [
    'Employee Management',
    'Role Management',
    'Permission Management',
    'Organization Management',
    'Workorder Management',
    'Empanelment Management',
    'Leave Management',
  ]

  const defaultPermissions = {
    create: false,
    read: false,
    update: false,
    delete: false,
    approve: false,
  }

  const [permissions, setPermissions] = useState(
    modules.reduce((acc, module) => {
      acc[module] = { ...defaultPermissions }
      return acc
    }, {})
  )

  const togglePermission = (module, key) => {
    setPermissions((prev) => ({
      ...prev,
      [module]: {
        ...prev[module],
        [key]: !prev[module][key],
      },
    }))
  }

  const toggleAll = (module, value) => {
    setPermissions((prev) => ({
      ...prev,
      [module]: {
        create: value,
        read: value,
        update: value,
        delete: value,
        approve: value,
      },
    }))
  }

  // ================= Role Assignment =================

  const handleSaveRole = () => {
    if (!selectedUser || !selectedRole) return

    const updatedUsers = users.map((user) =>
      user.name === selectedUser ? { ...user, role: selectedRole } : user
    )

    setUsers(updatedUsers)
    setVisible(false)
    setSelectedUser('')
    setSelectedRole('')
  }

  return (
    <CContainer fluid className="py-3">
      <CRow className="g-4">

        {/* Sidebar */}
        <CCol xs={12} md={4} lg={3}>
          <CCard className="h-100 shadow-sm">
            <CCardBody>
              <div className="d-flex mb-3">
                <CButton
                  color={activeTab === 'users' ? 'primary' : 'light'}
                  className="w-50 me-2"
                  onClick={() => setActiveTab('users')}
                >
                  User Role
                </CButton>

                <CButton
                  color={activeTab === 'roles' ? 'primary' : 'light'}
                  className="w-50"
                  onClick={() => setActiveTab('roles')}
                >
                  Role Permissions
                </CButton>
              </div>

              {activeTab === 'users' && (
                <>
                  <CFormInput placeholder="Search User" className="mb-3" />
                  <CButton
                    color="outline-primary"
                    className="w-100"
                    onClick={() => setVisible(true)}
                  >
                    + Set Role
                  </CButton>
                </>
              )}

              {activeTab === 'roles' && (
                <>
                  <CFormInput placeholder="Search Role" className="mb-3" />

                  <div className="list-group">
                    {[
                      { name: 'Admin', count: 8 },
                      { name: 'Developer', count: 10 },
                      { name: 'HR', count: 2 },
                      { name: 'Manager', count: 10 },
                    ].map((role) => {
                      const isActive = selectedRoleTab === role.name

                      return (
                        <div
                          key={role.name}
                          onClick={() => setSelectedRoleTab(role.name)}
                          className="list-group-item list-group-item-action"
                          style={{
                            cursor: 'pointer',
                            borderRadius: '8px',
                            marginBottom: '6px',
                            backgroundColor: isActive ? '#e7f1ff' : '#ffffff',
                            border: isActive
                              ? '1px solid #4e73df'
                              : '1px solid #e9ecef',
                            color: isActive ? '#1d4ed8' : '#212529',
                            fontWeight: isActive ? 600 : 400,
                          }}
                        >
                          {role.name}
                          <small
                            className="d-block"
                            style={{
                              color: isActive ? '#1d4ed8' : '#6c757d',
                            }}
                          >
                            {role.count} users
                          </small>
                        </div>
                      )
                    })}
                  </div>
                </>
              )}
            </CCardBody>
          </CCard>
        </CCol>

        {/* Main Content */}
        <CCol xs={12} md={8} lg={9}>

          {activeTab === 'users' && (
            <CCard className="shadow-sm">
              <CCardHeader>
                <strong>User Role</strong>
              </CCardHeader>
              <CCardBody>
                <CTable hover responsive align="middle">
                  <CTableHead>
                    <CTableRow>
                      <CTableHeaderCell>Name</CTableHeaderCell>
                      <CTableHeaderCell>Email</CTableHeaderCell>
                      <CTableHeaderCell>Role</CTableHeaderCell>
                      <CTableHeaderCell>Status</CTableHeaderCell>
                      <CTableHeaderCell>Actions</CTableHeaderCell>
                    </CTableRow>
                  </CTableHead>
                  <CTableBody>
                    {users.map((user) => (
                      <CTableRow key={user.id}>
                        <CTableDataCell>{user.name}</CTableDataCell>
                        <CTableDataCell>{user.email}</CTableDataCell>
                        <CTableDataCell>{user.role}</CTableDataCell>
                        <CTableDataCell>
                          <CBadge color="success">{user.status}</CBadge>
                        </CTableDataCell>
                        <CTableDataCell>
                          <CButton size="sm" color="light" className="me-2">
                            <CIcon icon={cilPencil} />
                          </CButton>
                          <CButton size="sm" color="light">
                            <CIcon icon={cilTrash} />
                          </CButton>
                        </CTableDataCell>
                      </CTableRow>
                    ))}
                  </CTableBody>
                </CTable>
              </CCardBody>
            </CCard>
          )}

          {/* Roles Modules */}
          {activeTab === 'roles' && (
            <CRow className="g-4">
              {modules.map((module, index) => {
                const modulePermissions = permissions[module]
                const allEnabled = Object.values(modulePermissions).every(Boolean)

                return (
                  <CCol xs={12} md={6} key={index}>
                    <CCard className="shadow-sm" style={{ borderRadius: '10px ', overflow:'hidden', border: '1px solid rgba(78,115,223,0.25)' }}>
                      <div
                        className="d-flex justify-content-between align-items-center"
                        style={{
                          background: '#e2e8ef',
                          padding: '6px 16px',
                          borderBottom: '1px solid #e2e8f0',
                        }}
                      >
                        <h6 className="mb-0">{module}</h6>
                        <CFormSwitch
                          checked={allEnabled}
                          onChange={(e) =>
                            toggleAll(module, e.target.checked)
                          }
                        />
                      </div>

                      <CCardBody>
                        <div className="d-flex flex-wrap gap-4">
                          {Object.keys(defaultPermissions).map((key) => (
                            <CFormSwitch
                              key={key}
                              label={key.charAt(0).toUpperCase() + key.slice(1)}
                              checked={modulePermissions[key]}
                              onChange={() =>
                                togglePermission(module, key)
                              }
                            />
                          ))}
                        </div>
                      </CCardBody>
                    </CCard>
                  </CCol>
                )
              })}
            </CRow>
          )}
        </CCol>
      </CRow>

      <CModal visible={visible} onClose={() => setVisible(false)} alignment="center">
        <CModalHeader>
          <CModalTitle>Set User Role</CModalTitle>
        </CModalHeader>
        <CModalBody>
          <div className="mb-3">
            <label className="form-label">Username</label>
            <CFormSelect
              value={selectedUser}
              onChange={(e) => setSelectedUser(e.target.value)}
            >
              <option value="">Select User</option>
              {users.map((user) => (
                <option key={user.id} value={user.name}>
                  {user.name}
                </option>
              ))}
            </CFormSelect>
          </div>

          <div className="mb-3">
            <label className="form-label">Role</label>
            <CFormSelect
              value={selectedRole}
              onChange={(e) => setSelectedRole(e.target.value)}
            >
              <option value="">Select Role</option>
              {roles.map((role, index) => (
                <option key={index} value={role}>
                  {role}
                </option>
              ))}
            </CFormSelect>
          </div>
        </CModalBody>

        <CModalFooter>
          <CButton color="secondary" onClick={() => setVisible(false)}>
            Cancel
          </CButton>
          <CButton
            color="primary"
            onClick={handleSaveRole}
            disabled={!selectedUser || !selectedRole}
          >
            Save
          </CButton>
        </CModalFooter>
      </CModal>
    </CContainer>
  )
}

export default Permission