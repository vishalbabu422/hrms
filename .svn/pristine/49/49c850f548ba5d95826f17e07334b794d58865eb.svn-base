import React, { useState, useEffect } from 'react'

import {
  CCard,
  CCardBody,
  CCardHeader,
  CForm,
  CRow,
  CCol,
  CFormLabel,
  CFormInput,
  CFormSelect,
  CFormCheck,
} from '@coreui/react'

import OrganizationSelect from '../../components/organization-select'

import {
  getDivisions,
  getDesignations,
} from '../../../services/employeeBasic'

const BasicInfo = ({ employeeDetails, setEmployeeDetails }) => {
  const [designations, setDesignations] = useState([])
  const [divisions, setDivisions] = useState([])

  /* ================= HANDLE CHANGE ================= */
  const handleChange = (e) => {
    const { name, value, type, checked } = e.target

    setEmployeeDetails((prev) => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : value,
    }))
  }

  /* ================= FETCH DROPDOWN ================= */
  useEffect(() => {
    const fetchDropdownData = async () => {
      try {
        const [divisionRes, designationRes] = await Promise.all([
          getDivisions(),
          getDesignations(),
        ])

        setDivisions(divisionRes.data?.data || [])
        setDesignations(designationRes.data?.data || [])
      } catch (error) {
        console.error('Dropdown fetch error:', error)
      }
    }

    fetchDropdownData()
  }, [])

  return (
    <CCard>
      <CCardHeader>Basic Information</CCardHeader>

      <CCardBody>
        <CForm>
          <CRow className="g-3">

            {/* ORGANIZATION */}
            <OrganizationSelect
              name="organization_id"
              value={employeeDetails.organization_id || ''}
              onChange={handleChange}
              label="Organization"
              colSize={12}
            />

            {/* SALUTATION */}
            <CCol md={2}>
              <CFormLabel>Salutation</CFormLabel>
              <CFormSelect
                name="salutation"
                value={employeeDetails.salutation || ''}
                onChange={handleChange}
              >
                <option value="">Select</option>
                <option value="Mr">Mr</option>
                <option value="Ms">Ms</option>
                <option value="Mrs">Mrs</option>
                <option value="Dr">Dr</option>
              </CFormSelect>
            </CCol>

            {/* NAME */}
            <CCol md={4}>
              <CFormLabel>First Name</CFormLabel>
              <CFormInput
                name="first_name"
                value={employeeDetails.first_name || ''}
                onChange={handleChange}
                required
              />
            </CCol>

            <CCol md={3}>
              <CFormLabel>Middle Name</CFormLabel>
              <CFormInput
                name="middle_name"
                value={employeeDetails.middle_name || ''}
                onChange={handleChange}
              />
            </CCol>

            <CCol md={3}>
              <CFormLabel>Last Name</CFormLabel>
              <CFormInput
                name="last_name"
                value={employeeDetails.last_name || ''}
                onChange={handleChange}
                required
              />
            </CCol>

            {/* TYPE */}
            <CCol md={6}>
              <CFormLabel>Employee Type</CFormLabel>
              <CFormSelect
                name="employee_type"
                value={employeeDetails.employee_type || ''}
                onChange={handleChange}
              >
                <option value="">Select</option>
                <option value="Payroll">Payroll</option>
                <option value="Contractual">Contractual</option>
              </CFormSelect>
            </CCol>

            {/* DESIGNATION */}
            <CCol md={6}>
              <CFormLabel>Designation</CFormLabel>
              <CFormSelect
                name="designation"
                value={employeeDetails.designation || ''}
                onChange={handleChange}
              >
                <option value="">Select</option>
                {designations.map((item) => (
                  <option key={item.id} value={item.id}>
                    {item.designation_name}
                  </option>
                ))}
              </CFormSelect>
            </CCol>

            {/* DIVISION */}
            <CCol md={6}>
              <CFormLabel>Division</CFormLabel>
              <CFormSelect
                name="division"
                value={employeeDetails.division || ''}
                onChange={handleChange}
              >
                <option value="">Select</option>
                {divisions.map((item) => (
                  <option key={item.id} value={item.id}>
                    {item.division_name}
                  </option>
                ))}
              </CFormSelect>
            </CCol>

            {/* EMAIL */}
            <CCol md={6}>
              <CFormLabel>Email</CFormLabel>
              <CFormInput
                type="email"
                name="email"
                value={employeeDetails.email || ''}
                onChange={handleChange}
                required
              />
            </CCol>

            {/* CONTACT */}
            <CCol md={6}>
              <CFormLabel>Contact No</CFormLabel>
              <CFormInput
                name="contact_no"
                value={employeeDetails.contact_no || ''}
                onChange={handleChange}
              />
            </CCol>

            {/* DOB */}
            <CCol md={6}>
              <CFormLabel>Date of Birth</CFormLabel>
              <CFormInput
                type="date"
                name="date_of_birth"
                value={employeeDetails.date_of_birth || ''}
                onChange={handleChange}
              />
            </CCol>

            {/* FIXED NAMES (IMPORTANT FIX) */}
            <CCol md={6}>
              <CFormLabel>Father's Name</CFormLabel>
              <CFormInput
                name="father_name"
                value={employeeDetails.father_name || ''}
                onChange={handleChange}
              />
            </CCol>

            <CCol md={6}>
              <CFormLabel>Mother's Name</CFormLabel>
              <CFormInput
                name="mother_name"
                value={employeeDetails.mother_name || ''}
                onChange={handleChange}
              />
            </CCol>

            {/* JOINING */}
            <CCol md={6}>
              <CFormLabel>Date Of Joining</CFormLabel>
              <CFormInput
                type="date"
                name="date_of_joining"
                value={employeeDetails.date_of_joining || ''}
                onChange={handleChange}
                required
              />
            </CCol>

            {/* GAZETTED */}
            <CCol md={6} className="d-flex align-items-center">
              <CFormCheck
                label="Gazetted"
                name="gazetted"
                checked={employeeDetails.gazetted || false}
                onChange={handleChange}
              />
            </CCol>

          </CRow>
        </CForm>
      </CCardBody>
    </CCard>
  )
}

export default BasicInfo