const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const EmpanelmentMaster = sequelize.define(
 "EmpanelmentMaster",
 {
    id: {
      type: DataTypes.BIGINT,
      allowNull: false,
      primaryKey: true,
      autoIncrement: true,
    },

    category: {
        type : DataTypes.STRING(20),
        allowNull: false,

    },

     empanelment_no: {
      type: DataTypes.STRING(50),
      allowNull: false,
    },

    date: {
      type: DataTypes.DATEONLY,
      allowNull: false,
    },

    shortcode: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    rfe: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

     is_active: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    effective_from: {
      type: DataTypes.DATEONLY,
      allowNull: false,
    },

     effective_to: {
      type: DataTypes.DATEONLY,
      allowNull: true,
    },

    created: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    modified: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },
 },
 {
    schema: "pmu",
    tableName: "empanelment_master",
    timestamps: false, // because you're handling created/modified manually
 }
);

module.exports = EmpanelmentMaster;
