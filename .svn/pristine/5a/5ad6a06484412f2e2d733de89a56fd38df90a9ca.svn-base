import RateFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate, useParams } from 'react-router-dom'
import { useEffect, useState } from 'react'

const edit = () => {
  const { id } = useParams()
  const navigate = useNavigate()
  const [initialData, setInitialData] = useState(null)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    const fetchData = async () => {
      try {
        const res = await api.get(`/admin/designation/${id}`)
        setInitialData(mapApiToForm(res.data.data))
      } catch (err) {
        console.log(err)
        toast.error('Failed to load Designation')
        navigate('/gst-code')
      } finally {
        setLoading(false)
      }
    }

    fetchData()
  }, [id])

  const mapApiToForm = (data) => ({
    desgn_id_fk: data.desgn_id_fk ?? '',
    unit_rate_incl_agency_margin: data.unit_rate_incl_agency_margin ?? '',
    agency_margin_percent: data.agency_margin_percent ?? '',
    agency_amount: data.agency_amount ?? '',
    unit_rate_excl_agency_margin: data.unit_rate_excl_agency_margin ?? '',
    nicsi_margin_percent: data.nicsi_margin_percent ?? '',
    nicsi_margin_amount: data.nicsi_margin_amount ?? '',
    total_amount: data.total_amount ?? '',
    hsn_sac_code: data.hsn_sac_code ?? '',
    cgst_amount: data.cgst_amount ?? '',
    sgst_amount: data.sgst_amount ?? '',
    igst_amount: data.igst_amount ?? '',
    total_gst_amount: data.total_gst_amount ?? '',
    final_amount: data.final_amount ?? '',
    is_active: Boolean(data.is_active),
  })

  const handleUpdate = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
      }

      await api.patch(`/admin/resourcerate/edit/${id}`, normalizedPayload)
      toast.success('Resource Rate updated successfully')
      navigate('/rate')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to update Resource Rate')
    }
  }

  return <RateFormComponent initialData={initialData} mode="edit" onSubmit={handleUpdate} />
}

export default edit
