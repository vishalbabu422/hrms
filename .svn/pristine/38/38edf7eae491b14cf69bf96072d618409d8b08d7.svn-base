              {sideTab === 'discipline' && (
                <CCol md={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* Section Header */}
                    <div className="d-flex align-items-center border-bottom pb-3 mb-3">
                      <h5 className="mb-0 fw-semibold">Disciplinary Record</h5>
                    </div>

                    <div className="row g-4">
                      {/* LEFT COLUMN */}
                      <div className="col-md-6">
                        <div className="mb-4">
