import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle } from '@coreui/icons'
import { useState, useRef } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desv',
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Work Order Designation</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search Work Order Designation Mapping ..."
              />
              <CTooltip content="Add Work Order Designation Mapping" placement="bottom">
                <CButton
                  color="primary"
                  size="sm"
                  onClick={() => navigate('/work-order-desgn/add')}
                >
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide={true} style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell label="Sno" sortKey="id" sort={sort} onSort={handleSort} />
                    <SortableHeaderCell
                      label="Work Order No"
                      sortKey="work_order_no"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Code"
                      sortKey="code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Description"
                      sortKey="description"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Person count"
                      sortKey="req_person_count"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Duration"
                      sortKey="duration_days"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Monthly Unit Rate"
                      sortKey="monthly_unit_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Deployment From"
                      sortKey="deployment_from"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Deployment Till"
                      sortKey="deployment_to"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Status"
                      sortKey="status"
                      sort={sort}
                      onSort={handleSort}
                    />
                    <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>
                <CTableBody>
                  <CTableRow>
                    <CTableHeaderCell scope="row">1</CTableHeaderCell>
                    <CTableDataCell>M2508011</CTableDataCell>
                    <CTableDataCell>17-NOV-2025</CTableDataCell>
                    <CTableDataCell>I190256EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>Internal Central Pool For E office</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>
                      <CIcon icon={cilCheckCircle} className="text-success" />
                    </CTableDataCell>
                    <CTableDataCell>
                      <div className="d-flex gap-2">
                        <CTooltip content="Edit" placement="left">
                          <CButton
                            color="primary"
                            size="sm"
                            variant="ghost"
                            onClick={() => navigate('/work-order/edit')}
                          >
                            <CIcon icon={cilPencil} />
                          </CButton>
                        </CTooltip>
                        <CTooltip content="Delete" placement="right">
                          <CButton color="danger" size="sm" variant="ghost">
                            <CIcon icon={cilTrash} />
                          </CButton>
                        </CTooltip>
                      </div>
                    </CTableDataCell>
                  </CTableRow>
                  <CTableRow>
                    <CTableHeaderCell scope="row">1</CTableHeaderCell>
                    <CTableDataCell>M2508011</CTableDataCell>
                    <CTableDataCell>17-NOV-2025</CTableDataCell>
                    <CTableDataCell>I190256EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>Internal Central Pool For E office</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>IA12356EOND</CTableDataCell>
                    <CTableDataCell>
                      <CIcon icon={cilXCircle} className="text-danger" />
                    </CTableDataCell>
                    <CTableDataCell>
                      <div className="d-flex gap-2">
                        <CTooltip content="Edit" placement="left">
                          <CButton
                            color="primary"
                            size="sm"
                            variant="ghost"
                            onClick={() => navigate('/work-order/edit')}
                          >
                            <CIcon icon={cilPencil} />
                          </CButton>
                        </CTooltip>
                      </div>
                    </CTableDataCell>
                  </CTableRow>
                </CTableBody>
              </CTable>
            </SimpleBar>
            <CPagination className="justify-content-end" aria-label="Page navigation example">
              <CPaginationItem aria-label="Previous" disabled>
                <span aria-hidden="true">&laquo;</span>
              </CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem aria-label="Next" disabled>
                <span aria-hidden="true">&raquo;</span>
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
