import React, { useState } from 'react'
import {
  CCard,
  CCardBody,
  CForm,
  CFormLabel,
  CFormInput,
  CButton,
  CRow,
  CCol,
} from '@coreui/react'

const ExamFormComponent = ({ initialData, onSubmit, mode }) => {
  const [formData, setFormData] = useState(initialData)

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()

    if (!formData.exam_name?.trim()) {
      alert('Examination Name is required')
      return
    }

    if (!formData.exam_type?.trim()) {
      alert('Exam Type is required')
      return
    }

    if (!formData.passing_marks) {
      alert('Passing Marks is required')
      return
    }

    onSubmit(formData)
  }

  return (
    <CCard>
      <CCardBody>
        <CForm onSubmit={handleSubmit}>
          <CRow>
            {/* Exam Name */}
            <CCol md={4}>
              <CFormLabel>Examination Name</CFormLabel>
              <CFormInput
                type="text"
                name="exam_name"
                value={formData.exam_name}
                onChange={handleChange}
                placeholder="Enter examination name"
              />
            </CCol>

            {/* Exam Type */}
            <CCol md={4}>
              <CFormLabel>Exam Type</CFormLabel>
              <CFormInput
                type="text"
                name="exam_type"
                value={formData.exam_type}
                onChange={handleChange}
                placeholder="Enter exam type"
              />
            </CCol>

            {/* Passing Marks */}
            <CCol md={4}>
              <CFormLabel>Passing Marks</CFormLabel>
              <CFormInput
                type="number"
                name="passing_marks"
                value={formData.passing_marks}
                onChange={handleChange}
                min="0"
                placeholder="Enter passing marks"
              />
            </CCol>
          </CRow>

          <div className="mt-3">
            <CButton type="submit" color="primary">
              {mode === 'create' ? 'Save' : 'Update'}
            </CButton>
          </div>
        </CForm>
      </CCardBody>
    </CCard>
  )
}

export default ExamFormComponent