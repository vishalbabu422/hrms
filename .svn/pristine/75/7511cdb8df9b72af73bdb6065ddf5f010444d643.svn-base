import EmpanelmentFormComponent from './form-component'
import api from '../../api/axios'
import { toast } from 'react-toastify'
import { useNavigate } from 'react-router-dom'

const add = () => {
  const navigate = useNavigate()

  const handleSubmit = async (payload) => {
    try {
      const normalizedPayload = {
        ...payload,
      }

      await api.post('/admin/empanelment/create', normalizedPayload)
      toast.success('Empanelment created successfully')
      navigate('/empanelment')
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to create Empanelment')
    }
  }

  const initialData = {
    company_id: '',
    category: '',
    empanelment_no: '',
    amc: 0.0,
    agm: 0.0,
    date: '',
    shortcode: '',
    rfe: '',
    effective_from: '',
    effective_to: null,

    leaves_per_month: '',
    carry_forward: false,
    leave_category: '',
    maternity_leaves: false,

    remarks: '',
    doc_file: null,
    doc_path: '',

    is_active: true,
  }

  return (
    <EmpanelmentFormComponent initialData={initialData} mode="create" onSubmit={handleSubmit} />
  )
}

export default add
