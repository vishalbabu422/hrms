import React, { useState } from 'react'
import CIcon from '@coreui/icons-react'
import {
  // cilEducation,
  // cilBriefcase,
  // cilPeople,
  cilStar,
  cilMedicalCross,
  cilHospital,
  cilClipboard,
  cilPuzzle,
  cilBadge,
  cilDevices,
  cilGlobeAlt,
  cilContact,
  cilBalanceScale,
} from '@coreui/icons'

const Add = () => {
  const [step, setStep] = useState(0)

  const [qualifications, setQualifications] = useState([
    {
      qualificationType: '',
      qualificationName: '',
      specialization: '',
      instituteName: '',
      boardUniversity: '',
      yearOfPassing: '',
      grade: '',
      percentage: '',
    },
  ])

  const [skills, setSkills] = useState([
    {
      skillName: '',
      experienceYears: '',
      remarks: '',
    },
  ])

  const [health, setHealth] = useState({
    heightCm: '',
    weightKg: '',
    hasHealthIssues: false,
    isHandicapped: false,
    physicalDisabilityCategory: '',
    healthIssueRemarks: '',
    identificationMark: '',
  })

  const [vaccinations, setVaccinations] = useState([
    {
      vaccinationName: '',
      vaccinationDate: '',
      vaccinationDocument: null,
    },
  ])

  const [vehicles, setVehicles] = useState([
    {
      vehicleDetails: '',
      drivingLicenseNumber: '',
      drivingLicenseIssueDate: '',
      drivingLicenseExpiryDate: '',
      vehicleCategory: '',
      professionalMembershipDetails: '',
      emtRegistrationExpiryDate: '',
    },
  ])

  const [achievements, setAchievements] = useState([
    {
      achievement_date: '',
      achievement: '',
      achievement_remarks: '',
      status: '',
    },
  ])

  const handleAchievementChange = (index, field, value) => {
    const updated = [...achievements]
    updated[index][field] = value
    setAchievements(updated)
  }

  const addAchievement = () => {
    setAchievements([
      ...achievements,
      {
        achievement_date: '',
        achievement: '',
        achievement_remarks: '',
        status: '',
      },
    ])
  }

  const removeAchievement = (index) => {
    const updated = achievements.filter((_, i) => i !== index)
    setAchievements(updated)
  }

  const [assets, setAssets] = useState([
    {
      asset_name: '',
      asset_code: '',
      asset_issue_date: '',
      asset_return_date: '',
      quantity_issued: '',
      should_be_returned: '',
      return_expected_by: '',
      quantity_returned: '',
      remarks: '',
      total_damage_worth: '',
    },
  ])

  const handleAssetChange = (index, field, value) => {
    const updated = [...assets]
    updated[index][field] = value
    setAssets(updated)
  }

  const addAsset = () => {
    setAssets([
      ...assets,
      {
        asset_name: '',
        asset_code: '',
        asset_issue_date: '',
        asset_return_date: '',
        quantity_issued: '',
        should_be_returned: '',
        return_expected_by: '',
        quantity_returned: '',
        remarks: '',
        total_damage_worth: '',
      },
    ])
  }

  const removeAsset = (index) => {
    setAssets(assets.filter((_, i) => i !== index))
  }

  const handleVehicleChange = (index, field, value) => {
    const updated = [...vehicles]
    updated[index][field] = value
    setVehicles(updated)
  }

  const addVehicle = () => {
    setVehicles([
      ...vehicles,
      {
        vehicleDetails: '',
        drivingLicenseNumber: '',
        drivingLicenseIssueDate: '',
        drivingLicenseExpiryDate: '',
        vehicleCategory: '',
        professionalMembershipDetails: '',
        emtRegistrationExpiryDate: '',
      },
    ])
  }

  const [hobbies, setHobbies] = useState([
    {
      hobby: '',
      remarks: '',
      status: '',
    },
  ])

  const [languages, setLanguages] = useState([
    {
      language_name: '',
      can_read: false,
      can_write: false,
      can_speak: false,
      proficiency: '',
    },
  ])

  const handleLanguageChange = (index, field, value) => {
    const updated = [...languages]
    updated[index][field] = value
    setLanguages(updated)
  }

  const addLanguage = () => {
    setLanguages([
      ...languages,
      {
        language_name: '',
        can_read: false,
        can_write: false,
        can_speak: false,
        proficiency: '',
      },
    ])
  }

  const removeLanguage = (index) => {
    setLanguages(languages.filter((_, i) => i !== index))
  }

  const [passport, setPassport] = useState({
    passport_number: '',
    passport_issue_date: '',
    passport_expiry_date: '',
    passport_place_of_issue: '',
    passport_issuing_country: '',
    passport_type: '',
    visa_issuing_authority: '',
    visa_start_date: '',
    visa_end_date: '',
  })

  const handlePassportChange = (field, value) => {
    setPassport((prev) => ({
      ...prev,
      [field]: value,
    }))
  }

  const [disciplineRecords, setDisciplineRecords] = useState([
    {
      offence: '',
      offence_date: '',
      disciplinary_action: '',
      remarks: '',
    },
  ])

  const handleDisciplineChange = (index, field, value) => {
    const updated = [...disciplineRecords]
    updated[index][field] = value
    setDisciplineRecords(updated)
  }

  const addDiscipline = () => {
    setDisciplineRecords([
      ...disciplineRecords,
      {
        offence: '',
        offence_date: '',
        disciplinary_action: '',
        remarks: '',
      },
    ])
  }

  const removeDiscipline = (index) => {
    setDisciplineRecords(disciplineRecords.filter((_, i) => i !== index))
  }

  const handleHobbyChange = (index, field, value) => {
    const updated = [...hobbies]
    updated[index][field] = value
    setHobbies(updated)
  }

  const addHobby = () => {
    setHobbies([
      ...hobbies,
      {
        hobby: '',
        remarks: '',
        status: '',
      },
    ])
  }

  const removeHobby = (index) => {
    setHobbies(hobbies.filter((_, i) => i !== index))
  }

  const removeVehicle = (index) => {
    setVehicles(vehicles.filter((_, i) => i !== index))
  }

  const handleVaccinationChange = (index, field, value) => {
    const arr = [...vaccinations]
    arr[index][field] = value
    setVaccinations(arr)
  }

  const handleVaccinationFile = (index, file) => {
    const arr = [...vaccinations]
    arr[index].vaccinationDocument = file
    setVaccinations(arr)
  }

  const handleHealthChange = (e) => {
    const { name, value, type, checked } = e.target

    setHealth({
      ...health,
      [name]: type === 'checkbox' ? checked : value,
    })
  }

  const stepConfig = [
    { label: 'Skills', icon: cilStar },
    { label: 'Health', icon: cilMedicalCross },
    // { label: 'Vaccination', icon: cilHospital },
    { label: 'Vehicle ', icon: cilClipboard },
    { label: 'Hobbies', icon: cilPuzzle },
    { label: 'Achievements', icon: cilBadge },
    { label: 'Assests', icon: cilDevices },
    { label: 'Languages', icon: cilGlobeAlt },
    { label: 'Passport', icon: cilContact },
    { label: 'Discipline', icon: cilBalanceScale },
  ]

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
        {/* 🔹 STEPPER */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => setStep(index)}
            >
              <CIcon icon={item.icon} />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {step === 0 && (
          <div className="step-content">
            {skills.map((s, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Skill Name */}
                  <div className="col-md-4">
                    <label className="form-label">Skill Name</label>
                    <input
                      type="text"
                      className="form-control"
                      value={s.skillName}
                      maxLength={100}
                      placeholder="Enter skill (e.g. React, Java, Excel)"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].skillName = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>

                  {/* Skills */}
                  <div className="col-md-4">
                    <label className="form-label">Experience (Years)</label>
                    <input
                      type="number"
                      className="form-control"
                      value={s.experienceYears}
                      min="0"
                      step="0.1"
                      placeholder="e.g. 2.5"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].experienceYears = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>

                  {/* Remarks */}
                  <div className="col-md-4">
                    <label className="form-label">Remarks</label>
                    <input
                      type="text"
                      className="form-control"
                      value={s.remarks}
                      maxLength={255}
                      placeholder="Optional remarks"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].remarks = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>
                </div>

                {/* REMOVE BUTTON */}
                {skills.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => setSkills(skills.filter((_, i) => i !== index))}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD SKILL BUTTON */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setSkills([
                  ...skills,
                  {
                    skillName: '',
                    experienceYears: '',
                    remarks: '',
                  },
                ])
              }
            >
              + Add Skill
            </button>
          </div>
        )}

        {step === 1 && (
          <div className="step-content">
            {/* ================= HEALTH SECTION ================= */}
            <div className="card mb-4 shadow-sm">
              <div className="card-header bg-light fw-semibold">Health Details</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-6">
                    <label className="form-label">Height (cm)</label>
                    <input
                      type="number"
                      className="form-control"
                      name="heightCm"
                      value={health.heightCm}
                      step="0.01"
                      min="0"
                      onChange={handleHealthChange}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Weight (kg)</label>
                    <input
                      type="number"
                      className="form-control"
                      name="weightKg"
                      value={health.weightKg}
                      step="0.01"
                      min="0"
                      onChange={handleHealthChange}
                    />
                  </div>

                  <div className="col-md-6 d-flex align-items-center">
                    <div className="form-check mt-3">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        name="hasHealthIssues"
                        checked={health.hasHealthIssues}
                        onChange={handleHealthChange}
                      />
                      <label className="form-check-label">Has Health Issues</label>
                    </div>
                  </div>

                  <div className="col-md-6 d-flex align-items-center">
                    <div className="form-check mt-3">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        name="isHandicapped"
                        checked={health.isHandicapped}
                        onChange={handleHealthChange}
                      />
                      <label className="form-check-label">Is Physically Handicapped</label>
                    </div>
                  </div>

                  {health.isHandicapped && (
                    <div className="col-md-6">
                      <label className="form-label">Disability Category</label>
                      <input
                        type="text"
                        className="form-control"
                        name="physicalDisabilityCategory"
                        value={health.physicalDisabilityCategory}
                        onChange={handleHealthChange}
                      />
                    </div>
                  )}

                  {health.hasHealthIssues && (
                    <div className="col-md-12">
                      <label className="form-label">Health Issue Remarks</label>
                      <textarea
                        className="form-control"
                        name="healthIssueRemarks"
                        rows="3"
                        value={health.healthIssueRemarks}
                        onChange={handleHealthChange}
                      />
                    </div>
                  )}

                  <div className="col-md-12">
                    <label className="form-label">Identification Mark</label>
                    <textarea
                      className="form-control"
                      name="identificationMark"
                      rows="2"
                      value={health.identificationMark}
                      onChange={handleHealthChange}
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* ================= VACCINATION SECTION ================= */}
            <div className="card shadow-sm">
              <div className="card-header bg-light fw-semibold">Vaccination Details</div>

              <div className="card-body">
                {vaccinations.map((v, index) => (
                  <div key={index} className="border rounded p-3 mb-3">
                    <div className="row g-3">
                      <div className="col-md-4">
                        <label className="form-label">Vaccination Name</label>
                        <input
                          type="text"
                          className="form-control"
                          value={v.vaccinationName}
                          onChange={(e) =>
                            handleVaccinationChange(index, 'vaccinationName', e.target.value)
                          }
                        />
                      </div>

                      <div className="col-md-4">
                        <label className="form-label">Vaccination Date</label>
                        <input
                          type="date"
                          className="form-control"
                          value={v.vaccinationDate}
                          onChange={(e) =>
                            handleVaccinationChange(index, 'vaccinationDate', e.target.value)
                          }
                        />
                      </div>

                      <div className="col-md-4">
                        <label className="form-label">Upload Document</label>
                        <input
                          type="file"
                          className="form-control"
                          accept=".pdf,.jpg,.jpeg,.png"
                          onChange={(e) => handleVaccinationFile(index, e.target.files[0])}
                        />
                        {v.vaccinationDocument && (
                          <small className="text-success">{v.vaccinationDocument.name}</small>
                        )}
                      </div>
                    </div>

                    {vaccinations.length > 1 && (
                      <div className="text-end mt-2">
                        <button
                          type="button"
                          className="btn btn-outline-danger btn-sm"
                          onClick={() =>
                            setVaccinations(vaccinations.filter((_, i) => i !== index))
                          }
                        >
                          Remove
                        </button>
                      </div>
                    )}
                  </div>
                ))}

                <button
                  type="button"
                  className="btn btn-outline-primary"
                  onClick={() =>
                    setVaccinations([
                      ...vaccinations,
                      {
                        vaccinationName: '',
                        vaccinationDate: '',
                        vaccinationDocument: null,
                      },
                    ])
                  }
                >
                  + Add Vaccination
                </button>
              </div>
            </div>
          </div>
        )}

        {step === 2 && (
          <div className="step-content">
            {vehicles.map((v, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Vehicle Details */}
                  <div className="col-md-6">
                    <label className="form-label">Vehicle Details</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={v.vehicleDetails}
                      placeholder="e.g. Honda City - DL01AB1234"
                      onChange={(e) => handleVehicleChange(index, 'vehicleDetails', e.target.value)}
                    />
                  </div>

                  {/* Vehicle Category */}
                  <div className="col-md-6">
                    <label className="form-label">Vehicle Category</label>
                    <select
                      className="form-select"
                      value={v.vehicleCategory}
                      onChange={(e) =>
                        handleVehicleChange(index, 'vehicleCategory', e.target.value)
                      }
                    >
                      <option value="">Select</option>
                      <option value="LMV">LMV</option>
                      <option value="HMV">HMV</option>
                      <option value="MCWG">MCWG</option>
                      <option value="MCWOG">MCWOG</option>
                    </select>
                  </div>

                  {/* Driving License Number */}
                  <div className="col-md-6">
                    <label className="form-label">Driving License Number</label>
                    <input
                      type="text"
                      className="form-control"
                      maxLength={30}
                      value={v.drivingLicenseNumber}
                      onChange={(e) =>
                        handleVehicleChange(index, 'drivingLicenseNumber', e.target.value)
                      }
                    />
                  </div>

                  {/* License Issue Date */}
                  <div className="col-md-3">
                    <label className="form-label">License Issue Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={v.drivingLicenseIssueDate}
                      max={new Date().toISOString().split('T')[0]}
                      onChange={(e) =>
                        handleVehicleChange(index, 'drivingLicenseIssueDate', e.target.value)
                      }
                    />
                  </div>

                  {/* License Expiry Date */}
                  <div className="col-md-3">
                    <label className="form-label">License Expiry Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={v.drivingLicenseExpiryDate}
                      onChange={(e) =>
                        handleVehicleChange(index, 'drivingLicenseExpiryDate', e.target.value)
                      }
                    />
                  </div>

                  {/* Professional Membership */}
                  <div className="col-md-6">
                    <label className="form-label">Professional Membership Details</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={v.professionalMembershipDetails}
                      onChange={(e) =>
                        handleVehicleChange(index, 'professionalMembershipDetails', e.target.value)
                      }
                    />
                  </div>

                  {/* EMT Registration Expiry */}
                  <div className="col-md-6">
                    <label className="form-label">EMT Registration Expiry Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={v.emtRegistrationExpiryDate}
                      onChange={(e) =>
                        handleVehicleChange(index, 'emtRegistrationExpiryDate', e.target.value)
                      }
                    />
                  </div>
                </div>

                {/* Remove Button */}
                {vehicles.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeVehicle(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary" onClick={addVehicle}>
              + Add Vehicle
            </button>
          </div>
        )}

        {step === 3 && (
          <div className="step-content">
            {hobbies.map((h, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Hobby Name */}
                  <div className="col-md-4">
                    <label className="form-label">Hobby</label>
                    <input
                      type="text"
                      className="form-control"
                      maxLength={100}
                      value={h.hobby}
                      placeholder="e.g. Reading, Cricket, Music"
                      onChange={(e) => handleHobbyChange(index, 'hobby', e.target.value)}
                    />
                  </div>

                  {/* Status */}
                  <div className="col-md-4">
                    <label className="form-label">Status</label>
                    <select
                      className="form-select"
                      value={h.status}
                      onChange={(e) => handleHobbyChange(index, 'status', e.target.value)}
                    >
                      <option value="">Select</option>
                      <option value="ACTIVE">Active</option>
                      <option value="INACTIVE">Inactive</option>
                      <option value="PROFESSIONAL">Professional</option>
                      <option value="AMATEUR">Amateur</option>
                    </select>
                  </div>

                  {/* Remarks */}
                  <div className="col-md-4">
                    <label className="form-label">Remarks</label>
                    <input
                      type="text"
                      className="form-control"
                      value={h.remarks}
                      placeholder="Optional remarks"
                      onChange={(e) => handleHobbyChange(index, 'remarks', e.target.value)}
                    />
                  </div>
                </div>

                {/* Remove Button */}
                {hobbies.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeHobby(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary" onClick={addHobby}>
              + Add Hobby
            </button>
          </div>
        )}

        {step === 4 && (
          <div className="step-content">
            {achievements.map((a, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Achievement Date */}
                  <div className="col-md-3">
                    <label className="form-label">Achievement Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={a.achievement_date}
                      onChange={(e) =>
                        handleAchievementChange(index, 'achievement_date', e.target.value)
                      }
                    />
                  </div>

                  {/* Achievement */}
                  <div className="col-md-4">
                    <label className="form-label">Achievement</label>
                    <input
                      type="text"
                      className="form-control"
                      maxLength={500}
                      value={a.achievement}
                      placeholder="Enter achievement details"
                      onChange={(e) =>
                        handleAchievementChange(index, 'achievement', e.target.value)
                      }
                    />
                  </div>

                  {/* Status */}
                  <div className="col-md-2">
                    <label className="form-label">Status</label>
                    <select
                      className="form-select"
                      value={a.status}
                      onChange={(e) => handleAchievementChange(index, 'status', e.target.value)}
                    >
                      <option value="">Select</option>
                      <option value="ACTIVE">Active</option>
                      <option value="INACTIVE">Inactive</option>
                    </select>
                  </div>

                  {/* Remarks */}
                  <div className="col-md-3">
                    <label className="form-label">Remarks</label>
                    <input
                      type="text"
                      className="form-control"
                      value={a.achievement_remarks}
                      placeholder="Optional remarks"
                      onChange={(e) =>
                        handleAchievementChange(index, 'achievement_remarks', e.target.value)
                      }
                    />
                  </div>
                </div>

                {/* Remove Button */}
                {achievements.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeAchievement(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary mb-4" onClick={addAchievement}>
              + Add Achievement
            </button>
          </div>
        )}

        {step === 5 && (
          <div className="step-content">
            {assets.map((a, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Asset Name */}
                  <div className="col-md-3">
                    <label className="form-label">Asset Name</label>
                    <input
                      type="text"
                      className="form-control "
                      maxLength={150}
                      value={a.asset_name}
                      onChange={(e) => handleAssetChange(index, 'asset_name', e.target.value)}
                    />
                  </div>

                  {/* Asset Code */}
                  <div className="col-md-2">
                    <label className="form-label">Asset Code</label>
                    <input
                      type="text"
                      className="form-control"
                      maxLength={50}
                      value={a.asset_code}
                      onChange={(e) => handleAssetChange(index, 'asset_code', e.target.value)}
                    />
                  </div>

                  {/* Quantity Issued */}
                  <div className="col-md-2">
                    <label className="form-label">Qty Issued</label>
                    <input
                      type="number"
                      className="form-control"
                      min="0"
                      value={a.quantity_issued}
                      onChange={(e) => handleAssetChange(index, 'quantity_issued', e.target.value)}
                    />
                  </div>

                  {/* Should Be Returned */}
                  <div className="col-md-2">
                    <label className="form-label">Returnable?</label>
                    <select
                      className="form-select"
                      value={a.should_be_returned}
                      onChange={(e) =>
                        handleAssetChange(index, 'should_be_returned', e.target.value === 'true')
                      }
                    >
                      <option value="">Select</option>
                      <option value="true">Yes</option>
                      <option value="false">No</option>
                    </select>
                  </div>

                  {/* Issue Date */}
                  <div className="col-md-3">
                    <label className="form-label">Issue Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={a.asset_issue_date}
                      onChange={(e) => handleAssetChange(index, 'asset_issue_date', e.target.value)}
                    />
                  </div>

                  {/* Expected Return Date */}
                  {a.should_be_returned && (
                    <div className="col-md-3">
                      <label className="form-label">Expected Return By</label>
                      <input
                        type="date"
                        className="form-control"
                        value={a.return_expected_by}
                        onChange={(e) =>
                          handleAssetChange(index, 'return_expected_by', e.target.value)
                        }
                      />
                    </div>
                  )}

                  {/* Actual Return Date */}
                  <div className="col-md-3">
                    <label className="form-label">Actual Return Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={a.asset_return_date}
                      onChange={(e) =>
                        handleAssetChange(index, 'asset_return_date', e.target.value)
                      }
                    />
                  </div>

                  {/* Quantity Returned */}
                  <div className="col-md-2">
                    <label className="form-label">Qty Returned</label>
                    <input
                      type="number"
                      className="form-control"
                      min="0"
                      value={a.quantity_returned}
                      onChange={(e) =>
                        handleAssetChange(index, 'quantity_returned', e.target.value)
                      }
                    />
                  </div>

                  {/* Damage Worth */}
                  <div className="col-md-2">
                    <label className="form-label">Damage Worth</label>
                    <input
                      type="number"
                      step="0.01"
                      className="form-control"
                      value={a.total_damage_worth}
                      onChange={(e) =>
                        handleAssetChange(index, 'total_damage_worth', e.target.value)
                      }
                    />
                  </div>

                  {/* Remarks */}
                  <div className="col-md-12">
                    <label className="form-label">Remarks</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={a.remarks}
                      onChange={(e) => handleAssetChange(index, 'remarks', e.target.value)}
                    />
                  </div>
                </div>

                {assets.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeAsset(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary" onClick={addAsset}>
              + Add Asset
            </button>
          </div>
        )}

        {step === 6 && (
          <div className="step-content">
            {languages.map((l, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Language Name */}
                  <div className="col-md-3">
                    <label className="form-label">Language</label>
                    <input
                      type="text"
                      className="form-control"
                      maxLength={50}
                      placeholder="e.g. English, Hindi"
                      value={l.language_name}
                      onChange={(e) => handleLanguageChange(index, 'language_name', e.target.value)}
                    />
                  </div>

                  {/* Read */}
                  <div className="col-md-2 d-flex align-items-end">
                    <div className="form-check">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        checked={l.can_read}
                        onChange={(e) => handleLanguageChange(index, 'can_read', e.target.checked)}
                      />
                      <label className="form-check-label">Can Read</label>
                    </div>
                  </div>

                  {/* Write */}
                  <div className="col-md-2 d-flex align-items-end">
                    <div className="form-check">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        checked={l.can_write}
                        onChange={(e) => handleLanguageChange(index, 'can_write', e.target.checked)}
                      />
                      <label className="form-check-label">Can Write</label>
                    </div>
                  </div>

                  {/* Speak */}
                  <div className="col-md-2 d-flex align-items-end">
                    <div className="form-check">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        checked={l.can_speak}
                        onChange={(e) => handleLanguageChange(index, 'can_speak', e.target.checked)}
                      />
                      <label className="form-check-label">Can Speak</label>
                    </div>
                  </div>

                  {/* Proficiency */}
                  <div className="col-md-3">
                    <label className="form-label">Proficiency</label>
                    <select
                      className="form-select"
                      value={l.proficiency}
                      onChange={(e) => handleLanguageChange(index, 'proficiency', e.target.value)}
                    >
                      <option value="">Select</option>
                      <option value="BASIC">Basic</option>
                      <option value="INTERMEDIATE">Intermediate</option>
                      <option value="ADVANCED">Advanced</option>
                      <option value="NATIVE">Native</option>
                    </select>
                  </div>
                </div>

                {languages.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeLanguage(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary" onClick={addLanguage}>
              + Add Language
            </button>
          </div>
        )}
        {step === 7 && (
          <div className="step-content">
            {/* ================= PASSPORT SECTION ================= */}
            <div className="card mb-4 shadow-sm">
              <div className="card-header bg-light fw-semibold">Passport Details</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-4">
                    <label className="form-label">Passport Number</label>
                    <input
                      type="text"
                      className="form-control"
                      name="passportNumber"
                      value={passport.passportNumber}
                      maxLength={30}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Passport Type</label>
                    <select
                      className="form-select"
                      name="passportType"
                      value={passport.passportType}
                      onChange={handlePassportChange}
                    >
                      <option value="">Select</option>
                      <option value="REGULAR">Regular</option>
                      <option value="OFFICIAL">Official</option>
                      <option value="DIPLOMATIC">Diplomatic</option>
                    </select>
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Issuing Country</label>
                    <input
                      type="text"
                      className="form-control"
                      name="passportIssuingCountry"
                      value={passport.passportIssuingCountry}
                      maxLength={100}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Place of Issue</label>
                    <input
                      type="text"
                      className="form-control"
                      name="passportPlaceOfIssue"
                      value={passport.passportPlaceOfIssue}
                      maxLength={100}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Issue Date</label>
                    <input
                      type="date"
                      className="form-control"
                      name="passportIssueDate"
                      value={passport.passportIssueDate}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Expiry Date</label>
                    <input
                      type="date"
                      className="form-control"
                      name="passportExpiryDate"
                      value={passport.passportExpiryDate}
                      onChange={handlePassportChange}
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* ================= VISA SECTION ================= */}
            <div className="card shadow-sm">
              <div className="card-header bg-light fw-semibold">Visa Details (Optional)</div>

              <div className="card-body">
                <div className="row g-3">
                  <div className="col-md-4">
                    <label className="form-label">Visa Issuing Authority</label>
                    <input
                      type="text"
                      className="form-control"
                      name="visaIssuingAuthority"
                      value={passport.visaIssuingAuthority}
                      maxLength={150}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Visa Start Date</label>
                    <input
                      type="date"
                      className="form-control"
                      name="visaStartDate"
                      value={passport.visaStartDate}
                      onChange={handlePassportChange}
                    />
                  </div>

                  <div className="col-md-4">
                    <label className="form-label">Visa End Date</label>
                    <input
                      type="date"
                      className="form-control"
                      name="visaEndDate"
                      value={passport.visaEndDate}
                      onChange={handlePassportChange}
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {step === 8 && (
          <div className="step-content">
            {disciplineRecords.map((d, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Offence */}
                  <div className="col-md-4">
                    <label className="form-label">Offence</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={d.offence}
                      onChange={(e) => handleDisciplineChange(index, 'offence', e.target.value)}
                    />
                  </div>

                  {/* Offence Date */}
                  <div className="col-md-2">
                    <label className="form-label">Offence Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={d.offence_date}
                      onChange={(e) =>
                        handleDisciplineChange(index, 'offence_date', e.target.value)
                      }
                    />
                  </div>

                  {/* Disciplinary Action */}
                  <div className="col-md-4">
                    <label className="form-label">Disciplinary Action</label>
                    <textarea
                      className="form-control"
                      rows="2"
                      value={d.disciplinary_action}
                      onChange={(e) =>
                        handleDisciplineChange(index, 'disciplinary_action', e.target.value)
                      }
                    />
                  </div>

                  {/* Remarks */}
                  <div className="col-md-2">
                    <label className="form-label">Remarks</label>
                    <input
                      type="text"
                      className="form-control"
                      value={d.remarks}
                      onChange={(e) => handleDisciplineChange(index, 'remarks', e.target.value)}
                    />
                  </div>
                </div>

                {disciplineRecords.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => removeDiscipline(index)}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            <button type="button" className="btn btn-outline-primary" onClick={addDiscipline}>
              + Add Record
            </button>
          </div>
        )}

        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-4">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>

          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => setStep(step + 1)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
