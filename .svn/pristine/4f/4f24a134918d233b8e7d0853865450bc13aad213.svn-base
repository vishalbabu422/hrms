import {
  CButton,
  CCol,
  CFormLabel,
  CFormSelect,
  CRow,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CModal,
  CModalBody,
  CModalFooter,
} from '@coreui/react'

import { useState, useEffect } from 'react'
import { toast } from 'react-toastify'
import CIcon from '@coreui/icons-react'
import { cilCloudDownload } from '@coreui/icons'
import SalaryDispatchModal from './salaryDispatchModal'
import api from '../../api/axios'

const MonthlyRegister = () => {
  const [filters, setFilters] = useState({
    month: '',
    year: '',
    structure: '',
  })

  const [errors, setErrors] = useState({})

  const [salaryStructures, setSalaryStructures] = useState([])

  const [salaryData, setSalaryData] = useState([])
  const [searched, setSearched] = useState(false)

  const [dispatchModal, setDispatchModal] = useState(false)
  const [payslipModal, setPayslipModal] = useState(false)

  const [selectedRow, setSelectedRow] = useState(null)
  const [txnNo, setTxnNo] = useState('')

  // FETCH SALARY STRUCTURES
  useEffect(() => {
    fetchSalaryStructures()
  }, [])

  const fetchSalaryStructures = async () => {
    try {
      const res = await api.get('salary-structure')
      setSalaryStructures(res?.data?.data || [])
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch salary structures')
    }
  }

  const handleChange = (e) => {
    const { name, value } = e.target

    setFilters((prev) => ({
      ...prev,
      [name]: value,
    }))
  }

  const handleSearch = async () => {
    const validationErrors = {}

    if (!filters.month) {
      validationErrors.month = 'Month is required'
    }

    if (!filters.year) {
      validationErrors.year = 'Year is required'
    }

    if (!filters.structure) {
      validationErrors.structure = 'Salary Structure is required'
    }

    if (Object.keys(validationErrors).length > 0) {
      setErrors(validationErrors)
      setSearched(false)
      return
    }

    setErrors({})

    try {
      const res = await api.get(`salary-structure/${filters.structure}/employees`, {
        params: {
          month: filters.month,
          year: filters.year,
        },
      })

      const employees = res?.data?.data || []
console.log(employees)
      setSalaryData(employees)
      setSearched(true)
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch employees')
    }
  }

  const handleDispatchSubmit = () => {
    if (!txnNo) {
      toast.error('Enter transaction number')
      return
    }

    const updated = salaryData.map((emp) =>
      emp.id === selectedRow.id
        ? {
            ...emp,
            status: 'Dispatched',
            transaction_no: txnNo,
          }
        : emp,
    )

    setSalaryData(updated)

    setDispatchModal(false)
    setTxnNo('')

    toast.success('Dispatched Successfully')
  }

  const handleGenerate = (row) => {
    const updated = salaryData.map((emp) =>
      emp.id === row.id
        ? {
            ...emp,
            status: 'Generated',
          }
        : emp,
    )

    setSalaryData(updated)

    setPayslipModal(false)

    toast.success('Payslip Generated')
  }

  const handleDownload = (row) => {
    toast.success(`Downloading payslip for ${row.employee_name}`)
  }

  return (
    <>
      {/* FILTERS */}
      <CRow className="mb-4">
        <CCol md={3}>
          <CFormLabel>Month</CFormLabel>

          <CFormSelect name="month" onChange={handleChange} invalid={!!errors.month}>
            <option value="">Select</option>

            <option value="1">Jan</option>
            <option value="2">Feb</option>
            <option value="3">Mar</option>
            <option value="4">Apr</option>
            <option value="5">May</option>
            <option value="6">Jun</option>
            <option value="7">Jul</option>
            <option value="8">Aug</option>
            <option value="9">Sep</option>
            <option value="10">Oct</option>
            <option value="11">Nov</option>
            <option value="12">Dec</option>
          </CFormSelect>

          {errors.month && <div style={{ color: 'red', fontSize: '12px' }}>{errors.month}</div>}
        </CCol>

        <CCol md={3}>
          <CFormLabel>Year</CFormLabel>

          <CFormSelect name="year" onChange={handleChange} invalid={!!errors.year}>
            <option value="">Select</option>

            {[new Date().getFullYear() - 1, new Date().getFullYear()].map((year) => (
              <option key={year} value={year}>
                {year}
              </option>
            ))}
          </CFormSelect>

          {errors.year && <div style={{ color: 'red', fontSize: '12px' }}>{errors.year}</div>}
        </CCol>

        <CCol md={3}>
          <CFormLabel>Salary Structure</CFormLabel>

          <CFormSelect name="structure" onChange={handleChange} invalid={!!errors.structure}>
            <option value="">Select</option>

            {salaryStructures.map((item) => (
              <option key={item.id} value={item.id}>
                {item.name}
              </option>
            ))}
          </CFormSelect>

          {errors.structure && (
            <div style={{ color: 'red', fontSize: '12px' }}>{errors.structure}</div>
          )}
        </CCol>

        <CCol md={3} className="d-flex align-items-end">
          <CButton color="primary" onClick={handleSearch}>
            Search
          </CButton>
        </CCol>
      </CRow>

      {/* TABLE */}
      {searched && (
        <CTable bordered hover responsive>
          <CTableHead>
            <CTableRow>
              <CTableHeaderCell>Employee</CTableHeaderCell>
              <CTableHeaderCell>CTC</CTableHeaderCell>
              <CTableHeaderCell>Status</CTableHeaderCell>
              <CTableHeaderCell>Action</CTableHeaderCell>
            </CTableRow>
          </CTableHead>

          <CTableBody>
            {salaryData.map((item) => (
              <CTableRow key={item.id}>
                <CTableDataCell>{item.employee_name}</CTableDataCell>

                <CTableDataCell>₹ {item.ctc}</CTableDataCell>

                <CTableDataCell>{item.status}</CTableDataCell>

                <CTableDataCell>
                  {item.status === 'Pending' && (
                    <CButton
                      size="sm"
                      style={{
                        background: '#2d72bb',
                        border: 'none',
                        color: '#fff',
                      }}
                      onClick={() => {
                        setSelectedRow(item)
                        setDispatchModal(true)
                      }}
                    >
                      Dispatch
                    </CButton>
                  )}

                  {item.status === 'Dispatched' && (
                    <CButton
                      size="sm"
                      style={{
                        background: '#3da375',
                        border: 'none',
                        color: '#fff',
                      }}
                      onClick={() => {
                        setSelectedRow(item)
                        setPayslipModal(true)
                      }}
                    >
                      Generate Payslip
                    </CButton>
                  )}

                  {item.status === 'Generated' && (
                    <>
                      <CButton
                        size="sm"
                        className="me-2"
                        style={{
                          background: '#7a8594',
                          border: 'none',
                          color: '#fff',
                        }}
                        onClick={() => {
                          setSelectedRow(item)
                          setPayslipModal(true)
                        }}
                      >
                        View
                      </CButton>

                      <CButton
                        size="sm"
                        style={{
                          background: '#5c7c99',
                          border: 'none',
                          color: '#fff',
                        }}
                        onClick={() => handleDownload(item)}
                      >
                        <CIcon icon={cilCloudDownload} className="me-1" />
                        Download
                      </CButton>
                    </>
                  )}
                </CTableDataCell>
              </CTableRow>
            ))}
          </CTableBody>
        </CTable>
      )}

      {/* DISPATCH MODAL */}
      <CModal visible={dispatchModal} onClose={() => setDispatchModal(false)}>
        <CModalBody>
          <h5 className="mb-3">Dispatch Salary Slip</h5>

          <div className="mb-3">
            <label className="form-label">Transaction Number</label>

            <input
              className="form-control"
              value={txnNo}
              onChange={(e) => setTxnNo(e.target.value)}
            />
          </div>
        </CModalBody>

        <CModalFooter>
          <CButton color="secondary" onClick={() => setDispatchModal(false)}>
            Cancel
          </CButton>

          <CButton color="primary" onClick={handleDispatchSubmit}>
            Submit
          </CButton>
        </CModalFooter>
      </CModal>

      <SalaryDispatchModal
        visible={dispatchModal}
        onClose={() => setDispatchModal(false)}
        employeeId={selectedRow?.employee_id}
        month={filters.month}
        year={filters.year}
        salaryStructureId={filters.structure}
        onSubmit={handleDispatchSubmit}
      />

      {/* PAYSLIP MODAL */}
      <CModal visible={payslipModal} onClose={() => setPayslipModal(false)} size="lg">
        <CModalBody style={{ padding: '30px', background: '#fff' }}>
          {/* DATE */}
          <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
            <strong>Date: {new Date().toLocaleDateString()}</strong>
          </div>

          <br />

          {/* DETAILS */}
          <p>
            <strong>Employee:</strong> {selectedRow?.employee_name}
          </p>
          <p>
            <strong>Transaction No:</strong> {selectedRow?.transaction_no}
          </p>

          {/* TABLE */}
          <table style={{ width: '100%', borderCollapse: 'collapse', border: '1px solid #000' }}>
            <thead>
              <tr>
                <th colSpan="2" style={{ border: '1px solid #000', padding: '6px' }}>
                  PAYSLIP DETAILS
                </th>
              </tr>
              <tr>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Components</th>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Monthly</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Basic</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.5)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>HRA</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.25)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Transport Allowance</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1600</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  Professional Development Allowance
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.1)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Gross Earnings</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.gross_earnings}</strong>
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Deductions</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}></td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Total Deductions</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {selectedRow?.total_deductions}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Net Pay</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.net_salary}</strong>
                </td>
              </tr>
            </tbody>
          </table>

          <br />

          <p style={{ fontSize: '12px' }}>This is a system generated payslip.</p>
        </CModalBody>

        <CModalFooter>
          {selectedRow?.status !== 'Generated' && (
            <CButton color="primary" onClick={() => handleGenerate(selectedRow)}>
              Generate
            </CButton>
          )}

          <CButton color="secondary" onClick={() => setPayslipModal(false)}>
            Close
          </CButton>
        </CModalFooter>
      </CModal>
    </>
  )
}

export default MonthlyRegister
