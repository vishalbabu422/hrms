import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CFormTextarea,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'

const OrganisationFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  if (!formData) return null

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={6}>
                <CFormLabel htmlFor="orgName">Organisation Name</CFormLabel>
                <CFormInput
                  name="org_name"
                  placeholder="Enter organisation name"
                  value={formData.org_name || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Code</CFormLabel>
                <CFormInput
                  name="org_code"
                  value={formData.org_code || ''}
                  onChange={handleChange}
                  placeholder="Enter organisation code"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Contact_Email</CFormLabel>
                <CFormInput
                  name="contact_email"
                  value={formData.contact_email || ''}
                  onChange={handleChange}
                  placeholder="Enter contact email"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Contact_Phone</CFormLabel>
                <CFormInput
                  name="contact_phone"
                  value={formData.contact_phone || ''}
                  onChange={handleChange}
                  placeholder="Enter contact phone"
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Address</CFormLabel>
                <CFormTextarea name="address" value={formData.address || ''} onChange={handleChange} rows={5} />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default OrganisationFormComponent
