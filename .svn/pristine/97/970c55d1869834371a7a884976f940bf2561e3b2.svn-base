const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const EmployeeDesignation = sequelize.define(
    "EmployeeDesignation",
    {
        id: {
            type: DataTypes.BIGINT,
            autoIncrement: true,
            primaryKey: true
        },

        employee_id: {
            type: DataTypes.BIGINT,
            allowNull: false
        },

        designation_id: {
            type: DataTypes.BIGINT,
            allowNull: false
        },

        effective_from: {
            type: DataTypes.DATEONLY,
            allowNull: false
        },

        effective_to: {
            type: DataTypes.DATEONLY,
            allowNull: true
        },

        is_current: {
            type: DataTypes.BOOLEAN,
            defaultValue: true
        }
    },
    {
        tableName: "employee_designations",
        schema: "pmu",
        timestamps: true,
        createdAt: "created_at",
        updatedAt: false, // since table doesn't have updated_at
        indexes: [
            {
                fields: ["employee_id"]
            },
            {
                fields: ["designation_id"]
            },
            {
                fields: ["is_current"]
            }
        ]
    }
);

EmployeeDesignation.associate = (models) => {

    EmployeeDesignation.belongsTo(models.Employee, {
        foreignKey: "employee_id",
        as: "employee",
        onDelete: "CASCADE"
    });

    EmployeeDesignation.belongsTo(models.DesignationMaster, {
        foreignKey: "designation_id",
        as: "designation",
        onDelete: "CASCADE"
    });
};
module.exports = EmployeeDesignation;