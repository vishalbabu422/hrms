.notification-toggle {
  border: none !important;
  background: transparent !important;
  box-shadow: none !important;
}

.notification-toggle::after {
  display: none !important;
}

.notification-menu {
  width: 380px;
  padding: 0;
  border: none;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
}

.notification-header {
  padding: 16px 20px;
  font-size: 15px;
  font-weight: 600;
  border-bottom: 1px solid #edf1f5;
  background: #fff;
}

.notification-item {
  display: flex;
  gap: 12px;
  padding: 14px 16px;
  border-bottom: 1px solid #edf1f5;
  transition: all 0.2s ease;
  cursor: pointer;
}

.notification-item:hover {
  background: #f8fafc;
}

.notification-icon {
  width: 40px;
  height: 40px;
  min-width: 40px;
  border-radius: 50%;
  background: #eef2ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification-content {
  flex: 1;
}

.notification-content h6 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: #1e293b;
}

.notification-content p {
  margin: 4px 0;
  font-size: 13px;
  color: #64748b;
}

.notification-content small {
  color: #94a3b8;
}

.notification-footer {
  padding: 14px;
  text-align: center;
  font-weight: 600;
  color: #321fdb;
  cursor: pointer;
  background: #fff;
}

.notification-footer:hover {
  background: #f8fafc;
}

.notification-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  min-width: 18px;
  height: 18px;
  border-radius: 50%;
  font-size: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification-bell-wrapper {
  position: relative;
}