export const validateEmployeeAddon = (
  data,
) => {

  const errors = {}

  if (!data.workorder_id) {
    errors.workorder_id =
      'Workorder is required'
  }

  if (!data.employee_id) {
    errors.employee_id =
      'Employee is required'
  }

  if (!data.amount) {
    errors.amount =
      'Amount is required'
  }

  if (!data.effective_from) {
    errors.effective_from =
      'Effective From is required'
  }

  return errors
}