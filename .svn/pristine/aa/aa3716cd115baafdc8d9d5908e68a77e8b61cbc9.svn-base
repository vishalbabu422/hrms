import {
  CCard,
  CCardBody,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CButton,
  CContainer,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { CTooltip } from '@coreui/react'
import ExpandableSearch from '../components/expandable-search'
import ExportDropdown from '../components/ExportDropdown'

import {
  cilPencil,
  cilTrash,
  cilPlus,
  cilDescription,
  cilCheckCircle,
  cilXCircle,
} from '@coreui/icons'

import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import jsPDF from 'jspdf'
import * as XLSX from 'xlsx'
import { saveAs } from 'file-saver'

const WorkOrderIndex = () => {
  const navigate = useNavigate()
  const [search, setSearch] = useState('')

  const workOrders = [
    {
      id: 1,
      work_order_no: 'M2508011',
      date: '17-NOV-2025',
      project_no: 'I190256EOND',
      pi_no: 'IA12356EOND',
      project_name: 'Internal Central Pool For E office',
      is_active: true,
    },
    {
      id: 2,
      work_order_no: 'M2508012',
      date: '17-NOV-2025',
      project_no: 'I190256EOND',
      pi_no: 'IA12356EOND',
      project_name: 'Internal Central Pool For E office',
      is_active: false,
    },
  ]

  /* ================= EXPORT ================= */

  const handleExportPDF = () => {
    const doc = new jsPDF()
    let y = 15
    doc.setFontSize(14)
    doc.text('Work Order List', 10, 10)

    workOrders.forEach((w, i) => {
      doc.text(`${i + 1}. ${w.work_order_no} - ${w.project_name}`, 10, y)
      y += 8
    })

    doc.save('workorder-list.pdf')
  }

  const handleExportExcel = () => {
    const worksheet = XLSX.utils.json_to_sheet(workOrders)
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'WorkOrders')

    const excelBuffer = XLSX.write(workbook, {
      bookType: 'xlsx',
      type: 'array',
    })

    const fileData = new Blob([excelBuffer], {
      type:
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8',
    })

    saveAs(fileData, 'workorder-list.xlsx')
  }

  return (
    <CContainer fluid className="py-4">

      {/* ================= PAGE HEADER ================= */}
      <div
        className="mb-4 p-3 rounded-3"
        style={{
          backgroundColor: '#f4f6f9',
          borderLeft: '4px solid #1b4f72',
        }}
      >
        <div className="d-flex justify-content-between align-items-center">
          <div>
            <h5 className="fw-bold mb-1 text-dark">Work Order </h5>
          </div>

          <div className="d-flex gap-3">
            <ExpandableSearch
              value={search}
              onChange={setSearch}
              placeholder="Search work orders..."
            />

            <ExportDropdown
              onExportPDF={handleExportPDF}
              onExportExcel={handleExportExcel}
            />

            <CButton
              color="primary"
              size="sm"
              onClick={() => navigate('/work-order/add')}
            >
              Add Work Order
            </CButton>
          </div>
        </div>
      </div>

      {/* ================= TABLE CARD ================= */}
      <CCard className="shadow border-0 rounded-4">
        <CCardBody>

          <CTable hover responsive align="middle" className="rounded overflow-hidden">
            <CTableHead style={{ backgroundColor: '#f8f9fc' }}>
              <CTableRow>
                <CTableHeaderCell>S.no</CTableHeaderCell>
                <CTableHeaderCell>Work Order No</CTableHeaderCell>
                <CTableHeaderCell>Date</CTableHeaderCell>
                <CTableHeaderCell>Project No</CTableHeaderCell>
                <CTableHeaderCell>PI No</CTableHeaderCell>
                <CTableHeaderCell>Project Name</CTableHeaderCell>
                <CTableHeaderCell className="text-center align-middle">
                  Status
                </CTableHeaderCell>
                <CTableHeaderCell className="text-center align-middle">
                  Action
                </CTableHeaderCell>
              </CTableRow>
            </CTableHead>

            <CTableBody>
              {workOrders.map((order, index) => (
                <CTableRow key={order.id}>
                  <CTableDataCell>{index + 1}</CTableDataCell>

                  <CTableDataCell className="fw-semibold text-dark">
                    {order.work_order_no}
                  </CTableDataCell>

                  <CTableDataCell>{order.date}</CTableDataCell>
                  <CTableDataCell>{order.project_no}</CTableDataCell>
                  <CTableDataCell>{order.pi_no}</CTableDataCell>
                  <CTableDataCell>{order.project_name}</CTableDataCell>

                  <CTableDataCell className="text-center align-middle">
                    {order.is_active ? (
                      <CIcon icon={cilCheckCircle} className="text-success" size="lg" />
                    ) : (
                      <CIcon icon={cilXCircle} className="text-danger" size="lg" />
                    )}
                  </CTableDataCell>

                  <CTableDataCell>
                    <div className="d-flex justify-content-center gap-2">
                      <CTooltip content="Preview">
                        <div>
                          <ActionButton
                            color="primary"
                            icon={cilDescription}
                            onClick={() =>
                              navigate(`/work-order/preview/${order.id}`)
                            }
                          />
                        </div>
                      </CTooltip>

                      <CTooltip content="Edit">
                        <div>
                          <ActionButton
                            color="primary"
                            icon={cilPencil}
                            onClick={() =>
                              navigate(`/work-order/edit/${order.id}`)
                            }
                          />
                        </div>
                      </CTooltip>

                      <CTooltip content="Delete">
                        <div>
                          <ActionButton
                            color="danger"
                            icon={cilTrash}
                          />
                        </div>
                      </CTooltip>
                    </div>
                  </CTableDataCell>
                </CTableRow>
              ))}
            </CTableBody>
          </CTable>

          <CPagination className="justify-content-end mt-3">
            <CPaginationItem disabled>&laquo;</CPaginationItem>
            <CPaginationItem active>1</CPaginationItem>
            <CPaginationItem disabled>&raquo;</CPaginationItem>
          </CPagination>

        </CCardBody>
      </CCard>
    </CContainer>
  )
}

export default WorkOrderIndex

/* ================= ACTION BUTTON ================= */

const ActionButton = ({ color, icon, onClick }) => (
  <CButton
    size="sm"
    color={color}
    variant="ghost"
    onClick={onClick}
    className="rounded-circle"
  >
    <CIcon icon={icon} />
  </CButton>
)
