const catchAsync = require("../utils/catchAsync");
const APIFeatures = require("../utils/apiFeature");

// Model
const ResourceRate = require("../models/resourceRate");
const { Op } = require("sequelize");

//  Get Resource Rate List (Index)
const index = catchAsync(async (req, res, next) => {
  const features = new APIFeatures(req.query)
    .filter()
    .sort()
    .limitFields()
    .join()
    .paginate();

  const page = req.query.page * 1 || 1;
  const limit = req.query.limit * 1 || 10;  

  if (!features.query.where) features.query.where = {};

  if (req.query.search && req.query.search.trim().length >= 3) {
    const search = req.query.search.trim();

    features.query.where[Op.or] = [
      { unit_rate_incl_agency_margin: { [Op.iLike]: `%${search}%` } },
      { agency_margin_percent: { [Op.iLike]: `%${search}%` } },
    ];
  }

  const { rows: resourceRateList, count } = await ResourceRate.findAndCountAll(
    features.query);

  res.status(200).json({
    status: "success",
    message: "Get Resource Rate List!",
    total: count,
    page,
    limit,
    totalPages: Math.ceil(count / limit),
    results: resourceRateList.length,
    data: { resourceRateList },
  });
});


// Get Resource Rate By ID
const dataById = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const { is_active = true } = req.query;

  const where = { id };

  if (is_active !== undefined) {
    where.is_active = is_active === "true";
  }

  const resourceRate = await ResourceRate.findOne({ where });

  if (!resourceRate) {
    return res.status(404).json({
      status: "fail",
      message: "Resource Rate not found",
    });
  }

  res.status(200).json({
    status: "success",
    data: resourceRate,
  });
});


//  Create Resource Rate
const create = catchAsync(async (req, res, next) => {
  const payload = req.body;

  // Prevent duplicate active record (based on designation)
  const existing = await ResourceRate.findOne({
    where: {
      desgn_id_fk: payload.desgn_id_fk,
      is_active: true,
    },
  });

  if (existing) {
    return res.status(409).json({
      status: "fail",
      message: "Resource Rate already exists for this designation",
    });
  }

  const resourceRate = await ResourceRate.create({
    ...payload,
    is_active: true,
    created: new Date(),
    modified: new Date(),
  });

  res.status(201).json({
    status: "success",
    data: resourceRate,
  });
});


//  Edit Resource Rate
const edit = catchAsync(async (req, res, next) => {
  const { id } = req.params;
  const updates = req.body;

  const resourceRate = await ResourceRate.findByPk(id);

  if (!resourceRate) {
    return res.status(404).json({
      status: "fail",
      message: "Resource Rate not found",
    });
  }

  // Duplicate check only if designation changing
  if (
    updates.desgn_id_fk &&
    updates.desgn_id_fk !== resourceRate.desgn_id_fk
  ) {
    const duplicate = await ResourceRate.findOne({
      where: {
        desgn_id_fk: updates.desgn_id_fk,
        is_active: true,
      },
    });

    if (duplicate && duplicate.id !== resourceRate.id) {
      return res.status(409).json({
        status: "fail",
        message: "Resource Rate already exists for this designation",
      });
    }
  }

  await resourceRate.update({
    ...updates,
    modified: new Date(),
  });

  res.status(200).json({
    status: "success",
    data: resourceRate,
  });
});


// Soft Delete Resource Rate
const deleteById = catchAsync(async (req, res, next) => {
  const { id } = req.params;

  const resourceRate = await ResourceRate.findByPk(id);

  if (!resourceRate) {
    return res.status(404).json({
      status: "fail",
      message: "Resource Rate not found",
    });
  }

  if (resourceRate.is_active === false) {
    return res.status(409).json({
      status: "fail",
      message: "Resource Rate is already inactive",
    });
  }

  await resourceRate.update({
    is_active: false,
    modified: new Date(),
  });

  return res.status(200).json({
    status: "success",
    message: "Resource Rate deleted successfully",
  });
});


module.exports = {
  index,
  dataById,
  create,
  edit,
  deleteById,
};
