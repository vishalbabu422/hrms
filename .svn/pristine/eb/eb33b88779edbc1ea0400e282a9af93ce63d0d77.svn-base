import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CFormCheck,
  CRow,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import { validateSalaryStructure } from '../../validations/salaryStructureValidation'

const SalaryStructureForm = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [errors, setErrors] = useState({})
  const [selectedComponents, setSelectedComponents] = useState([])

  // ✅ Dummy Components
  const componentOptions = [
  { id: 1, name: 'Basic Salary' },
  { id: 2, name: 'HRA' },
  { id: 3, name: ' DA' },
  { id: 4, name: 'Conveyance Allowance' },
  { id: 5, name: 'Medical Allowance' },
  { id: 6, name: 'Special Allowance' },
  { id: 7, name: 'PF' },
  { id: 8, name: 'Professional Tax' },
  { id: 9, name: 'Bonus' },
]

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)

      // If edit mode (optional future)
      if (initialData.components) {
        setSelectedComponents(initialData.components)
      }
    }
  }, [initialData])

  if (!formData) return null

  // ✅ Handle Input Change
  const handleChange = (e) => {
    const { name, value } = e.target

    let updatedValue = value

    if (name === 'is_active') {
      updatedValue = value === 'true'
    }

    setFormData((prev) => ({
      ...prev,
      [name]: updatedValue === '' ? null : updatedValue,
    }))
  }

  // ✅ Handle Checkbox
  const handleComponentChange = (id) => {
    setSelectedComponents((prev) =>
      prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id],
    )
  }

  // Validation
  const validateForm = () => {
    const validationErrors = validateSalaryStructure({
      ...formData,
      components: selectedComponents,
    })

    if (selectedComponents.length === 0) {
      validationErrors.components = 'Select at least one component'
    }

    setErrors(validationErrors)
    return Object.keys(validationErrors).length === 0
  }

  // Submit
  const handleSubmit = (e) => {
    e.preventDefault()

    if (!validateForm()) return

    const payload = {
      ...formData,
      components: selectedComponents,
    }

    onSubmit(payload)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard>
          <CCardBody>
            <CForm onSubmit={handleSubmit} className="row g-3">
              {/* Name */}
              <CCol md={12}>
                <CFormLabel>
                  Name <span className="text-danger">*</span>
                </CFormLabel>
                <CFormInput
                  name="name"
                  placeholder="Name"
                  value={formData.name || ''}
                  onChange={handleChange}
                  invalid={!!errors.name}
                  feedback={errors.name}
                />
              </CCol>

              {/* Description */}
              <CCol md={12}>
                <CFormLabel>Description</CFormLabel>
                <CFormInput
                  name="description"
                  value={formData.description || ''}
                  onChange={handleChange}
                  placeholder="Enter description"
                />
              </CCol>

              {/*Components Checkbox */}
              <CCol md={6}>
                <CFormLabel>
                  Components <span className="text-danger">*</span>
                </CFormLabel>

                <div className="d-flex gap-4 flex-wrap mt-2">
                  {componentOptions.map((item) => (
                    <CFormCheck
                      key={item.id}
                      label={item.name}
                      checked={selectedComponents.includes(item.id)}
                      onChange={() => handleComponentChange(item.id)}
                    />
                  ))}
                </div>

                {/* Error */}
                {errors.components && <div className="text-danger mt-1">{errors.components}</div>}
              </CCol>

              {/* Status */}
              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">Active</option>
                  <option value="false">Inactive</option>
                </CFormSelect>
              </CCol>
              {/* Submit */}
              <CCol xs={12}>
                <CButton type="submit" color="primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default SalaryStructureForm
