import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CCol, CCardBody } from '@coreui/react'
import { getEmployeeVehicles } from '../../../services/vehicleService'

const VehicleView = () => {
  const { employeeId } = useParams()

  const [vehicle, setVehicle] = useState({})
  const [loading, setLoading] = useState(false)

  const fetchVehicle = async () => {
    try {
      setLoading(true)

      const response = await getEmployeeVehicles(employeeId)

      // ⚠️ adjust if API returns array
      const data = response.data?.data || response.data || {}

      // If API returns array → take first object
      setVehicle(Array.isArray(data) ? data[0] : data)
    } catch (error) {
      console.error('Error fetching vehicle:', error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchVehicle()
  }, [employeeId])

  return (
    <CCol xs={12} sm={12} md={9} lg={10}>
      <CCardBody style={{ minHeight: '400px' }}>
        {/* ===== Header ===== */}
        <div className="section-header mb-4">
          <div className="section-accent"></div>
          <h5 className="section-title">Vehicle Details</h5>
        </div>

        {/* 🔄 Loading */}
        {loading && <p>Loading vehicle details...</p>}

        {/* ❌ Empty */}
        {!loading && Object.keys(vehicle).length === 0 && (
          <p className="text-muted">No vehicle data available</p>
        )}

        {/* ✅ Data */}
        {!loading && Object.keys(vehicle).length > 0 && (
          <div className="row g-4">
            {/* LEFT */}
            <div className="col-12 col-md-6">
              <div className="mb-4">
                <small className="text-muted">Vehicle Details</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.vehicleName
                    ? `${vehicle.vehicleName} – ${vehicle.registrationNumber}`
                    : '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">Driving License Number</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.licenseNumber || '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">License Issue Date</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.licenseIssueDate
                    ? new Date(vehicle.licenseIssueDate).toLocaleDateString()
                    : '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">License Expiry Date</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.licenseExpiryDate
                    ? new Date(vehicle.licenseExpiryDate).toLocaleDateString()
                    : '-'}
                </div>
              </div>
            </div>

            {/* RIGHT */}
            <div className="col-12 col-md-6">
              <div className="mb-4">
                <small className="text-muted">Vehicle Category</small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.vehicleCategory || '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">
                  Professional Membership Details
                </small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.professionalDetails || '-'}
                </div>
              </div>

              <div className="mb-4">
                <small className="text-muted">
                  EMT Registration Expiry Date
                </small>
                <div className="fw-semibold border-bottom pb-2">
                  {vehicle.emtExpiryDate
                    ? new Date(vehicle.emtExpiryDate).toLocaleDateString()
                    : '-'}
                </div>
              </div>
            </div>
          </div>
        )}
      </CCardBody>
    </CCol>
  )
}

export default VehicleView