                          <div className="row g-4">
                            <div className="col-md-12">
                              {/* Resume */}
                              <div className="mb-4 d-flex justify-content-between align-items-center border-bottom pb-2">
                                <div>
                                  <small className="text-muted">Resume</small>
                                  <div className="fw-semibold">resume_naina.pdf</div>
                                </div>

                                <CButton
                                  size="sm"
                                  variant="outline"
                                  href="/documents/resume_naina.pdf"
                                  download
                                >
                                  <CIcon icon={cilCloudDownload} />
                                </CButton>
                              </div>

                              {/* PAN Card */}
                              <div className="mb-4 d-flex justify-content-between align-items-center border-bottom pb-2">
                                <div>
                                  <small className="text-muted">PAN Card</small>
                                  <div className="fw-semibold">pan_card.pdf</div>
                                </div>
                                <CButton
                                  size="sm"
                                  variant="outline"
                                  href="/documents/pan_card.pdf"
                                  download
                                >
                                  <CIcon icon={cilCloudDownload} />
                                </CButton>
                              </div>

                              {/* Aadhaar Card */}
                              <div className="mb-4 d-flex justify-content-between align-items-center border-bottom pb-2">
                                <div>
                                  <small className="text-muted">Aadhaar Card</small>
                                  <div className="fw-semibold">aadhaar_card.pdf</div>
                                </div>
                                <CButton
                                  size="sm"
                                  variant="outline"
                                  href="/documents/aadhaar_card.pdf"
                                  download
                                >
                                  <CIcon icon={cilCloudDownload} />
                                </CButton>
                              </div>
                            </div>
                          </div>
                        </div>
                      )}
                    </CCardBody>
                  </CCard>
                </CCol>
              )}

              {sideTab === 'skills' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header (CSS Based) ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Skills</h5>
                    </div>

                    <div className="mt-3">
                      <div className="row g-4">
                        <div className="col-md-6">
                          <div className="mb-4">
                            <small className="text-muted">Company Name</small>
                            <div className="fw-semibold border-bottom pb-2">Infosys Ltd.</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Designation</small>
                            <div className="fw-semibold border-bottom pb-2">Software Engineer</div>
                          </div>
                        </div>

                        <div className="col-md-6">
                          <div className="mb-4">
                            <small className="text-muted">Duration</small>
                            <div className="fw-semibold border-bottom pb-2">
                              Jan 2020 – Dec 2023
                            </div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Total Experience</small>
                            <div className="fw-semibold border-bottom pb-2">3 Years</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {/* Health */}

              {sideTab === 'health' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header (Same as Skills) ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Health</h5>
                    </div>

                    <div className="mt-3">
                      <div className="row g-4">
                        {/* LEFT COLUMN */}
                        <div className="col-12 col-md-6">
                          <div className="mb-4">
                            <small className="text-muted">Height (cm)</small>
                            <div className="fw-semibold border-bottom pb-2">168 cm</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Weight (kg)</small>
                            <div className="fw-semibold border-bottom pb-2">60 kg</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Has Health Issues</small>
                            <div className="fw-semibold border-bottom pb-2 text-danger">Yes</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Health Issue Remarks</small>
                            <div className="fw-semibold border-bottom pb-2">
                              Mild seasonal asthma
                            </div>
                          </div>
                        </div>

                        {/* RIGHT COLUMN */}
                        <div className="col-12 col-md-6">
                          <div className="mb-4">
                            <small className="text-muted">Is Handicapped</small>
                            <div className="fw-semibold border-bottom pb-2">No</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Physical Disability Category</small>
                            <div className="fw-semibold border-bottom pb-2">Not Applicable</div>
                          </div>

                          <div className="mb-4">
                            <small className="text-muted">Identification Mark</small>
                            <div className="fw-semibold border-bottom pb-2">Mole on left cheek</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'vehicle' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Vehicle Details</h5>
                    </div>

                    <div className="row g-4">
                      {/* LEFT COLUMN */}
                      <div className="col-12 col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Vehicle Details</small>
                          <div className="fw-semibold border-bottom pb-2">
                            Hyundai i20 – DL8CAB1234
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Driving License Number</small>
                          <div className="fw-semibold border-bottom pb-2">DL0420110149646</div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">License Issue Date</small>
                          <div className="fw-semibold border-bottom pb-2">15 January 2018</div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">License Expiry Date</small>
                          <div className="fw-semibold border-bottom pb-2">14 January 2038</div>
                        </div>
                      </div>

                      {/* RIGHT COLUMN */}
                      <div className="col-12 col-md-6">
                        <div className="mb-4">
                          <small className="text-muted">Vehicle Category</small>
                          <div className="fw-semibold border-bottom pb-2">
                            LMV (Light Motor Vehicle)
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">Professional Membership Details</small>
                          <div className="fw-semibold border-bottom pb-2">
                            Registered EMT Professional
                          </div>
                        </div>

                        <div className="mb-4">
                          <small className="text-muted">EMT Registration Expiry Date</small>
                          <div className="fw-semibold border-bottom pb-2">31 December 2026</div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'hobbies' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Hobbies</h5>
                    </div>

                    {/* Hobby 1 */}
                    <div className="mb-4">
                      <div className="row">
                        <div className="col-12 col-md-6">
                          <small className="text-muted">Hobby</small>
                          <div className="fw-semibold border-bottom pb-2">Photography</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Remarks</small>
                          <div className="fw-semibold border-bottom pb-2">
                            Passionate about landscape photography.
                          </div>
                        </div>
                      </div>
                    </div>

                    {/* Hobby 2 */}
                    <div className="mb-4">
                      <div className="row">
                        <div className="col-12 col-md-6">
                          <small className="text-muted">Hobby</small>
                          <div className="fw-semibold border-bottom pb-2">Traveling</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Remarks</small>
                          <div className="fw-semibold border-bottom pb-2">
                            Explored 12 states across India.
                          </div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}
{sideTab === 'achievements' && (
  <CCol xs={12} sm={12} md={9} lg={10}>
    <CCardBody style={{ minHeight: '400px' }}>
      
      {/* ===== Attractive Header ===== */}
      <div className="section-header mb-4">
        <div className="section-accent"></div>
        <h5 className="section-title">Achievements</h5>
      </div>

      <CAccordion alwaysOpen>
        {achievementData.map((item, index) => (
          <CAccordionItem itemKey={index} key={item.id}>
            
            {/* Accordion Header */}
            <CAccordionHeader>
              <div className="fw-semibold">
                {item.achievement} – {item.date}
              </div>
            </CAccordionHeader>

            {/* Accordion Body */}
            <CAccordionBody>
              <div className="row g-4">

                <div className="col-12 col-md-6 col-lg-3">
                  <small className="text-muted">Achievement Date</small>
                  <div className="fw-semibold border-bottom pb-2">
                    {item.date}
                  </div>
                </div>

                <div className="col-12 col-md-6 col-lg-3">
                  <small className="text-muted">Achievement</small>
                  <div className="fw-semibold border-bottom pb-2">
                    {item.achievement}
                  </div>
                </div>

                <div className="col-12 col-md-6 col-lg-3">
                  <small className="text-muted">Status</small>
                  <div
                    className={`fw-semibold border-bottom pb-2 ${
                      item.status === 'Approved'
                        ? 'text-success'
                        : item.status === 'Rejected'
                        ? 'text-danger'
                        : 'text-warning'
                    }`}
                  >
                    {item.status}
                  </div>
                </div>

                <div className="col-12 col-md-6 col-lg-3">
                  <small className="text-muted">Remarks</small>
                  <div className="fw-semibold border-bottom pb-2">
                    {item.remarks}
                  </div>
                </div>

              </div>
            </CAccordionBody>

          </CAccordionItem>
        ))}
      </CAccordion>

    </CCardBody>
  </CCol>
)}

              {sideTab === 'assets' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Assets</h5>
                    </div>

                    {/* ===== Asset 1 ===== */}
                    <div className="mb-4">
                      <div className="row">
                        <div className="col-12 col-md-6">
                          <small className="text-muted">Asset Name</small>
                          <div className="fw-semibold border-bottom pb-2">Dell Latitude Laptop</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Asset Code</small>
                          <div className="fw-semibold border-bottom pb-2">DL-IT-2024-001</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Asset Issue Date</small>
                          <div className="fw-semibold border-bottom pb-2">10 Jan 2024</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Quantity Issued</small>
                          <div className="fw-semibold border-bottom pb-2">1</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Should Be Returned</small>
                          <div className="fw-semibold border-bottom pb-2 text-danger">Yes</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Return Expected By</small>
                          <div className="fw-semibold border-bottom pb-2">31 Dec 2026</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Asset Return Date</small>
                          <div className="fw-semibold border-bottom pb-2">—</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Quantity Returned</small>
                          <div className="fw-semibold border-bottom pb-2">0</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Total Damage Worth</small>
                          <div className="fw-semibold border-bottom pb-2">₹0.00</div>
                        </div>

                        <div className="col-12 col-md-6">
                          <small className="text-muted">Remarks</small>
                          <div className="fw-semibold border-bottom pb-2">
                            Asset in good condition
                          </div>
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'languages' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Languages</h5>
                    </div>

                    {languageData.map((item) => (
                      <div key={item.id} className="mb-4">
                        <div className="row align-items-center">
                          {/* Language Name */}
                          <div className="col-12 col-md-3">
                            <small className="text-muted">Language</small>
                            <div className="fw-semibold  pb-2">{item.language_name}</div>
                          </div>

                          {/* Can Read */}
                          <div className="col-6 col-md-2 mt-3 mt-md-0">
                            <div className="d-flex align-items-center gap-2">
                              <input
                                type="checkbox"
                                className="form-check-input"
                                checked={item.can_read}
                                disabled
                              />
                              <span>Read</span>
                            </div>
                          </div>

                          {/* Can Write */}
                          <div className="col-6 col-md-2 mt-3 mt-md-0">
                            <div className="d-flex align-items-center gap-2">
                              <input
                                type="checkbox"
                                className="form-check-input"
                                checked={item.can_write}
                                disabled
                              />
                              <span>Write</span>
                            </div>
                          </div>

                          {/* Can Speak */}
                          <div className="col-6 col-md-2 mt-3 mt-md-0">
                            <div className="d-flex align-items-center gap-2">
                              <input
                                type="checkbox"
                                className="form-check-input"
                                checked={item.can_speak}
                                disabled
                              />
                              <span>Speak</span>
                            </div>
                          </div>

                          {/* Proficiency */}
                          <div className="col-12 col-md-3 mt-3 mt-md-0">
                            <small className="text-muted">Proficiency</small>
                            <div className="fw-semibold pb-2">{item.proficiency}</div>
                          </div>
                        </div>

                        <hr className="mt-4" />
                      </div>
                    ))}
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'passport' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Passport & Visa Details</h5>
                    </div>

                    <div className="row g-4">
                      {/* Passport Number */}
                      <div className="col-12 col-md-6 ">
                        <small className="text-muted">Passport Number</small>
                        <div className="fw-semibold border-bottom pb-2">N1234567</div>
                      </div>

                      {/* Passport Type */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Passport Type</small>
                        <div className="fw-semibold border-bottom pb-2">Ordinary</div>
                      </div>

                      {/* Issuing Country */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Issuing Country</small>
                        <div className="fw-semibold border-bottom pb-2">India</div>
                      </div>

                      {/* Issue Date */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Issue Date</small>
                        <div className="fw-semibold border-bottom pb-2">10 March 2019</div>
                      </div>

                      {/* Expiry Date */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Expiry Date</small>
                        <div className="fw-semibold border-bottom pb-2">09 March 2029</div>
                      </div>

                      {/* Place of Issue */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Place of Issue</small>
                        <div className="fw-semibold border-bottom pb-2">New Delhi</div>
                      </div>

                      {/* Visa Authority */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Visa Issuing Authority</small>
                        <div className="fw-semibold border-bottom pb-2">UK Embassy</div>
                      </div>

                      {/* Visa Validity */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Visa Validity</small>
                        <div className="fw-semibold border-bottom pb-2">
                          01 Jan 2024 – 31 Dec 2024
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}

              {sideTab === 'discipline' && (
                <CCol xs={12} sm={12} md={9} lg={10}>
                  <CCardBody style={{ minHeight: '400px' }}>
                    {/* ===== Attractive Header ===== */}
                    <div className="section-header mb-4">
                      <div className="section-accent"></div>
                      <h5 className="section-title">Disciplinary Record</h5>
                    </div>

                    <div className="row g-4">
                      {/* Offence */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Offence</small>
                        <div className="fw-semibold border-bottom pb-2">
                          Late reporting without prior notice
                        </div>
                      </div>

                      {/* Offence Date */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Offence Date</small>
                        <div className="fw-semibold border-bottom pb-2">15 February 2024</div>
                      </div>

                      {/* Disciplinary Action */}
                      <div className="col-12 col-md-6">
                        <small className="text-muted">Disciplinary Action</small>
                        <div className="fw-semibold border-bottom pb-2 text-danger">
                          Written Warning Issued
                        </div>
                      </div>

                      {/* Remarks */}
                      <div className="col-6">
                        <small className="text-muted">Remarks</small>
                        <div className="fw-semibold border-bottom pb-2">
                          Employee counselled and advised to maintain punctuality.
                        </div>
                      </div>
                    </div>
                  </CCardBody>
                </CCol>
              )}
            </CRow>
          </CCardBody>
        </CCard>
      </CContainer>
    </div>
  )
}

export default EmployeeProfile
