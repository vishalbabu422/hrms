        {/* 🔹 Qualification */}

        {step === 3 && (
          <Qualification
            step={step}
            employeeQualification={employeeQualification}
            setEmployeeQualification={setEmployeeQualification}
          />
        )}

        {step === 4 && (
          <Bank step={step} employeeBank={employeeBank} setEmployeeBank={setEmployeeBank} />
        )}

        {step === 5 && (
          <Insurance
            step={step}
            insurance={insurance}
            setInsurance={setInsurance}
            familyMembers={familyMembers}
            setFamilyMembers={setFamilyMembers}
          />
        )}

        {step === 6 && <Screening step={step} screening={screening} setScreening={setScreening} />}

        {step === 7 && (
          <Experience step={step} experiences={experiences} setExperiences={setExperiences} />
        )}

        {step === 8 && (
          <Ltc step={step} ltcData={ltcData} setLtcData={setLtcData} ltcLocked={ltcLocked} />
        )}

        {step === 9 && (
          <div className="step-content">
            <div className="card shadow-sm p-4">
              <div className="row g-3">
                {/* Document Type */}
                <div className="col-md-12">
                  <label className="form-label">Document Type</label>
                  <select
                    className="form-select"
                    value={selectedDocType}
                    onChange={(e) => setSelectedDocType(e.target.value)}
                  >
                    <option value="">Select Document Type</option>
                    <option value="PHOTO">Photo</option>
                    <option value="RESUME">Resume</option>
                    <option value="PAN_FILE">PAN Card</option>
                    <option value="AADHAAR_FILE">Aadhaar Card</option>
                    <option value="VOTER_ID_FILE">Voter ID</option>
                    <option value="BIRTH_CERT">Birth Certificate</option>
                    <option value="DRIVING_LICENSE">Driving License</option>
                    <option value="WORK_PERMIT">Work Permit</option>
                    <option value="POLICY_DOCUMENT">Policy Document</option>
                    <option value="SALARY_SLIP">Salary Slip</option>
                    <option value="FORM16">Form 16</option>
                    <option value="POLICE_VERIFICATION">Police Verification</option>
                    <option value="DECLARATION">Declaration</option>
                  </select>
                </div>

                {/* Upload Box */}
                <div className="col-12">
                  <label className="form-label">Upload File</label>

                  <div
                    className="border rounded p-5 text-center"
                    style={{
                      cursor: 'pointer',
                      background: '#fafafa',
                      borderStyle: 'dashed',
                    }}
                    onDrop={handleDrop}
                    onDragOver={handleDragOver}
                    onClick={() => document.getElementById('hiddenFileInput').click()}
                  >
                    {selectedFile ? (
                      <div className="text-success fw-semibold">{selectedFile.name}</div>
                    ) : (
                      <div className="text-muted">Drag & Drop file here or Click to Browse</div>
                    )}
                  </div>

                  <input
                    id="hiddenFileInput"
                    type="file"
                    hidden
                    accept=".pdf,.jpg,.jpeg,.png"
                    onChange={(e) => handleFileSelect(e.target.files[0])}
                  />
                </div>

                {/* Add Button */}
                <div className="col-12 text-end">
                  <button type="button" className="btn btn-primary" onClick={handleAddDocument}>
                    Add Document
                  </button>
                </div>
              </div>
            </div>

            {/* ================= DOCUMENT PREVIEW TABLE ================= */}
            {documents.length > 0 && (
              <div className="card mt-4 shadow-sm p-3">
                <h6 className="fw-semibold mb-3">Uploaded Documents</h6>

                <div className="table-responsive">
                  <table className="table table-bordered align-middle">
                    <thead className="table-light">
                      <tr>
                        <th>Document Type</th>
                        <th>File Name</th>
                        <th width="100">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      {documents.map((doc, index) => (
                        <tr key={index}>
                          <td>{doc.type}</td>
                          <td>{doc.file.name}</td>
                          <td>
                            <button
                              className="btn btn-sm btn-outline-danger"
                              onClick={() => handleRemoveDocument(index)}
                            >
                              Remove
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>
        )}

        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-5">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>
          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => handleSubmit(step)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
