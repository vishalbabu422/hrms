const Add = () => {
  const [step, setStep] = useState(0)
  const [employeeId, setEmployeeId] = useState(null)
  const [profileImage, setProfileImage] = useState(null)
  const [cancelledCheque, setCancelledCheque] = useState(null)
  const [screeningMail, setScreeningMail] = useState(null)
  const [policyDocument, setPolicyDocument] = useState(null)
  const [selectedDocType, setSelectedDocType] = useState('')
  const [selectedFile, setSelectedFile] = useState(null)
  const [documents, setDocuments] = useState([])

  const stepConfig = [
    { label: 'Basic Information', icon: cilUser, url: '/employee' },
    { label: 'Address', icon: cilLocationPin, url: '/employee/{employeeId}/address' },
    { label: 'Office Address', icon: cilBuilding, url: '/employee/{employeeId}/address' },
    { label: 'Qualification', icon: cilEducation, url: '/employee/{employeeId}/qualification' },
    { label: 'Bank Details', icon: cilBank, url: '/employee/{employeeId}/bankId' },
    { label: 'Insurance', icon: cilShieldAlt, url: `/employee/${employeeId}/insurance` },
    { label: 'Screening Test', icon: cilClipboard },
    { label: 'Experience', icon: cilBriefcase },
    { label: 'LTC', icon: cilMap },
    { label: 'Documents', icon: cilFile },
  ]

  const initialBasicDetails = {
    employee_code: '',
    attendance_code: '',
    password_hash: '',
    salutation: '',
    first_name: '',
    middle_name: '',
    last_name: '',
    email: '',
    contact_no: '',
    date_of_joining: null,
    probation_end_date: null,
    confirmation_date: null,
    date_of_exit: null,
    notice_period_days: null,
    employeeType: '',
    designation: '',
    division: '',
    modeOfWorking: '',
    stateOfWorking: '',
    employeeCategory: '',
    dateOfBirth: '',
    fathersName: '',
    mothersName: '',
    maritalStatus: '',
    gender: '',
    relievingDate: '',
    gazetted: false,
  }

  const [employeeDetails, setEmployeeDetails] = useState(initialBasicDetails)

  const createAddress = (type, isPrimary = false) => ({
    address_type: type,
    address: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: '',
    pin_code: '',
    is_primary: isPrimary,
  })

  const initialAddressDetails = {
    correspondence: createAddress('CORRESPONDENCE', true),
    permanent: createAddress('PERMANENT'),
    office: createAddress('OFFICE'),
    client_office: createAddress('CLIENT_OFFICE'),
  }

  const emptyAddress = {
    address_line1: '',
    address_line2: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
  }

  const [employeeAddress, setEmployeeAddress] = useState(initialAddressDetails)

  const [employeeQualification, setEmployeeQualification] = useState([
    {
      qualification_type: '',
      qualification_name: '',
      specialization: '',
      institute_name: '',
      board_university: '',
      year_of_passing: '',
      grade: '',
      percentage: '',
      document: null,
    },
  ])

  // Experience //

  const [experiences, setExperiences] = useState([
    {
      company_name: '',
      designation: '',
      start_date: '',
      end_date: '',
      total_years: '',
      description: '',
      document: null,
    },
  ])
  // Bank //

  const [employeeBank, setEmployeeBank] = useState({
    bank_name: '',
    branch_name: '',
    bank_address: '',
    account_number: '',
    ifsc: '',
    micr_code: '',
    cancelled_cheque: null,
  })

  // FAMILY MEMBERS STATE
  const [familyMembers, setFamilyMembers] = useState([
    {
      relation: '',
      name: '',
      dob: '',
      gender: '',
      pan_number: '',
      is_dependent: false,
    },
  ])

  // INSURANCE STATE
  const [insurance, setInsurance] = useState({
    insurance_company: '',
    policy_number: '',
    from_date: '',
    to_date: '',
    sum_insured: '',
    policy_premium: '',
    family_members_covered: '',
    policy_document: null,
  })

  // Screening Test//

  const [screening, setScreening] = useState({
    test_scheduled_date: '',
    test_given_date: '',
    marks_secured: '',
    result: '',
    screening_mail: null,
  })

  const handleLtcChange = (e) => {
    const { name, value } = e.target

    setLtcData((prev) => ({
      ...prev,
      [name]: value,
    }))
  }

  const handleFamilyChange = (index, field, value) => {
    const updated = [...familyMembers]
    updated[index][field] = value
    setFamilyMembers(updated)
  }

  const addFamilyMember = () => {
    setFamilyMembers([
      ...familyMembers,
      {
        relation: '',
        name: '',
        dob: '',
        gender: '',
        pan_number: '',
        is_dependent: false,
      },
    ])
  }

  const removeFamilyMember = (index) => {
    setFamilyMembers(familyMembers.filter((_, i) => i !== index))
  }

  const handleFileSelect = (file) => {
    if (!file) return
    setSelectedFile(file)
  }

  const handleDrop = (e) => {
    e.preventDefault()
    const file = e.dataTransfer.files[0]
    if (file) setSelectedFile(file)
  }

  const handleDragOver = (e) => {
    e.preventDefault()
  }

  const handleAddDocument = () => {
    if (!selectedDocType || !selectedFile) {
      alert('Please select document type and file.')
      return
    }

    setDocuments((prev) => [
      ...prev,
      {
        type: selectedDocType,
        file: selectedFile,
      },
    ])

    // Reset
    setSelectedFile(null)
    setSelectedDocType('')

    const input = document.getElementById('hiddenFileInput')
    if (input) input.value = ''
  }

  const handleRemoveDocument = (indexToRemove) => {
    setDocuments((prev) => prev.filter((_, index) => index !== indexToRemove))

    const input = document.getElementById('hiddenFileInput')
    if (input) input.value = ''
  }

  // LTC

  const [ltcData, setLtcData] = useState({
    hometown: '',
    district: '',
    state: '',
    nearest_railway: '',
    nearest_airport: '',
  })

  const [ltcLocked, setLtcLocked] = useState(false)

  // dynamic submit// dont change

  //   const handleSubmit = async () => {
  //     try {
  //       if (step === 0) {
  //         const response = await api.post('/employee', employeeDetails)
  //         const id = response.data?.data?.id
  //         setEmployeeId(id)
  //         toast.success('Basic info saved')
  //       } else if (step === 0) {
  //         const url = `/employee/${employeeId}/address`

  //         const addresses = [employeeAddress.correspondence, employeeAddress.permanent]

  //         for (const addr of addresses) {
  //           const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

  //           if (isEmpty) continue

  //           await api.post(url, addr)
  //         }

  //         toast.success('Addresses saved')
  //       } else if (step === 1) {
  //         const url = `/employee/${employeeId}/address`

  //         const addresses = [employeeAddress.office, employeeAddress.client_office]

  //         for (const addr of addresses) {
  //           const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

  //           if (isEmpty) continue

  //           await api.post(url, addr)
  //         }

  //         toast.success('Office Addresses saved')
  //       } else if (step === 2) {
  //         const url = `/employee/${employeeId}/qualification`

  //         // const qualification = [employeeQualification]

  //         for (const qual of employeeQualification) {
  //           const isEmpty = !qual

  //           if (isEmpty) continue

  //           await api.post(url, qual)
  //         }

  //         toast.success('qualification saved')
  //       } else if (step === 3) {
  //         if (!employeeId) {
  //           toast.error('Employee ID missing')
  //           return
  //         }

  //         const url = `/employee/${employeeId}/bankId`

  //         if (!employeeBank.bank_name || !employeeBank.account_number) {
  //           toast.error('Bank name and account number are required')
  //           return
  //         }

  //         await api.post(url, employeeBank)

  //         toast.success('Bank details saved')
  //       } else if (step === 4) {
  //         const url = `/employee/${employeeId}/insurance`

  //         await api.post(url, insurance)

  //         toast.success('Insurance details saved')
  //       } else if (step === 5) {
  //         const url = `/employee/${employeeId}/screening-test`

  //         await api.post(url, screening)

  //         toast.success('Screening test saved')
  //       } else if (step === 6) {

  //       } else if (step === 8) {

  //   const url = `/employee/${employeeId}/ltc`;

  //   await api.post(url, ltcData);

  //   setLtcLocked(true);

  //   toast.success("LTC details saved");
  // }

  //       {
  //         const url = stepConfig[step]?.url
  //         await api.post(url, employeeDetails)
  //         toast.success('Data submitted successfully')
  //       }
  //       setStep((prev) => prev + 1)
  //     } catch (error) {
  //       console.error(error)
  //       toast.error(error.response?.data?.message || 'Failed to create Employee')
  //     }
  //   }

  const handleSubmit = async () => {
    try {
      // STEP 0 - Basic Info
      if (step === 0) {
        const response = await api.post('/employee', employeeDetails)
        const id = response.data?.data?.id

        setEmployeeId(id)
        toast.success('Basic info saved')
      }

      // STEP 1 - Correspondence + Permanent Address
      else if (step === 1) {
        const url = `/employee/${employeeId}/address`

        const addresses = [employeeAddress.correspondence, employeeAddress.permanent]

        for (const addr of addresses) {
          const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

          if (isEmpty) continue

          await api.post(url, addr)
        }

        toast.success('Addresses saved')
      }

      // STEP 2 - Office + Client Office Address
      else if (step === 2) {
        const url = `/employee/${employeeId}/address`

        const addresses = [employeeAddress.office, employeeAddress.client_office]

        for (const addr of addresses) {
          const isEmpty = !addr.address && !addr.city && !addr.state && !addr.pin_code

          if (isEmpty) continue

          await api.post(url, addr)
        }

        toast.success('Office Addresses saved')
      }

      // STEP 3 - Qualification
      else if (step === 3) {
        const url = `/employee/${employeeId}/qualification`

        for (const qual of employeeQualification) {
          const isEmpty = !qual.qualification_name

          if (isEmpty) continue

          await api.post(url, qual)
        }

        toast.success('Qualification saved')
      }

      // STEP 4 - Bank
      else if (step === 4) {
        const url = `/employee/${employeeId}/bank`

        if (!employeeBank.bank_name || !employeeBank.account_number) {
          toast.error('Bank name and account number are required')
          return
        }

        await api.post(url, employeeBank)

        toast.success('Bank details saved')
      }

      // STEP 5 - Insurance
      else if (step === 5) {
        const url = `/employee/${employeeId}/insurance`

        await api.post(url, insurance)

        toast.success('Insurance details saved')
      }

      // STEP 6 - Screening
      else if (step === 6) {
        const url = `/employee/${employeeId}/screening-test`

        await api.post(url, screening)

        toast.success('Screening test saved')
      }

      // STEP 7 - Experience
      else if (step === 7) {
        const url = `/employee/${employeeId}/experience`

        for (const exp of experiences) {
          const isEmpty = !exp.company_name

          if (isEmpty) continue

          await api.post(url, exp)
        }

        toast.success('Experience saved')
      }

      // STEP 8 - LTC  ✅ (your issue fixed here)
      else if (step === 8) {
        const url = `/employee/${employeeId}/ltc`

        await api.post(url, ltcData)

        setLtcLocked(true)

        toast.success('LTC details saved')
      }
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to submit step')
    }
  }

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm" style={{ minHeight: '800px' }}>
