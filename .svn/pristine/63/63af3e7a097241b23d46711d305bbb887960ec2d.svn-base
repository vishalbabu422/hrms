import React, { useState } from 'react'
import { toast } from 'react-toastify'
import CIcon from '@coreui/icons-react'
import BasicInfo from './modules/basic-info'
import Address from './modules/address'
import OfficeAddress from './modules/office-address'
import Qualification from './modules/qualification'
import Bank from './modules/bank'
import Insurance from './modules/insurance'
import Screening from './modules/screening'
import Experience from './modules/experience'
import Ltc from './modules/ltc'

import {
  cilUser,
  cilLocationPin,
  cilEducation,
  cilBriefcase,
  cilPeople,
  cilBank,
  cilShieldAlt,
  cilClipboard,
  cilFile,
  cilBuilding,
  cilMap,
  cilChart,
} from '@coreui/icons'
