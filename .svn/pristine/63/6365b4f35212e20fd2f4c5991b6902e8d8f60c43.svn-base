import {
  CButton,
  CModal,
  CModalBody,
  CModalFooter,
  CModalHeader,
  CModalTitle,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CSpinner,
} from '@coreui/react'

import { useEffect, useMemo, useState } from 'react'
import api from '../../api/axios'

const CtcHistoryModal = ({ visible, onClose, employee, workorder }) => {
  const [historyData, setHistoryData] = useState([])
  const [loading, setLoading] = useState(false)

  const fetchHistory = async () => {
    try {
      if (!employee?.employee_id) return

      setLoading(true)

      const models = 'empSalaryStructure,EmployeeWorkOrderDeployment.WoDesgnMapping'
      const modelFilter = {
        EmployeeWorkOrderDeployment: { is_deleted: false, relieving_date: null },
        WoDesgnMapping: { work_order_id: Number(workorder) },
      }

      const url = `employee/${employee.employee_id}?models=${encodeURIComponent(
        models,
      )}&modelFilter=${encodeURIComponent(JSON.stringify(modelFilter))}`

      const response = await api.get(url)

      const salaryHistory = response?.data?.data?.empSalaryStructure || []

      const sortedHistory = [...salaryHistory].sort(
        (a, b) => new Date(b.effective_from) - new Date(a.effective_from),
      )

      setHistoryData(sortedHistory)
    } catch (error) {
      console.error(error)
      setHistoryData([])
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    if (visible) {
      fetchHistory()
    }
  }, [visible, employee])

  const currentCtc = useMemo(() => {
    if (!historyData.length) return 0

    return historyData[0]?.ctc || 0
  }, [historyData])

  const formattedHistory = useMemo(() => {
    return historyData.map((item, index) => {
      const previous = historyData[index + 1]

      const oldCtc = previous ? Number(previous.ctc) : Number(item.ctc)

      const newCtc = Number(item.ctc)

      const incrementAmount = newCtc - oldCtc

      const incrementPercentage = oldCtc > 0 ? ((incrementAmount / oldCtc) * 100).toFixed(2) : 0

      return {
        ...item,
        old_ctc: oldCtc,
        new_ctc: newCtc,
        increment_amount: incrementAmount,
        increment_percentage: incrementPercentage,
      }
    })
  }, [historyData])

  return (
    <CModal visible={visible} onClose={onClose} size="xl" alignment="center" backdrop="static">
      <CModalHeader>
        <CModalTitle>
          CTC History
          {employee?.name ? ` - ${employee.name}` : ''}
        </CModalTitle>
      </CModalHeader>

      <CModalBody>
        {/* SUMMARY CARD */}
        <div
          style={{
            background: '#f8fafc',
            border: '1px solid #e5e7eb',
            borderRadius: '12px',
            padding: '16px',
            marginBottom: '20px',
          }}
        >
          <div className="d-flex justify-content-between flex-wrap gap-3">
            <div>
              <div className="text-muted small">Employee</div>

              <div className="fw-semibold">{employee?.name || '-'}</div>
            </div>

            <div>
              <div className="text-muted small">Current CTC</div>

              <div className="fw-semibold text-primary">₹ {currentCtc}</div>
            </div>

            <div>
              <div className="text-muted small">Total Revisions</div>

              <div className="fw-semibold text-success">{historyData.length}</div>
            </div>
          </div>
        </div>

        {loading ? (
          <div className="text-center py-4">
            <CSpinner />
          </div>
        ) : (
          <CTable bordered hover responsive align="middle">
            <CTableHead color="light">
              <CTableRow>
                <CTableHeaderCell>Effective Date</CTableHeaderCell>

                <CTableHeaderCell>Previous CTC</CTableHeaderCell>

                <CTableHeaderCell>Revised CTC</CTableHeaderCell>

                <CTableHeaderCell>Increment</CTableHeaderCell>

                <CTableHeaderCell>Increment %</CTableHeaderCell>

                <CTableHeaderCell>Created At</CTableHeaderCell>
              </CTableRow>
            </CTableHead>

            <CTableBody>
              {formattedHistory.length > 0 ? (
                formattedHistory.map((item) => (
                  <CTableRow key={item.id}>
                    <CTableDataCell>{item.effective_from}</CTableDataCell>

                    <CTableDataCell>₹ {item.old_ctc}</CTableDataCell>

                    <CTableDataCell className="fw-semibold text-primary">
                      ₹ {item.new_ctc}
                    </CTableDataCell>

                    <CTableDataCell className="text-success fw-semibold">
                      +₹ {item.increment_amount}
                    </CTableDataCell>

                    <CTableDataCell>+{item.increment_percentage}%</CTableDataCell>

                    <CTableDataCell>{new Date(item.created_at).toLocaleString()}</CTableDataCell>
                  </CTableRow>
                ))
              ) : (
                <CTableRow>
                  <CTableDataCell colSpan={6} className="text-center text-muted py-4">
                    No CTC history found
                  </CTableDataCell>
                </CTableRow>
              )}
            </CTableBody>
          </CTable>
        )}
      </CModalBody>

      <CModalFooter>
        <CButton color="secondary" onClick={onClose}>
          Close
        </CButton>
      </CModalFooter>
    </CModal>
  )
}

export default CtcHistoryModal
