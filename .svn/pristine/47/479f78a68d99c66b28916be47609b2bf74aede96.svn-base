import { CCol, CFormLabel } from '@coreui/react'
import { useEffect, useState } from 'react'
import Select from 'react-select'
import api from '../../api/axios'
import './select.css'

const EmpanelmentSelect = ({
  name = 'empanelment_id_fk',
  value = '',
  onChange,
  label = 'Empanelment',
  placeholder = 'Select Empanelment',
  disabled = false,
  colSize = 12,
}) => {
  const [empanelmentList, setEmpanelmentList] = useState([])

  useEffect(() => {
    const fetchEmpanelments = async () => {
      try {
        const response = await api.get(
          '/admin/empanelment/index?is_active=true&sort=empanelment_no',
          {
            params: {
              fields: 'id,empanelment_no',
            },
          },
        )
        

        setEmpanelmentList(response?.data?.data?.EmpanelmentList || [])
      } catch (error) {
        console.error('Failed to fetch Empanelments:', error)
      }
    }

    fetchEmpanelments()
  }, [])

  const options = empanelmentList.map((item) => ({
    value: item.id,
    label: item.empanelment_no,
  }))

  return (
    <CCol md={colSize}>
      <CFormLabel>{label}</CFormLabel>

      <Select
        name={name}
        options={options}
        placeholder={placeholder}
        isSearchable
        isClearable
        isDisabled={disabled}
        classNamePrefix="react-select"
        value={
          options.find((option) => String(option.value) === String(value)) || null
        }
        onChange={(selected) =>
          onChange({
            target: {
              name,
              value: selected ? selected.value : '',
            },
          })
        }
      />
    </CCol>
  )
}

export default EmpanelmentSelect