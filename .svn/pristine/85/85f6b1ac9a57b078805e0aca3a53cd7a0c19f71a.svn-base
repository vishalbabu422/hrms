import React, { useEffect, useState } from 'react'
import {
  CCard,
  CCardBody,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CBadge,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPlus, cilDescription } from '@coreui/icons'
import { useParams } from 'react-router-dom'
import api from '../../api/axios'
import DeploymentTableModal from '../components/deployment-table-modal'
import AddEditEmployeeModal from '../components/add-edit-employee-modal'

const EmpDeployment = () => {
  const { id } = useParams()
  const [loading, setLoading] = useState(false)
  const [workOrder, setWorkOrder] = useState({})

  const fetchWorkOrderById = async () => {
    try {
      setLoading(true)

      const response = await api.get(
        `admin/workorder/${id}?models=WoDesgnMappings.Designation%2CWoDesgnMappings.EmployeeWorkOrderDeployments&modelFilter=%7B%7D`,
      )

      setWorkOrder(response.data?.data || [])
    } catch (error) {
      console.error(error)
      toast.error('Failed to fetch Work Order')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchWorkOrderById()
  }, [])

  const [selectedDesignation, setSelectedDesignation] = useState(null)
  const [deploymentId, setDeploymentId] = useState(null)

  /* modal state */

  const [addEditVisible, setAddEditVisible] = useState(false)
  const [tableVisible, setTableVisible] = useState(false)

  const [editEmployee, setEditEmployee] = useState(null)

  const openAddModal = (woDesgnId) => {
    setSelectedDesignation(woDesgnId)
    setEditEmployee(null)
    setAddEditVisible(true)
  }

  const openTableModal = (woDesgnId) => {
    setSelectedDesignation(woDesgnId)
    setTableVisible(true)
  }

  const openEditModal = (id, employee) => {
    setDeploymentId(id)
    setEditEmployee(employee)
    setAddEditVisible(true)
  }

  return (
    <>
      <h4 className="mb-4 fw-semibold">
        Employee Deployment - Work Order {workOrder.work_order_no}
      </h4>

      <CCard className="border rounded-3 shadow-sm">
        <CCardBody>
          <CTable hover responsive>
            <CTableHead style={{ background: '#f5f6f8' }}>
              <CTableRow>
                <CTableHeaderCell>Designation</CTableHeaderCell>
                <CTableHeaderCell>Total</CTableHeaderCell>
                <CTableHeaderCell>Deployed</CTableHeaderCell>
                <CTableHeaderCell>Vacant</CTableHeaderCell>
                <CTableHeaderCell>Action</CTableHeaderCell>
              </CTableRow>
            </CTableHead>

            <CTableBody>
              {workOrder?.WoDesgnMappings?.map((item) => {
                const deployed =
                  item?.EmployeeWorkOrderDeployments?.filter(
                    (d) => !d.is_deleted && !d.relieving_date
                  ).length || 0
                const vacant = item.req_person_count - deployed

                return (
                  <CTableRow key={item.id}>
                    <CTableDataCell>{item?.Designation?.designation}</CTableDataCell>

                    <CTableDataCell>
                      <CBadge color="danger">{item.req_person_count}</CBadge>
                    </CTableDataCell>

                    <CTableDataCell>
                      <CBadge color="success">{deployed}</CBadge>
                    </CTableDataCell>

                    <CTableDataCell>
                      <CBadge color={vacant > 0 ? 'danger' : 'success'}>{vacant}</CBadge>
                    </CTableDataCell>

                    <CTableDataCell>
                      {vacant > 0 && (
                        <CButton
                          size="sm"
                          variant="ghost"
                          color="primary"
                          onClick={() => openAddModal(item?.id)}
                        >
                          <CIcon icon={cilPlus} />
                        </CButton>
                      )}

                      {deployed > 0 && (
                        <CButton
                          size="sm"
                          variant="ghost"
                          color="primary"
                          className="ms-2"
                          onClick={() => openTableModal(item.id)}
                        >
                          <CIcon icon={cilDescription} />
                        </CButton>
                      )}
                    </CTableDataCell>
                  </CTableRow>
                )
              })}
            </CTableBody>
          </CTable>
        </CCardBody>
      </CCard>

      <AddEditEmployeeModal
        visible={addEditVisible}
        setVisible={setAddEditVisible}
        deployment={selectedDesignation}
        editEmployee={editEmployee}
        onSuccess={fetchWorkOrderById}
        editId={deploymentId}
      />

      <DeploymentTableModal
        visible={addEditVisible}
        tableVisible={tableVisible}
        setTableVisible={setTableVisible}
        deployment={selectedDesignation}
        onEdit={openEditModal}
        onSuccess={fetchWorkOrderById}
      />
    </>
  )
}

export default EmpDeployment
