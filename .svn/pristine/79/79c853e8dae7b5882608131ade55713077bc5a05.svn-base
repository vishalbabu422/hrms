import api from "../api/axios";

export const getExaminations = async () => {
    return await api.get(`/examinations`)
}

export const getEmployeeExaminations = async (employeeId) => {
    return await api.get(`/employee/${employeeId}/examinations`)
}

export const createEmployeeExamination = async (employeeId, payload) => {
    return await api.post(`/employee/${employeeId}/examinations`, payload)
}

export const updateEmployeeExamination = async (employeeId, id, payload) => {
    return await api.patch(`/employee/${employeeId}/examinations/${id}`, payload)
}