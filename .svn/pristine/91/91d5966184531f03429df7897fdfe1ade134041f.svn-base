const { DataTypes } = require("sequelize");
const sequelize = require("../utils/database");

const CompanyMaster = sequelize.define(
  "CompanyMaster",
  {
    id: {
      type: DataTypes.BIGINT,
      allowNull: false,
      primaryKey: true,
      autoIncrement: true,
    },

    organization_id: {
      type: DataTypes.BIGINT,
      allowNull: true,
    },

    company_name: {
      type: DataTypes.STRING(255),
      allowNull: false,
    },

    company_code: {
      type: DataTypes.STRING(50),
      unique: true,
    },

    company_type: {
      type: DataTypes.ENUM(
        "PRIVATE_LIMITED",
        "PUBLIC_LIMITED",
        "LLP",
        "PROPRIETORSHIP",
        "PARTNERSHIP",
        "GOVERNMENT",
        "NGO",
        "OTHER"
      ),
    },

    incorporation_date: {
      type: DataTypes.DATEONLY,
    },

    official_email: {
      type: DataTypes.STRING(150),
    },

    official_phone: {
      type: DataTypes.STRING(30),
    },

    website: {
      type: DataTypes.STRING(150),
    },

    address_line1: {
      type: DataTypes.TEXT,
    },

    address_line2: {
      type: DataTypes.TEXT,
    },

    city: {
      type: DataTypes.STRING(100),
    },

    state: {
      type: DataTypes.STRING(100),
    },

    country: {
      type: DataTypes.STRING(100),
      defaultValue: "India",
    },

    pincode: {
      type: DataTypes.STRING(15),
    },

    is_active: {
      type: DataTypes.BOOLEAN,
      defaultValue: true,
    },

    created_at: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },

    updated_at: {
      type: DataTypes.DATE,
      defaultValue: DataTypes.NOW,
    },
  },
  {
    schema: "pmu",
    tableName: "company_master",
    timestamps: false,
  }
);

module.exports = CompanyMaster;