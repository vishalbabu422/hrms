import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'

import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle, cilZoom } from '@coreui/icons'

import { useState } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'

const Index = () => {
  const navigate = useNavigate()

  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // Dummy Vendor Data (Updated as per DB)
  const vendors = [
    {
      id: 1,
      vendor_name: 'ABC Solutions Pvt Ltd',
      vendor_code: 'VND001',
      vendor_type: 'PRIVATE_LIMITED',
      contact_person: 'John Doe',
      contact_email: 'john@abc.com',
      contact_phone: '9876543210',
      city: 'Delhi',
      state: 'Delhi',
      is_active: true,
    },
    {
      id: 2,
      vendor_name: 'National Infra LLP',
      vendor_code: 'VND002',
      vendor_type: 'LLP',
      contact_person: 'Rahul Sharma',
      contact_email: 'rahul@infra.com',
      contact_phone: '9123456780',
      city: 'Mumbai',
      state: 'Maharashtra',
      is_active: false,
    },
  ]

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Vendor</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search Vendor..."
              />

              <CTooltip content="Add Vendor" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/vendor/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped responsive>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell label="Sno" sortKey="id" sort={sort} onSort={handleSort} />

                    <SortableHeaderCell
                      label="Vendor Name"
                      sortKey="vendor_name"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Vendor Code"
                      sortKey="vendor_code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Vendor Type"
                      sortKey="vendor_type"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Contact Person"
                      sortKey="contact_person"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Contact Email"
                      sortKey="contact_email"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Contact Phone"
                      sortKey="contact_phone"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Location"
                      sortKey="city"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell>Status</CTableHeaderCell>
                    <CTableHeaderCell>Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>

                <CTableBody>
                  {vendors.map((vendor, index) => (
                    <CTableRow key={vendor.id}>
                      <CTableHeaderCell scope="row">{index + 1}</CTableHeaderCell>

                      <CTableDataCell>{vendor.vendor_name}</CTableDataCell>
                      <CTableDataCell>{vendor.vendor_code || '-'}</CTableDataCell>
                      <CTableDataCell>{vendor.vendor_type || '-'}</CTableDataCell>
                      <CTableDataCell>{vendor.contact_person || '-'}</CTableDataCell>
                      <CTableDataCell>{vendor.contact_email || '-'}</CTableDataCell>
                      <CTableDataCell>{vendor.contact_phone || '-'}</CTableDataCell>
                      <CTableDataCell>
                        {vendor.city}, {vendor.state}
                      </CTableDataCell>

                      <CTableDataCell>
                        {vendor.is_active ? (
                          <CIcon icon={cilCheckCircle} className="text-success" />
                        ) : (
                          <CIcon icon={cilXCircle} className="text-danger" />
                        )}
                      </CTableDataCell>

                      <CTableDataCell>
                        <div className="d-flex gap-2">
                          <CTooltip content="Edit" placement="left">
                            <CButton
                              color="primary"
                              size="sm"
                              variant="ghost"
                              onClick={() => navigate(`/vendor/edit/${vendor.id}`)}
                            >
                              <CIcon icon={cilPencil} />
                            </CButton>
                          </CTooltip>

                          <CTooltip content="View" placement="left">
                            <CButton
                              color="info"
                              size="sm"
                              variant="ghost"
                              onClick={() => navigate(`/vendor/view/${vendor.id}`)}
                            >
                              <CIcon icon={cilPencil} />
                            </CButton>
                          </CTooltip>

                          <CTooltip content="Delete" placement="right">
                            <CButton color="danger" size="sm" variant="ghost">
                              <CIcon icon={cilTrash} />
                            </CButton>
                          </CTooltip>
                        </div>
                      </CTableDataCell>
                    </CTableRow>
                  ))}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <CPagination className="justify-content-end">
              <CPaginationItem disabled>&laquo;</CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem disabled>&raquo;</CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Index
