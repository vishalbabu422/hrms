import { CCol, CFormLabel } from '@coreui/react'
import { useEffect, useState } from 'react'
import Select from 'react-select'
import api from '../../api/axios'
import './select.css'

const WoDesignationSelect = ({
  name = 'designation_id',
  value = '',
  onChange,
  label = 'Designation',
  placeholder = 'Select Designation',
  disabled = false,
  colSize = 12,
}) => {
  const [desgnList, setDesgnList] = useState([])

  useEffect(() => {
    const fetchDesignation = async () => {
      try {
        const response = await api.get('/admin/designation/index', {
          params: {
            fields: 'id,designation,qualification,exp_in_years',
          },
        })

        setDesgnList(response?.data?.data?.DesignationList || [])
      } catch (error) {
        console.error('Failed to fetch Designation:', error)
      }
    }

    fetchDesignation()
  }, [])

  const options = [
    ...desgnList.map((item) => ({
      value: item.id,
      label: item.designation,
    })),
    {
      value: 0,
      label: 'Others',
    },
  ]

  return (
    <CCol md={colSize}>
      <CFormLabel>{label}</CFormLabel>

      <Select
        name={name}
        options={options}
        placeholder={placeholder}
        isSearchable
        isClearable
        isDisabled={disabled}
        classNamePrefix="react-select"
        value={
          options.find(
            (option) => String(option.value) === String(value)
          ) || null
        }
        onChange={(selected) =>
          onChange({
            target: {
              name,
              value: selected ? selected.value : '',
            },
          })
        }
      />
    </CCol>
  )
}

export default WoDesignationSelect