import React from 'react'
import Preview from './views/hrm/preview'

const Preview = ({ data, onEdit }) => {
  if (!data) return null

  const {
    basic = {},
    address = {},
    bank = {},
    insurance = {},
    qualifications = [],
    experiences = [],
    skills = [],
  } = data

  return (
    <div className="container-fluid my-4">
      <div className="card shadow-sm p-4">

        {/* ================= HEADER ================= */}
        <div className="d-flex flex-column flex-md-row justify-content-between align-items-center border-bottom pb-3 mb-4">
          <div className="d-flex align-items-center gap-3 text-center text-md-start">
            
            <div className="preview-avatar">
              {basic.profileImage ? (
                <img src={basic.profileImage} alt="Profile" />
              ) : (
                <div className="avatar-placeholder">👤</div>
              )}
            </div>

            <div>
              <h4 className="mb-1">
                {basic.firstName} {basic.lastName}
              </h4>
              <p className="mb-1 text-muted">{basic.email}</p>
              <small>{basic.contactNo}</small>
            </div>
          </div>

          <button className="btn btn-primary mt-3 mt-md-0" onClick={onEdit}>
            Edit Profile
          </button>
        </div>

        {/* ================= PERSONAL INFO ================= */}
        <div className="row g-4">

          <div className="col-md-6">
            <Section title="Personal Information">
              <Field label="Date of Birth" value={basic.dob} />
              <Field label="Gender" value={basic.gender} />
              <Field label="Blood Group" value={basic.bloodGroup} />
              <Field label="Date of Joining" value={basic.doj} />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Address">
              <Field
                label="Correspondence"
                value={`${address?.correspondence?.address || ''}, ${address?.correspondence?.city || ''}`}
              />
              <Field
                label="Permanent"
                value={`${address?.permanent?.address || ''}, ${address?.permanent?.city || ''}`}
              />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Bank Details">
              <Field label="Bank Name" value={bank.bankName} />
              <Field label="Account No" value={bank.accountNumber} />
              <Field label="IFSC" value={bank.ifsc} />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Insurance">
              <Field label="Company" value={insurance.company} />
              <Field label="Policy No" value={insurance.policyNo} />
            </Section>
          </div>

        </div>

        {/* ================= QUALIFICATION ================= */}
        {qualifications.length > 0 && (
          <div className="mt-5">
            <h6 className="section-title">Qualifications</h6>
            {qualifications.map((q, i) => (
              <div key={i} className="preview-box">
                {q.qualificationName} ({q.yearOfPassing})
              </div>
            ))}
          </div>
        )}

        {/* ================= EXPERIENCE ================= */}
        {experiences.length > 0 && (
          <div className="mt-4">
            <h6 className="section-title">Experience</h6>
            {experiences.map((e, i) => (
              <div key={i} className="preview-box">
                {e.companyName} - {e.designation}
              </div>
            ))}
          </div>
        )}

      </div>
    </div>
  )
}

/* ---------- Small Reusable Components ---------- */

const Section = ({ title, children }) => (
  <div>
    <h6 className="section-title">{title}</h6>
    {children}
  </div>
)

const Field = ({ label, value }) => (
  <div className="mb-3">
    <small className="text-muted d-block">{label}</small>
    <div className="fw-semibold">{value || '-'}</div>
  </div>
)

export default Preview
