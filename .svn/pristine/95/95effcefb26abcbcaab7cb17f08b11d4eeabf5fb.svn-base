import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'

import { useEffect, useState } from 'react'
import api from '../../api/axios'

const EmpanelmentFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)
  const [orgList, setOrgList] = useState([])

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  if (!formData) return null

  useEffect(() => {
    const fetchOrg = async () => {
      const params = {
        fields: 'id,org_name',
      }

      try {
        const response = await api.get('/admin/organization/index', { params })
        setOrgList(response.data.data.organizationList)
      } catch (error) {
        console.error('Failed to fetch Organisation:', error)
      }
    }

    fetchOrg()
  }, [])

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={6}>
                <CFormLabel>Organisation</CFormLabel>
                <CFormSelect
                  name="organization_id"
                  value={String(formData.organization_id || '')}
                  onChange={handleChange}
                >
                  <option value="">Select Organisation</option>
                  {orgList.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.org_name}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>
              <CCol md={6}>
                <CFormLabel>Category</CFormLabel>
                <CFormInput
                  name="category"
                  placeholder="Enter category"
                  value={formData.category || ''}
                  onChange={handleChange}
                  maxLength={20}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Empanelment No</CFormLabel>
                <CFormInput
                  name="empanelment_no"
                  placeholder="Enter empanelment no"
                  value={formData.empanelment_no || ''}
                  maxLength={50}
                  onChange={handleChange}
                  disabled={mode === 'edit'}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="date"
                  value={formData.date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Short Code</CFormLabel>
                <CFormInput
                  name="shortcode"
                  value={formData.shortcode || ''}
                  onChange={handleChange}
                  placeholder="Enter Short Code"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>RFE</CFormLabel>
                <CFormInput
                  name="rfe"
                  value={formData.rfe || ''}
                  placeholder="Enter RFE"
                  onChange={handleChange}
                  maxLength={255}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Leaves (Per Month)</CFormLabel>
                <CFormInput
                  type="number"
                  name="leaves_per_month"
                  value={formData.leaves_per_month || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={3}>
                <CFormLabel>Leave Category</CFormLabel>
                <CFormSelect
                  name="leave_category"
                  value={String(formData.leave_category)}
                  onChange={handleChange}
                >
                  <option value="calendar_mon">Calendar Month</option>
                  <option value="calendar_yr">Calendar Year</option>
                  <option value="fin_yr">Financial Year</option>
                  <option value="wo_to_wo">Work Order Based</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Carry Forward</CFormLabel>
                <CFormSelect
                  name="carry_forward"
                  value={String(formData.carry_forward)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel>Maternity</CFormLabel>
                <CFormSelect
                  name="maternity_leaves"
                  value={String(formData.maternity_leaves)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel>Effective From</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Effective To</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_to"
                  value={formData.effective_to || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel>Remarks</CFormLabel>
                <CFormTextarea
                  name="remarks"
                  value={formData.remarks || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormInput
                  type="file"
                  name="doc_path"
                  label="Upload Empanelment"
                  onChange={(e) => {
                    const file = e.target.files[0]
                    setFormData({
                      ...formData,
                      doc_file: file,
                    })
                  }}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default EmpanelmentFormComponent
