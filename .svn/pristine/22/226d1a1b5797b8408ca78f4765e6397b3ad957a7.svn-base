// export default OfficeAddress

import React, { useEffect } from 'react'
import api from '../../../api/axios'

const OfficeAddress = ({ employeeId, employeeAddress, setEmployeeAddress }) => {

  const emptyAddress = (type) => ({
    address_type: type,
    address_line1: '',
    landmark: '',
    city: '',
    district: '',
    state: '',
    country: 'India',
    pin_code: '',
    is_primary: false,
  })

  // ================= FETCH ADDRESS =================
  useEffect(() => {
    if (!employeeId) return   // ✅ prevent null API call

    const fetchAddress = async () => {
      try {
        const response = await api.get(`/employee/${employeeId}/address`)

        const data = response.data?.data || response.data   // ✅ FIXED

        setEmployeeAddress((prev) => ({
          ...prev,
          office: data?.office_address || emptyAddress('OFFICE'),
          client_office: data?.client_address || emptyAddress('CLIENT_OFFICE'),
        }))
      } catch (error) {
        console.error('Error fetching address', error)
      }
    }

    fetchAddress()
  }, [employeeId])

  // ================= HANDLE OFFICE =================
  const handleOfficeChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      office: {
        ...prev?.office,   // ✅ safe
        [name]: value,
      },
    }))
  }

  // ================= HANDLE CLIENT =================
  const handleClientChange = (e) => {
    const { name, value } = e.target

    setEmployeeAddress((prev) => ({
      ...prev,
      client_office: {
        ...prev?.client_office,   // ✅ safe
        [name]: value,
      },
    }))
  }

  const addressFields = ['landmark', 'city', 'district', 'state', 'country', 'pin_code']

  return (
    <>
      {/* ================= OFFICE ADDRESS ================= */}
      <div className="card mb-4 shadow-sm">
        <div className="card-header bg-light fw-semibold">
          Office Address
        </div>

        <div className="card-body">
          <div className="row g-3">

            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.office?.address_line1 || ''}   // ✅ FIXED
                onChange={handleOfficeChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.office?.[field] || ''}   // ✅ FIXED
                  onChange={handleOfficeChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}

          </div>
        </div>
      </div>

      {/* ================= CLIENT ADDRESS ================= */}
      <div className="card shadow-sm">
        <div className="card-header bg-light fw-semibold">
          Client Address
        </div>

        <div className="card-body">
          <div className="row g-3">

            <div className="col-md-12">
              <textarea
                className="form-control"
                rows="3"
                name="address_line1"
                value={employeeAddress?.client_office?.address_line1 || ''}   // ✅ FIXED
                onChange={handleClientChange}
                placeholder="Enter address"
              />
            </div>

            {addressFields.map((field) => (
              <div className="col-md-3" key={field}>
                <input
                  className="form-control"
                  name={field}
                  value={employeeAddress?.client_office?.[field] || ''}   // ✅ FIXED
                  onChange={handleClientChange}
                  placeholder={`Enter ${field.replace('_', ' ')}`}
                />
              </div>
            ))}

          </div>
        </div>
      </div>
    </>
  )
}

export default OfficeAddress