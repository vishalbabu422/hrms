import React, { useState } from 'react'
import CIcon from '@coreui/icons-react'
import { cilEducation, cilBriefcase, cilPeople, cilStar, cilMedicalCross ,cilHospital , cilClipboard ,cilPuzzle   } from '@coreui/icons'

const Add = () => {
  const [step, setStep] = useState(0)

  const [qualifications, setQualifications] = useState([
    {
      qualificationType: '',
      qualificationName: '',
      specialization: '',
      instituteName: '',
      boardUniversity: '',
      yearOfPassing: '',
      grade: '',
      percentage: '',
    },
  ])

  const [experiences, setExperiences] = useState([
    {
      companyName: '',
      designation: '',
      startDate: '',
      endDate: '',
      totalExperience: '',
    },
  ])

  const [skills, setSkills] = useState([
    {
      skillName: '',
      experienceYears: '',
      remarks: '',
    },
  ])

  const [health, setHealth] = useState({
    heightCm: '',
    weightKg: '',
    hasHealthIssues: false,
    isHandicapped: false,
    physicalDisabilityCategory: '',
    healthIssueRemarks: '',
    identificationMark: '',
  })

  const [vaccinations, setVaccinations] = useState([
    {
      vaccinationName: '',
      vaccinationDate: '',
      vaccinationDocument: null,
    },
  ])

const [vehicles, setVehicles] = useState([
  {
    vehicleDetails: '',
    drivingLicenseNumber: '',
    drivingLicenseIssueDate: '',
    drivingLicenseExpiryDate: '',
    vehicleCategory: '',
    professionalMembershipDetails: '',
    emtRegistrationExpiryDate: '',
  },
])


const handleVehicleChange = (index, field, value) => {
  const updated = [...vehicles]
  updated[index][field] = value
  setVehicles(updated)
}

const addVehicle = () => {
  setVehicles([
    ...vehicles,
    {
      vehicleDetails: '',
      drivingLicenseNumber: '',
      drivingLicenseIssueDate: '',
      drivingLicenseExpiryDate: '',
      vehicleCategory: '',
      professionalMembershipDetails: '',
      emtRegistrationExpiryDate: '',
    },
  ])
}

const [hobbies, setHobbies] = useState([
  {
    hobby: '',
    remarks: '',
    status: '',
  },
])

const handleHobbyChange = (index, field, value) => {
  const updated = [...hobbies]
  updated[index][field] = value
  setHobbies(updated)
}

const addHobby = () => {
  setHobbies([
    ...hobbies,
    {
      hobby: '',
      remarks: '',
      status: '',
    },
  ])
}

const removeHobby = (index) => {
  setHobbies(hobbies.filter((_, i) => i !== index))
}




const removeVehicle = (index) => {
  setVehicles(vehicles.filter((_, i) => i !== index))
}

  const handleVaccinationChange = (index, field, value) => {
    const arr = [...vaccinations]
    arr[index][field] = value
    setVaccinations(arr)
  }

  const handleVaccinationFile = (index, file) => {
    const arr = [...vaccinations]
    arr[index].vaccinationDocument = file
    setVaccinations(arr)
  }

  const handleHealthChange = (e) => {
    const { name, value, type, checked } = e.target

    setHealth({
      ...health,
      [name]: type === 'checkbox' ? checked : value,
    })
  }

  const stepConfig = [
    { label: 'Qualification', icon: cilEducation },
    { label: 'Experience', icon: cilBriefcase },
    { label: 'Family Members', icon: cilPeople },
    { label: 'Family Members', icon: cilStar },
    { label: 'Health', icon: cilMedicalCross },
    { label: 'Vaccination', icon: cilHospital },
    { label: 'Vehicle & License', icon: cilClipboard },
    { label: 'Hobbies', icon: cilPuzzle },

  ]

  return (
    <div className="container my-4">
      <div className="card p-4 shadow-sm">
        {/* 🔹 STEPPER */}
        <div className="stepper-underline mb-4">
          {stepConfig.map((item, index) => (
            <div
              key={index}
              className={`stepper-item ${step === index ? 'active' : ''}`}
              onClick={() => setStep(index)}
            >
              <CIcon icon={item.icon} />
              <span>{item.label}</span>
            </div>
          ))}
        </div>

        {/* ================= STEP 0 : QUALIFICATION ================= */}
        {step === 0 && (
          <div className="step-content">
            {qualifications.map((q, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  <div className="col-md-6">
                    <label className="form-label">Qualification Type</label>
                    <select
                      className="form-select"
                      value={q.qualificationType}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].qualificationType = e.target.value
                        setQualifications(arr)
                      }}
                    >
                      <option value="">Select</option>
                      <option>Degree</option>
                      <option>Certification</option>
                      <option>Diploma</option>
                      <option>Training</option>
                    </select>
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Qualification Name</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.qualificationName}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].qualificationName = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Specialization</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.specialization}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].specialization = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Institute Name</label>
                    <input
                      type="text"
                      className="form-control"
                      name="institute_name"
                      value={q.instituteName}
                      maxLength={200}
                      placeholder="Enter institute name"
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].instituteName = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Board / University</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.boardUniversity}
                      maxLength={200}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].boardUniversity = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Year of Passing</label>
                    <input
                      type="number"
                      className="form-control"
                      value={q.yearOfPassing}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].yearOfPassing = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Grade</label>
                    <input
                      type="text"
                      className="form-control"
                      value={q.grade}
                      maxLength={50}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].grade = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Percentage (%)</label>
                    <input
                      type="number"
                      className="form-control"
                      value={q.percentage}
                      onChange={(e) => {
                        const arr = [...qualifications]
                        arr[index].percentage = e.target.value
                        setQualifications(arr)
                      }}
                    />
                  </div>
                </div>

                {/* REMOVE */}
                {qualifications.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() =>
                        setQualifications(qualifications.filter((_, i) => i !== index))
                      }
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD MORE */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setQualifications([
                  ...qualifications,
                  {
                    qualificationType: '',
                    qualificationName: '',
                    specialization: '',
                    instituteName: '',
                    boardUniversity: '',
                    yearOfPassing: '',
                    grade: '',
                    percentage: '',
                  },
                ])
              }
            >
              + Add Qualification
            </button>
          </div>
        )}

        {/* ================= STEP 1 : EXPERIENCE ================= */}

        {step === 1 && (
          <div className="step-content">
            {experiences.map((exp, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3 mt-2">
                  <div className="col-md-6">
                    <label className="form-label">Company Name</label>
                    <input
                      type="text"
                      className="form-control"
                      placeholder="Enter Company Name"
                      maxLength={200}
                      value={exp.companyName}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].companyName = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Designation</label>
                    <input
                      type="text"
                      className="form-control"
                      placeholder="Enter Designation"
                      maxLength={150}
                      value={exp.designation}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].designation = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">Start Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={exp.startDate}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].startDate = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-6">
                    <label className="form-label">End Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={exp.endDate}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].endDate = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>

                  <div className="col-md-12">
                    <label className="form-label">Total Experience (Years)</label>
                    <input
                      type="number"
                      className="form-control"
                      min={0}
                      step="0.1"
                      value={exp.totalExperience}
                      onChange={(e) => {
                        const arr = [...experiences]
                        arr[index].totalExperience = e.target.value
                        setExperiences(arr)
                      }}
                    />
                  </div>
                </div>

                {/* REMOVE BUTTON */}
                {experiences.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => setExperiences(experiences.filter((_, i) => i !== index))}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD EXPERIENCE BUTTON */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setExperiences([
                  ...experiences,
                  {
                    companyName: '',
                    designation: '',
                    startDate: '',
                    endDate: '',
                    totalExperience: '',
                  },
                ])
              }
            >
              + Add Experience
            </button>
          </div>
        )}

        {/* ================= STEP 2 : FAMILY ================= */}
        {step === 2 && (
          <div className="step-content">
            <div className="row g-3 mt-2">
              <div className="col-md-6">
                <label className="form-label">Marital Status</label>
                <select className="form-select" name="marital_status" required>
                  <option value="">Select</option>
                  <option value="SINGLE">Single</option>
                  <option value="MARRIED">Married</option>
                  <option value="DIVORCED">Divorced</option>
                  <option value="WIDOWED">Widowed</option>
                  <option value="SEPARATED">Separated</option>
                </select>
              </div>
              <div className="col-md-6">
                <label className="form-label">Relation</label>
                <select className="form-select">
                  <option value="">Select </option>
                  <option>Spouse</option>
                  <option>Child</option>
                  <option>Father</option>
                  <option>Mother</option>
                  <option>Sibling</option>
                </select>
              </div>
              <div className="col-md-6">
                <label className="form-label">Name</label>
                <input type="text" className="form-control" maxLength={150} />
              </div>

              <div className="col-md-6">
                <label className="form-label">Date of Birth</label>
                <input
                  type="date"
                  className="form-control"
                  max={new Date().toISOString().split('T')[0]}
                />
              </div>

              <div className="col-md-6">
                <label className="form-label">Gender</label>
                <select className="form-select">
                  <option value="">Select </option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                </select>
              </div>

              <div className="col-md-6">
                <label className="form-label">Pan No</label>
                <input type="text" className="form-control" maxLength={20} />
              </div>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="step-content">
            {skills.map((s, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Skill Name */}
                  <div className="col-md-4">
                    <label className="form-label">Skill Name</label>
                    <input
                      type="text"
                      className="form-control"
                      value={s.skillName}
                      maxLength={100}
                      placeholder="Enter skill (e.g. React, Java, Excel)"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].skillName = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>

                  {/* Experience */}
                  <div className="col-md-4">
                    <label className="form-label">Experience (Years)</label>
                    <input
                      type="number"
                      className="form-control"
                      value={s.experienceYears}
                      min="0"
                      step="0.1"
                      placeholder="e.g. 2.5"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].experienceYears = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>

                  {/* Remarks */}
                  <div className="col-md-4">
                    <label className="form-label">Remarks</label>
                    <input
                      type="text"
                      className="form-control"
                      value={s.remarks}
                      maxLength={255}
                      placeholder="Optional remarks"
                      onChange={(e) => {
                        const arr = [...skills]
                        arr[index].remarks = e.target.value
                        setSkills(arr)
                      }}
                    />
                  </div>
                </div>

                {/* REMOVE BUTTON */}
                {skills.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => setSkills(skills.filter((_, i) => i !== index))}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* ADD SKILL BUTTON */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setSkills([
                  ...skills,
                  {
                    skillName: '',
                    experienceYears: '',
                    remarks: '',
                  },
                ])
              }
            >
              + Add Skill
            </button>
          </div>
        )}

        {step === 4 && (
          <div className="step-content">
            <div className="card shadow-sm">
              <div className="card-body">
                <div className="row g-3">
                  {/* Height */}
                  <div className="col-md-6">
                    <label className="form-label">Height (cm)</label>
                    <input
                      type="number"
                      className="form-control"
                      name="heightCm"
                      value={health.heightCm}
                      step="0.01"
                      min="0"
                      placeholder="e.g. 172.50"
                      onChange={handleHealthChange}
                    />
                  </div>

                  {/* Weight */}
                  <div className="col-md-6">
                    <label className="form-label">Weight (kg)</label>
                    <input
                      type="number"
                      className="form-control"
                      name="weightKg"
                      value={health.weightKg}
                      step="0.01"
                      min="0"
                      placeholder="e.g. 68.25"
                      onChange={handleHealthChange}
                    />
                  </div>

                  {/* Has Health Issues */}
                  <div className="col-md-6 d-flex align-items-center">
                    <div className="form-check mt-3">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        name="hasHealthIssues"
                        checked={health.hasHealthIssues}
                        onChange={handleHealthChange}
                      />
                      <label className="form-check-label">Has Health Issues</label>
                    </div>
                  </div>

                  {/* Is Handicapped */}
                  <div className="col-md-6 d-flex align-items-center">
                    <div className="form-check mt-3">
                      <input
                        type="checkbox"
                        className="form-check-input"
                        name="isHandicapped"
                        checked={health.isHandicapped}
                        onChange={handleHealthChange}
                      />
                      <label className="form-check-label">Is Physically Handicapped</label>
                    </div>
                  </div>

                  {/* Disability Category (Conditional) */}
                  {health.isHandicapped && (
                    <div className="col-md-6">
                      <label className="form-label">Disability Category</label>
                      <input
                        type="text"
                        className="form-control"
                        name="physicalDisabilityCategory"
                        value={health.physicalDisabilityCategory}
                        maxLength={100}
                        placeholder="Enter disability category"
                        onChange={handleHealthChange}
                      />
                    </div>
                  )}

                  {/* Health Remarks (Conditional) */}
                  {health.hasHealthIssues && (
                    <div className="col-md-12">
                      <label className="form-label">Health Issue Remarks</label>
                      <textarea
                        className="form-control"
                        name="healthIssueRemarks"
                        value={health.healthIssueRemarks}
                        rows="3"
                        placeholder="Describe health issues"
                        onChange={handleHealthChange}
                      />
                    </div>
                  )}

                  {/* Identification Mark */}
                  <div className="col-md-12">
                    <label className="form-label">Identification Mark</label>
                    <textarea
                      className="form-control"
                      name="identificationMark"
                      value={health.identificationMark}
                      rows="2"
                      placeholder="e.g. Mole on left cheek"
                      onChange={handleHealthChange}
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {step === 5 && (
          <div className="step-content">
            {vaccinations.map((v, index) => (
              <div key={index} className="border rounded p-3 mb-3">
                <div className="row g-3">
                  {/* Vaccination Name */}
                  <div className="col-md-4">
                    <label className="form-label">Vaccination Name</label>
                    <input
                      type="text"
                      className="form-control"
                      value={v.vaccinationName}
                      maxLength={100}
                      placeholder="e.g. COVID-19, Hepatitis B"
                      onChange={(e) =>
                        handleVaccinationChange(index, 'vaccinationName', e.target.value)
                      }
                    />
                  </div>

                  {/* Vaccination Date */}
                  <div className="col-md-4">
                    <label className="form-label">Vaccination Date</label>
                    <input
                      type="date"
                      className="form-control"
                      value={v.vaccinationDate}
                      onChange={(e) =>
                        handleVaccinationChange(index, 'vaccinationDate', e.target.value)
                      }
                    />
                  </div>

                  {/* Document Upload */}
                  <div className="col-md-4">
                    <label className="form-label">Upload Document</label>
                    <input
                      type="file"
                      className="form-control"
                      accept=".pdf,.jpg,.jpeg,.png"
                      onChange={(e) => handleVaccinationFile(index, e.target.files[0])}
                    />
                    {v.vaccinationDocument && (
                      <small className="text-success">{v.vaccinationDocument.name}</small>
                    )}
                  </div>
                </div>

                {/* Remove Button */}
                {vaccinations.length > 1 && (
                  <div className="text-end mt-2">
                    <button
                      type="button"
                      className="btn btn-outline-danger btn-sm"
                      onClick={() => setVaccinations(vaccinations.filter((_, i) => i !== index))}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
            ))}

            {/* Add More */}
            <button
              type="button"
              className="btn btn-outline-primary"
              onClick={() =>
                setVaccinations([
                  ...vaccinations,
                  {
                    vaccinationName: '',
                    vaccinationDate: '',
                    vaccinationDocument: null,
                  },
                ])
              }
            >
              + Add Vaccination
            </button>
          </div>
        )}






{step === 6 && (
  <div className="step-content">

    {vehicles.map((v, index) => (
      <div key={index} className="border rounded p-3 mb-3">
        <div className="row g-3">

          {/* Vehicle Details */}
          <div className="col-md-6">
            <label className="form-label">Vehicle Details</label>
            <textarea
              className="form-control"
              rows="2"
              value={v.vehicleDetails}
              placeholder="e.g. Honda City - DL01AB1234"
              onChange={(e) =>
                handleVehicleChange(index, 'vehicleDetails', e.target.value)
              }
            />
          </div>

          {/* Vehicle Category */}
          <div className="col-md-6">
            <label className="form-label">Vehicle Category</label>
            <select
              className="form-select"
              value={v.vehicleCategory}
              onChange={(e) =>
                handleVehicleChange(index, 'vehicleCategory', e.target.value)
              }
            >
              <option value="">Select</option>
              <option value="LMV">LMV</option>
              <option value="HMV">HMV</option>
              <option value="MCWG">MCWG</option>
              <option value="MCWOG">MCWOG</option>
            </select>
          </div>

          {/* Driving License Number */}
          <div className="col-md-6">
            <label className="form-label">Driving License Number</label>
            <input
              type="text"
              className="form-control"
              maxLength={30}
              value={v.drivingLicenseNumber}
              onChange={(e) =>
                handleVehicleChange(index, 'drivingLicenseNumber', e.target.value)
              }
            />
          </div>

          {/* License Issue Date */}
          <div className="col-md-3">
            <label className="form-label">License Issue Date</label>
            <input
              type="date"
              className="form-control"
              value={v.drivingLicenseIssueDate}
              max={new Date().toISOString().split('T')[0]}
              onChange={(e) =>
                handleVehicleChange(index, 'drivingLicenseIssueDate', e.target.value)
              }
            />
          </div>

          {/* License Expiry Date */}
          <div className="col-md-3">
            <label className="form-label">License Expiry Date</label>
            <input
              type="date"
              className="form-control"
              value={v.drivingLicenseExpiryDate}
              onChange={(e) =>
                handleVehicleChange(index, 'drivingLicenseExpiryDate', e.target.value)
              }
            />
          </div>

          {/* Professional Membership */}
          <div className="col-md-6">
            <label className="form-label">Professional Membership Details</label>
            <textarea
              className="form-control"
              rows="2"
              value={v.professionalMembershipDetails}
              onChange={(e) =>
                handleVehicleChange(index, 'professionalMembershipDetails', e.target.value)
              }
            />
          </div>

          {/* EMT Registration Expiry */}
          <div className="col-md-6">
            <label className="form-label">EMT Registration Expiry Date</label>
            <input
              type="date"
              className="form-control"
              value={v.emtRegistrationExpiryDate}
              onChange={(e) =>
                handleVehicleChange(index, 'emtRegistrationExpiryDate', e.target.value)
              }
            />
          </div>

        </div>

        {/* Remove Button */}
        {vehicles.length > 1 && (
          <div className="text-end mt-2">
            <button
              type="button"
              className="btn btn-outline-danger btn-sm"
              onClick={() => removeVehicle(index)}
            >
              Remove
            </button>
          </div>
        )}
      </div>
    ))}

    <button
      type="button"
      className="btn btn-outline-primary"
      onClick={addVehicle}
    >
      + Add Vehicle
    </button>

  </div>
)}


{step === 7 && (
  <div className="step-content">

    {hobbies.map((h, index) => (
      <div key={index} className="border rounded p-3 mb-3">
        <div className="row g-3">

          {/* Hobby Name */}
          <div className="col-md-4">
            <label className="form-label">Hobby</label>
            <input
              type="text"
              className="form-control"
              maxLength={100}
              value={h.hobby}
              placeholder="e.g. Reading, Cricket, Music"
              onChange={(e) =>
                handleHobbyChange(index, 'hobby', e.target.value)
              }
            />
          </div>

          {/* Status */}
          <div className="col-md-4">
            <label className="form-label">Status</label>
            <select
              className="form-select"
              value={h.status}
              onChange={(e) =>
                handleHobbyChange(index, 'status', e.target.value)
              }
            >
              <option value="">Select</option>
              <option value="ACTIVE">Active</option>
              <option value="INACTIVE">Inactive</option>
              <option value="PROFESSIONAL">Professional</option>
              <option value="AMATEUR">Amateur</option>
            </select>
          </div>

          {/* Remarks */}
          <div className="col-md-4">
            <label className="form-label">Remarks</label>
            <input
              type="text"
              className="form-control"
              value={h.remarks}
              placeholder="Optional remarks"
              onChange={(e) =>
                handleHobbyChange(index, 'remarks', e.target.value)
              }
            />
          </div>

        </div>

        {/* Remove Button */}
        {hobbies.length > 1 && (
          <div className="text-end mt-2">
            <button
              type="button"
              className="btn btn-outline-danger btn-sm"
              onClick={() => removeHobby(index)}
            >
              Remove
            </button>
          </div>
        )}
      </div>
    ))}

    <button
      type="button"
      className="btn btn-outline-primary"
      onClick={addHobby}
    >
      + Add Hobby
    </button>

  </div>
)}







        {/* 🔹 FOOTER */}
        <div className="d-flex justify-content-end gap-2 mt-4">
          <button
            className="btn btn-outline-secondary"
            disabled={step === 0}
            onClick={() => setStep(step - 1)}
          >
            Previous
          </button>

          <button
            className="btn btn-primary"
            disabled={step === stepConfig.length - 1}
            onClick={() => setStep(step + 1)}
          >
            {step === stepConfig.length - 1 ? 'Submit' : 'Next'}
          </button>
        </div>
      </div>
    </div>
  )
}

export default Add
