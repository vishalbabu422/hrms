export const validateEmpSalaryStructure = (data) => {
  const errors = {}

  if (!data || Object.keys(data).length === 0) {
    return { general: 'Please select at least one employee' }
  }

  Object.entries(data).forEach(([id, value]) => {
    if (!value?.checked) return

    const rowErrors = {}

    // ✅ CTC validation
    if (!value.value && value.value !== 0) {
      rowErrors.ctc = 'CTC is required'
    } else if (isNaN(value.value) || Number(value.value) <= 0) {
      rowErrors.ctc = 'CTC must be a valid positive number'
    }

    // ✅ Date validation
    if (!value.effective_from) {
      rowErrors.effective_from = 'Effective date is required'
    }

    if (Object.keys(rowErrors).length > 0) {
      errors[id] = rowErrors
    }
  })

  return errors
}
