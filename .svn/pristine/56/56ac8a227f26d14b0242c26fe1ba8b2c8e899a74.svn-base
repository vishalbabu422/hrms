export const validateQualifications = (data) => {
  const errors = [];

  data.forEach((q, index) => {
    const err = {};

    // ✅ REQUIRED
    if (!q.qualification_name || q.qualification_name.trim() === "") {
      err.qualification_name = "Qualification name is required";
    }

    // ✅ VARCHAR LIMITS
    if (q.qualification_type && q.qualification_type.length > 50) {
      err.qualification_type = "Max 50 characters allowed";
    }

    if (q.qualification_name && q.qualification_name.length > 200) {
      err.qualification_name = "Max 200 characters allowed";
    }

    if (q.specialization && q.specialization.length > 150) {
      err.specialization = "Max 150 characters allowed";
    }

    if (q.institute_name && q.institute_name.length > 200) {
      err.institute_name = "Max 200 characters allowed";
    }

    if (q.board_university && q.board_university.length > 200) {
      err.board_university = "Max 200 characters allowed";
    }

    if (q.grade && q.grade.length > 50) {
      err.grade = "Max 50 characters allowed";
    }

    // ✅ YEAR VALIDATION
    if (q.year_of_passing) {
      const year = Number(q.year_of_passing);
      const currentYear = new Date().getFullYear();

      if (isNaN(year) || year < 1950 || year > currentYear) {
        err.year_of_passing = "Enter valid year";
      }
    }

    // ✅ PERCENTAGE
    if (q.percentage) {
      const per = Number(q.percentage);

      if (isNaN(per) || per < 0 || per > 100) {
        err.percentage = "Enter valid percentage (0–100)";
      }
    }

    errors[index] = err;
  });

  return errors;
};