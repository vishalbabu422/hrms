import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

const Add = () => {
  return (
    <CForm>
      <CRow>
        {/* ================= CARD 1 : RESOURCE RATE ================= */}
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={12}>
                <CFormLabel htmlFor="designation">Designation</CFormLabel>
                <CFormSelect id="designation" name="designation">
                  <option value="">Select</option>
                  <option value="BCA">BCA</option>
                  <option value="MCA">MCA</option>
                  <option value="BTech">B.Tech</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="unitRateExcl">Unit Rate (Excluding A.M)</CFormLabel>
                <CFormInput
                  type="text"
                  id="unitRateExcl"
                  name="unit_rate_excl"
                  inputMode="numeric"
                  maxLength={15}
                  onInput={(e) => (e.target.value = e.target.value.replace(/\D/g, ''))}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="unitRateIncl">Unit Rate (Including A.M)</CFormLabel>
                <CFormInput
                  type="text"
                  id="unitRateIncl"
                  name="unit_rate_incl"
                  inputMode="numeric"
                  maxLength={15}
                  onInput={(e) => (e.target.value = e.target.value.replace(/\D/g, ''))}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="agencyAmount">Agency Amount</CFormLabel>
                <CFormInput
                  type="text"
                  id="agencyAmount"
                  name="agency_amount"
                  inputMode="decimal"
                  maxLength={15}
                  onInput={(e) =>
                    (e.target.value = e.target.value
                      .replace(/[^0-9.]/g, '')
                      .replace(/(\..*)\./g, '$1'))
                  }
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="nicsiMargin">NICSI Margin (%)</CFormLabel>
                <CFormInput
                  type="text"
                  id="nicsiMargin"
                  name="nicsi_margin"
                  inputMode="decimal"
                  maxLength={6}
                  onInput={(e) =>
                    (e.target.value = e.target.value
                      .replace(/[^0-9.]/g, '')
                      .replace(/(\..*)\./g, '$1'))
                  }
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="nicsiMarginAmount">NICSI Margin Amount</CFormLabel>
                <CFormInput
                  type="text"
                  id="nicsiMarginAmount"
                  name="nicsi_margin_amount"
                  inputMode="decimal"
                  maxLength={15}
                  onInput={(e) =>
                    (e.target.value = e.target.value
                      .replace(/[^0-9.]/g, '')
                      .replace(/(\..*)\./g, '$1'))
                  }
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="totalAmount">Total Amount</CFormLabel>
                <CFormInput
                  type="text"
                  id="totalAmount"
                  name="total_amount"
                  placeholder="0.00"
                  defaultValue="0.00"
                  inputMode="decimal"
                  maxLength={15}
                  onInput={(e) =>
                    (e.target.value = e.target.value
                      .replace(/[^0-9.]/g, '')
                      .replace(/(\..*)\./g, '$1'))
                  }
                />
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>

        {/* ================= CARD 2 : GST DETAILS ================= */}
        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={3}>
                <CFormLabel htmlFor="hsncode">HSN Code</CFormLabel>
                <CFormSelect id="hsncode" name="hsncode">
                  <option value="">Select</option>
                  <option value="9818989">9818989</option>
                  <option value="2558524">2558524</option>
                </CFormSelect>
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="cgstRate">CGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="cgstRate" name="cgst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="sgstRate">SGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="sgstRate" name="sgst_rate" placeholder="0.00" />
              </CCol>

              <CCol md={3}>
                <CFormLabel htmlFor="igstRate">IGST Rate (%)</CFormLabel>
                <CFormInput type="number" id="igstRate" name="igst_rate" placeholder="0.00" />
              </CCol>
            </CCardBody>
          </CCard>
        </CCol>

        {/* ================= CARD 3 : STATUS & SUBMIT ================= */}

        <CCol xs={12}>
          <CCard className="mb-4">
            <CCardBody className="row g-3">
              <CCol md={12}>
                <CFormLabel htmlFor="finalAmount">Final Amount</CFormLabel>
                <CFormInput
                  type="text"
                  id="finalAmount"
                  name="final_amount"
                  inputMode="decimal"
                  maxLength={15}
                  onInput={(e) =>
                    (e.target.value = e.target.value
                      .replace(/[^0-9.]/g, '')
                      .replace(/(\..*)\./g, '$1'))
                  }
                />
              </CCol>
              <CCol xs={12} className="text-end">
                <CButton color="primary" type="submit">
                  Submit
                </CButton>
              </CCol>
            </CCardBody>
          </CCard>
