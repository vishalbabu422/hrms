import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus } from '@coreui/icons'
import { useState, useRef } from 'react'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desv',
  })

  const [search, setSearch] = useState('')

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Work Orders</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search work orders..."
              />
              <CTooltip content="Add Work Order" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/work-order/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <CTable striped hover>
              <CTableHead>
                <CTableRow>
                  <SortableHeaderCell label="Sno" sortKey="id" sort={sort} onSort={handleSort} />
                  <SortableHeaderCell
                    label="Work Order No"
                    sortKey="work_order_no"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} />

                  <SortableHeaderCell
                    label="Project No"
                    sortKey="project_no"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="PI No"
                    sortKey="pi_no"
                    sort={sort}
                    onSort={handleSort}
                  />

                  <SortableHeaderCell
                    label="Project Name"
                    sortKey="project_name"
                    sort={sort}
                    onSort={handleSort}
                  />
                  <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                </CTableRow>
              </CTableHead>
              <CTableBody>
                <CTableRow>
                  <CTableHeaderCell scope="row">1</CTableHeaderCell>
                  <CTableDataCell>M2508011</CTableDataCell>
                  <CTableDataCell>17-NOV-2025</CTableDataCell>
                  <CTableDataCell>I190256EOND</CTableDataCell>
                  <CTableDataCell>IA12356EOND</CTableDataCell>
                  <CTableDataCell>Internal Central Pool For E office</CTableDataCell>
                  <CTableDataCell>
                    <div className="d-flex gap-2">
                      <CTooltip content="Edit" placement="left">
                        <CButton color="primary" size="sm" variant="ghost">
                          <CIcon icon={cilPencil} />
                        </CButton>
                      </CTooltip>
                      <CTooltip content="Delete" placement="right">
                        <CButton color="danger" size="sm" variant="ghost">
                          <CIcon icon={cilTrash} />
                        </CButton>
                      </CTooltip>
                    </div>
                  </CTableDataCell>
                </CTableRow>
              </CTableBody>
            </CTable>
            <CPagination className="justify-content-end" aria-label="Page navigation example">
              <CPaginationItem aria-label="Previous" disabled>
                <span aria-hidden="true">&laquo;</span>
              </CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem aria-label="Next" disabled>
                <span aria-hidden="true">&raquo;</span>
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
