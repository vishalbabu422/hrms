import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CPagination,
  CPaginationItem,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle } from '@coreui/icons'
import { useState, useEffect } from 'react'
import api from '../../api/axios'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import { useNavigate } from 'react-router-dom'
import SimpleBar from 'simplebar-react'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const [search, setSearch] = useState('')

  // gst codes and loader

  const [gstCodes, setGstCodes] = useState([])
  const [loading, setLoading] = useState(false)

  // fetch all the availale gst codes

  useEffect(() => {
    const fetchGstCodes = async () => {
      try {
        setLoading(true)
        const response = await api.get('/admin/gst-code/index')
        console.log(response.data)
        // setGstCodes(response.data.data.GstCodeList)
      } catch (error) {
        console.error(error)
      } finally {
        setLoading(false)
      }
    }

    fetchGstCodes()
  }, [search, sort])

  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>GST Codes</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch
                value={search}
                onChange={setSearch}
                placeholder="Search HSN SAC Code..."
              />
              <CTooltip content="Add HSN SAC Code" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/hsnsac/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide={true} style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell label="Sno" sortKey="id" sort={sort} onSort={handleSort} />
                    <SortableHeaderCell
                      label="Code Type"
                      sortKey="code_type"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Code"
                      sortKey="code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Description"
                      sortKey="description"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="GST Rate"
                      sortKey="gst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="CGST Rate"
                      sortKey="cgst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="SGST Rate"
                      sortKey="sgst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="IGST Rate"
                      sortKey="igst_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Cess Rate"
                      sortKey="cess_rate"
                      sort={sort}
                      onSort={handleSort}
                    />

                    {/* <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} /> */}

                    <SortableHeaderCell
                      label="Effective From"
                      sortKey="effective_from"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Effective To"
                      sortKey="effective_to"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Status"
                      sortKey="status"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>
                <CTableBody>
                  <CTableRow>
                    <CTableDataCell scope="row">1</CTableDataCell>
                    <CTableDataCell>HSN</CTableDataCell>
                    <CTableDataCell>998313</CTableDataCell>
                    <CTableDataCell>Information technology consulting services</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>01 Apr 2025</CTableDataCell>
                    <CTableDataCell>-</CTableDataCell>
                    <CTableDataCell>
                      <CIcon icon={cilCheckCircle} className="text-success" />
                    </CTableDataCell>
                    <CTableDataCell>
                      <div className="d-flex gap-2">
                        <CTooltip content="Edit" placement="left">
                          <CButton color="primary" size="sm" variant="ghost">
                            <CIcon icon={cilPencil} />
                          </CButton>
                        </CTooltip>
                        <CTooltip content="Delete" placement="right">
                          <CButton color="danger" size="sm" variant="ghost">
                            <CIcon icon={cilTrash} />
                          </CButton>
                        </CTooltip>
                      </div>
                    </CTableDataCell>
                  </CTableRow>

                  <CTableRow>
                    <CTableDataCell scope="row">2</CTableDataCell>
                    <CTableDataCell>SAC</CTableDataCell>
                    <CTableDataCell>998313</CTableDataCell>
                    <CTableDataCell>Information technology consulting services</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>0.00%</CTableDataCell>
                    <CTableDataCell>25 Apr 2025</CTableDataCell>
                    <CTableDataCell>-</CTableDataCell>
                    <CTableDataCell>
                      <CIcon icon={cilCheckCircle} className="text-success" />
                    </CTableDataCell>
                    <CTableDataCell>
                      <div className="d-flex gap-2">
                        <CTooltip content="Edit" placement="left">
                          <CButton color="primary" size="sm" variant="ghost">
                            <CIcon icon={cilPencil} />
                          </CButton>
                        </CTooltip>
                        <CTooltip content="Delete" placement="right">
                          <CButton color="danger" size="sm" variant="ghost">
                            <CIcon icon={cilTrash} />
                          </CButton>
                        </CTooltip>
                      </div>
                    </CTableDataCell>
                  </CTableRow>
                </CTableBody>
              </CTable>
            </SimpleBar>
            <CPagination className="justify-content-end" aria-label="Page navigation example">
              <CPaginationItem aria-label="Previous" disabled>
                <span aria-hidden="true">&laquo;</span>
              </CPaginationItem>
              <CPaginationItem active>1</CPaginationItem>
              <CPaginationItem aria-label="Next" disabled>
                <span aria-hidden="true">&raquo;</span>
              </CPaginationItem>
            </CPagination>
          </CCardBody>
        </CCard>
      </CCol>
