import React, { useState, useEffect, useRef } from 'react'
import {
  CCard,
  CCardBody,
  CRow,
  CCol,
  CFormSelect,
  CFormInput,
  CButton,
  CAlert,
} from '@coreui/react'

import './leave.css'

const LeaveRecord = () => {
  const [workOrder, setWorkOrder] = useState('')
  const [month, setMonth] = useState('')
  const [selectedEmployees, setSelectedEmployees] = useState([])
  const [showDropdown, setShowDropdown] = useState(false)
  const [employeeData, setEmployeeData] = useState({})
  const [isReady, setIsReady] = useState(false)

  const dropdownRef = useRef(null)

  const workOrderEmployees = {
    'WO-001': ['John', 'Priya', 'Amit'],
    'WO-002': ['Rahul', 'Sneha'],
  }

  const employeesList = workOrder ? workOrderEmployees[workOrder] || [] : []

  const isAllSelected =
    employeesList.length > 0 &&
    selectedEmployees.length === employeesList.length

  // Close dropdown
  useEffect(() => {
    const handleClickOutside = (e) => {
      if (dropdownRef.current && !dropdownRef.current.contains(e.target)) {
        setShowDropdown(false)
      }
    }
    document.addEventListener('mousedown', handleClickOutside)
    return () => document.removeEventListener('mousedown', handleClickOutside)
  }, [])

  // Reset employees on WO change
  useEffect(() => {
    setSelectedEmployees([])
  }, [workOrder])

  // Prepare employee data
  useEffect(() => {
    const data = {}
    selectedEmployees.forEach((emp) => {
      data[emp] = {
        leaveTaken: 0,
        holidaysWorked: 0,
      }
    })
    setEmployeeData(data)
  }, [selectedEmployees])

  // ✅ CONTROL TABLE VISIBILITY
  useEffect(() => {
    if (workOrder && month && selectedEmployees.length > 0) {
      setIsReady(true)
    } else {
      setIsReady(false)
    }
  }, [workOrder, month, selectedEmployees])

  const handleEmployeeToggle = (emp) => {
    if (selectedEmployees.includes(emp)) {
      setSelectedEmployees(selectedEmployees.filter((e) => e !== emp))
    } else {
      setSelectedEmployees([...selectedEmployees, emp])
    }
  }

  const handleSelectAll = () => {
    if (isAllSelected) {
      setSelectedEmployees([])
    } else {
      setSelectedEmployees(employeesList)
    }
  }

  const handleInputChange = (emp, field, value) => {
    setEmployeeData((prev) => ({
      ...prev,
      [emp]: {
        ...prev[emp],
        [field]: value,
      },
    }))
  }

  return (
    <CCard className="leave-card">
      <CCardBody>

        {/* 🔹 HEADER */}
        <div className="leave-header">

          <h4 className="leave-title">Leave Record</h4>

          <CRow className="g-3">

            {/* Work Order */}
            <CCol md={4}>
              <CFormSelect
                value={workOrder}
                onChange={(e) => setWorkOrder(e.target.value)}
              >
                <option value="">Select Work Order</option>
                <option value="WO-001">WO-001 — Site Alpha</option>
                <option value="WO-002">WO-002 — Site Beta</option>
              </CFormSelect>
            </CCol>

            {/* Employee */}
            <CCol md={4}>
              <div ref={dropdownRef} className="dropdown-wrapper">

                <div
                  className={`form-select custom-multiselect ${
                    showDropdown ? 'open' : ''
                  }`}
                  onClick={() => setShowDropdown(!showDropdown)}
                >
                  {selectedEmployees.length === 0
                    ? 'Select Employee'
                    : selectedEmployees.slice(0, 2).join(', ') +
                      (selectedEmployees.length > 2
                        ? ` +${selectedEmployees.length - 2} more`
                        : '')}
                </div>

                {showDropdown && (
                  <div className="multi-select-dropdown">

                    <div className="dropdown-item">
                      <input
                        type="checkbox"
                        checked={isAllSelected}
                        onChange={handleSelectAll}
                      /> Select All
                    </div>

                    <hr />

                    {employeesList.map((emp, index) => (
                      <div key={index} className="dropdown-item">
                        <input
                          type="checkbox"
                          checked={selectedEmployees.includes(emp)}
                          onChange={() => handleEmployeeToggle(emp)}
                        /> {emp}
                      </div>
                    ))}
                  </div>
                )}

              </div>
            </CCol>

            {/* Month */}
            <CCol md={4}>
              <CFormSelect
                value={month}
                onChange={(e) => setMonth(e.target.value)}
              >
                <option value="">Select Month</option>
                <option>Jan 2026</option>
                <option>Feb 2026</option>
              </CFormSelect>
            </CCol>

          </CRow>    

        </div>

        {/* INFO */}
        {isReady && (
          <CAlert color="info" className="info-box mt-3">
            Employee can take <strong>1.5 days</strong> leave per month with carry-forward.
          </CAlert>
        )}

        {/* TABLE */}
        {isReady && (
          <div className="mpr-table">

            <table className="table">
              <thead>
                <tr>
                  <th>Emp Name</th>
                  <th>Opening Bal.</th>
                  <th>No.of Leave Taken</th>
                  <th>No. of Holiday Worked</th>
                  <th>Leave Adjusted</th>
                  <th>Leave Granted</th>
                  <th>Closing Bal.</th>
                </tr>
              </thead>

              <tbody>
                {selectedEmployees.map((emp, index) => {
                  const data = employeeData[emp] || {}

                  const opening = 3
                  const adjusted = 1.5
                  const granted = 1.5

                  const closing =
                    granted +
                    Number(data.holidaysWorked || 0) -
                    Number(data.leaveTaken || 0)

                  return (
                    <tr key={index}>
                      <td>{emp}</td>
                      <td>{opening}</td>

                      <td>
                        <CFormInput
                          type="number"
                          value={data.leaveTaken || 0}
                          onChange={(e) =>
                            handleInputChange(emp, 'leaveTaken', e.target.value)
                          }
                        />
                      </td>

                      <td>
                        <CFormInput
                          type="number"
                          value={data.holidaysWorked || 0}
                          onChange={(e) =>
                            handleInputChange(emp, 'holidaysWorked', e.target.value)
                          }
                        />
                      </td>

                      <td>{adjusted}</td>
                      <td>{granted}</td>
                      <td><strong>{closing}</strong></td>
                    </tr>
                  )
                })}
              </tbody>

            </table>

          </div>
        )}

      </CCardBody>
    </CCard>
  )
}

export default LeaveRecord