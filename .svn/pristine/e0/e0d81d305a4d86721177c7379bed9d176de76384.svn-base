import React from 'react'

/* ================= MOCK DATA ================= */

const previewData = {
  basic: {
    firstName: "Vishal",
    lastName: "Babu",
    email: "vishalbabu422@example.com",
    contactNo: "7291926153",
    dob: "1995-07-17",
    gender: "Male",
    bloodGroup: "B+",
    doj: "2023-01-10",
    profileImage: "", // Add image URL if needed
  },

  address: {
    correspondence: {
      address: "123 Green Park",
      city: "New Delhi",
    },
    permanent: {
      address: "45 MG Road",
      city: "Jaipur",
    },
  },

  bank: {
    bankName: "State Bank of India",
    accountNumber: "123456789012",
    ifsc: "SBIN0001234",
  },

  insurance: {
    company: "LIC India",
    policyNo: "LIC12345678",
  },

  qualifications: [
    {
      qualificationName: "B.Tech in Computer Science",
      yearOfPassing: "2017",
    },
    {
      qualificationName: "M.Tech in Software Engineering",
      yearOfPassing: "2019",
    },
  ],

  experiences: [
    {
      companyName: "Infosys",
      designation: "Software Engineer",
    },
    {
      companyName: "TCS",
      designation: "Senior Developer",
    },
  ],

  skills: [
    { skillName: "JavaScript" },
    { skillName: "Node.js" },
    { skillName: "React" },
  ],
}

/* ================= PREVIEW COMPONENT ================= */

const Preview = ({ data, onEdit }) => {
  if (!data) return null

  const {
    basic = {},
    address = {},
    bank = {},
    insurance = {},
    qualifications = [],
    experiences = [],
    skills = [],
  } = data

  return (
    <div className="container-fluid my-4">
      <div className="card shadow-sm p-4">

        {/* HEADER */}
        <div className="d-flex flex-column flex-md-row justify-content-between align-items-center border-bottom pb-3 mb-4">
          <div className="d-flex align-items-center gap-3 text-center text-md-start">

            <div className="preview-avatar">
              {basic.profileImage ? (
                <img src={basic.profileImage} alt="Profile" width="80" />
              ) : (
                <div
                  style={{
                    width: 80,
                    height: 80,
                    borderRadius: "50%",
                    background: "#eee",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    fontSize: 30,
                  }}
                >
                  👤
                </div>
              )}
            </div>

            <div>
              <h4 className="mb-1">
                {basic.firstName} {basic.lastName}
              </h4>
              <p className="mb-1 text-muted">{basic.email}</p>
              <small>{basic.contactNo}</small>
            </div>
          </div>

          <button className="btn btn-primary mt-3 mt-md-0" onClick={onEdit}>
            Edit Profile
          </button>
        </div>

        {/* PERSONAL INFO */}
        <div className="row g-4">

          <div className="col-md-6">
            <Section title="Personal Information">
              <Field label="Date of Birth" value={basic.dob} />
              <Field label="Gender" value={basic.gender} />
              <Field label="Blood Group" value={basic.bloodGroup} />
              <Field label="Date of Joining" value={basic.doj} />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Address">
              <Field
                label="Correspondence"
                value={`${address?.correspondence?.address || ''}, ${address?.correspondence?.city || ''}`}
              />
              <Field
                label="Permanent"
                value={`${address?.permanent?.address || ''}, ${address?.permanent?.city || ''}`}
              />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Bank Details">
              <Field label="Bank Name" value={bank.bankName} />
              <Field label="Account No" value={bank.accountNumber} />
              <Field label="IFSC" value={bank.ifsc} />
            </Section>
          </div>

          <div className="col-md-6">
            <Section title="Insurance">
              <Field label="Company" value={insurance.company} />
              <Field label="Policy No" value={insurance.policyNo} />
            </Section>
          </div>

        </div>

        {/* QUALIFICATIONS */}
        {qualifications.length > 0 && (
          <div className="mt-5">
            <h6>Qualifications</h6>
            {qualifications.map((q, i) => (
              <div key={i} className="border p-2 mb-2 rounded">
                {q.qualificationName} ({q.yearOfPassing})
              </div>
            ))}
          </div>
        )}

        {/* EXPERIENCE */}
        {experiences.length > 0 && (
          <div className="mt-4">
            <h6>Experience</h6>
            {experiences.map((e, i) => (
              <div key={i} className="border p-2 mb-2 rounded">
                {e.companyName} - {e.designation}
              </div>
            ))}
          </div>
        )}

      </div>
    </div>
  )
}

/* ---------- Small Reusable Components ---------- */

const Section = ({ title, children }) => (
  <div>
    <h6 className="mb-3">{title}</h6>
    {children}
  </div>
)

const Field = ({ label, value }) => (
  <div className="mb-3">
    <small className="text-muted d-block">{label}</small>
    <div className="fw-semibold">{value || '-'}</div>
  </div>
)

/* ================= WRAPPER COMPONENT ================= */

const App = () => {
  return (
    <Preview
      data={previewData}
      onEdit={() => alert("Edit clicked")}
    />
  )
}

export default App
