export const validateOfficeAddress = (address, type = "Address") => {
  const errors = {};

  const isAnyFilled =
    address.address ||
    address.city ||
    address.state ||
    address.pin_code ||
    address.landmark;

  if (!isAnyFilled) return errors;

  // ✅ REQUIRED (as per your structure)
  if (!address.address || address.address.trim() === "") {
    errors.address = `${type}: Address is required`;
  }

  // OPTIONAL validation
  if (address.pin_code) {
    const pinRegex = /^[0-9]{4,10}$/;
    if (!pinRegex.test(address.pin_code)) {
      errors.pin_code = `${type}: Invalid pin code`;
    }
  }

  return errors;
};