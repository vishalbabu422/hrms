import React from 'react'
import api from '../../../api/axios'
const Bank = ({ step, employeeBank, setEmployeeBank }) => {

  const handleChange = (field, value) => {
    setEmployeeBank({
      ...employeeBank,
      [field]: value
    })
  }

  const handleChequeUpload = (e) => {
    const file = e.target.files[0]
    setEmployeeBank({
      ...employeeBank,
      cancelled_cheque: file
    })
  }

  return (
    <>
      {step === 4 && (
        <div className="step-content">

          <div className="row border rounded g-3 mt-2 p-3">

            {/* Bank Name */}
            <div className="col-md-6">
              <label className="form-label">Bank Name</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter bank name"
                maxLength={120}
                value={employeeBank.bank_name || ""}
                onChange={(e) => handleChange("bank_name", e.target.value)}
              />
            </div>

            {/* Branch Name */}
            <div className="col-md-6">
              <label className="form-label">Branch Name</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter branch name"
                maxLength={120}
                value={employeeBank.branch_name || ""}
                onChange={(e) => handleChange("branch_name", e.target.value)}
              />
            </div>

            {/* Bank Address */}
            <div className="col-md-6">
              <label className="form-label">Bank Address</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter bank branch address"
                value={employeeBank.bank_address || ""}
                onChange={(e) => handleChange("bank_address", e.target.value)}
              />
            </div>

            {/* Account Number */}
            <div className="col-md-6">
              <label className="form-label">Account Number</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter account number"
                maxLength={40}
                value={employeeBank.account_number || ""}
                onChange={(e) => handleChange("account_number", e.target.value)}
              />
            </div>

            {/* IFSC */}
            <div className="col-md-6">
              <label className="form-label">IFSC Code</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter IFSC code (e.g. SBIN0001234)"
                maxLength={20}
                value={employeeBank.ifsc || ""}
                onChange={(e) => handleChange("ifsc", e.target.value)}
              />
            </div>

            {/* MICR */}
            <div className="col-md-6">
              <label className="form-label">MICR Code</label>
              <input
                type="text"
                className="form-control"
                placeholder="Enter MICR code"
                maxLength={20}
                value={employeeBank.micr_code || ""}
                onChange={(e) => handleChange("micr_code", e.target.value)}
              />
            </div>

            {/* Cancelled Cheque */}
            <div className="col-md-12">
              <label className="form-label">Cancelled Cheque (Upload)</label>
              <input
                type="file"
                className="form-control"
                accept=".pdf,.jpg,.jpeg,.png"
                onChange={handleChequeUpload}
              />
              <small className="text-muted">
                Allowed: PDF, JPG, PNG | Max Size: 2MB
              </small>
            </div>

          </div>

        </div>
      )}
    </>
  )
}

export default Bank