.dashboard-wrapper {
  min-height: 100vh;
  padding: 20px;
  /* background: #f8fafc; */
}

/* ==================================
   COMMON
================================== */

.dashboard-widget,
.kpi-card,
.welcome-banner {
  border: none !important;
  border-radius: 16px !important;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  transition: all 0.3s ease;
}

.dashboard-widget:hover,
.kpi-card:hover {
  transform: translateY(-4px);
}


.banner-stats {
  display: flex;
  gap: 40px;
}

.banner-stats div {
  text-align: center;
}

.banner-stats strong {
  display: block;
  font-size: 24px;
  font-weight: 700;
}

.banner-stats span {
  font-size: 13px;
  opacity: 0.85;
}

/* ==================================
   KPI CARDS
================================== */

.kpi-card {
  color: #fff;
}

.employee-card {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.active-card {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.leave-card1 {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.join-card {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.kpi-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kpi-icon {
  width: 55px;
  height: 55px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.18);

  display: flex;
  align-items: center;
  justify-content: center;
}

.kpi-icon svg {
  width: 26px;
  height: 26px;
}

.growth-badge {
  background: rgba(255, 255, 255, 0.18);
  padding: 5px 12px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 600;
}

.kpi-value {
  font-size: 32px;
  font-weight: 700;
  margin-top: 20px;
}

.kpi-title {
  margin-top: 5px;
  opacity: 0.9;
  font-size: 14px;
}

/* ==================================
   SECTION HEADER
================================== */

.widget-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 20px;
}

.widget-header h5 {
  margin: 0;
  font-weight: 700;
  color: #1e293b;
}

/* ==================================
   ATTENDANCE
================================== */

.attendance-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}

.attendance-item strong {
  font-size: 22px;
}

.attendance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  margin-top: 20px;
}

.attendance-grid h4 {
  margin: 0;
  color: #0f172a;
  font-weight: 700;
}

.attendance-grid span {
  color: #64748b;
  font-size: 13px;
}

/* ==================================
   APPROVALS
================================== */

.approval-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.approval-row {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 14px;
  border-radius: 12px;
  background: #f8fafc;
}

.approval-row strong {
  padding: 6px 12px;
  border-radius: 30px;
  color: #fff;
}

.danger {
  background: #ef4444;
}

.warning {
  background: #f59e0b;
}

.primary {
  background: #3b82f6;
}

.success {
  background: #22c55e;
}

/* ==================================
   METRICS
================================== */

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.metric-card {
  padding: 20px;
  border-radius: 14px;
  background: #f8fafc;
  text-align: center;
}

.metric-card svg {
  width: 24px;
  height: 24px;
  color: #4f46e5;
  margin-bottom: 10px;
}

.metric-card h4 {
  margin: 0;
  font-weight: 700;
}

.metric-card span {
  color: #64748b;
  font-size: 13px;
}

/* ==================================
   TIMELINE
================================== */

.timeline {
  position: relative;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 20px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #e2e8f0;
}

.timeline-item {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
  position: relative;
}

.timeline-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 2;
}

.timeline-content {
  flex: 1;
}

.timeline-content div {
  font-weight: 500;
  color: #334155;
}

.timeline-content small {
  color: #94a3b8;
}

/* ==================================
   DEPARTMENT
================================== */

.department-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.dept-row {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 14px;
  border-radius: 12px;

  background: #f8fafc;
}

.dept-row strong {
  color: #4f46e5;
}

/* ==================================
   SPOTLIGHT
================================== */

.spotlight-card {
  text-align: center;
}

.spotlight-card img {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  object-fit: cover;

  margin-bottom: 15px;
}

.spotlight-card h4 {
  margin-bottom: 4px;
}

.spotlight-card p {
  color: #64748b;
  margin-bottom: 16px;
}

.spotlight-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 10px 18px;
  border-radius: 30px;

  background: #fff7ed;
  color: #ea580c;

  font-size: 13px;
  font-weight: 600;
}

.spotlight-stats {
  display: flex;
  justify-content: center;
  gap: 40px;

  margin-top: 25px;
}

.spotlight-stats strong {
  display: block;
  font-size: 22px;
}

.spotlight-stats span {
  color: #64748b;
  font-size: 13px;
}

/* ==================================
   COLORS
================================== */

.primary-bg {
  background: #dbeafe;
  color: #2563eb;
}

.success-bg {
  background: #dcfce7;
  color: #16a34a;
}

.warning-bg {
  background: #fef3c7;
  color: #d97706;
}

.purple-bg {
  background: #ede9fe;
  color: #7c3aed;
}

/* ==================================
   RESPONSIVE
================================== */

@media (max-width: 992px) {
  .welcome-content {
    flex-direction: column;
    align-items: flex-start;
  }

  .banner-stats {
    width: 100%;
    justify-content: space-between;
  }
}

@media (max-width: 768px) {
  .metric-grid {
    grid-template-columns: 1fr;
  }

  .attendance-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .banner-stats {
    flex-direction: column;
    gap: 15px;
  }

  .kpi-value {
    font-size: 28px;
  }
}



.widget-header h5 {
  margin: 0;
  font-weight: 700;
  color: var(--cui-body-color);
}

.attendance-item span,
.attendance-item strong {
  color: var(--cui-body-color);
}

.attendance-grid h4 {
  margin: 0;
  color: var(--cui-body-color);
  font-weight: 700;
}

.attendance-grid span {
  color: var(--cui-secondary-color);
  font-size: 13px;
}