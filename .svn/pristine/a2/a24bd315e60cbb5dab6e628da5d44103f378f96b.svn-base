const router = require("express").Router({ mergeParams: true });

const EmployeeWOLeaveController = require("./employeeWOLeave.controller");

const {
  protect,
  checkPermission,
  restrictTo,
} = require("../../../middlewares/authMiddleware");

const ROLES = ["ORG_ADMIN", "SUPER_ADMIN"];

router.use(protect);

router
  .route("/")
  .get(
    checkPermission("LEAVE.READ"),
    EmployeeWOLeaveController.getEmployeeWOLeave
  )
  .post(
    checkPermission("LEAVE.CREATE"),
    EmployeeWOLeaveController.assignEmployeeWOLeave
  );

  router
  .route("/:leaveId")
  .patch(
    checkPermission("LEAVE.UPDATE"),
    EmployeeWOLeaveController.updateEmployeeWOLeave
  );

module.exports = router;