import { useState, useEffect } from 'react'
import api from '../api/axios'
import { getMonthMeta } from '../views/components/leave-mpr/leaveCalculation'

const useLeaveMprForm = (mpr = false) => {
  const [workOrder, setWorkOrder] = useState('')
  const [month, setMonth] = useState('')
  const [monthOptions, setMonthOptions] = useState([])
  const [selectedEmployees, setSelectedEmployees] = useState([])
  const [employeeData, setEmployeeData] = useState({})
  const [allEmployees, setAllEmployees] = useState([])

  // Fetch month options
  useEffect(() => {
    const fetchWorkOrderDesign = async () => {
      if (!workOrder) {
        setMonthOptions([])
        return
      }

      try {
        const res = await api.get(`/admin/workorder-desgn/workorder/${workOrder}?modelFilter={}`)

        const list = res.data?.data?.workOrderDesgnList || []

        if (!list.length) {
          setMonthOptions([])
          return
        }

        const dates = list.flatMap((item) => [
          new Date(item.deployment_from),
          new Date(item.deployment_to),
        ])

        const minDate = new Date(Math.min(...dates))
        const maxDate = new Date(Math.max(...dates))

        const months = []
        const current = new Date(minDate)

        const today = new Date()
        const currentMonthStart = new Date(today.getFullYear(), today.getMonth() + 1, 1)

        while (current <= maxDate) {
          if (current <= currentMonthStart) {
            months.push({
              label: current.toLocaleString('default', {
                month: 'short',
                year: 'numeric',
              }),
              value: `${current.getFullYear()}-${current.getMonth() + 1}`,
            })
          }

          current.setMonth(current.getMonth() + 1)
        }

        setMonthOptions(months)
      } catch (err) {
        console.error(err)
        setMonthOptions([])
      }
    }

    fetchWorkOrderDesign()
  }, [workOrder])

  useEffect(() => {
    const fetchEmployees = async () => {
      if (!workOrder || !month) {
        setAllEmployees([])
        return
      }

      try {
        const { monthName, year } = getMonthMeta(month)
        const modelFilter = {
          EmployeeWorkOrderDeployment: {
            is_deleted: false,
            relieving_date: null,
          },
          WoDesgnMapping: {
            work_order_id: workOrder,
          },
          employeeWorkOrderLeaves: {
            month: monthName,
            year: year,
          },
        }

        let models =
          'EmployeeWorkOrderDeployment.WoDesgnMapping.Designation,employeeWorkOrderLeaves'

        // 🔹 conditionally add MPR filter
        if (mpr) {
          modelFilter.employeeWorkOrderLeaves = {
            month: monthName,
            year: year,
          }

          models += ',employeeWorkOrderLeaves'
        }

        const url = `/employee?models=${encodeURIComponent(
          models,
        )}&modelFilter=${encodeURIComponent(JSON.stringify(modelFilter))}`
        const res = await api.get(url)

        const list = res.data?.data || []

        setAllEmployees(list)

        // map employee data from API
        const dataMap = {}
        list.forEach((emp) => {
          dataMap[emp.id] = {
            leaveTaken: emp.leave_taken || 0,
            holidaysWorked: emp.holidays_worked || 0,
          }
        })

        setEmployeeData(dataMap)
      } catch (err) {
        console.error(err)
        setAllEmployees([])
      }
    }

    fetchEmployees()
  }, [workOrder, month])

  // Reset when workOrder changes
  useEffect(() => {
    setSelectedEmployees([])
    setEmployeeData({})
    setMonth('')
  }, [workOrder])

  useEffect(() => {
    if (!month) return

    setSelectedEmployees([])
    setEmployeeData({})
  }, [month])

  // Map employee data
  useEffect(() => {
    setEmployeeData((prev) => {
      const updated = { ...prev }

      selectedEmployees.forEach((emp) => {
        if (!updated[emp.id]) {
          updated[emp.id] = {
            leaveTaken: 0,
            holidaysWorked: 0,
          }
        }
      })

      return updated
    })
  }, [selectedEmployees])

  // Ready state
  const isReady = workOrder && month && selectedEmployees.length > 0

  // Input handler
  const handleInputChange = (empId, field, value) => {
    setEmployeeData((prev) => ({
      ...prev,
      [empId]: {
        ...prev[empId],
        [field]: value,
      },
    }))
  }

  const filteredEmployees =
    selectedEmployees.length === 0
      ? []
      : allEmployees.filter((emp) => selectedEmployees.some((sel) => sel.id === emp.id))

  useEffect(() => {
    if (!allEmployees.length) return

    setEmployeeData((prev) => {
      const updated = { ...prev }

      allEmployees.forEach((emp) => {
        if (!updated[emp.employee_id]) {
          updated[emp.employee_id] = {
            leaveTaken: 0,
            holidaysWorked: 0,
          }
        }
      })

      return updated
    })
  }, [allEmployees])

  const mergeApiData = (data) => {
    if (!data.length) return

    setEmployeeData((prev) => {
      const updated = { ...prev }

      data.forEach((item) => {
        const empId = Number(item.employee_id)

        updated[empId] = {
          leaveTaken: item.leave_taken,
          holidaysWorked: item.holiday_worked,
          recordId: item.id,
        }
      })

      return updated
    })
  }

  return {
    workOrder,
    setWorkOrder,
    month,
    setMonth,
    monthOptions,
    selectedEmployees,
    setSelectedEmployees,
    employeeData,
    handleInputChange,
    mergeApiData,
    isReady,
    filteredEmployees,
    setEmployeeData,
  }
}

export default useLeaveMprForm
