import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
  CFormTextarea,
} from '@coreui/react'

import { useEffect, useState } from 'react'

const EmpanelmentFormComponent = ({ initialData, mode, onSubmit }) => {
  const [formData, setFormData] = useState(initialData)

  useEffect(() => {
    if (initialData) {
      setFormData(initialData)
    }
  }, [initialData])

  if (!formData) return null

  const handleChange = (e) => {
    const { name, value } = e.target

    setFormData((prev) => ({
      ...prev,
      [name]: value === '' ? null : name === 'is_active' ? value === 'true' : value,
    }))
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    onSubmit(formData)
  }

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3" onSubmit={handleSubmit}>
              <CCol md={12}>
                <CFormLabel>Category</CFormLabel>
                <CFormInput
                  name="category"
                  placeholder="Enter category"
                  value={formData.category || ''}
                  onChange={handleChange}
                  maxLength={20}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Empanelment No</CFormLabel>
                <CFormInput
                  name="empanelment_no"
                  placeholder="Enter empanelment no"
                  value={formData.empanelment_no || ''}
                  maxLength={50}
                  onChange={handleChange}
                  disabled={mode === 'edit'}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Date</CFormLabel>
                <CFormInput
                  type="date"
                  name="date"
                  value={formData.date || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Short Code</CFormLabel>
                <CFormInput
                  name="shortcode"
                  value={formData.shortcode || ''}
                  onChange={handleChange}
                  placeholder="Enter Short Code"
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>RFE</CFormLabel>
                <CFormInput
                  name="rfe"
                  value={formData.rfe || ''}
                  placeholder="Enter RFE"
                  onChange={handleChange}
                  maxLength={255}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Effective From</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Effective To</CFormLabel>
                <CFormInput
                  type="date"
                  name="effective_to"
                  value={formData.effective_to || ''}
                  onChange={handleChange}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel>Status</CFormLabel>
                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton type="submit" className="btn btn-primary">
                  {mode === 'edit' ? 'Update' : 'Create'}
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default EmpanelmentFormComponent
