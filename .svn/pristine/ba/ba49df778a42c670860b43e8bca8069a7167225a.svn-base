import {
  CButton,
  CCol,
  CFormLabel,
  CFormSelect,
  CRow,
  CTable,
  CTableHead,
  CTableRow,
  CTableHeaderCell,
  CTableBody,
  CTableDataCell,
  CModal,
  CModalBody,
  CModalFooter,
} from '@coreui/react'

import { useState, useEffect } from 'react'
import { toast } from 'react-toastify'
import CIcon from '@coreui/icons-react'
import { cilViewStream, cilCloudDownload } from '@coreui/icons'
import { validateEmployeeSalaryRegister } from 'src/validations/employeeSalaryRegisterValidation'


const MonthlyRegister = () => {
  const cell = { border: '1px solid #000', padding: '6px' }

  const [filters, setFilters] = useState({
    month: '',
    year: '',
    structure: '',
  })

  const [salaryData, setSalaryData] = useState([])
  const [filteredData, setFilteredData] = useState([])
  const [searched, setSearched] = useState(false)

  const [dispatchModal, setDispatchModal] = useState(false)
  const [payslipModal, setPayslipModal] = useState(false)

  const [selectedRow, setSelectedRow] = useState(null)
  const [txnNo, setTxnNo] = useState('')

  useEffect(() => {
    const dummyData = [
      {
        id: 1,
        employee_name: 'Amit Sharma',
        ctc: 50000,
        gross_earnings: 45000,
        total_deductions: 5000,
        net_salary: 40000,
        month: 1,
        year: 2026,
        salary_structure_id: 1,
        status: 'Pending',
      },
      {
        id: 2,
        employee_name: 'Neha Verma',
        ctc: 60000,
        gross_earnings: 55000,
        total_deductions: 7000,
        net_salary: 48000,
        month: 1, // 🔥 SAME MONTH
        year: 2026,
        salary_structure_id: 2,
        status: 'Pending',
      },
      {
        id: 3,
        employee_name: 'Rahul Singh',
        ctc: 45000,
        gross_earnings: 42000,
        total_deductions: 4000,
        net_salary: 38000,
        month: 1, // 🔥 SAME MONTH
        year: 2026,
        salary_structure_id: 1,
        status: 'Pending',
      },
      {
        id: 4,
        employee_name: 'Priya Mehta',
        ctc: 52000,
        gross_earnings: 47000,
        total_deductions: 5000,
        net_salary: 42000,
        month: 2, // Feb
        year: 2026,
        salary_structure_id: 1,
        status: 'Pending',
      },

      {
        id: 5,
        employee_name: 'Neeraj Sharma',
        ctc: 50000,
        gross_earnings: 45000,
        total_deductions: 5000,
        net_salary: 40000,
        month: 1,
        year: 2026,
        salary_structure_id: 1,
        status: 'Pending',
      },
    ]
    setSalaryData(dummyData)
  }, [])

  const handleChange = (e) => {
    const { name, value } = e.target
    setFilters((prev) => ({ ...prev, [name]: value }))
  }

  const handleSearch = () => {
    // ❌ prevent empty search
    if (!filters.month && !filters.year && !filters.structure) {
      toast.error('Please select at least one filter')
      setSearched(false)
      return
    }

    let data = [...salaryData]

    data = data.filter((item) => {
      return (
        (!filters.month || Number(item.month) === Number(filters.month)) &&
        (!filters.year || Number(item.year) === Number(filters.year)) &&
        (!filters.structure || Number(item.salary_structure_id) === Number(filters.structure))
      )
    })

    setFilteredData(data)
    setSearched(true)
  }

  const handleDispatchSubmit = () => {
    if (!txnNo) {
      toast.error('Enter transaction number')
      return
    }

    const updated = salaryData.map((emp) =>
      emp.id === selectedRow.id ? { ...emp, status: 'Dispatched', transaction_no: txnNo } : emp,
    )

    setSalaryData(updated)
    setFilteredData(updated)

    setDispatchModal(false)
    setTxnNo('')

    toast.success('Dispatched Successfully')
  }

  const handleGenerate = (row) => {
    const updated = salaryData.map((emp) =>
      emp.id === row.id ? { ...emp, status: 'Generated' } : emp,
    )

    setSalaryData(updated)
    setFilteredData(updated)

    setPayslipModal(false)

    toast.success('Payslip Generated')
  }

  return (
    <>
      {/* FILTERS */}
      <CRow className="mb-4">
        <CCol md={3}>
          <CFormLabel>Month</CFormLabel>
          <CFormSelect name="month" onChange={handleChange}>
            <option value="">Select</option>
            <option value="1">Jan</option>
            <option value="2">Feb</option>
            <option value="3">Mar</option>
          </CFormSelect>
        </CCol>

        <CCol md={3}>
          <CFormLabel>Year</CFormLabel>
          <CFormSelect name="year" onChange={handleChange}>
            <option value="">Select</option>
            <option value="2026">2026</option>
          </CFormSelect>
        </CCol>

        <CCol md={3}>
          <CFormLabel>Salary Structure</CFormLabel>
          <CFormSelect name="structure" onChange={handleChange}>
            <option value="">Select</option>
            <option value="1">Structure A</option>
            <option value="2">Structure B</option>
          </CFormSelect>
        </CCol>

        <CCol md={3} className="d-flex align-items-end">
          <CButton color="primary" onClick={handleSearch}>
            Search
          </CButton>
        </CCol>
      </CRow>

      {/* TABLE */}
      {searched && (
        <CTable bordered hover>
          <CTableHead>
            <CTableRow>
              <CTableHeaderCell>Employee</CTableHeaderCell>
              <CTableHeaderCell>CTC</CTableHeaderCell>
              <CTableHeaderCell>Gross</CTableHeaderCell>
              <CTableHeaderCell>Deduction</CTableHeaderCell>
              <CTableHeaderCell>Net Pay</CTableHeaderCell>
              <CTableHeaderCell>Status</CTableHeaderCell>
              <CTableHeaderCell>Action</CTableHeaderCell>
            </CTableRow>
          </CTableHead>

          <CTableBody>
            {filteredData.map((item) => (
              <CTableRow key={item.id}>
                <CTableDataCell>{item.employee_name}</CTableDataCell>
                <CTableDataCell>₹ {item.ctc}</CTableDataCell>
                <CTableDataCell>₹ {item.gross_earnings}</CTableDataCell>
                <CTableDataCell>₹ {item.total_deductions}</CTableDataCell>
                <CTableDataCell>₹ {item.net_salary}</CTableDataCell>
                <CTableDataCell>{item.status}</CTableDataCell>

                <CTableDataCell>
                  {item.status === 'Pending' && (
                    <CButton
                      size="sm"
                      style={{
                        background: '#2d72bb',
                        border: 'none',
                        color: '#fff',
                      }}
                      onClick={() => {
                        setSelectedRow(item)
                        setDispatchModal(true)
                      }}
                    >
                      Dispatch
                    </CButton>
                  )}

                  {item.status === 'Dispatched' && (
                    <CButton
                      size="sm"
                      style={{
                        background: '#3da375',
                        border: 'none',
                        color: '#fff',
                      }}
                      onClick={() => {
                        setSelectedRow(item)
                        setPayslipModal(true)
                      }}
                    >
                      Generate Payslip
                    </CButton>
                  )}

                  {item.status === 'Generated' && (
                    <>
                      {/* VIEW */}
                      <CButton
                        size="sm"
                        className="me-2"
                        style={{
                          background: '#7a8594',
                          border: 'none',
                          color: '#fff',
                        }}
                        onClick={() => {
                          setSelectedRow(item)
                          setPayslipModal(true)
                        }}
                      >
                        View
                      </CButton>

                      {/* DOWNLOAD */}
                      <CButton
                        size="sm"
                        style={{
                          background: '#5c7c99',
                          border: 'none',
                          color: '#fff',
                        }}
                        onClick={() => handleDownload(item)}
                      >
                        <CIcon icon={cilCloudDownload} className="me-1" />
                        Download
                      </CButton>
                    </>
                  )}
                </CTableDataCell>
              </CTableRow>
            ))}
          </CTableBody>
        </CTable>
      )}

      {/* DISPATCH MODAL */}
      <CModal visible={dispatchModal} onClose={() => setDispatchModal(false)} size="lg">
        <CModalBody style={{ padding: '30px', background: '#fff' }}>
          {/* DATE */}
          <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
            <strong>Date: {new Date().toLocaleDateString()}</strong>
          </div>

          <br />

          {/* HEADER TEXT */}
          <p>
            <strong>Dear {selectedRow?.employee_name},</strong>
          </p>
          <p>
            <strong>Sub: Revised Salary Structure</strong>
          </p>

          <p>We would like to inform you that your revised salary structure is as given below:</p>

          {/* TABLE */}
          <table style={{ width: '100%', borderCollapse: 'collapse', border: '1px solid #000' }}>
            <thead>
              <tr>
                <th colSpan="2" style={{ border: '1px solid #000', padding: '6px' }}>
                  COST TO THE COMPANY
                </th>
              </tr>
              <tr>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Components</th>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Monthly</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Basic</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.5)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>HRA</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.25)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Transport Allowance</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1600</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  Professional Development Allowance
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.1)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Gross</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.ctc}</strong>
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Statutory Benefits</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}></td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  Company PF Contribution
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1800</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Leave Encashment</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1675</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Mediclaim Insurance</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 840</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Accidental Insurance</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 50</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Gratuity</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1111</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>COST TO COMPANY</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.ctc + 5000}</strong>
                </td>
              </tr>
            </tbody>
          </table>

          <br />

          <p style={{ fontSize: '12px' }}>
            Kindly share your acceptance. If no response, it will be considered accepted.
          </p>

          <br />

          <p>
            For Company <br />
            <strong>Authorized Signatory</strong>
          </p>

          {/* TRANSACTION */}
          <div className="mt-3">
            <label>
              <strong>Transaction Number</strong>
            </label>
            <input
              className="form-control"
              value={txnNo}
              onChange={(e) => setTxnNo(e.target.value)}
            />
          </div>
        </CModalBody>

        <CModalFooter>
          <CButton color="primary" onClick={handleDispatchSubmit}>
            Submit
          </CButton>
        </CModalFooter>
      </CModal>
      {/* PAYSLIP MODAL */}
      <CModal visible={payslipModal} onClose={() => setPayslipModal(false)} size="lg">
        <CModalBody style={{ padding: '30px', background: '#fff' }}>
          {/* DATE */}
          <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
            <strong>Date: {new Date().toLocaleDateString()}</strong>
          </div>

          <br />

          {/* DETAILS */}
          <p>
            <strong>Employee:</strong> {selectedRow?.employee_name}
          </p>
          <p>
            <strong>Transaction No:</strong> {selectedRow?.transaction_no}
          </p>

          {/* TABLE */}
          <table style={{ width: '100%', borderCollapse: 'collapse', border: '1px solid #000' }}>
            <thead>
              <tr>
                <th colSpan="2" style={{ border: '1px solid #000', padding: '6px' }}>
                  PAYSLIP DETAILS
                </th>
              </tr>
              <tr>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Components</th>
                <th style={{ border: '1px solid #000', padding: '6px' }}>Monthly</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Basic</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.5)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>HRA</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.25)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Transport Allowance</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>₹ 1600</td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  Professional Development Allowance
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {Math.round(selectedRow?.ctc * 0.1)}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Gross Earnings</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.gross_earnings}</strong>
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Deductions</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}></td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>Total Deductions</td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  ₹ {selectedRow?.total_deductions}
                </td>
              </tr>

              <tr>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>Net Pay</strong>
                </td>
                <td style={{ border: '1px solid #000', padding: '6px' }}>
                  <strong>₹ {selectedRow?.net_salary}</strong>
                </td>
              </tr>
            </tbody>
          </table>

          <br />

          <p style={{ fontSize: '12px' }}>This is a system generated payslip.</p>
        </CModalBody>

        <CModalFooter>
          {/*  Only show if NOT generated */}
          {selectedRow?.status !== 'Generated' && (
            <CButton color="primary" onClick={() => handleGenerate(selectedRow)}>
              Generate
            </CButton>
          )}
        </CModalFooter>
      </CModal>
    </>
  )
}

export default MonthlyRegister
