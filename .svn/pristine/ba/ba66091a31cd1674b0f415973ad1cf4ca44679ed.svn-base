import {
  CCard,
  CCardBody,
  CCardHeader,
  CCol,
  CRow,
  CTable,
  CTableBody,
  CTableDataCell,
  CTableHead,
  CTableHeaderCell,
  CTableRow,
  CTooltip,
  CButton,
} from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilPencil, cilTrash, cilPlus, cilCheckCircle, cilXCircle } from '@coreui/icons'
import { CSpinner } from '@coreui/react'

import SimpleBar from 'simplebar-react'
import { toast } from 'react-toastify'
import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'

import api from '../../api/axios'
import SortableHeaderCell from '../components/sort-table-header'
import ExpandableSearch from '../components/expandable-search'
import AppPagination from '../components/app-pagination'
import TableEmptyState from '../components/table-empty'

const index = () => {
  const [sort, setSort] = useState({
    key: 'id',
    order: 'desc',
  })

  const LIMIT = Number(import.meta.env.VITE_DEFAULT_LIMIT) || 10
  const [page, setPage] = useState(1)
  const [limit] = useState(LIMIT)
  const [totalPages, setTotalPages] = useState(1)

  const [search, setSearch] = useState('')

  // resource rate list and loader
  const [resourceRate, setResourceRate] = useState([])
  const [loading, setLoading] = useState(false)

  // fetch all the availale gst codes
  const fetchResourceRate = async () => {
    try {
      setLoading(true)

      const params = {
        sort: `${sort.key} ${sort.order}`,
        page,
        limit,
      }

      if (search.length >= 3) {
        params.search = search
      }

      const response = await api.get('/admin/resourcerate/index', { params })
      setResourceRate(response.data.data.resourceRateList)

      setTotalPages(response.data.totalPages)
    } catch (error) {
      console.error(error)
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    setPage(1)
  }, [search, sort])

  useEffect(() => {
    if (search.length === 0 || search.length >= 3) {
      fetchResourceRate()
    }
  }, [search, sort, page])

  //sort
  const handleSort = (key) => {
    setSort((prev) => {
      if (prev.key === key) {
        return { key, order: prev.order === 'asc' ? 'desc' : 'asc' }
      }
      return { key, order: 'asc' }
    })
  }

  // delete
  const confirmDelete = (id) => {
    if (!window.confirm('Are you sure you want to delete this Resource Rate?')) return
    handleDelete(id)
  }

  const handleDelete = async (id) => {
    try {
      await api.delete(`/admin/resourcerate/delete/${id}`)

      toast.success('Resource Rate deleted successfully')

      fetchResourceRate()
    } catch (error) {
      console.error(error)
      toast.error(error.response?.data?.message || 'Failed to delete Resource Rate')
    }
  }

  const navigate = useNavigate()

  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardHeader className="d-flex justify-content-between align-items-center">
            <strong>Resource Rate</strong>

            <div className="d-flex align-items-center gap-4">
              <ExpandableSearch onSearch={setSearch} placeholder="Search By Designation" />
              <CTooltip content="Add Resource Rate" placement="bottom">
                <CButton color="primary" size="sm" onClick={() => navigate('/rate/add')}>
                  <CIcon icon={cilPlus} className="me-1" />
                </CButton>
              </CTooltip>
            </div>
          </CCardHeader>

          <CCardBody>
            <SimpleBar autoHide={true} style={{ marginBottom: '5px' }}>
              <CTable align="middle" className="mb-4 border" hover striped>
                <CTableHead>
                  <CTableRow>
                    <SortableHeaderCell
                      label="Designation"
                      sortKey="desgn_id_fk"
                      sort={sort}
                      onSort={handleSort}
                    />

                    {/* <SortableHeaderCell label="Code" sortKey="code" sort={sort} onSort={handleSort} /> */}

                    <SortableHeaderCell
                      label="Agency Margin (%)"
                      sortKey="agency_margin_percent"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Unit Rate (Excluding A.M)"
                      sortKey="unit_rate_excl_agency_margin"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Unit Rate (Including A.M)"
                      sortKey="unit_rate_incl_agency_margin"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Agency Amount"
                      sortKey="agency_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="NICSI Margin (%)"
                      sortKey="nicsi_margin_percent"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="NICSI Margin Amount"
                      sortKey="nicsi_margin_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Total Amount"
                      sortKey="total_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Hsn Code"
                      sortKey="hsn_sac_code"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="CGST Amount"
                      sortKey="cgst_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="SGST Amount"
                      sortKey="sgst_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="IGST Amount"
                      sortKey="igst_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Total Amount"
                      sortKey="total_gst_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    {/* <SortableHeaderCell label="Date" sortKey="date" sort={sort} onSort={handleSort} /> */}

                    <SortableHeaderCell
                      label="Final Amount"
                      sortKey="final_amount"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <SortableHeaderCell
                      label="Status"
                      sortKey="status"
                      sort={sort}
                      onSort={handleSort}
                    />

                    <CTableHeaderCell scope="col">Action</CTableHeaderCell>
                  </CTableRow>
                </CTableHead>
                <CTableBody>
                  {loading ? (
                    <CTableRow>
                      <CTableDataCell colSpan={13} className="text-center py-4">
                        <CSpinner size="sm" />
                      </CTableDataCell>
                    </CTableRow>
                  ) : resourceRate?.length > 0 ? (
                    resourceRate.map((item) => (
                      <CTableRow key={item.id}>
                        <CTableDataCell>{item.designation.designation}</CTableDataCell>
                        <CTableDataCell>{item.agency_margin_percent}</CTableDataCell>
                        <CTableDataCell>{item.unit_rate_excl_agency_margin}</CTableDataCell>
                        <CTableDataCell>{item.unit_rate_incl_agency_margin}</CTableDataCell>
                        <CTableDataCell>{item.agency_amount}</CTableDataCell>
                        <CTableDataCell>{item.nicsi_margin_percent}</CTableDataCell>
                        <CTableDataCell>{item.nicsi_margin_amount}</CTableDataCell>
                        <CTableDataCell>{item.total_amount}</CTableDataCell>
                        <CTableDataCell>{item.hsn_sac_code}</CTableDataCell>
                        <CTableDataCell>{item.cgst_amount}</CTableDataCell>
                        <CTableDataCell>{item.sgst_amount}</CTableDataCell>
                        <CTableDataCell>{item.igst_amount}</CTableDataCell>
                        <CTableDataCell>{item.total_gst_amount}</CTableDataCell>
                        <CTableDataCell>{item.final_amount}</CTableDataCell>

                        <CTableDataCell>
                          {item.is_active ? (
                            <CIcon icon={cilCheckCircle} className="text-success" />
                          ) : (
                            <CIcon icon={cilXCircle} className="text-danger" />
                          )}
                        </CTableDataCell>

                        <CTableDataCell>
                          <div className="d-flex gap-2">
                            <CTooltip content="Edit" placement="left">
                              <CButton
                                color="primary"
                                size="sm"
                                variant="ghost"
                                onClick={() => navigate(`/rate/edit/${item.id}`)}
                              >
                                <CIcon icon={cilPencil} />
                              </CButton>
                            </CTooltip>
                            {item.is_active && (
                              <CTooltip content="Delete" placement="right">
                                <CButton
                                  color="danger"
                                  size="sm"
                                  variant="ghost"
                                  onClick={() => confirmDelete(item.id)}
                                >
                                  <CIcon icon={cilTrash} />
                                </CButton>
                              </CTooltip>
                            )}
                          </div>
                        </CTableDataCell>
                      </CTableRow>
                    ))
                  ) : (
                    <TableEmptyState colSpan={16} />
                  )}
                </CTableBody>
              </CTable>
            </SimpleBar>

            <AppPagination page={page} totalPages={totalPages} onPageChange={setPage} />
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default index
