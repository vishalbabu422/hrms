import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

import Select from 'react-select'
import { useState } from 'react'
import { validateEmployeeAddon } from '../../validations/employeeAddonValidation'

const EmployeeAddon = () => {
  /* ================= DUMMY DROPDOWNS ================= */

  const workorderOptions = [
    {
      value: 1,
      label: 'WO-1001',
    },
    {
      value: 2,
      label: 'WO-1002',
    },
  ]

  const employeeOptions = [
    {
      value: 1,
      label: 'Aman Sharma',
    },
    {
      value: 2,
      label: 'Priya Verma',
    },
    {
      value: 3,
      label: 'Rahul Kumar',
    },
  ]

  const salaryAddonOptions = [
    {
      value: 1,
      label: 'Basic Salary',
    },
    {
      value: 2,
      label: 'HRA',
    },
    {
      value: 3,
      label: 'PF',
    },
  ]

  /* ================= FORM ================= */

  const [formData, setFormData] = useState({
    workorder_id: '',
    employees: [],
    salary_addon_id: '',
    amount: '',
    effective_from: '',
    effective_to: '',
    is_active: true,
  })

  const [errors, setErrors] = useState({})

  /* ================= CHANGE ================= */

  const handleChange = (e) => {
    const { name, value } = e.target

    let updatedValue = value

    if (name === 'is_active') {
      updatedValue = value === 'true'
    }

    // NUMERIC ONLY
    if (name === 'amount') {
      updatedValue = value.replace(/[^0-9.]/g, '')
    }

    setFormData((prev) => ({
      ...prev,
      [name]: updatedValue,
    }))
  }

  /* ================= EMPLOYEE MULTISELECT ================= */

  const handleEmployeeChange = (selectedOptions) => {
    setFormData((prev) => ({
      ...prev,
      employees: selectedOptions || [],
    }))
  }

  /* ================= VALIDATION ================= */

 const validateForm = () => {
  const validationErrors =
    validateEmployeeAddon(formData)

  setErrors(validationErrors)

  return Object.keys(validationErrors).length === 0
}
  /* ================= SUBMIT ================= */

  const handleSubmit = (e) => {
    e.preventDefault()

    if (!validateForm()) return

    console.log('FORM DATA : ', formData)
  }

  /* ================= UI ================= */

  return (
    <CRow>
      <CCol xs={12}>
        <CCard>
          <CCardBody>

            <CForm onSubmit={handleSubmit} className="row g-3">

              {/* WORKORDER */}
              <CCol md={6}>
                <CFormLabel>
                  Workorder{' '}
                  <span className="text-danger">*</span>
                </CFormLabel>

                <CFormSelect
                  name="workorder_id"
                  value={formData.workorder_id}
                  onChange={handleChange}
                  invalid={!!errors.workorder_id}
                >
                  <option value="">
                    Select Workorder
                  </option>

                  {workorderOptions.map((item) => (
                    <option
                      key={item.value}
                      value={item.value}
                    >
                      {item.label}
                    </option>
                  ))}
                </CFormSelect>
              </CCol>

              {/* EMPLOYEE MULTISELECT */}
              <CCol md={6}>
                <CFormLabel>
                  Employee{' '}
                  <span className="text-danger">*</span>
                </CFormLabel>

                <Select
                  isMulti
                  options={employeeOptions}
                  value={formData.employees}
                  onChange={handleEmployeeChange}
                  placeholder="Select Employees"
                />

                {errors.employees && (
                  <div className="text-danger mt-1 small">
                    {errors.employees}
                  </div>
                )}
              </CCol>
{/* 
              SALARY ADDON
              <CCol md={6}>
                <CFormLabel>
                  Salary Addon{' '}
                  <span className="text-danger">*</span>
                </CFormLabel>

                <CFormSelect
                  name="salary_addon_id"
                  value={formData.salary_addon_id}
                  onChange={handleChange}
                  invalid={!!errors.salary_addon_id}
                >
                  <option value="">
                    Select Salary Addon
                  </option>

                  {salaryAddonOptions.map((item) => (
                    <option
                      key={item.value}
                      value={item.value}
                    >
                      {item.label}
                    </option>
                  ))}
                </CFormSelect>
              </CCol> */}

              {/* AMOUNT */}
              <CCol md={6}>
                <CFormLabel>
                  Amount{' '}
                  <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  type="text"
                  name="amount"
                  placeholder="Enter Amount"
                  value={formData.amount}
                  onChange={handleChange}
                  invalid={!!errors.amount}
                />
              </CCol>

              {/* EFFECTIVE FROM */}
              <CCol md={6}>
                <CFormLabel>
                  Effective From{' '}
                  <span className="text-danger">*</span>
                </CFormLabel>

                <CFormInput
                  type="date"
                  name="effective_from"
                  value={formData.effective_from}
                  onChange={handleChange}
                  invalid={!!errors.effective_from}
                />
              </CCol>

              {/* EFFECTIVE TO */}
              <CCol md={6}>
                <CFormLabel>
                  Effective To
                </CFormLabel>

                <CFormInput
                  type="date"
                  name="effective_to"
                  value={formData.effective_to}
                  onChange={handleChange}
                />
              </CCol>

              {/* STATUS */}
              <CCol md={6}>
                <CFormLabel>
                  Status
                </CFormLabel>

                <CFormSelect
                  name="is_active"
                  value={String(formData.is_active)}
                  onChange={handleChange}
                >
                  <option value="true">
                    Active
                  </option>

                  <option value="false">
                    Inactive
                  </option>
                </CFormSelect>
              </CCol>

              {/* SUBMIT */}
              <CCol xs={12}>
                <CButton type="submit" color="primary">
                  Submit
                </CButton>
              </CCol>

            </CForm>

          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default EmployeeAddon