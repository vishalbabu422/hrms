import {
  CButton,
  CCard,
  CCardBody,
  CCol,
  CForm,
  CFormInput,
  CFormLabel,
  CFormSelect,
  CRow,
} from '@coreui/react'

const Add = () => {
  return (
    <CRow>
      <CCol xs={12}>
        <CCard className="mb-4">
          <CCardBody>
            <CForm className="row g-3">
              <CCol md={12}>
                <CFormLabel htmlFor="inputType">Type</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputType"
                  name="type"
                  placeholder="Enter type"
                  maxLength={100}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="status">Empanelment No</CFormLabel>
                <CFormSelect id="status" name="status">
                  <option value="">Select</option>
                  <option value="true">987352</option>
                  <option value="false">729192</option>
                </CFormSelect>
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputDesignation">Designation</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputDesignation"
                  name="designation"
                  placeholder="Enter designation"
                  maxLength={150}
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputQualification">Qualification</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputQualification"
                  name="qualification"
                  placeholder="Enter qualification"
                />
              </CCol>

              <CCol md={6}>
                <CFormLabel htmlFor="inputExperience">Experience</CFormLabel>
                <CFormInput
                  type="text"
                  id="inputExperience"
                  name="experience"
                  placeholder="Enter experience"
                  nputMode="numeric"
                  onInput={(e) => {
                    e.target.value = e.target.value.replace(/\D/g, '')
                  }}
                />
              </CCol>

              <CCol md={12}>
                <CFormLabel htmlFor="status">Status</CFormLabel>
                <CFormSelect id="status" name="status">
                  <option value="">Select</option>
                  <option value="true">True</option>
                  <option value="false">False</option>
                </CFormSelect>
              </CCol>

              <CCol xs={12}>
                <CButton color="primary" type="submit">
                  Submit
                </CButton>
              </CCol>
            </CForm>
          </CCardBody>
        </CCard>
      </CCol>
    </CRow>
  )
}

export default Add
