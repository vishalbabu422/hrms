import React, { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { CCard, CCardHeader, CCardBody } from '@coreui/react'
import Field from '../../components/field'
import { getEmployeeLtc } from '../../../services/employeeLtc'

const LtcView = () => {
  const { employeeId } = useParams()
  const [ltc, setLtc] = useState({})

  useEffect(() => {
    if (!employeeId) return

    getEmployeeLtc(employeeId)
      .then((res) => {
        console.log('LTC RESPONSE:', res.data)

        const data = res.data?.data || {}

        setLtc({
          hometown: data.hometown,
          state: data.state,
          district: data.district,
          nearestAirport: data.nearest_airport,
          nearestRailway: data.nearest_railway,
        })
      })
      .catch((err) => {
        console.error('LTC ERROR:', err)
      })
  }, [employeeId])

  return (
    <div className="row g-4">
      <div className="col-12">
        <CCard className="border-0 shadow-sm">
          <CCardHeader className="bg-light fw-semibold">
            LTC Details
          </CCardHeader>

          <CCardBody>
            <div className="row g-4">

              {/* LEFT */}
              <div className="col-md-6">
                <Field label="Hometown" value={ltc.hometown} />
                <Field label="State" value={ltc.state} />
                <Field label="Nearest Airport" value={ltc.nearestAirport} />
              </div>

              {/* RIGHT */}
              <div className="col-md-6">
                <Field label="District" value={ltc.district} />
                <Field label="Nearest Railway" value={ltc.nearestRailway} />
              </div>

            </div>
          </CCardBody>
        </CCard>
      </div>
    </div>
  )
}

export default LtcView