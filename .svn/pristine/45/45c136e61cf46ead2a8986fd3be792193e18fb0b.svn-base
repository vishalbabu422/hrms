import React, { useRef } from 'react'

const SUPPORTED_DOCS = [
  { label: 'Photo', value: 'PHOTO' },
  { label: 'Resume', value: 'RESUME' },
  { label: 'PAN Card', value: 'PAN_FILE' },
  { label: 'Aadhaar Card', value: 'AADHAAR_FILE' },
  { label: 'Voter ID', value: 'VOTER_ID_FILE' },
  { label: 'Birth Certificate', value: 'BIRTH_CERT' },
  { label: 'Driving License', value: 'DRIVING_LICENSE' },
  { label: 'Work Permit', value: 'WORK_PERMIT' },
  { label: 'Policy Document', value: 'POLICY_DOCUMENT' },
  { label: 'Salary Slip', value: 'SALARY_SLIP' },
  { label: 'Form 16', value: 'FORM16' },
  { label: 'Police Verification', value: 'POLICE_VERIFICATION' },
  { label: 'Declaration', value: 'DECLARATION' },
]

const Documents = ({
  step,
  documents,
  setDocuments,
  selectedDocType,
  setSelectedDocType,
  selectedFile,
  setSelectedFile,
}) => {
  const fileRef = useRef()

  // 🧠 Already used document types
  const usedTypes = documents.map((d) => d.type)

  // 🧠 Available docs in dropdown
  const availableDocs = SUPPORTED_DOCS.filter(
    (doc) => !usedTypes.includes(doc.value)
  )

  // 📂 File select
  const handleFileChange = (e) => {
    setSelectedFile(e.target.files[0])
  }

  // ➕ Add document
  const handleAdd = () => {
    if (!selectedDocType || !selectedFile) {
      alert('Select document type and file')
      return
    }

 
    if (documents.some((doc) => doc.type === selectedDocType)) {
      alert('This document is already added')
      return
    }

    setDocuments((prev) => [
      ...prev,
      {
        type: selectedDocType,
        file: selectedFile,
        name: selectedFile.name,
        size: selectedFile.size,
      },
    ])



    // 🔄 Reset
    setSelectedDocType('')
    setSelectedFile(null)

    if (fileRef.current) {
      fileRef.current.value = ''
    }
  }

  
  const handleRemove = (index) => {
    setDocuments((prev) => prev.filter((_, i) => i !== index))
  }

  return (
    <>
      {step === 9 && (
        <div className="step-content">

       
          {/* 📥 Upload Section */}
          <div className="card p-3 mb-3 shadow-sm">
            <div className="row g-3">

              {/* Dropdown */}
              <div className="col-md-6">
                <label className="form-label">Document Type</label>

                <select
                  className="form-select"
                  value={selectedDocType}
                  onChange={(e) => setSelectedDocType(e.target.value)}
                >
                  <option value="">Select Document</option>

                  {availableDocs.map((doc) => (
                    <option key={doc.value} value={doc.value}>
                      {doc.label}
                    </option>
                  ))}
                </select>
              </div>

              {/* File */}
              <div className="col-md-6">
                <label className="form-label">Upload File</label>

                <input
                  ref={fileRef}
                  type="file"
                  className="form-control"
                  accept=".pdf,.jpg,.jpeg,.png"
                  onChange={handleFileChange}
                />
              </div>

              {/* Add Button */}
              <div className="col-12 text-end">
                <button className="btn btn-primary" onClick={handleAdd}>
                  Add Document
                </button>
              </div>

            </div>
          </div>

          {/* 📄 Uploaded Documents */}
          {documents.length > 0 && (
            <div className="card shadow-sm p-3">
              <h6 className="fw-semibold mb-3 text-primary">
                Uploaded Documents
              </h6>

              <div className="table-responsive">
                <table className="table align-middle table-hover">
                  <thead className="table-light">
                    <tr>
                      <th>Type</th>
                      <th>File</th>
                      <th>Size</th>
                      <th></th>
                    </tr>
                  </thead>

                  <tbody>
                    {documents.map((doc, index) => {
                      const label =
                        SUPPORTED_DOCS.find((d) => d.value === doc.type)?.label ||
                        doc.type

                      return (
                        <tr key={index}>
                          <td>
                            <span className="badge bg-light border text-dark">
                              {label}
                            </span>
                          </td>

                          <td className="fw-semibold">{doc.name}</td>

                          <td>{(doc.size / 1024).toFixed(1)} KB</td>

                          <td>
                            <button
                              className="btn btn-sm btn-outline-danger"
                              onClick={() => handleRemove(index)}
                            >
                              Remove
                            </button>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      )}
    </>
  )
}

export default Documents